Two Years Prior Boolean Deep Unviable for Cost Driven Retirement[Electricity Source]=
	DELAY FIXED(Last Year Boolean Deep Unviable for Cost Driven Retirement[Electricity Source\
		], 1, 0)
	~	Dmnl
	~		|

Two Years Prior CF Scaling Revenue per Unit Capacity for Cost Driven Retirement[Electricity Source\
		]=
	DELAY FIXED(Last Year CF Scaling Revenue per Unit Capacity for Cost Driven Retirement\
		[Electricity Source], 1, 0)
	~	$/MW
	~		|

Two Years Prior Fleet Average Generation Hours for Cost Driven Retirement[Electricity Source\
		]=
	DELAY FIXED(Last Year Fleet Average Generation Hours for Cost Driven Retirement[Electricity Source\
		], 1, 0)
	~	hours
	~		|

Two Years Prior Hypothetical Hourly Electricity Capacity Factor[Electricity Timeslice\
		,Hour,Electricity Source]= DELAY FIXED (
	  Last Year Hypothetical Hourly Electricity Capacity Factor[Electricity Timeslice,Hour\
		,Electricity Source],
	  1,
	  SYSHECF Start Year Seasonal Expected Hourly Electricity Capacity Factors[Electricity Source\
		,Electricity Timeslice,Hour
	] * RAF Regional Availability Factor for Generation[Electricity Source])
	~	Dmnl
	~		|

