	~		|

Change in BAU Energy Production vs Initial Year[All Fuels]=
	BAU Energy Production including Energy Carriers[All Fuels]
	- Initial BAU Energy Production including Energy Carriers[All Fuels]
	~	BTU
	~		|

Change in BAU Kept Online Capacity Pool due to Predicted Capacity Payment[Electricity Source\
		]=
	(MIN(
	   BAU Economic Capacity Retirements Excluding Capacity Payment[Electricity Source],
	   MAX(0,
	     MIN(
	       BAU Generation Capacity Reliant on Predicted Capacity Payment This Year[Electricity Source\
		],
	       BAU Electricity Generation Capacity[Electricity Source])
	     - BAU Kept Online Capacity Pool due to Predicted Capacity Payment[Electricity Source\
		]))
	 - MIN(
	   BAU Kept Online Capacity Pool due to Predicted Capacity Payment[Electricity Source\
		],
	   BAU Retiring Generation Capacity[Electricity Source]
	   + MAX(0,
	     BAU Kept Online Capacity Pool due to Predicted Capacity Payment[Electricity Source\
		]
	     - BAU Electricity Generation Capacity[Electricity Source])))
	/ One Year
	~	MW/Year
	~		|

Change in BAU Schedule Netting Credit from Economic Retirements[Electricity Source]=
	(SUM(BAU Economic Capacity Retirements by Optimization Pass[Electricity Source,last pass\
		!])
	- MIN(BAU Schedule Netting Credit from Economic Retirements[Electricity Source],
	  BCRbQ BAU Capacity Retirements before Quantization[Electricity Source]))
	/ One Year
	~	MW/Year
	~		|

