	   'InputData/land/BLAPE/BLAPE.csv',
	   ',',
	   '1',
	   'B2'
	)
	~	g pollutant
	~		|

Blended Industrial Combustion Fuel Cost per Unit Energy[Industry Category]=
	ZIDZ(
	  SUM(Industrial Total Fuel Use before Measures[Industry Category,Industrial Fuel!]
	    * Industrial Fuel Cost per Unit Energy[Industry Category,Industrial Fuel!])
	  - Industrial Total Fuel Use before Measures[Industry Category,electricity if]
	    * Industrial Fuel Cost per Unit Energy[Industry Category,electricity if],

	  Industrial Combustion Fuel Base for Measures[Industry Category]
	)
	~	$/BTU
	~	Average cost of the industry's nonelectric fuel mix, weighted by current \
		fuel use.  Carbon-tax-inclusive via Industrial Fuel Cost per Unit Energy.  \
		Values avoided fuel purchases from process efficiency measures.
	|

Blended Industrial Heat Fuel Cost per Unit Energy[Industry Category]=
	ZIDZ(
	  SUM(Industrial Heating Process Fuel Use before Measures[Industry Category,Industrial Fuel\
		!]
	    * Industrial Fuel Cost per Unit Energy[Industry Category,Industrial Fuel!])
	  - Industrial Heating Process Fuel Use before Measures[Industry Category,electricity if\
		]
	    * Industrial Fuel Cost per Unit Energy[Industry Category,electricity if],

	  Industrial Heat Combustion Fuel Base for Measures[Industry Category]
	)
	~	$/BTU
	~	Average cost of the industry's heating-process nonelectric fuel mix, \
		weighted by current fuel use.  Carbon-tax-inclusive via Industrial Fuel \
		Cost per Unit Energy.  Values avoided fuel purchases from waste heat \
		measures.
	|

