		],
	  1,
	  0
	)
	~	$/MW
	~		|

BAU Last Year Weighted Average Expected Capacity Factors by Hour[Electricity Source,Electricity Timeslice\
		,Hour]= DELAY FIXED (
	  BAU Weighted Average Expected Capacity Factors by Hour Without Hypothetical Adjustments\
		[Electricity Source,Electricity Timeslice
	,Hour],
	  1,
	  Start Year Seasonal Expected Hourly Electricity Capacity Factors after RAF[Electricity Source\
		,Electricity Timeslice
	,Hour])
	~	Dmnl
	~		|

BAU LCFS Credit Price=
	MIN(
	  LCPC LCFS Credit Price Cap,
	
	  ZIDZ(
	    BAU Incremental Costs from Substitute Fuel Production due to LCFS,
	    BAU LCFS Credits Generated
	  )
	)
	~	$/LCFS credit
	~	Although some substitute fuels have no incremental cost to produce, they \
		still create LCFS credits and thus reduce the market price for LCFS \
		credits, so we divide total costs by total credits, rather than \
		subscripting by fuel type.
	~	:SUPPLEMENTARY 
	|

BAU LCFS Credits Generated=
	SUM(BAU Reduction in CO2 Emissions due to LCFS[Vehicle Type!,Cargo Type!,Vehicle Technology\
		!,Transportation Fuel!])
	/ GCApLC Grams CO2e Avoided per LCFS Credit
	~	LCFS credits
	~		|

BAU Legally Required Elec Portfolio Percentage[Clean Elec Requirement]=
	SUM(
	  BAU Weighted Average Elec Portfolio Percentage by Year[Future Year!,Clean Elec Requirement\
		]
	  * This Year Flag[Future Year!]
	)
	~	Dmnl
	~		|

BAU Legally Required Electricity Dispatch to Satisfy Elec Portfolio Stds[Clean Elec Requirement\
		]=
	SUM(
	  BAU Electricity Dispatch Required to Satisfy Elec Portfolio Stds[Electricity Timeslice\
		!,Hour!,Clean Elec Requirement]
	  * SHELF Days per Electricity Timeslice[Electricity Timeslice!]
	)
	~	MW*hour
	~		~	:SUPPLEMENTARY 
	|

BAU Low Carbon Hydrogen Demand=
	SUM(BAU Low Carbon Hydrogen Demand by Sector[Sectors!])
	~	BTU
	~		|

BAU Low Carbon Hydrogen Demand by Sector[Sectors] :EXCEPT:          [industry sector]\
		,[geoengineering sector],[district heat and hydrogen sector]=
	BAU Hydrogen Demand by Sector[Sectors]
	* SoHDTiGaLCbS Share of Hydrogen Demand That is Low Carbon by Sector[Sectors] ~~|
BAU Low Carbon Hydrogen Demand by Sector[industry sector]=
	SUM(BAU Industrial Fuel Use[low carbon hydrogen if,Industry Category!]) ~~|
BAU Low Carbon Hydrogen Demand by Sector[geoengineering sector]=
	BAU Geoengineering Sector Energy Use[low carbon hydrogen if] ~~|
BAU Low Carbon Hydrogen Demand by Sector[district heat and hydrogen sector]=
	BAU Fuel Used to Generate Heat[low carbon hydrogen if]
	~	BTU
	~		|

BAU Low Carbon Hydrogen Production by Pathway[Hydrogen Production Pathway]=
	ZIDZ(
	  BAU New Low Carbon Hydrogen Production Capacity This Year[Hydrogen Production Pathway\
		]
	  + BAU Surviving Capacity Used for Low Carbon Hydrogen Production[Hydrogen Production Pathway\
		],
	
	  SUM(
	    BAU New Low Carbon Hydrogen Production Capacity This Year[Hydrogen Production Pathway\
		!]
	    + BAU Surviving Capacity Used for Low Carbon Hydrogen Production[Hydrogen Production Pathway\
		!]
	  )
	)
	~	Dmnl
	~		|

BAU Low Carbon Hydrogen Production Shares with Fallback[Hydrogen Production Pathway]=
	IF THEN ELSE(
	  SUM(BAU Low Carbon Hydrogen Production by Pathway[Hydrogen Production Pathway!]) =\
		 0,
	
	  IF THEN ELSE(
	    SUM(BAU New Low Carbon Hydrogen Production Capacity Shares This Year[Hydrogen Production Pathway\
		!]) = 0,
	
	    BAU Start Year Low Carbon Hydrogen Production Shares by Pathway[Hydrogen Production Pathway\
		],
	
	    BAU New Low Carbon Hydrogen Production Capacity Shares This Year[Hydrogen Production Pathway\
		]
	  ),
	
	  ZIDZ( 
	    BAU Low Carbon Hydrogen Production by Pathway[Hydrogen Production Pathway],
	    SUM(BAU Low Carbon Hydrogen Production by Pathway[Hydrogen Production Pathway!])
	  )
	)
	~	Dmnl
	~		|

BAU Marginal Capacity Factor by Hour[Electricity Source,Electricity Timeslice,Hour,Clean Elec Requirement\
		]=
	IF THEN ELSE(
	  Time = INITIAL TIME
	
	  :OR:
	
	   ABS(BAU Last Year Electricity Generation Capacity[Electricity Source])*MW Tolerance Unit Correction Factor\
		 < Tolerance,
	
	  BAU Last Year Weighted Average Expected Capacity Factors by Hour[Electricity Source\
		,Electricity Timeslice,Hour]
	  *  IF THEN ELSE(
	    SUM(
	      BAU Last Year Weighted Average Expected Capacity Factors by Hour[Electricity Source\
		!,Electricity Timeslice,Hour]
	      * BAU Last Year Electricity Generation Capacity[Electricity Source!]
	      * BAU Elec Portfolio Qualifying Sources[Electricity Source!,Clean Elec Requirement\
		]
	    )
	    < BAU Last Year Total Electricity Demand by Hour After Demand Altering Technologies\
		[Electricity Timeslice,Hour]/One Hour
	,
	
	    1,
	
	    0),
	         
	
	  IF THEN ELSE(
	    SUM(
	      BAU Last Year Weighted Average Expected Capacity Factors by Hour[Electricity Source\
		!,Electricity Timeslice,Hour]
	      * BAU Last Year Electricity Generation Capacity[Electricity Source!]
	      * BAU Elec Portfolio Qualifying Sources[Electricity Source!,Clean Elec Requirement\
		]
	    )
	    < BAU Last Year Total Electricity Demand by Hour After Demand Altering Technologies\
		[Electricity Timeslice,Hour]/One Hour
	,
	
	BAU Last Year Weighted Average Expected Capacity Factors by Hour[Electricity Source,\
		Electricity Timeslice,Hour]
	    ,
	
	    0
	  )
	)
	~	Dmnl
	~		|

BAU Marginal Capacity Factor by Hour for Hybrid Plants[Hybrid Electricity Source,Electricity Timeslice\
		,Hour,Clean Elec Requirement]=
	IF THEN ELSE(
	  Time = INITIAL TIME
	
	  :OR:
	
	   ABS(BAU Last Year Electricity Generation Capacity[Hybrid Electricity Source])*MW Tolerance Unit Correction Factor\
		 < Tolerance,
	
	  BAU Expected Capacity Factors by Hour for Hybrid Plants Built This Year[Hybrid Electricity Source\
		,Electricity Timeslice,Hour]
	  *  IF THEN ELSE(
	    SUM(
	      BAU Last Year Weighted Average Expected Capacity Factors by Hour[Electricity Source\
		!,Electricity Timeslice,Hour]
	      * BAU Last Year Electricity Generation Capacity[Electricity Source!]
	      * BAU Elec Portfolio Qualifying Sources[Electricity Source!,Clean Elec Requirement\
		]
	    )
	    < BAU Last Year Total Electricity Demand by Hour After Demand Altering Technologies\
		[Electricity Timeslice,Hour]/One Hour
	,
	
	    1,
	
	    0),
	         
	
	  IF THEN ELSE(
	    SUM(
	      BAU Last Year Weighted Average Expected Capacity Factors by Hour[Electricity Source\
		!,Electricity Timeslice,Hour]
	      * BAU Last Year Electricity Generation Capacity[Electricity Source!]
	      * BAU Elec Portfolio Qualifying Sources[Electricity Source!,Clean Elec Requirement\
		]
	    )
	    < BAU Last Year Total Electricity Demand by Hour After Demand Altering Technologies\
		[Electricity Timeslice,Hour]/One Hour
	,
	
	BAU Expected Capacity Factors by Hour for Hybrid Plants Built This Year[Hybrid Electricity Source\
		,Electricity Timeslice,Hour]
	    ,
	
	    0
	  )
	)
	~	Dmnl
	~		|

BAU Marginal Capacity Factor x Hours per Year[Electricity Source,Clean Elec Requirement\
		]=
	SUM(
	  BAU Marginal Capacity Factor by Hour[Electricity Source,Electricity Timeslice!,Hour\
		!,Clean Elec Requirement]
	  * SHELF Days per Electricity Timeslice[Electricity Timeslice!]
	  * One Hour
	)
	~	hours
	~		|

BAU Marginal Capacity Factor x Hours per Year for Hybrid Power Plants[Hybrid Electricity Source\
		, Clean Elec Requirement]=
	SUM(
	  BAU Marginal Capacity Factor by Hour for Hybrid Plants[Hybrid Electricity Source,Electricity Timeslice\
		!,Hour!,Clean Elec Requirement]
	  * SHELF Days per Electricity Timeslice[Electricity Timeslice!]
	  * One Hour
	)
	~	hours
	~		|

BAU Marginal Dispatch Cost by Hour[Electricity Timeslice,Hour]=
	IF THEN ELSE(ABS(SUM(BAU Total Electricity Dispatched by Hour by Plant Type[Electricity Timeslice\
		,Hour,Electricity Source
	!]
	))*MWhr Tolerance Unit Correction Factor < Tolerance,EIaE Imported Electricity Price\
		,
	  IF THEN ELSE(
	    ABS(BAU Electricity Market Price Adjusted for Zero Least Cost Dispatch Hours[Electricity Timeslice\
		,Hour])*Dollar per MWhr Tolerance Unit Correction Factor
	 < Tolerance
	    :OR: ABS(SUM(BAU Electricity Dispatched by Least Cost by Hour[Electricity Timeslice\
		,Hour,Electricity Source!]))*MWhr Tolerance Unit Correction Factor
	 < Tolerance
	,
	
	    SUM(BAU Dispatch Cost per Unit Electricity Output[Electricity Source!]*BAU Share of Total Electricity Dispatched by Hour by Plant Type\
		[Electricity Timeslice,Hour,Electricity Source!]),
	
	    BAU Electricity Market Price Adjusted for Zero Least Cost Dispatch Hours[Electricity Timeslice\
		,Hour]
	  )
	)
	~	$/(MW*hour)
	~		|

BAU Max Achievable Annual CES this Year=
	SUM(
	  MIN(
	    BAU Max Expected Hourly Output from CES Qualifying Resources Irrespective of Electricity Demand\
		[Electricity Timeslice
	!,Hour!],
	  BAU Total Qualifying CES Electricity Demand by Hour After Demand Altering Technologies\
		[Electricity Timeslice!,Hour!])
	  * SHELF Days per Electricity Timeslice[Electricity Timeslice!]
	)
	/ SUM(
	    BAU Total Qualifying CES Electricity Demand by Hour After Demand Altering Technologies\
		[Electricity Timeslice!,Hour!]
	    * SHELF Days per Electricity Timeslice[Electricity Timeslice!]
	  )
	~	Dmnl
	~		|

BAU Max Achievable Annual RPS this Year=
	SUM(
	  MIN(
	    BAU Max Expected Hourly Output from RPS Qualifying Resources Irrespective of Electricity Demand\
		[Electricity Timeslice
	!,
	Hour!],
	  BAU Total Qualifying RPS Electricity Demand by Hour After Demand Altering Technologies\
		[Electricity Timeslice!,Hour!])
	  * SHELF Days per Electricity Timeslice[Electricity Timeslice!]
	)
	/ SUM(
	    BAU Total Qualifying RPS Electricity Demand by Hour After Demand Altering Technologies\
		[Electricity Timeslice!,Hour!]
	    * SHELF Days per Electricity Timeslice[Electricity Timeslice!]
	  )
	~	Dmnl
	~		|

BAU Max Achievable CES Hit by Optimization Pass[Optimization Pass] :EXCEPT:   [last pass\
		]=
	IF THEN ELSE(
	  ABS(
	    BAU Expected Achievable Annual CES by Optimization Pass[Optimization Pass]
	    - BAU Max Achievable Annual CES this Year
	  ) < Tolerance
	  :AND:
	  BAU Expected Achievable Annual CES by Optimization Pass[Optimization Pass]
	  <= BAU Elec Portfolio Percentage to Seek This Year[CES],
	  1,
	  9999
	) ~~|
BAU Max Achievable CES Hit by Optimization Pass[last pass]=
	9999
	~	Dmnl
	~		|

BAU Max Achievable RPS Hit by Optimization Pass[Optimization Pass] :EXCEPT:     [last pass\
		]=
	IF THEN ELSE(
	  ABS(
	    BAU Expected Achievable Annual RPS by Optimization Pass[Optimization Pass]
	    - BAU Max Achievable Annual RPS this Year
	  ) < Tolerance
	  :AND:
	  BAU Expected Achievable Annual RPS by Optimization Pass[Optimization Pass]
	  <= BAU Elec Portfolio Percentage to Seek This Year[RPS],
	  1,
	  9999
	) ~~|
BAU Max Achievable RPS Hit by Optimization Pass[last pass]=
	9999
	~	Dmnl
	~		|

BAU Max Additional Potential Capacity by Source[Electricity Source]=
	MAX(
	  0,
	
	  MPCbS Max Potential Capacity by Source[Electricity Source]
	  - BAU Surviving Electricity Generation Capacity before Economic Retirements[Electricity Source\
		]
	)
	~	MW
	~		|

BAU Max Capacity Available for CCUS Retrofit[Electricity Source] :EXCEPT:      [hard coal w CCS es\
		],[natural gas combined cycle w CCS es
],[biomass w CCS es],[lignite w CCS es]=
	0 ~~|
BAU Max Capacity Available for CCUS Retrofit[hard coal w CCS es]=
	BAU Surviving Electricity Generation Capacity before Economic Retirements[hard coal es\
		] ~~|
BAU Max Capacity Available for CCUS Retrofit[natural gas combined cycle w CCS es]=
	BAU Surviving Electricity Generation Capacity before Economic Retirements[natural gas combined cycle es\
		] ~~|
BAU Max Capacity Available for CCUS Retrofit[biomass w CCS es]=
	BAU Surviving Electricity Generation Capacity before Economic Retirements[biomass es\
		] ~~|
BAU Max Capacity Available for CCUS Retrofit[lignite w CCS es]=
	BAU Surviving Electricity Generation Capacity before Economic Retirements[lignite es\
		]
	~	MW
	~		|

BAU Max Capacity Available for CCUS Retrofits after Mandated Retrofits[Electricity Source\
		] :EXCEPT:    [CCUS Electricity Source]=
	0 ~~|
BAU Max Capacity Available for CCUS Retrofits after Mandated Retrofits[CCUS Electricity Source\
		]=
	MAX(0,(BAU Max Capacity Available for CCUS Retrofit[CCUS Electricity Source]
	-BAU New Policy Mandated Retrofits[CCUS Electricity Source]))
	
	* IF THEN ELSE(
	    BBPPRTY BAU Ban Power Plant Retrofits This Year[CCUS Electricity Source]>0,
	    0,
	    1
	  )
	~	MW
	~		|

BAU Max Capacity Buildable after Cost Effective and RPS Additions[Electricity Source,\
		Clean Elec Requirement]=
	MAX(
	  0,
	
	  BAU Max Capacity Buildable after Mandated and Required Clean Dispatchable Additions\
		[Electricity Source]
	  - BAU New Capacity Desired due to Cost Effectiveness[Electricity Source,Clean Elec Requirement\
		]
	  - BAU New Capacity Desired due to Cost Effectiveness for Hybrid Power Plants[Electricity Source\
		,Clean Elec Requirement]
	)
	~	MW
	~		|

BAU Max Capacity Buildable after Mandated Additions[Electricity Source]=
	MAX(
	  0,
	
	  BAU Max Capacity Buildable This Year[Electricity Source]
	  - BAU New Policy Mandated Capacity[Electricity Source]
	)
	~	MW
	~		|

BAU Max Capacity Buildable after Mandated and Required Clean Dispatchable Additions[Electricity Source\
		]=
	MAX(0,
	  BAU Max Capacity Buildable after Mandated Additions[Electricity Source]
	 )
	~	MW
	~		|

BAU Max Capacity Buildable This Year[Electricity Source]=
	IF THEN ELSE(
	  BAU Boolean Plant Types that May Not be Built due to Having Been Retired to Zero[Electricity Source\
		] > 0
	  :OR:
	  BBNPPTY BAU Ban New Power Plants This Year[Electricity Source] > 0,
	
	  0,
	
	  MIN(
	    BAU Max Additional Potential Capacity by Source[Electricity Source],
	    BAU Annual Electricity Capacity Build Limit[Electricity Source]
	  )
	)
	~	MW
	~		|

BAU Max Capacity that Can be Retired Economically by Plant Type[Electricity Source]=
	MAX(0,
	SUM(
	  BAU Last Year Electricity Generation Capacity by Vintage[Electricity Source,Modeled Vintage\
		 !]
	  * BAU Retirable Vintages by Year[Modeled Vintage!]
	)
	  - BAU Capacity Retirements from Schedule[Electricity Source])
	~	MW
	~		|

BAU Max Expected Hourly Output from CES Qualifying Resources Irrespective of Electricity Demand\
		[Electricity Timeslice,Hour]=
	BAU Expected CES Qualifying Hourly Output from Surviving Capacity[Electricity Timeslice\
		,Hour]
	+ BAU Expected CES Qualifying Hourly Output from Mandated and Required Clean Dispatchable Capacity\
		[Electricity Timeslice
	,Hour]
	+ BAU Max Potential CES Qualifying Hourly Output from New Cost Effective Capacity[Electricity Timeslice\
		,Hour]
	~	MW*hour
	~		|

BAU Max Expected Hourly Output from RPS Qualifying Resources Irrespective of Electricity Demand\
		[Electricity Timeslice,Hour]=
	BAU Expected RPS Qualifying Hourly Output from Surviving Capacity[Electricity Timeslice\
		,Hour]
	+ BAU Expected RPS Qualifying Hourly Output from Mandated and Required Clean Dispatchable Capacity\
		[Electricity Timeslice
	,Hour]
	+ BAU Max Potential RPS Qualifying Hourly Output from New Cost Effective Capacity[Electricity Timeslice\
		,Hour]
	~	MW*hour
	~		|

BAU Max Incremental Revenue for Cost Effective CCUS Retrofits for RPS and CES[CCUS Electricity Source\
		,Clean Elec Requirement]=
	MAX(0,
	  BAU Predicted Change in Energy Market Revenue for CCUS Retrofits[CCUS Electricity Source\
		]
	  + BAU Max RPS and CES Revenue at Marginal Capacity Factors[CCUS Electricity Source\
		,Clean Elec Requirement]
	  -(BAU Cost per MW for CCUS Retrofits Excluding Subsidies[CCUS Electricity Source]
	    * SoCtMbCtbDP Share of Costs that Must be Covered to Be Deemed Profitable[CCUS Electricity Source\
		]
	  )
	)
	~	$/MW
	~		|

BAU Max Incremental Revenue for Cost Effectiveness Additions for Hybrid Power Plants for RPS and CES\
		[Hybrid Electricity Source,Clean Elec Requirement]=
	MAX(0,
	  BAU Average Four Year Prior Net Energy Market Revenue by Plant Type Excluding Subsidies for Hybrid Power Plants\
		[Hybrid Electricity Source
	]
	  + BAU Max RPS and CES Revenue at Marginal Capacity Factors for Hybrid Power Plants\
		[Hybrid Electricity Source,Clean Elec Requirement]
	  -(BAU Annualized Fixed Costs per Unit New Capacity[Hybrid Electricity Source] + BAU Annual Financing Repayment per Unit Storage Capacity for Hybrid Power Plants
	[Hybrid Electricity Source])
	    * SoCtMbCtbDP Share of Costs that Must be Covered to Be Deemed Profitable[Hybrid Electricity Source\
		]
	  )
	~	$/MW
	~		|

BAU Max Incremental Revenue for Cost Effectiveness Additions for RPS and CES[Electricity Source\
		,Clean Elec Requirement]=
	MAX(0,
	      BAU Average Four Year Prior Total Predicted Net Energy Market Revenue per MW for New Entrants\
		[Electricity Source]
	      + BAU Max RPS and CES Revenue at Marginal Capacity Factors[Electricity Source,\
		Clean Elec Requirement]
	      -(BAU Annualized Fixed Costs per Unit New Capacity[Electricity Source]
	         * SoCtMbCtbDP Share of Costs that Must be Covered to Be Deemed Profitable
	[Electricity Source]
	      )
	    )
	~	$/MW
	~		|

BAU Max Net Electricity Supply Relative to Demand[Electricity Timeslice]=
	VMAX(BAU Net Electricity Supply Relative to Demand by Hour[Electricity Timeslice,Hour\
		!])
	~	MW*hr
	~	BAU twin of Max Net Electricity Supply Relative to Demand.
	|

BAU Max New Capacity Desired due to Cost Effectiveness for Hybrid Power Plants for RPS and CES\
		[Electricity Source,Clean Elec Requirement] :EXCEPT:              
[
Hybrid Electricity Source,Clean Elec Requirement]=
	0 ~~|
BAU Max New Capacity Desired due to Cost Effectiveness for Hybrid Power Plants for RPS and CES\
		[Hybrid Electricity Source
,Clean Elec Requirement]=
	QUANTUM(
	
	  IF THEN ELSE(
	
	    BAU Max Profitable Capacity for Cost Effectiveness Additions for Hybrid Power Plants for RPS and CES Before Hybrid Prioritization\
		[Hybrid Electricity Source,Clean Elec Requirement]
	    + BAU Max Profitable Capacity for Cost Effectiveness Additions for RPS and CES Before Hybrid Prioritization\
		[Hybrid Electricity Source,Clean Elec Requirement]
	    > BAU Max Capacity Buildable after Mandated and Required Clean Dispatchable Additions\
		[Hybrid Electricity Source],
	
	 
	  BAU Max Capacity Buildable after Mandated and Required Clean Dispatchable Additions\
		[Hybrid Electricity Source]
	  * 
	  ZIDZ(
	    BAU Max Profitable Capacity for Cost Effectiveness Additions for Hybrid Power Plants for RPS and CES Before Hybrid Prioritization\
		[Hybrid Electricity Source,Clean Elec Requirement],
	    BAU Max Profitable Capacity for Cost Effectiveness Additions for Hybrid Power Plants for RPS and CES Before Hybrid Prioritization\
		[Hybrid Electricity Source,Clean Elec Requirement]
	    + BAU Max Profitable Capacity for Cost Effectiveness Additions for RPS and CES Before Hybrid Prioritization\
		[Hybrid Electricity Source,Clean Elec Requirement]
	  ),
	  BAU Max Profitable Capacity for Cost Effectiveness Additions for Hybrid Power Plants for RPS and CES Before Hybrid Prioritization\
		[Hybrid Electricity Source,Clean Elec Requirement]
	),
	  
	MPPC Minimum Power Plant Capacity[Hybrid Electricity Source]
	)
	~	MW
	~		|

BAU Max New Capacity Desired due to Cost Effectiveness for RPS and CES[Electricity Source\
		,Clean Elec Requirement] :EXCEPT: [Hybrid Electricity Source,Clean Elec Requirement\
		]=
	QUANTUM(
	  MIN(
	    BAU Max Capacity Buildable after Mandated and Required Clean Dispatchable Additions\
		[Electricity Source],
	
	    BAU Max Profitable Capacity for Cost Effectiveness Additions for RPS and CES Before Hybrid Prioritization\
		[Electricity Source,Clean Elec Requirement]
	  ),
	 MPPC Minimum Power Plant Capacity[Electricity Source]
	) ~~|
BAU Max New Capacity Desired due to Cost Effectiveness for RPS and CES[Hybrid Electricity Source\
		,Clean Elec Requirement]=
	QUANTUM(
	
	  IF THEN ELSE(
	
	    BAU Max Profitable Capacity for Cost Effectiveness Additions for Hybrid Power Plants for RPS and CES Before Hybrid Prioritization\
		[Hybrid Electricity Source,Clean Elec Requirement]
	    + BAU Max Profitable Capacity for Cost Effectiveness Additions for RPS and CES Before Hybrid Prioritization\
		[Hybrid Electricity Source,Clean Elec Requirement]
	    > BAU Max Capacity Buildable after Mandated and Required Clean Dispatchable Additions\
		[Hybrid Electricity Source],
	
	 
	  BAU Max Capacity Buildable after Mandated and Required Clean Dispatchable Additions\
		[Hybrid Electricity Source]
	  * 
	  ZIDZ(
	    BAU Max Profitable Capacity for Cost Effectiveness Additions for RPS and CES Before Hybrid Prioritization\
		[Hybrid Electricity Source,Clean Elec Requirement],
	    BAU Max Profitable Capacity for Cost Effectiveness Additions for Hybrid Power Plants for RPS and CES Before Hybrid Prioritization\
		[Hybrid Electricity Source,Clean Elec Requirement]
	    + BAU Max Profitable Capacity for Cost Effectiveness Additions for RPS and CES Before Hybrid Prioritization\
		[Hybrid Electricity Source,Clean Elec Requirement]
	  ),
	  BAU Max Profitable Capacity for Cost Effectiveness Additions for RPS and CES Before Hybrid Prioritization\
		[Hybrid Electricity Source,Clean Elec Requirement]
	),
	  
	MPPC Minimum Power Plant Capacity[Hybrid Electricity Source]
	)
	~	MW
	~		|

BAU Max Potential CES Qualifying Hourly Output from New Cost Effective Capacity[Electricity Timeslice\
		,Hour]=
	SUM(
	  BAU Max New Capacity Desired due to Cost Effectiveness for RPS and CES[Electricity Source\
		!,CES]
	   * BAU Last Year Hourly Bid Electricity Capacity Factors by Plant Type[Electricity Timeslice\
		,Hour,Electricity Source!]
	   * BAU Elec Portfolio Qualifying Sources[Electricity Source!,CES]
	  * (1-TACFMfPBTY Time Adjusted Capacity Factor Multiplier for Plants Built This Year\
		[Electricity Source!])
	) * One Hour
	        
	+ SUM(
	  BAU Max Retrofitted Capacity Desired due to Cost Effectiveness for RPS and CES[Electricity Source\
		!,CES]
	  * BAU Last Year Hourly Bid Electricity Capacity Factors by Plant Type[Electricity Timeslice\
		,Hour,Electricity Source!]
	  * BAU Elec Portfolio Qualifying Sources[Electricity Source!,CES]
	  * (1-TACFMfPBTY Time Adjusted Capacity Factor Multiplier for Plants Built This Year\
		[Electricity Source!])
	) * One Hour
	        
	       + SUM(BAU Max New Capacity Desired due to Cost Effectiveness for Hybrid Power Plants for RPS and CES\
		[Hybrid Electricity Source
	!,CES]
	        * BAU Expected Capacity Factors by Hour for Hybrid Plants Built This Year[Hybrid Electricity Source\
		!,Electricity Timeslice
	,Hour]
	        * BAU Elec Portfolio Qualifying Sources[Hybrid Electricity Source!,CES]
	       *(1-TACFMfPBTY Time Adjusted Capacity Factor Multiplier for Plants Built This Year\
		[Hybrid Electricity Source!])
	) * One Hour
	~	MW*hour
	~		|

BAU Max Potential RPS Qualifying Hourly Output from New Cost Effective Capacity[Electricity Timeslice\
		,Hour]=
	SUM(
	  BAU Max New Capacity Desired due to Cost Effectiveness for RPS and CES[Electricity Source\
		!,RPS]
	   * BAU Last Year Hourly Bid Electricity Capacity Factors by Plant Type[Electricity Timeslice\
		,Hour,Electricity Source!]
	   * BAU Elec Portfolio Qualifying Sources[Electricity Source!,RPS]
	  * (1-TACFMfPBTY Time Adjusted Capacity Factor Multiplier for Plants Built This Year\
		[Electricity Source!])
	) * One Hour
	        
	+ SUM(
	  BAU Max Retrofitted Capacity Desired due to Cost Effectiveness for RPS and CES[Electricity Source\
		!,RPS]
	  * BAU Last Year Hourly Bid Electricity Capacity Factors by Plant Type[Electricity Timeslice\
		,Hour,Electricity Source!]
	  * BAU Elec Portfolio Qualifying Sources[Electricity Source!,RPS]
	  * (1-TACFMfPBTY Time Adjusted Capacity Factor Multiplier for Plants Built This Year\
		[Electricity Source!])
	) * One Hour
	        
	       + SUM(BAU Max New Capacity Desired due to Cost Effectiveness for Hybrid Power Plants for RPS and CES\
		[Hybrid Electricity Source
	!,RPS]
	        * BAU Expected Capacity Factors by Hour for Hybrid Plants Built This Year[Hybrid Electricity Source\
		!,Electricity Timeslice
	,Hour]
	        * BAU Elec Portfolio Qualifying Sources[Hybrid Electricity Source!,RPS]
	       *(1-TACFMfPBTY Time Adjusted Capacity Factor Multiplier for Plants Built This Year\
		[Hybrid Electricity Source!])
	) * One Hour
	~	MW*hour
	~		|

BAU Max Profitable Capacity for Cost Effective CCUS Retrofits for RPS and CES[CCUS Electricity Source
,Clean Elec Requirement]=
	IF THEN ELSE(
	  BAU Max Incremental Revenue for Cost Effective CCUS Retrofits for RPS and CES[CCUS Electricity Source\
		,Clean Elec Requirement
	] < 1,
	  0,
	  (1-exp(-((  BAU Max Incremental Revenue for Cost Effective CCUS Retrofits for RPS and CES\
		[CCUS Electricity Source,Clean Elec Requirement
	]/BAU Capacity Supply Curve Parameters by Power Plant Type[cutoff parameter,CCUS Electricity Source\
		] / One Dollar per MW-(BAU Capacity Supply Curve Parameters by Power Plant Type[location parameter\
		,CCUS Electricity Source]-0.5))/BAU Capacity Supply Curve Parameters by Power Plant Type\
		[scale parameter,CCUS Electricity Source])^BAU Capacity Supply Curve Parameters by Power Plant Type\
		[shape parameter,CCUS Electricity Source]))*BAU Capacity Supply Curve Parameters by Power Plant Type\
		[saturation,CCUS Electricity Source] * One MW
	)
	~	MW
	~		|

BAU Max Profitable Capacity for Cost Effectiveness Additions for Hybrid Power Plants for RPS and CES\
		[Hybrid Electricity Source,Clean Elec Requirement]=
	IF THEN ELSE(
	  BAU Max Incremental Revenue for Cost Effectiveness Additions for Hybrid Power Plants for RPS and CES\
		[Hybrid Electricity Source
	,Clean Elec Requirement
	] < 1,
	  0,
	  (1-exp(-((  BAU Max Incremental Revenue for Cost Effectiveness Additions for Hybrid Power Plants for RPS and CES\
		[Hybrid Electricity Source
	,Clean Elec Requirement
	]/BAU Capacity Supply Curve Parameters by Power Plant Type[cutoff parameter,Hybrid Electricity Source\
		] / One Dollar per MW-(BAU Capacity Supply Curve Parameters by Power Plant Type[location parameter\
		,Hybrid Electricity Source]-0.5))/BAU Capacity Supply Curve Parameters by Power Plant Type\
		[scale parameter,Hybrid Electricity Source])^BAU Capacity Supply Curve Parameters by Power Plant Type\
		[shape parameter,Hybrid Electricity Source]))*BAU Capacity Supply Curve Parameters by Power Plant Type\
		[saturation,Hybrid Electricity Source] * One MW
	)
	~	MW
	~		|

BAU Max Profitable Capacity for Cost Effectiveness Additions for Hybrid Power Plants for RPS and CES Before Hybrid Prioritization\
		[Hybrid Electricity Source,Clean Elec Requirement]=
	BAU Max Profitable Capacity for Cost Effectiveness Additions for Hybrid Power Plants for RPS and CES\
		[Hybrid Electricity Source
	,Clean Elec Requirement]
	* CSCSoCECBiaSY Share of Cost Effective Capacity Built in a Single Year[Hybrid Electricity Source\
		]
	~	MW
	~		|

BAU Max Profitable Capacity for Cost Effectiveness Additions for RPS and CES[Electricity Source
,Clean Elec Requirement]=
	IF THEN ELSE(
	  BAU Max Incremental Revenue for Cost Effectiveness Additions for RPS and CES[Electricity Source\
		,Clean Elec Requirement
	] < 1,
	  0,
	  (1-exp(-((  BAU Max Incremental Revenue for Cost Effectiveness Additions for RPS and CES\
		[Electricity Source,Clean Elec Requirement
	]/BAU Capacity Supply Curve Parameters by Power Plant Type[cutoff parameter,Electricity Source\
		] / One Dollar per MW-(BAU Capacity Supply Curve Parameters by Power Plant Type[location parameter\
		,Electricity Source]-0.5))/BAU Capacity Supply Curve Parameters by Power Plant Type\
		[scale parameter,Electricity Source])^BAU Capacity Supply Curve Parameters by Power Plant Type\
		[shape parameter,Electricity Source]))*BAU Capacity Supply Curve Parameters by Power Plant Type\
		[saturation,Electricity Source] * One MW
	)
	~	MW
	~		|

BAU Max Profitable Capacity for Cost Effectiveness Additions for RPS and CES Before Hybrid Prioritization\
		[Electricity Source, Clean Elec Requirement]=
	BAU Max Profitable Capacity for Cost Effectiveness Additions for RPS and CES[Electricity Source\
		,Clean Elec Requirement]
	* CSCSoCECBiaSY Share of Cost Effective Capacity Built in a Single Year[Electricity Source\
		]
	~	MW
	~		|

BAU Max Retrofitted Capacity Desired due to Cost Effectiveness for RPS and CES[Electricity Source\
		,Clean Elec Requirement] :EXCEPT:     [CCUS Electricity Source,Clean Elec Requirement
]=
	0 ~~|
BAU Max Retrofitted Capacity Desired due to Cost Effectiveness for RPS and CES[CCUS Electricity Source\
		,Clean Elec Requirement]=
	QUANTUM(
	  MIN(
	    BAU Max Capacity Available for CCUS Retrofits after Mandated Retrofits[CCUS Electricity Source\
		],
	
	    BAU Max Profitable Capacity for Cost Effective CCUS Retrofits for RPS and CES[CCUS Electricity Source\
		,Clean Elec Requirement]
	    * CSCSoCECBiaSY Share of Cost Effective Capacity Built in a Single Year[CCUS Electricity Source\
		]
	  ),
	 MPPC Minimum Power Plant Capacity[CCUS Electricity Source]
	 )
	~	MW
	~		|

BAU Max RPS and CES Revenue at Marginal Capacity Factors[Electricity Source,Clean Elec Requirement\
		]=
	BAU Elec Portfolio Qualifying Sources[Electricity Source,Clean Elec Requirement]
	* BAU Marginal Capacity Factor x Hours per Year[Electricity Source,Clean Elec Requirement\
		]
	* BRACP BAU RPS Alternative Compliance Payment
	~	$/MW
	~		|

BAU Max RPS and CES Revenue at Marginal Capacity Factors for Hybrid Power Plants[Hybrid Electricity Source\
		,Clean Elec Requirement]=
	BAU Marginal Capacity Factor x Hours per Year for Hybrid Power Plants[Hybrid Electricity Source\
		,Clean Elec Requirement]
	* BRACP BAU RPS Alternative Compliance Payment
	* BAU Elec Portfolio Qualifying Sources[Hybrid Electricity Source,Clean Elec Requirement\
		]
	~	$/MW
	~		|

BAU Max Slope of Line Approaching Future Elec Portfolio Standard[Clean Elec Requirement\
		]=
	VMAX(
	  BAU Slope of Line Approaching Future Elec Portfolio Percentages by Year[Future Year\
		!,Clean Elec Requirement]
	)
	~	Dmnl
	~		|

BAU Maximum Achievable Binding Hour Supply for Dispatchable Reliability[Optimization Pass\
		]=
	SUM(
	  (BAU Electricity Generation Capacity before Reliability Additions[Electricity Source\
		!]
	   + MAX(0,
	       MIN(
	         BAU Max Capacity Buildable after Cost Effective and RPS Additions[Electricity Source\
		!,CES],
	         BAU Capacity Supply Curve Parameters by Power Plant Type[saturation,Electricity Source\
		!] * One MW
	           * CSCSoCECBiaSY Share of Cost Effective Capacity Built in a Single Year[Electricity Source\
		!]
	         - BAU Total New Capacity Desired due to Cost Effectiveness[Electricity Source\
		!,CES]
	       )
	     )
	     * MAX(
	         BAU Last Year New Entry Reliability Credit Relaxation Share,
	         IF THEN ELSE(
	           BAU Five Year Foresight Elec Portfolio Values for Reliability Check[RPS]=\
		1,
	           BAU Elec Portfolio Qualifying Sources[Electricity Source!,RPS],
	           IF THEN ELSE(
	             BAU Five Year Foresight Elec Portfolio Values for Reliability Check[CES\
		]=1,
	             BAU Elec Portfolio Qualifying Sources[Electricity Source!,CES],
	             1
	           )
	         )
	       )
	  )
	  * BAU Last Year Hourly Bid Electricity Capacity Factors for Reliability in Binding Hour by Plant Type\
		[Electricity Source
	!]
	)
	* One Hour
	+ BAU New Grid Battery Capacity Deployed for Seasonal Dispatchable Reliability by Optimization Pass\
		[Optimization Pass]
	  * ESTRTE Grid Battery Round Trip Efficiency
	  / GBSC Diurnal Grid Battery Daily Storage Duration
	  * One Hour
	~	MW*hour
	~		|

BAU Maximum Annual Decrease in Demand from Diurnal Grid Batteries=
	SUM(
	  BAU Last Year Grid and Hybrid Battery Storage Available for Load Shifting[Electricity Timeslice\
		!]
	  * SHELF Days per Electricity Timeslice[Electricity Timeslice!]
	  * ESTRTE Grid Battery Round Trip Efficiency
	)
	~	MW*hour
	~		|

BAU Maximum Annual Decrease in Demand from EVs=
	BAU Maximum Daily Quantity of Electricity Charged by EVs for Diurnal Balancing
	* ESTRTE Grid Battery Round Trip Efficiency
	* Days per Year
	~	MW*hour
	~		|

BAU Maximum Annual Decrease in Demand from Pumped Hydro=
	SUM(BAU Maximum Daily Quantity of Electricity Charged by Pumped Hydro[Electricity Timeslice\
		!]
	  * SHELF Days per Electricity Timeslice[Electricity Timeslice!]
	  )
	* ESTRTE Pumped Hydro Round Trip Efficiency
	~	MW*hour
	~		|

BAU Maximum Annual Decrease in Demand from Seasonal Electricity Storage=
	BAU Maximum Annual Quantity of Electricity Charged by Seasonal Electricity Storage
	* SES Seasonal Electricity Storage Round Trip Efficiency
	~	MW*hour
	~		|

BAU Maximum Annual Quantity of Electricity Absorbed for Seasonal Balancing=
	BAU Maximum Annual Quantity of Electricity Charged by Seasonal Electricity Storage
	* RAF Regional Availability Factor for Demand Altering Technologies
	~	MW*hr
	~		|

BAU Maximum Annual Quantity of Electricity Absorbed for Seasonal Net Peak Load Reduction\
		=
	BAU Maximum Annual Quantity of Electricity Absorbed for Seasonal Balancing
	~	MW*hr
	~		|

BAU Maximum Annual Quantity of Electricity Charged by Seasonal Electricity Storage=
	SES Seasonal Electricity Storage Capacity
	* SES Seasonal Electricity Storage Annual Charge and Discharge Cycles
	~	MW*hr
	~		|

BAU Maximum Capacity Factor after RAF[Electricity Source]=
	MCF Maximum Capacity Factor[Electricity Source]
	* RAF Regional Availability Factor for Generation[Electricity Source]
	~	Dmnl
	~		|

BAU Maximum Daily Quantity of Electricity Absorbed for Diurnal Balancing[Electricity Timeslice\
		]=
	(
	  BAU Last Year Grid and Hybrid Battery Storage Available for Load Shifting[Electricity Timeslice\
		]
	  + BAU Maximum Daily Quantity of Electricity Charged by EVs for Diurnal Balancing
	  + BAU Maximum Daily Quantity of Electricity Charged by Pumped Hydro[Electricity Timeslice\
		]
	)
	* RAF Regional Availability Factor for Demand Altering Technologies
	~	MW*hr
	~		|

BAU Maximum Daily Quantity of Electricity Absorbed for Diurnal Net Peak Load Reduction\
		[Electricity Timeslice]=
	BAU Maximum Daily Quantity of Electricity Absorbed for Diurnal Balancing[Electricity Timeslice\
		]
	~	MW*hr
	~		|

BAU Maximum Daily Quantity of Electricity Charged by EVs for Diurnal Balancing=
	BAU Total EV Battery Capacity
	* BEVGB BAU Fraction of EVs Used for Grid Balancing on Average Day
	* BEVGB Fraction of EV Battery Capacity Used for Grid Balancing when EV is Used for Grid Balancing
	~	MW*hr
	~		|

BAU Maximum Daily Quantity of Electricity Charged by Pumped Hydro[Electricity Timeslice\
		]=
	BPHC BAU Pumped Hydro Capacity
	* SUM(SYSHECF Start Year Seasonal Expected Capacity Factor for Pumped Hydro[Electricity Timeslice\
		,Hour!])
	* One Hour
	~	MW*hr
	~		|

BAU Maximum Daily Quantity of Electricity Reduced by Demand Response Programs[peak day electricity timeslice\
		]=
	BAU This Year Demand Response Capacity
	* DRC Average DR Hours per Day on Which DR is Called Upon ~~|
BAU Maximum Daily Quantity of Electricity Reduced by Demand Response Programs[average day electricity timeslice\
		]=
	0
	~	MW*hr
	~	We assume that DR can be called upon for every peak day (i.e. at least the \
		five peak summer and five peak winter days).  In the U.S., an average \
		number of DR days per year is 24, more than enough to be used on all peak \
		days.
	|

BAU Maximum Daily Quantity of Electricity Reduced by Demand Response Programs for Net Peak Load Reduction\
		[Electricity Timeslice]=
	BAU Maximum Daily Quantity of Electricity Reduced by Demand Response Programs[Electricity Timeslice\
		]
	~	MW*hr
	~		|

BAU Maximum Possible LCFS Percentage=
	ZIDZ(
	  SUM(BAU Carbon Free Energy in Absence of LCFS by Vehicle Type[Vehicle Type!,Cargo Type\
		!,Vehicle Technology!,Transportation Fuel!])
	   + SUM(BAU Quantity Carbon Free Energy May be Increased by Fuel by Regulated Vehicle Type\
		[Vehicle Type!,Cargo Type!,Transportation Fuel!]),
	
	  SUM(BAU Fuel that would be Used by Regulated Vehicle Types in Absence of LCFS with Elec Eff Adj\
		[Vehicle Type!,Cargo Type!,Vehicle Technology!,Transportation Fuel!])
	)
	~	Dmnl
	~		~	:SUPPLEMENTARY 
	|

BAU Maximum Potential Binding Hour Electricity Output by Hour for Dispatchable Reliability\
		[Optimization Pass]=
	(SUM(
	 BAU Total Electricity Generation Capacity by Optimization Pass for Seasonal Dispatchable Reliability\
		[Electricity Source
	!,Optimization Pass]
	  * BAU Last Year Hourly Bid Electricity Capacity Factors for Reliability in Binding Hour by Plant Type\
		[Electricity Source
	!]
	 )
	
	+(BAU New Grid Battery Capacity Deployed for Seasonal Dispatchable Reliability by Optimization Pass\
		[Optimization Pass]
	  *ESTRTE Grid Battery Round Trip Efficiency
	  /GBSC Diurnal Grid Battery Daily Storage Duration)
	)
	* One Hour
	~	MW*hour
	~		|

BAU Metric Tons CO2 Stored per MWh[Electricity Source] :EXCEPT:    [biomass w CCS es]\
		=
	BAU Heat Rate by Electricity Fuel for Plants Built This Year[Electricity Source]
	* Electricity Fuel Pollutant Emissions Intensities This Year[CO2,Electricity Source]
	* CCP CO2 Capture Potential by Electricity Source[Electricity Source]
	/ Grams per Metric Ton CO2e
	/ Grams Pollutant per Gram CO2e Unit Converter ~~|
BAU Metric Tons CO2 Stored per MWh[biomass w CCS es]=
	BwCCSSpM Biomass with CCS Storage per MWh
	~	metric ton CO2e/(MW*hour)
	~		|

BAU Mileage Weighted Last Year Vehicles[Vehicle Type,Cargo Type,Vehicle Technology]=
	SUM(BAU Last Year Vehicles by Vintage[Vehicle Type,Cargo Type,Vehicle Technology,Vehicle Vintage\
		!] * Vehicle Relative Annual Mileage by Vintage[Cargo Type,Vehicle Type,Vehicle Vintage\
		!])
	~	vehicles
	~		|

BAU Mileage Weighted Vehicles[Vehicle Type,Cargo Type,Vehicle Technology]=
	SUM(BAU Last Year Vehicles by Vintage[Vehicle Type,Cargo Type,Vehicle Technology,Vehicle Vintage\
		!] * (1 - Vehicle Survival Rate by Vehicle Type Cargo Type Engine and Vintage[Cargo Type\
		,Vehicle Type,Vehicle Vintage!]) * Vehicle Relative Annual Mileage by Vintage[Cargo Type\
		,Vehicle Type,Vehicle Vintage!])
	+ BAU New Vehicles[Vehicle Type,Cargo Type,Vehicle Technology] * One Year
	~	vehicles
	~		|

BAU Min Net Electricity Supply Relative to Demand[Electricity Timeslice]=
	VMIN(BAU Net Electricity Supply Relative to Demand by Hour[Electricity Timeslice,Hour\
		!])
	~	MW*hr
	~	BAU twin of Min Net Electricity Supply Relative to Demand.
	|

BAU Minimum Buildable Capacity for Plants[Electricity Source]=
	MAX(

	  MAX(
	    CSCSCbPT Seed Capacity by Plant Type[Electricity Source],
	    MPPC Minimum Power Plant Capacity[Electricity Source]
	  ),

	  FOAKCFoF First of a Kind Capacity Fraction of Fleet
	  * SUM(BAU Last Year Electricity Generation Capacity[Electricity Source!])

	)
	~	MW
	~	BAU twin of Minimum Buildable Capacity for Plants.
	|

BAU Minimum Eligible Cement Pathway Cost per Ton of Clinker=
	VMIN(
	  BAU Cement Pathway Levelized Cost per Ton of Clinker[Cement Production Pathway!]
	  + IF THEN ELSE(
	      CPSW Cement Pathway Shareweight[Cement Production Pathway!] > 0,
	      0,
	      1e+09
	    )
	)
	~	$/metric ton
	~	BAU twin of Minimum Eligible Cement Pathway Cost per Ton of Clinker.
	|

BAU Minimum Eligible Fuel Cost per Unit Energy in Electricity Equivalent[Industry Category\
		,Industrial Process]=
	VMIN(
	  BAU Industrial Equipment Annual Costs and Annual Financing Repayment per Unit Energy in Electricity Equivalent\
		[Industry Category,Industrial Fuel!,Industrial Process]
	  + IF THEN ELSE(
	      Effective Industrial Equipment Shareweights[Industry Category,Industrial Fuel!\
		,Industrial Process] > 0,
	      0,
	      1
	    )
	)
	~	$/BTU
	~	BAU twin of Minimum Eligible Fuel Cost per Unit Energy in Electricity \
		Equivalent. See that variable for documentation.
	|

BAU Model Run Clinker Capacity Facing Overhaul Decision by Pathway[Cement Production Pathway\
		]=
	MIN(
	  BAU Last Year Clinker Production Capacity Added During Model Run by Pathway[Cement Production Pathway\
		],
	  BAU Model Run Clinker Capacity Reaching Campaign End by Pathway[Cement Production Pathway\
		]
	)
	~	metric tons/Year
	~	BAU twin of Cement Model Run Capacity Facing Overhaul Decision by Pathway \
		(see the policy twin for the Q4 decision-curve rationale).
	|

BAU Model Run Clinker Capacity Overhauled by Pathway[Cement Production Pathway]=
	BAU Model Run Clinker Capacity Facing Overhaul Decision by Pathway[Cement Production Pathway\
		]
	* BAU Cement Overhaul Share at Decision[Cement Production Pathway]
	~	metric tons/Year
	~	BAU twin of Cement Model Run Capacity Overhauled by Pathway.
	|

BAU Model Run Clinker Capacity Reaching Campaign End by Pathway[Cement Production Pathway\
		]= DELAY3I(
	BAU New Clinker Production Capacity by Pathway[Cement Production Pathway]
	+ BAU Model Run Clinker Capacity Overhauled by Pathway[Cement Production Pathway],
	CPPL Cement Pathway Campaign Length[Cement Production Pathway],
	0)
	~	metric tons/Year
	~	BAU twin of Cement Model Run Capacity Reaching Campaign End by Pathway.
	|

BAU Model Run Clinker Capacity Retirements by Pathway[Cement Production Pathway]=
	BAU Model Run Clinker Capacity Facing Overhaul Decision by Pathway[Cement Production Pathway\
		]
	- BAU Model Run Clinker Capacity Overhauled by Pathway[Cement Production Pathway]
	~	metric tons/Year
	~	BAU twin of Model Run Clinker Capacity Retirements by Pathway (see the \
		policy twin for the Q4 decision-based-retirement rationale).
	|

BAU Net Clinker Imports=
	BAU Total Clinker Demand
	- BAU Domestic Clinker Demand
	~	metric tons/Year
	~	BAU twin of Net Clinker Imports.
	~	:SUPPLEMENTARY 
	|

BAU Net Electricity Demand Relative to Achievable Supply in Binding Hour by Optimization Pass\
		[Optimization Pass]=
	MIN(
	  SUM(BAU Total Electricity Demand by Hour Plus Reserve Margin After Demand Altering Technologies\
		[peak day electricity timeslice
	!,Hour!]
	    * BAU Binding Peak Hour for Reliability Additions[peak day electricity timeslice\
		!,Hour!]),
	  BAU Existing Credited Binding Hour Supply for Dispatchable Reliability
	  + 0.95 * (BAU Maximum Achievable Binding Hour Supply for Dispatchable Reliability[\
		Optimization Pass]
	            - BAU Existing Credited Binding Hour Supply for Dispatchable Reliability\
		)
	)
	- BAU Maximum Potential Binding Hour Electricity Output by Hour for Dispatchable Reliability\
		[Optimization Pass]
	~	MW*hour
	~		|

BAU Net Electricity Demand Relative to Available Supply by Hour before Reliability Additions\
		[peak day electricity timeslice,Hour]=
	BAU Total Electricity Demand by Hour Plus Reserve Margin After Demand Altering Technologies\
		[peak day electricity timeslice
	,Hour]
	
	  - SUM(BAU Electricity Generation Capacity before Reliability Additions[Electricity Source\
		!]*BAU Last Year Hourly Bid Electricity Capacity Factors for Reliability by Plant Type
	[peak day electricity timeslice,Hour,Electricity Source!])* One Hour
	~	MW*hour
	~		|

BAU Net Electricity Demand Relative to Available Supply in Binding Hour by Optimization Pass\
		[Optimization Pass]=
	SUM(BAU Total Electricity Demand by Hour Plus Reserve Margin After Demand Altering Technologies\
		[peak day electricity timeslice!,
	Hour!]*BAU Binding Peak Hour for Reliability Additions[peak day electricity timeslice\
		!,Hour!])
	- BAU Maximum Potential Binding Hour Electricity Output by Hour for Dispatchable Reliability\
		[Optimization Pass]
	~	MW*hour
	~		|

BAU Net Electricity Supply Relative to Demand by Hour[Electricity Timeslice,Hour]=
	SUM(BAU Last Year Electricity Generation Capacity[Electricity Source!]
	*BAU Last Year Hourly Bid Electricity Capacity Factors by Plant Type[Electricity Timeslice\
		,Hour,Electricity Source!]
	*One Hour)
	-BAU Total Electricity Demand by Hour before Net Imports[Electricity Timeslice,Hour]
	~	MW*hr
	~	BAU twin of Net Electricity Supply Relative to Demand by Hour.
	|

BAU Net Imports of Electricity=
	(
	  BAU Imported Electricity
	  - EIaE BAU Exported Electricity
	)
	* (1 + Perc Change in Sectoral Energy Use due to Exogenous GDP Adjustment[electricity sector\
		])
	~	MW*hour
	~		|

BAU Net Loss per Unit Capacity[Electricity Source,Optimization Pass]=
	MAX(
	  0,
	
	  BAU Last Year Annual Recurring Costs by Plant Type[Electricity Source]
	  * SoFCtMbCtPR Share of Forward Costs that Must Be Covered to Prevent Retirement[Electricity Source\
		]
	  - BAU Expected Total Revenue per Unit Capacity by Plant Type Excluding Subsidies[Electricity Source\
		,Optimization Pass]
	)
	~	$/MW
	~		|

BAU Net Loss per Unit Capacity Excluding Predicted Capacity Payment[Electricity Source\
		]=
	MAX(
	  0,
	
	  BAU Last Year Annual Recurring Costs by Plant Type[Electricity Source]
	  * SoFCtMbCtPR Share of Forward Costs that Must Be Covered to Prevent Retirement[Electricity Source\
		]
	  - BAU Expected Total Revenue per Unit Capacity by Plant Type Excluding Subsidies and Predicted Capacity Payment\
		[Electricity Source]
	)
	~	$/MW
	~		|

BAU New Capacity Added due to Elec Portfolio Stds for Hybrid Power Plants[Electricity Source\
		,Clean Elec Requirement]=
	BAU New Capacity Desired due to Cost Effectiveness for Hybrid Power Plants[Electricity Source\
		,Clean Elec Requirement]
	-BAU New Capacity Desired due to Cost Effectivness for Hybrid Power Plants without CES\
		[Electricity Source]
	~	MW
	~		|

BAU New Capacity Added or Retrofitted due to Elec Portfolio Stds[Electricity Source,Clean Elec Requirement\
		]=
	BAU New Capacity Added due to Elec Portfolio Stds for Hybrid Power Plants[Electricity Source\
		,Clean Elec Requirement]
	+ BAU New Capacity Added or Retrofitted due to Elec Portfolio Stds excluding Hybrid Power Plants\
		[Electricity Source,Clean Elec Requirement]
	~	MW
	~		|

BAU New Capacity Added or Retrofitted due to Elec Portfolio Stds excluding Hybrid Power Plants\
		[Electricity Source,Clean Elec Requirement]=
	BAU New Capacity Desired due to Cost Effectiveness[Electricity Source,Clean Elec Requirement\
		]
	+ BAU Retrofit Capacity Desired due to Cost Effectiveness[Electricity Source,Clean Elec Requirement\
		]
	- BAU New Capacity Desired due to Cost Effectivness without CES[Electricity Source]
	- BAU Retrofitted Capacity Desired due to Cost Effectiveness without CES[Electricity Source\
		]
	~	MW
	~		|

BAU New Capacity Desired due to Cost Effectiveness[Electricity Source,RPS]=
	MAX(0,
	
	  
	  SUM(BAU New Capacity Desired due to Cost Effectivness by Optimization Pass[Electricity Source\
		,last pass!,RPS])
	
	 ) ~~|
BAU New Capacity Desired due to Cost Effectiveness[Electricity Source,CES]=
	MAX(0,
	
	  
	  SUM(BAU New Capacity Desired due to Cost Effectivness by Optimization Pass[Electricity Source\
		,last pass!,CES])
	
	 )
	~	MW
	~	Although "last pass" is intended to contain a single element, we must sum \
		across it becuase it is technically a subrange.
	|

BAU New Capacity Desired due to Cost Effectiveness by Optimization Pass before Hybrid Prioritization\
		[Electricity Source,
 Optimization Pass
,RPS]=
	BAU Profitable Capacity for Cost Effectiveness Additions[Electricity Source,Optimization Pass\
		,RPS]
	* CSCSoCECBiaSY Share of Cost Effective Capacity Built in a Single Year[Electricity Source\
		] ~~|
BAU New Capacity Desired due to Cost Effectiveness by Optimization Pass before Hybrid Prioritization\
		[Electricity Source,
Optimization Pass
,CES]=
	BAU Profitable Capacity for Cost Effectiveness Additions[Electricity Source,Optimization Pass\
		,CES]
	* CSCSoCECBiaSY Share of Cost Effective Capacity Built in a Single Year[Electricity Source\
		]
	~	MW
	~		|

BAU New Capacity Desired due to Cost Effectiveness by Optimization Pass for Hybrid Power Plants before Hybrid Prioritization\
		[Electricity Source, Optimization Pass,Clean Elec Requirement] :EXCEPT:        [Hybrid Electricity Source\
		, Optimization Pass
,
Clean Elec Requirement]=
	0 ~~|
BAU New Capacity Desired due to Cost Effectiveness by Optimization Pass for Hybrid Power Plants before Hybrid Prioritization\
		[Hybrid Electricity Source,Optimization Pass,RPS]=
	BAU Profitable Capacity for Cost Effectiveness Additions for Hybrid Power Plants[Hybrid Electricity Source\
		,Optimization Pass,RPS]
	* CSCSoCECBiaSY Share of Cost Effective Capacity Built in a Single Year[Hybrid Electricity Source\
		] ~~|
BAU New Capacity Desired due to Cost Effectiveness by Optimization Pass for Hybrid Power Plants before Hybrid Prioritization
[Hybrid Electricity Source,Optimization Pass,CES]=
	BAU Profitable Capacity for Cost Effectiveness Additions for Hybrid Power Plants[Hybrid Electricity Source\
		,Optimization Pass
	,CES]
	* CSCSoCECBiaSY Share of Cost Effective Capacity Built in a Single Year[Hybrid Electricity Source\
		]
	~	MW
	~		|

BAU New Capacity Desired due to Cost Effectiveness for Hybrid Power Plants[Electricity Source\
		,Clean Elec Requirement] :EXCEPT:   [Hybrid Electricity Source,Clean Elec Requirement\
		]=
	0 ~~|
BAU New Capacity Desired due to Cost Effectiveness for Hybrid Power Plants[Hybrid Electricity Source\
		,RPS]=
	SUM(BAU New Capacity Desired due to Cost Effectivness by Optimization Pass for Hybrid Power Plants\
		[Hybrid Electricity Source,last pass!,RPS]) ~~|
BAU New Capacity Desired due to Cost Effectiveness for Hybrid Power Plants[Hybrid Electricity Source\
		,CES]=
	SUM(BAU New Capacity Desired due to Cost Effectivness by Optimization Pass for Hybrid Power Plants\
		[Hybrid Electricity Source,last pass!,CES])
	~	MW
	~	Although "last pass" is intended to contain a single element, we must sum \
		across it becuase it is technically a subrange.
	|

BAU New Capacity Desired due to Cost Effectivness by Optimization Pass[Electricity Source\
		, Optimization Pass,Clean Elec Requirement] :EXCEPT:    [Hybrid Electricity Source,\
		 Optimization Pass,Clean Elec Requirement]=
	QUANTUM(
	  MIN(
	    BAU Max Capacity Buildable after Mandated and Required Clean Dispatchable Additions\
		[Electricity Source],
	
	    BAU New Capacity Desired due to Cost Effectiveness by Optimization Pass before Hybrid Prioritization\
		[Electricity Source,Optimization Pass,Clean Elec Requirement]
	  ),
	  MPPC Minimum Power Plant Capacity[Electricity Source]
	) ~~|
BAU New Capacity Desired due to Cost Effectivness by Optimization Pass[Hybrid Electricity Source\
		,Optimization Pass,Clean Elec Requirement]=
	QUANTUM(
	
	  IF THEN ELSE(
	
	    BAU New Capacity Desired due to Cost Effectiveness by Optimization Pass for Hybrid Power Plants before Hybrid Prioritization\
		[Hybrid Electricity Source,Optimization Pass,Clean Elec Requirement]
	    + BAU New Capacity Desired due to Cost Effectiveness by Optimization Pass before Hybrid Prioritization\
		[Hybrid Electricity Source,Optimization Pass,Clean Elec Requirement]
	    > BAU Max Capacity Buildable after Mandated and Required Clean Dispatchable Additions\
		[Hybrid Electricity Source],
	
	 
	  BAU Max Capacity Buildable after Mandated and Required Clean Dispatchable Additions\
		[Hybrid Electricity Source]
	  * 
	  ZIDZ(
	    BAU New Capacity Desired due to Cost Effectiveness by Optimization Pass before Hybrid Prioritization\
		[Hybrid Electricity Source,Optimization Pass,Clean Elec Requirement],
	    BAU New Capacity Desired due to Cost Effectiveness by Optimization Pass for Hybrid Power Plants before Hybrid Prioritization\
		[Hybrid Electricity Source,Optimization Pass,Clean Elec Requirement]
	    + BAU New Capacity Desired due to Cost Effectiveness by Optimization Pass before Hybrid Prioritization\
		[Hybrid Electricity Source,Optimization Pass,Clean Elec Requirement]
	  ),
	  BAU New Capacity Desired due to Cost Effectiveness by Optimization Pass before Hybrid Prioritization\
		[Hybrid Electricity Source,Optimization Pass,Clean Elec Requirement]
	),
	  
	MPPC Minimum Power Plant Capacity[Hybrid Electricity Source]
	)
	~	MW
	~		|

BAU New Capacity Desired due to Cost Effectivness by Optimization Pass for Hybrid Power Plants\
		[Electricity Source, Optimization Pass,Clean Elec Requirement] :EXCEPT:      [Hybrid Electricity Source\
		, Optimization Pass,Clean Elec Requirement]=
	0 ~~|
BAU New Capacity Desired due to Cost Effectivness by Optimization Pass for Hybrid Power Plants\
		[Hybrid Electricity Source
,Optimization Pass,Clean Elec Requirement]=
	QUANTUM(
	
	  IF THEN ELSE(
	
	    BAU New Capacity Desired due to Cost Effectiveness by Optimization Pass for Hybrid Power Plants before Hybrid Prioritization\
		[Hybrid Electricity Source,Optimization Pass,Clean Elec Requirement]
	    + BAU New Capacity Desired due to Cost Effectiveness by Optimization Pass before Hybrid Prioritization\
		[Hybrid Electricity Source,Optimization Pass,Clean Elec Requirement]
	    > BAU Max Capacity Buildable after Mandated and Required Clean Dispatchable Additions\
		[Hybrid Electricity Source],
	
	 
	  BAU Max Capacity Buildable after Mandated and Required Clean Dispatchable Additions\
		[Hybrid Electricity Source]
	  * 
	  ZIDZ(
	    BAU New Capacity Desired due to Cost Effectiveness by Optimization Pass for Hybrid Power Plants before Hybrid Prioritization\
		[Hybrid Electricity Source,Optimization Pass,Clean Elec Requirement],
	    BAU New Capacity Desired due to Cost Effectiveness by Optimization Pass for Hybrid Power Plants before Hybrid Prioritization\
		[Hybrid Electricity Source,Optimization Pass,Clean Elec Requirement]
	    + BAU New Capacity Desired due to Cost Effectiveness by Optimization Pass before Hybrid Prioritization\
		[Hybrid Electricity Source,Optimization Pass,Clean Elec Requirement]
	  ),
	  BAU New Capacity Desired due to Cost Effectiveness by Optimization Pass for Hybrid Power Plants before Hybrid Prioritization\
		[Hybrid Electricity Source,Optimization Pass,Clean Elec Requirement]
	),
	  
	MPPC Minimum Power Plant Capacity[Hybrid Electricity Source]
	)
	~	MW
	~		|

BAU New Capacity Desired due to Cost Effectivness for Hybrid Power Plants without CES\
		[Electricity Source] :EXCEPT:      [
Hybrid Electricity Source]=
	0 ~~|
BAU New Capacity Desired due to Cost Effectivness for Hybrid Power Plants without CES\
		[Hybrid Electricity Source]=
	QUANTUM(
	  MIN(
	    BAU Max Capacity Buildable after Mandated and Required Clean Dispatchable Additions\
		[Hybrid Electricity Source]
	    - BAU New Capacity Desired due to Cost Effectivness without CES[Hybrid Electricity Source\
		],
	
	    BAU Profitable Capacity for Cost Effectiveness Additions for Hybrid Power Plants without CES\
		[Hybrid Electricity Source
	  ]
	    * CSCSoCECBiaSY Share of Cost Effective Capacity Built in a Single Year[Hybrid Electricity Source\
		]
	 ),
	 MPPC Minimum Power Plant Capacity[Hybrid Electricity Source]
	)
	~	MW
	~		|

BAU New Capacity Desired due to Cost Effectivness without CES[Electricity Source]=
	QUANTUM(
	  MIN(
	    BAU Max Capacity Buildable after Mandated and Required Clean Dispatchable Additions\
		[Electricity Source],
	
	    BAU Profitable Capacity for Cost Effectiveness Additions without CES[Electricity Source\
		]
	    * CSCSoCECBiaSY Share of Cost Effective Capacity Built in a Single Year[Electricity Source\
		]
	  ),
	 MPPC Minimum Power Plant Capacity[Electricity Source]
	)
	~	MW
	~		|

BAU New Capacity Desired for Seasonal Dispatchable Reliability by Optimization Pass[Electricity Source\
		,Optimization Pass]=
	QUANTUM(
	  MAX(0,MIN(
	    BAU Max Capacity Buildable after Cost Effective and RPS Additions[Electricity Source\
		,CES
	],
	
	    (
	      BAU Profitable Capacity for Seasonal Dispatchable Reliability Additions[Electricity Source\
		,Optimization Pass
	]
	      * CSCSoCECBiaSY Share of Cost Effective Capacity Built in a Single Year[Electricity Source
	]
	    )
	    - BAU Total New Capacity Desired due to Cost Effectiveness[Electricity Source,CES\
		]
	  )
	  )
	   * MAX(
	       BAU Last Year New Entry Reliability Credit Relaxation Share,
	       IF THEN ELSE(
	         BAU Five Year Foresight Elec Portfolio Values for Reliability Check[RPS]=1,
	         BAU Elec Portfolio Qualifying Sources[Electricity Source,RPS],
	         IF THEN ELSE(
	           BAU Five Year Foresight Elec Portfolio Values for Reliability Check[CES]=\
		1,
	           BAU Elec Portfolio Qualifying Sources[Electricity Source,CES],
	           1
	         )
	       )
	     ),
	  MPPC Minimum Power Plant Capacity[Electricity Source]
	)
	~	MW
	~		|

BAU New Clinker Production Capacity by Pathway[Cement Production Pathway]=
	BAU Share of New Clinker Production Capacity by Pathway[Cement Production Pathway]
	* BAU Unmet Clinker Production Capacity Need
	* BAU Cement Replacement Blend Weight
	/ SYCCU Start Year Cement Capacity Utilization
	~	metric tons/Year
	~	BAU twin of New Clinker Production Capacity by Pathway.
	|

BAU New Components Energy Use[Building Type,Building Fuel,Building Component] :EXCEPT:\
		     [Building Type,Building Fuel,envelope
]=
	BAU Components Energy Use Including Data Centers[Building Type,Building Fuel,Building Component\
		]
	* SoCEUtiNTY Share of Components Energy Use that is New This Year[Building Type,Building Component\
		] ~~|
BAU New Components Energy Use[Building Type,Building Fuel,envelope]=
	1
	
	{This is a coefficient that will be modified by policies, then multiplied by heating and by cooling new components potential energy use}
	~	BTU
	~		|

BAU New Components Energy Use after Envelope Effects[Building Type,Building Fuel,heating\
		]=
	BAU New Components Energy Use[Building Type,Building Fuel,heating]
	* BAU New Components Energy Use[Building Type,Building Fuel,envelope]
	* Envelope Multiplier Unit Correction Factor
	/ One Year ~~|
BAU New Components Energy Use after Envelope Effects[Building Type,Building Fuel,cooling and ventilation\
		]=
	BAU New Components Energy Use[Building Type,Building Fuel,cooling and ventilation]
	* BAU New Components Energy Use[Building Type,Building Fuel,envelope]
	* Envelope Multiplier Unit Correction Factor
	/ One Year ~~|
BAU New Components Energy Use after Envelope Effects[Building Type,Building Fuel,envelope\
		]=
	0 ~~|
BAU New Components Energy Use after Envelope Effects[Building Type,Building Fuel,lighting\
		]=
	BAU New Components Energy Use[Building Type,Building Fuel,lighting]
	/ One Year ~~|
BAU New Components Energy Use after Envelope Effects[Building Type,Building Fuel,appliances\
		]=
	BAU New Components Energy Use[Building Type,Building Fuel,appliances]
	/ One Year ~~|
BAU New Components Energy Use after Envelope Effects[Building Type,Building Fuel,other component\
		]=
	BAU New Components Energy Use[Building Type,Building Fuel,other component]
	/ One Year
	~	BTU/Year
	~		|

BAU New Components Energy Use after Envelope Effects after Lifetime[Building Type,Building Fuel\
		,Building Component]= DELAY FIXED (
	BAU New Components Energy Use after Envelope Effects[Building Type,Building Fuel,Building Component\
		],
	CL Component Lifetime[Building Type,Building Component],
	0)
	~	BTU/Year
	~		|

BAU New Dispatchable Only Capacity Desired for Seasonal Reliability[Electricity Source\
		]=
	VMAX(BAU New Capacity Desired for Seasonal Dispatchable Reliability by Optimization Pass\
		[Electricity Source,last pass!])
	+ BAU Emergency Nonqualifying Capacity Additions for Reliability[Electricity Source]
	~	MW
	~		|

BAU New Distributed Electricity Source Capacity[Electricity Source]=
	SUM(
	  BAU Distributed Electricity Source Capacity[Building Type!,Electricity Source]
	  - Last Year BAU Distributed Electricity Source Capacity[Building Type!,Electricity Source\
		]
	)
	/ One Year
	~	MW/Year
	~		|

BAU New Entrant Dispatch Cost per Unit Electricity Output before Subsidies[Electricity Source\
		]=
	BAU Five Year Forward Average Electricity Fuel Cost per Unit Energy[Electricity Source\
		]
	* BAU Heat Rate by Electricity Fuel for Plants Built This Year[Electricity Source]
	+ SUM(
	    CCaMC Variable OM Cost per Unit Output[Electricity Source,Modeled Vintage!]
	    * This Year Modeled Vintage Flag[Modeled Vintage!]
	  )
	~	$/(MW*hour)
	~		|

BAU New Entry Reliability Credit Relaxation Share=
	MIN(1,
	  ZIDZ(
	    BAU Binding Hour Reliability Shortfall after Fossil Backstop,
	    BAU Nonqualifying New Entry Binding Hour Capability
	  )
	)
	~	Dmnl
	~		|

BAU New EV Chargers This Year=
	BNoEVC BAU Number of EV Chargers
	- BAU Last Year Number of EV Chargers
	~	chargers
	~		|

BAU New Generation Capacity[Electricity Source]=
	BAU New Generation Capacity Excluding Retrofit Capacity[Electricity Source]
	+BAU Retrofit Capacity after Quantization[Electricity Source]
	~	MW
	~		|

BAU New Generation Capacity after Dispatchable Only Reliability Additions[Electricity Source\
		]=
	BAU New Generation Capacity before Reliability Additions[Electricity Source]
	+BAU New Dispatchable Only Capacity Desired for Seasonal Reliability[Electricity Source\
		]
	~	MW
	~		|

BAU New Generation Capacity before Cost Effectiveness Additions[Electricity Source]=
	BAU New Policy Mandated Capacity[Electricity Source]
	~	MW
	~		|

BAU New Generation Capacity before Reliability Additions[Electricity Source]=
	BAU New Generation Capacity before Cost Effectiveness Additions[Electricity Source]
	+BAU Total New Capacity Desired due to Cost Effectiveness[Electricity Source,CES]
	~	MW
	~		|

BAU New Generation Capacity Excluding Retrofit Capacity[Electricity Source]=
	BAU New Generation Capacity after Dispatchable Only Reliability Additions[Electricity Source\
		]
	~	MW
	~		|

BAU New Green Hydrogen Production Capacity This Year=
	MAX( 
	  0,
	  BAU Green Hydrogen Demand
	  - BAU Surviving Green Hydrogen Production Capacity
	)
	~	BTU
	~		|

BAU New Grid Battery Capacity=
	BAU New Grid Battery Capacity Deployed before Capacity Market Revenue
	+SUM(BAU New Grid Battery Capacity Deployed for Seasonal Dispatchable Reliability by Optimization Pass\
		[last pass!])
	~	MW*hour
	~		|

BAU New Grid Battery Capacity Deployed before Capacity Market Revenue=
	MAX(
	 GBCGpUNR Grid Battery Capacity Growth per Unit Net Revenue*BAU Grid Batteries Net Energy Market Revenue per Unit Elec Output
	,
	 0
	)
	~	MW*hr
	~		|

BAU New Grid Battery Capacity Deployed for Seasonal Dispatchable Reliability by Optimization Pass\
		[Optimization Pass]=
	MAX(
	 GBCGpUNR Grid Battery Capacity Growth per Unit Net Revenue*
	 (BAU Grid Batteries Net Energy Market Revenue per Unit Elec Output
	  +BAU Grid Batteries Capacity Market Revenue for Seasonal Dispatchable Reliability per Unit Elec Output\
		[Optimization Pass
	]
	)
	,
	 0
	)
	-BAU New Grid Battery Capacity Deployed before Capacity Market Revenue
	~	MW*hr
	~		|

BAU New Hybrid Grid Battery Storage Capacity[Electricity Source]=
	BAU New Capacity Desired due to Cost Effectivness by Optimization Pass for Hybrid Power Plants\
		[Electricity Source,pass20,CES]
	   *HESBCpUEC Hybrid Electricity Source Battery Capacity per Unit Electricity Capacity
	   *GBSC Diurnal Grid Battery Daily Storage Duration
	~	MW*hour
	~		|

BAU New Hydrogen Production Capacity[Hydrogen Production Pathway] :EXCEPT:  [electrolysis with guaranteed clean electricity\
		]=
	(BAU New Low Carbon Hydrogen Production Capacity This Year[Hydrogen Production Pathway\
		]
	+ BAU New Other Hydrogen Production Capacity This Year[Hydrogen Production Pathway])
	/ One Year ~~|
BAU New Hydrogen Production Capacity[electrolysis with guaranteed clean electricity]=
	(BAU New Green Hydrogen Production Capacity This Year
	+ BAU New Low Carbon Hydrogen Production Capacity This Year[electrolysis with guaranteed clean electricity\
		]
	+ BAU New Other Hydrogen Production Capacity This Year[electrolysis with guaranteed clean electricity\
		])
	/ One Year
	~	BTU/Year
	~		|

BAU New Industrial Equipment Capital Cost[Industry Category] :EXCEPT: [cement and other nonmetallic minerals 239\
		]=
	SUM(
	  BAU New Industrial Equipment Energy Use by Fuel Type and Process[Industry Category\
		,Industrial Fuel!,Industrial Process
	!]
	  * BAU Industrial Equipment Capital Cost per Unit Energy Before Subsidy[Industry Category\
		,Industrial Fuel!,Industrial Process!]
	)
	+ SUM(BAU Thermal Battery New Energy Service[Industry Category,industrial heating process\
		!]
	* TBCC Thermal Battery Capital Cost per Unit Annual Energy Served[industrial heating process\
		!]) ~~|
BAU New Industrial Equipment Capital Cost[cement and other nonmetallic minerals 239]=
	SUM(
	  BAU New Industrial Equipment Energy Use by Fuel Type and Process[cement and other nonmetallic minerals 239\
		,Industrial Fuel!,Industrial Process
	!]
	  * BAU Industrial Equipment Capital Cost per Unit Energy Before Subsidy[cement and other nonmetallic minerals 239\
		,Industrial Fuel!,Industrial Process!]
	)
	+ SUM(BAU Thermal Battery New Energy Service[cement and other nonmetallic minerals 239\
		,industrial heating process!]
	* TBCC Thermal Battery Capital Cost per Unit Annual Energy Served[industrial heating process\
		!])
	+ SUM(
	    BAU New Clinker Production Capacity by Pathway[Cement Production Pathway!]
	    * BAU Cement Pathway Capital Cost per Unit Annual Capacity Including Capture Equipment\
		[Cement Production Pathway!]
	  )
	+ SUM(
	    BAU Total Clinker Capacity Overhauled by Pathway[Cement Production Pathway!]
	    * CPCaOC Overhaul Capital Cost per Unit Annual Capacity[Cement Production Pathway\
		!]
	  )
	~	$
	~	Includes thermal battery equipment purchases (service added times TBCC), \
		which are outside the Industrial Fuel dimension. See the policy-case twin \
		for documentation, including the cement branch's pathway capital.
	|

BAU New Industrial Equipment Energy Intensity[Industry Category,Industrial Fuel,Industrial Process\
		]=
	MAX(
	
	 BAU Last Year New Equipment Energy Intensity[Industry Category,Industrial Fuel,Industrial Process\
		]
	 / (1 + BIEEI BAU Industrial Equipment Efficiency Improvement[Industrial Process,Industrial Fuel\
		]),
	 
	 IEMUEF Industrial Equipment Minimum Unit Energy Factor[Industrial Fuel,Industrial Process\
		]
	)
	~	Dmnl
	~		|

BAU New Industrial Equipment Energy Intensity in Electricity Equivalent[Industry Category\
		,Industrial Fuel,Industrial Process]=
	BAU New Industrial Equipment Energy Intensity[Industry Category,Industrial Fuel,Industrial Process\
		]
	* (1 - PIFURfE Percentage Industry Fuel Use Reduction for Electricity[Industry Category\
		,Industrial Process])
	~	Dmnl
	~		|

BAU New Industrial Equipment Energy Use by Fuel Type and Process[Industry Category,Industrial Fuel\
		,Industrial Process] :EXCEPT:  [Industry Category,electricity if,Industrial Process\
		]=
	BAU New Industrial Equipment Energy Use by Fuel Type and Process in Electricity Equivalent\
		[Industry Category,Industrial Fuel,Industrial Process]
	/ (1 - PIFURfE Percentage Industry Fuel Use Reduction for Electricity[Industry Category\
		,Industrial Process]) ~~|
BAU New Industrial Equipment Energy Use by Fuel Type and Process[Industry Category,electricity if\
		,Industrial Process]=
	BAU New Industrial Equipment Energy Use by Fuel Type and Process in Electricity Equivalent\
		[Industry Category,electricity if,Industrial Process]
	~	BTU
	~		|

BAU New Industrial Equipment Energy Use by Fuel Type and Process in Electricity Equivalent\
		[Industry Category,Industrial Fuel
,Industrial Process]=
	BAU Output from New Industrial Equipment by Fuel Type and Industrial Process[Industry Category\
		,Industrial Fuel,Industrial Process
	]
	* BAU Energy Intensity of Industrial Production by Fuel and Process for New Equipment in Electricity Equivalent\
		[Industry Category,Industrial Fuel,Industrial Process]
	~	BTU
	~		|

BAU New Low Carbon Hydrogen Production Capacity Shares This Year[Hydrogen Production Pathway\
		]=
	ZIDZ(
	  HPS Hydrogen Production Shareweights[Hydrogen Production Pathway]
	  * exp(MAX(10^-8, BAU Cost per Unit New Hydrogen Production[Hydrogen Production Pathway\
		] / One Dollar * One BTU)*10^4
	  * HPLC Hydrogen Production Logit Coefficient)
	  * Hydrogen Production Pathways Qualifying as Low Carbon[Hydrogen Production Pathway\
		]
	
	  ,
	
	  SUM(
	    HPS Hydrogen Production Shareweights[Hydrogen Production Pathway!]
	    * exp(MAX(10^-8, BAU Cost per Unit New Hydrogen Production[Hydrogen Production Pathway\
		!] / One Dollar * One BTU)*10^4
	    * HPLC Hydrogen Production Logit Coefficient)
	    * Hydrogen Production Pathways Qualifying as Low Carbon[Hydrogen Production Pathway\
		!]
	  )
	)
	~	Dmnl
	~		|

BAU New Low Carbon Hydrogen Production Capacity This Year[Hydrogen Production Pathway\
		]=
	BAU New Low Carbon Hydrogen Production Capacity Shares This Year[Hydrogen Production Pathway\
		]
	
	* BAU Total New Low Carbon Hydrogen Production Capacity This Year
	~	BTU
	~		|

BAU New Off Grid Capacity for Green Hydrogen Demand[Electricity Source]=
	QUANTUM(
	  ZIDZ(
	    BAU Off Grid Electricity Demand for Green Hydrogen That is New This Year by Power Plant Type\
		[Electricity Source],
	    BAU Expected Capacity Factor x Hours per Year for Plants Built This Year Without Hypothetical Calculations\
		[Electricity Source]
	  ),
	
	  MPPC Minimum Power Plant Capacity[Electricity Source]
	)
	~	MW
	~		|

BAU New Off Grid Electricity Capacity Serving Thermal Batteries[Electricity Source]=
	QUANTUM(
	  ZIDZ(
	    BAU Thermal Battery Off Grid Electricity Demand That is New This Year[Electricity Source\
		],
	    BAU Expected Capacity Factor x Hours per Year for Plants Built This Year Without Hypothetical Calculations\
		[Electricity Source]
	  ),

	  MPPC Minimum Power Plant Capacity[Electricity Source]
	)
	~	MW
	~	BAU twin of Thermal Battery New Off Grid Capacity Deployed.
	|

BAU New Other Hydrogen Production Capacity Shares This Year[Hydrogen Production Pathway\
		]=
	ZIDZ(
	  HPS Hydrogen Production Shareweights[Hydrogen Production Pathway]
	  * exp(MAX(10^-8, BAU Cost per Unit New Hydrogen Production[Hydrogen Production Pathway\
		] / One Dollar * One BTU)*10^4
	  * HPLC Hydrogen Production Logit Coefficient)
	
	  ,
	
	  SUM(
	    HPS Hydrogen Production Shareweights[Hydrogen Production Pathway!]
	    * exp(MAX(10^-8, BAU Cost per Unit New Hydrogen Production[Hydrogen Production Pathway\
		!] / One Dollar * One BTU)*10^4
	    * HPLC Hydrogen Production Logit Coefficient)
	  )
	)
	~	Dmnl
	~		|

BAU New Other Hydrogen Production Capacity This Year[Hydrogen Production Pathway]=
	BAU New Other Hydrogen Production Capacity Shares This Year[Hydrogen Production Pathway\
		]
	
	* BAU Total New Other Hydrogen Production Capacity This Year
	~	BTU
	~		|

BAU New Plant Capacity Factor Scaling for Merchant Entry[Electricity Source]=
	IF THEN ELSE(
	  BAU Fleet Average Capacity Factor x Hours per Year by Power Plant Type[Electricity Source\
		] < One Hour,
	  1,
	  BAU Expected Capacity Factor x Hours per Year for Plants Built This Year[Electricity Source\
		]
	  / BAU Fleet Average Capacity Factor x Hours per Year by Power Plant Type[Electricity Source\
		]
	)
	~	Dmnl
	~		|

BAU New Policy Mandated Capacity[Electricity Source]=
	BPMCCS BAU Policy Mandated Capacity Construction Schedule[Electricity Source]
	~	MW
	~		|

BAU New Policy Mandated Retrofits[Electricity Source]=
	MIN(
	  BAU Max Capacity Available for CCUS Retrofit[Electricity Source],
	
	  BPMCRS BAU Policy Mandated Capacity Retrofit Schedule[Electricity Source]
	
	 )
	~	MW
	~		|

BAU New Utility and Distributed Electricity Capacity Last Year[Electricity Source]= DELAY FIXED\
		 (
	BAU New Utility and Distributed Electricity Source Capacity[Electricity Source], 1 ,\
		 0)
	~	MW/Year
	~		|

BAU New Utility and Distributed Electricity Source Capacity[Electricity Source]=
	BAU New Distributed Electricity Source Capacity[Electricity Source]
	+ BAU New Generation Capacity[Electricity Source] / One Year
	~	MW/Year
	~		|

BAU New Vehicle Cost per Mile[Vehicle Type,Cargo Type,Vehicle Technology]=
	ZIDZ(
	  BAU NPV of Lifetime Vehicle Cost[Vehicle Type,Cargo Type,Vehicle Technology],
	
	  (BAADTbVT BAU Average Annual Dist Traveled by Vehicle Type[Vehicle Type,Cargo Type\
		]
	    * AVLo Average Vehicle Loading[Vehicle Type,Cargo Type]
	    * AVOP Average Vehicle Ownership Period[Vehicle Type,Cargo Type]
	    / One Year
	    )
	)
	~	$/(thing*mile)
	~		|

BAU New Vehicle Fuel Cost per Unit Vehicle Distance[Vehicle Type,Cargo Type,Vehicle Technology\
		]=
	IF THEN ELSE(BAU New Vehicle Fuel Economy[Vehicle Type,Cargo Type,Vehicle Technology\
		] > 0, (BAU Weighted Avg Fuel Cost per Unit Energy by Vehicle Technology[Vehicle Type\
		,Cargo Type,Vehicle Technology]) / (BAU New Vehicle Fuel Economy[Vehicle Type,Cargo Type\
		,Vehicle Technology]), 0)
	~	$/mile
	~		|

BAU New Vehicle Fuel Economy[Vehicle Type,Cargo Type,Vehicle Technology]=
	SUM(NVFEbV New Vehicle Fuel Economy by Vintage[Vehicle Type,Cargo Type,Vehicle Technology\
		,Vehicle Vintage!] * This Year Vintage Flag[Vehicle Vintage!])
	~	miles/BTU
	~		|

BAU New Vehicle Price[Vehicle Type,Cargo Type,Vehicle Technology]=
	MAX(BAU New Vehicle Price after Endogenous Vehicle Learning[Vehicle Type,Cargo Type,\
		Vehicle Technology]
	     - BAU Vehicle Subsidy Perc[Cargo Type,Vehicle Type,Vehicle Technology],
	
	   0
	)
	~	$/vehicle
	~		|

BAU New Vehicle Price after Endogenous Vehicle Learning[Vehicle Type,Cargo Type,Vehicle Technology\
		]=
	BAU This Year Battery Portion of Vehicle Price[Cargo Type,Vehicle Type,Vehicle Technology\
		]
	  + NBPoNVP Non Battery Portion of New Vehicle Price[Vehicle Type,Cargo Type,Vehicle Technology\
		]
	~	$/vehicle
	~		|

BAU New Vehicle Price Including EV Shadow Cost[Vehicle Type,Cargo Type,Vehicle Technology\
		] :EXCEPT:    [LDVs,passenger,battery electric vehicle
]=
	BAU New Vehicle Price[Vehicle Type,Cargo Type,Vehicle Technology] ~~|
BAU New Vehicle Price Including EV Shadow Cost[LDVs,passenger,battery electric vehicle\
		]=
	BAU New Vehicle Price[LDVs,passenger,battery electric vehicle]
	+ BRASC BAU Range Anxiety Shadow Cost
	+ BAU Charging Availability Shadow Cost
	+BAU Consumer Preference Shadow Cost[LDVs,passenger,battery electric vehicle]
	~	$/vehicle
	~		|

BAU New Vehicle Price Without Subsidies[Vehicle Type,Cargo Type,Vehicle Technology]=
	BAU New Vehicle Price after Endogenous Vehicle Learning[Vehicle Type,Cargo Type,Vehicle Technology\
		]
	+ BAU This Year Battery Subsidy Passed Through to Consumers by Vehicle Type[Cargo Type\
		,Vehicle Type,Vehicle Technology]
	~	$/vehicle
	~		|

BAU New Vehicles[Vehicle Type,Cargo Type,Vehicle Technology]=
	QUANTUM(
	  SUM(BAU New Vehicles by Subregion[Subregion!,Vehicle Type,Cargo Type,Vehicle Technology\
		]),
	  QSfV Quantization Size for Vehicles[Vehicle Type,Cargo Type]
	)
	/ One Year
	~	vehicles/Year
	~	If the model wishes to add fewer than +/- VQS vehicles, this is rounding \
		error, and we dampen it to zero.  If we do not, it can throw off the Fleet \
		Average Fuel Economy if the erroneously introduced vehicle (or negative \
		vehicle) is the only vehicle of its type and technology in the model.
	|

BAU New Vehicles Allocated before ZEV Standards[Vehicle Type,Cargo Type,Vehicle Technology\
		]=
	(
	  TTS Transportation Technology Shareweights[Vehicle Type,Cargo Type,Vehicle Technology\
		]
	  * 
	  exp(
	    BAU New Vehicle Cost per Mile[Vehicle Type,Cargo Type,Vehicle Technology]
	    * Vehicle Allocation Unit Correction
	    * TTLE Transportation Technology Logit Exponents[Vehicle Type,Cargo Type]
	  )
	)
	
	/
	
	(
	  SUM(
	    TTS Transportation Technology Shareweights[Vehicle Type,Cargo Type,Vehicle Technology\
		!]
	    * 
	    exp(
	      BAU New Vehicle Cost per Mile[Vehicle Type,Cargo Type,Vehicle Technology!]
	      * Vehicle Allocation Unit Correction
	      * TTLE Transportation Technology Logit Exponents[Vehicle Type,Cargo Type]
	    )
	  )
	)
	* BAU New Vehicles Demanded[Vehicle Type,Cargo Type]
	~	vehicles
	~	Using "Modified Logit" function as described at \
		https://jgcri.github.io/gcam-doc/choice.html
		
		The terms "* 10^6" and "/ 10^4" are added to both the numerator and the \
		denominator to prevent rounding error, since this term can get very small \
		and be rounded to zero by Vensim.
	|

BAU New Vehicles before ZEV Standards by Subregion[Subregion,Vehicle Type,Cargo Type,\
		Vehicle Technology]=
	BAU New Vehicles Allocated before ZEV Standards[Vehicle Type,Cargo Type,Vehicle Technology\
		]
	* VSbS Vehicle Shares by Subregion[Subregion,Vehicle Type,Cargo Type]
	~	vehicles
	~		|

BAU New Vehicles by Subregion[Subregion,Vehicle Type,Cargo Type,Vehicle Technology]=
	BAU New Vehicles by Subregion for Vehicle Types with BAU Qualifying Technologies[Subregion\
		,Vehicle Type,Cargo Type,Vehicle Technology]
	+ BAU New Vehicles by Subregion for Vehicle Types without BAU Qualifying Technologies\
		[Subregion,Vehicle Type,Cargo Type,Vehicle Technology]
	~	vehicles
	~	If the ZEV standard is met naturally, we keep the pre-ZEV standard \
		allocation. Otherwise, we scale up ZEVs sales such that the standard is \
		hit and scale down non-ZEV sales so as to avoid changing the total number \
		of vehicles sold.
	|

BAU New Vehicles by Subregion for Vehicle Types with BAU Qualifying Technologies[Subregion\
		,Vehicle Type,Cargo Type,Vehicle Technology]=
	IF THEN ELSE(BAU Sum of Shareweights by Vehicle and Cargo Type[Vehicle Type,Cargo Type\
		] = 0,
	
	0,
	
	IF THEN ELSE(
	
	  BAU ZEV Sales Share Without ZEV Standard[Subregion,Vehicle Type,Cargo Type]
	  > BAU Required ZEV Sales Percentage by Subregion[Subregion,Vehicle Type,Cargo Type\
		],
	
	
	  BAU New Vehicles before ZEV Standards by Subregion[Subregion,Vehicle Type,Cargo Type\
		,Vehicle Technology],
	
	
	  BAU New Vehicles before ZEV Standards by Subregion[Subregion,Vehicle Type,Cargo Type\
		,Vehicle Technology]
	    * BAU Vehicle Technologies Qualifying as ZEVs[Vehicle Type,Vehicle Technology]
	    * ZIDZ(
	        BAU Required ZEV Sales Percentage by Subregion[Subregion,Vehicle Type,Cargo Type\
		],
	        BAU ZEV Sales Share Without ZEV Standard[Subregion,Vehicle Type,Cargo Type]
	      )
	  + BAU New Vehicles before ZEV Standards by Subregion[Subregion,Vehicle Type,Cargo Type\
		,Vehicle Technology]
	    * (1 - BAU Vehicle Technologies Qualifying as ZEVs[Vehicle Type,Vehicle Technology\
		])
	    * ZIDZ(
	        (1 - BAU Required ZEV Sales Percentage by Subregion[Subregion,Vehicle Type,Cargo Type\
		]),
	        (1 - BAU ZEV Sales Share Without ZEV Standard[Subregion,Vehicle Type,Cargo Type\
		])
	      )
	)
	)
	~	vehicles
	~	If the ZEV standard is met naturally, we keep the pre-ZEV standard \
		allocation. Otherwise, we scale up ZEVs sales such that the standard is \
		hit and scale down non-ZEV sales so as to avoid changing the total number \
		of vehicles sold.
	|

BAU New Vehicles by Subregion for Vehicle Types without BAU Qualifying Technologies[Subregion\
		,Vehicle Type,Cargo Type,Vehicle Technology]=
	IF THEN ELSE(BAU Sum of Shareweights by Vehicle and Cargo Type[Vehicle Type,Cargo Type\
		] = 0,
	
	
	IF THEN ELSE(
	  
	  BAU ZEV Sales Share Without ZEV Standard[Subregion,Vehicle Type,Cargo Type]
	  > BAU Required ZEV Sales Percentage by Subregion[Subregion,Vehicle Type,Cargo Type\
		],
	
	
	  BAU New Vehicles before ZEV Standards by Subregion[Subregion,Vehicle Type,Cargo Type\
		,Vehicle Technology],
	
	
	  (BAU New Vehicles before ZEV Standards by Subregion[Subregion,Vehicle Type,Cargo Type\
		,Vehicle Technology]
	  * (1 - BAU Required ZEV Sales Percentage by Subregion[Subregion,Vehicle Type,Cargo Type\
		]))
	
	  + 
	
	  SUM(BAU New Vehicles before ZEV Standards by Subregion[Subregion,Vehicle Type,Cargo Type\
		,Vehicle Technology!])
	  * BAU Required ZEV Sales Percentage by Subregion[Subregion,Vehicle Type,Cargo Type\
		]
	  * 
	
	  ((BAU Vehicle Technologies Qualifying as ZEVs[Vehicle Type,Vehicle Technology]
	  * exp(BAU New Vehicle Cost per Mile[Vehicle Type,Cargo Type,Vehicle Technology]* Vehicle Allocation Unit Correction
	  * TTLE Transportation Technology Logit Exponents[Vehicle Type,Cargo Type])
	)
	/
	(
	  SUM(BAU Vehicle Technologies Qualifying as ZEVs[Vehicle Type,Vehicle Technology!]
	  * exp(BAU New Vehicle Cost per Mile[Vehicle Type,Cargo Type,Vehicle Technology!]* \
		Vehicle Allocation Unit Correction
	  * TTLE Transportation Technology Logit Exponents[Vehicle Type,Cargo Type])
	  )
	))
	
	
	)
	
	,0)
	~	vehicles
	~		|

BAU New Vehicles Demanded[Vehicle Type,Cargo Type]=
	INTEGER(
	 MAX(0, BAU Fleet Needed[Vehicle Type,Cargo Type] - BAU Surviving Fleet[Vehicle Type\
		,Cargo Type])
	 +0.999999
	)
	~	vehicles
	~		|

BAU New Vehicles Last Year[Vehicle Type,Cargo Type,Vehicle Technology]= DELAY FIXED (
	BAU New Vehicles[Vehicle Type,Cargo Type,Vehicle Technology],
	1,
	0)
	~	vehicles/Year
	~		|

BAU New Vehicles over Fuel Economy[Vehicle Type,Cargo Type,Vehicle Technology]=
	IF THEN ELSE(BAU New Vehicle Fuel Economy[Vehicle Type,Cargo Type,Vehicle Technology\
		] > 0, (BAU New Vehicles[Vehicle Type,Cargo Type,Vehicle Technology]) / BAU New Vehicle Fuel Economy\
		[Vehicle Type,Cargo Type,Vehicle Technology], IF THEN ELSE(Start Year Fleet Avg Fuel Economy\
		[Vehicle Type,Cargo Type,Vehicle Technology] > 0, (BAU New Vehicles[Vehicle Type,Cargo Type\
		,Vehicle Technology]) / Start Year Fleet Avg Fuel Economy[Vehicle Type,Cargo Type,Vehicle Technology\
		], 0))
	~	vehicles/(miles/BTU)/Year
	~		|

BAU Newly Persistently Deep Unviable for Cost Driven Retirement[Electricity Source]=
	BAU Boolean Persistently Deep Unviable for Cost Driven Retirement[Electricity Source\
		]
	* (1 - BAU Last Year Boolean Persistently Deep Unviable for Cost Driven Retirement[Electricity Source\
		])
	~	Dmnl
	~		|

BAU Non Hybrid Demand Shifting Capacity in MW[Electricity Timeslice,Hour]=
	(BAU This Year Demand Response Capacity
	 + BAU Non Hybrid Diurnal Storage Power in MW[Electricity Timeslice]
	 + BPHC BAU Pumped Hydro Capacity
	   * SYSHECF Start Year Seasonal Expected Capacity Factor for Pumped Hydro[Electricity Timeslice\
		,Hour]
	 + BAU Total EV Battery Capacity Available in MW)
	* RAF Regional Availability Factor for Demand Altering Technologies
	~	MW
	~		|

BAU Non Hybrid Diurnal Storage Power in MW[Electricity Timeslice]=
	(BAU Last Year Grid Battery Storage Capacity excluding Hybrid Batteries
	 + BAU This Year Cumulative Policy Mandated Grid Battery Storage)
	* (1 - UFDfGBS Usage Factor Discount for Grid Battery Storage[Electricity Timeslice]\
		)
	/ GBSC Diurnal Grid Battery Daily Storage Duration
	~	MW
	~		|

BAU Non Qualifying Annual Energy Serving Peak Reliability Timeslices[Clean Elec Requirement\
		]=
	MAX(One MW * One Hour,
	SUM(
	  MAX(0,
	    BAU Total Electricity Demand by Hour Plus Reserve Margin After Demand Altering Technologies\
		[peak day electricity timeslice!,Hour!]
	    - BAU Qualifying Hourly Supply for Reliability Credit[Clean Elec Requirement,peak day electricity timeslice\
		!,Hour!]*One Hour
	  )
	  * SHELF Days per Electricity Timeslice[peak day electricity timeslice!]
	))
	~	MW*hour
	~		|

BAU Non Qualifying Reliability Credit Rampdown Before Full Requirement[Clean Elec Requirement\
		]=
	SUM(
	  IF THEN ELSE(
	    Numerical Future Year Definitions[Future Year!] >= Time :AND:
	    Numerical Future Year Definitions[Future Year!] <= Time + (RLYr Reliability Lookahead Years\
		 - 1),
	
	    MIN(1,
	      ZIDZ(
	        (1 - BAU Weighted Average Elec Portfolio Percentage by Year[Future Year!,Clean Elec Requirement\
		])
	        * BAU Annual Electricity Demand Energy for Reliability Credit[Clean Elec Requirement\
		],
	        BAU Non Qualifying Annual Energy Serving Peak Reliability Timeslices[Clean Elec Requirement\
		]
	      )
	    ),
	
	    0
	  )
	) / RLYr Reliability Lookahead Years
	* One Year
	~	Dmnl
	~		|

BAU Non RPS Qualifying Guaranteed Dispatch Amount[Electricity Source,Electricity Timeslice\
		,Hour,Clean Elec Requirement]=
	BAU Expected Capacity by Hour[Electricity Source,Electricity Timeslice,Hour]
	 * BGDPbES BAU Guaranteed Dispatch Percentage by Electricity Source[Electricity Source\
		]
	 * (1 - BAU Elec Portfolio Qualifying Sources[Electricity Source,Clean Elec Requirement\
		])
	 * One Hour
	~	MW*hr
	~		|

BAU Non RPS Qualifying Guaranteed Dispatch Amount after RPS Policy[Electricity Source\
		,Electricity Timeslice,Hour,Clean Elec Requirement]=
	BAU Non RPS Qualifying Guaranteed Dispatch Amount[Electricity Source,Electricity Timeslice\
		,Hour,Clean Elec Requirement]
	  * MIN(
	    1,
	
	    ZIDZ(
	      BAU Total Electricity Demand by Hour After Demand Altering Technologies[Electricity Timeslice\
		,Hour]
	      * (1 - BAU Legally Required Elec Portfolio Percentage[Clean Elec Requirement])\
		,      
	
	      BAU Non RPS Qualifying Guaranteed Dispatch Amount[Electricity Source,Electricity Timeslice\
		,Hour,Clean Elec Requirement]
	  )
	)
	~	MW*hr
	~		|

BAU Nonqualifying New Entry Binding Hour Capability=
	SUM(
	  (1 - BAU Elec Portfolio Qualifying Sources[Electricity Source!,CES])
	  * MAX(0,
	      MIN(
	        BAU Max Capacity Buildable after Cost Effective and RPS Additions[Electricity Source\
		!,CES],
	        BAU Capacity Supply Curve Parameters by Power Plant Type[saturation,Electricity Source\
		!] * One MW
	          * CSCSoCECBiaSY Share of Cost Effective Capacity Built in a Single Year[Electricity Source\
		!]
	        - BAU Total New Capacity Desired due to Cost Effectiveness[Electricity Source\
		!,CES]
	      )
	    )
	  * BAU Uncredited Binding Hour Bid Electricity Capacity Factors for Reliability by Plant Type\
		[Electricity Source!]
	)
	* One Hour
	~	MW*hour
	~		|

BAU Normalized Standard Deviation of Dispatch Costs Mapped to Hydrogen Production Pathways\
		[electrolysis]=
	SUM(
	  NSDoDC Normalized Standard Deviation of Dispatch Costs[Electricity Source!]
	  * BAU Last Year Electricity Generation by Type[Electricity Source!]
	)
	/
	SUM(BAU Last Year Electricity Generation by Type[Electricity Source!]) ~~|
BAU Normalized Standard Deviation of Dispatch Costs Mapped to Hydrogen Production Pathways\
		[natural gas reforming]=
	NSDoDC Normalized Standard Deviation of Dispatch Costs[natural gas combined cycle es\
		] ~~|
BAU Normalized Standard Deviation of Dispatch Costs Mapped to Hydrogen Production Pathways\
		[coal gasification]=
	NSDoDC Normalized Standard Deviation of Dispatch Costs[hard coal es] ~~|
BAU Normalized Standard Deviation of Dispatch Costs Mapped to Hydrogen Production Pathways\
		[biomass gasification]=
	NSDoDC Normalized Standard Deviation of Dispatch Costs[biomass es] ~~|
BAU Normalized Standard Deviation of Dispatch Costs Mapped to Hydrogen Production Pathways\
		[hydrocarbon partial oxidation
]=
	NSDoDC Normalized Standard Deviation of Dispatch Costs[heavy or residual fuel oil es\
		] ~~|
BAU Normalized Standard Deviation of Dispatch Costs Mapped to Hydrogen Production Pathways\
		[electrolysis with guaranteed clean electricity
]=
	SUM(NSDoDC Normalized Standard Deviation of Dispatch Costs[Electricity Source!]*BAU Share of Off Grid Electricity Demand That is New This Year Met by Power Plant Type
	[Electricity Source!]) ~~|
BAU Normalized Standard Deviation of Dispatch Costs Mapped to Hydrogen Production Pathways\
		[natural gas reforming with CCS
]=
	BAU Normalized Standard Deviation of Dispatch Costs Mapped to Hydrogen Production Pathways\
		[natural gas reforming]
	~	Dmnl
	~		|

BAU NPV of Lifetime Fuel Expenditures for a Vehicle Sold This Year[Vehicle Type,Cargo Type\
		,Vehicle Technology]=
	BAU Total Annual Vehicle Costs[Vehicle Type,Cargo Type,Vehicle Technology]
	* (
	    (1 - (1 + VBDR Vehicle Buyer Discount Rate[Vehicle Type]) ^ (- AVOP Average Vehicle Ownership Period\
		[Vehicle Type,Cargo Type
	]/One Year
	))
	    / VBDR Vehicle Buyer Discount Rate[Vehicle Type]
	  )
	
	+BAU Added Cost for Passenger LDV EV EVSE Equipment[Vehicle Type,Cargo Type,Vehicle Technology\
		]
	~	$/vehicle
	~		|

BAU NPV of Lifetime Vehicle Cost[Vehicle Type,Cargo Type,Vehicle Technology]=
	BAU New Vehicle Price Including EV Shadow Cost[Vehicle Type,Cargo Type,Vehicle Technology\
		]
	+ BAU NPV of Lifetime Fuel Expenditures for a Vehicle Sold This Year[Vehicle Type,Cargo Type\
		,Vehicle Technology]
	~	$/vehicle
	~		|

BAU Off Grid Capacity for Green Hydrogen Demand[Electricity Source]=
	BAU New Off Grid Capacity for Green Hydrogen Demand[Electricity Source]
	+ BAU Last Year Cumulative Off Grid Capacity for Green Hydrogen Demand[Electricity Source\
		]
	~	MW
	~		|

BAU Off Grid Electricity Capacity Serving Thermal Batteries[Electricity Source]=
	BAU New Off Grid Electricity Capacity Serving Thermal Batteries[Electricity Source]
	+ BAU Last Year Off Grid Electricity Capacity Serving Thermal Batteries[Electricity Source\
		]
	- BAU Retired Off Grid Electricity Capacity Serving Thermal Batteries[Electricity Source\
		]
	~	MW
	~	BAU twin of Thermal Battery Off Grid Capacity.
	|

BAU Off Grid Electricity Demand for Green Hydrogen by Power Plant Type[Electricity Source\
		]=
	BAU Off Grid Electricity Demand for Green Hydrogen That is New This Year by Power Plant Type With Quantization\
		[Electricity Source]
	+ BAU Last Year Cumulative Off Grid Electricity Demand for Green Hydrogen by Power Plant Type\
		[Electricity Source]
	~	MW*hr
	~		|

BAU Off Grid Electricity Demand for Green Hydrogen That is New This Year by Power Plant Type\
		[Electricity Source]=
	BAU Share of Off Grid Electricity Demand That is New This Year Met by Power Plant Type\
		[Electricity Source]
	* BAU Hydrogen Sector Off Grid Electricity Demand for Green Hydrogen That is New This Year
	~	MW*hr
	~		|

BAU Off Grid Electricity Demand for Green Hydrogen That is New This Year by Power Plant Type With Quantization\
		[Electricity Source]=
	BAU New Off Grid Capacity for Green Hydrogen Demand[Electricity Source]
	* BAU Expected Capacity Factor x Hours per Year for Plants Built This Year Without Hypothetical Calculations\
		[Electricity Source]
	~	MW*hr
	~		|

BAU Off Grid Thermal Battery Electricity Cost per Unit Energy=
	SUM(BAU Cost per Unit New Elec Output Using Expected Capacity Factors[Electricity Source\
		!]
	  * BAU Share of Off Grid Electricity Demand That is New This Year Met by Power Plant Type\
		[Electricity Source!])
	* MWh per BTU

	+
	SUM(
	  ZIDZ(BAU Share of Off Grid Electricity Demand That is New This Year Met by Power Plant Type\
		[Electricity Source!],
	  BAU Expected Capacity Factor x Hours per Year for Plants Built This Year[Electricity Source\
		!])
	)
	* TCCpUNEC Transmission Construction Cost per Unit New Electricity Capacity
	* MWh per BTU
	~	$/BTU
	~	BAU twin of Off Grid Thermal Battery Electricity Cost per Unit Energy. See \
		that variable for documentation.
	|

BAU One Year Average Net Energy Market Revenue by Plant Type Excluding Subsidies for Hybrid Power Plants\
		[Hybrid Electricity Source]=
	SUM(BAU Expected Capacity Factors by Hour for Hybrid Plants Built This Year[Hybrid Electricity Source\
		,Electricity Timeslice
	!,Hour!]
	*BAU Last Year Five Year Average Marginal Dispatch Cost by Hour[Electricity Timeslice\
		!,Hour!]
	*SHELF Days per Electricity Timeslice[Electricity Timeslice!]
	* One Hour)
	-BAU Last Year Five Year Average Annual Expected Dispatch Costs by Power Plant Type[\
		Hybrid Electricity Source]
	~	$/MW
	~		|

BAU One Year Average Wholesale Energy Market Costs=
	SUM(
	 (BAU Total Electricity Dispatched by Hour[Electricity Timeslice!,Hour!])
	 *BAU Marginal Dispatch Cost by Hour[Electricity Timeslice!,Hour!]
	 *SHELF Days per Electricity Timeslice[Electricity Timeslice!])
	~	$
	~		|

BAU Ongoing Capital Costs for Green Hydrogen Electricity[Electricity Source]=
	BAU Off Grid Capacity for Green Hydrogen Demand[Electricity Source]
	* BAU Weighted Average Annual Capital Costs per Unit Capacity[Electricity Source]
	~	$
	~		|

BAU Optimized CES Credit Price=
	MAX(
	  0,
	
	  SUM(BAU CES Credit Price by Optimization Pass[last pass!])
	)
	~	$/(MW*hour)
	~	Although "last pass" is intended to contain a single element, we must sum \
		across it becuase it is technically a subrange.
	|

BAU Optimized RPS Credit Price=
	MAX(
	  0,
	
	  SUM(BAU RPS Credit Price by Optimization Pass[last pass!])
	)
	~	$/(MW*hour)
	~	Although "last pass" is intended to contain a single element, we must sum \
		across it becuase it is technically a subrange.
	|

BAU Other Hydrogen Demand=
	BAU Total Hydrogen Demand
	- BAU Green Hydrogen Demand
	- BAU Low Carbon Hydrogen Demand
	~	BTU
	~		|

BAU Other Hydrogen Production by Pathway[Hydrogen Production Pathway]=
	ZIDZ(
	  BAU New Other Hydrogen Production Capacity This Year[Hydrogen Production Pathway]
	  + BAU Surviving Capacity Used for Other Hydrogen Production[Hydrogen Production Pathway\
		],
	
	  SUM(
	    BAU New Other Hydrogen Production Capacity This Year[Hydrogen Production Pathway\
		!]
	    + BAU Surviving Capacity Used for Other Hydrogen Production[Hydrogen Production Pathway\
		!]
	  )
	)
	~	Dmnl
	~		|

BAU Other Hydrogen Production Shares with Fallback[Hydrogen Production Pathway]=
	IF THEN ELSE(
	  SUM(BAU Other Hydrogen Production by Pathway[Hydrogen Production Pathway!]) = 0,
	
	  IF THEN ELSE(
	    SUM(BAU New Other Hydrogen Production Capacity Shares This Year[Hydrogen Production Pathway\
		!]) = 0,
	    BAU Start Year Other Hydrogen Production Shares by Pathway[Hydrogen Production Pathway\
		],
	    BAU New Other Hydrogen Production Capacity Shares This Year[Hydrogen Production Pathway\
		]
	  ),
	
	  ZIDZ( 
	    BAU Other Hydrogen Production by Pathway[Hydrogen Production Pathway],
	    SUM(BAU Other Hydrogen Production by Pathway[Hydrogen Production Pathway!])
	  )
	)
	~	1
	~		|

BAU Output by ISIC Code by Year[ISIC Code]=
	BAU Domestic Energy Revenue by Producing ISIC Code[ISIC Code]
	* FoPTaFbIC Fractions of Products That are Fuels by ISIC Code[ISIC Code]
	
	+ BAU Output by ISIC Code by Year from Exogenous Data[ISIC Code]
	  * (1 - FoPTaFbIC Fractions of Products That are Fuels by ISIC Code[ISIC Code])
	~	$
	~	Insofar as each ISIC code's revenues are from energy products, we use \
		endogenously-calculated values, and insofar as each ISIC code's revenues \
		are from non-energy products, we use exogenous values.
	|

BAU Output by ISIC Code by Year from Exogenous Data[ISIC Code]=
	BObIC BAU Output by ISIC Code[ISIC Code]
	* (1 + BPCiObIC BAU Percent Change in Output by ISIC Code[ISIC Code])
	~	$
	~		|

BAU Output Cost per Unit New Hydrogen Production[Hydrogen Production Pathway]=
	BAU Cost per Unit New Hydrogen Production[Hydrogen Production Pathway]
	* BpMMTH BTU per MMT Hydrogen
	/ Kilogram per Million Metric Ton
	/ OCCF Dollars per Small Output Currency Unit
	~	output currency unit/kg
	~		|

BAU Output from Industrial Equipment Installed During Model Run[Industry Category,Industrial Process\
		,Model Run Vintage]=
	BAU Potential Output from Industrial Equipment Installed During Model Run[Industry Category\
		,Industrial Process,Model Run Vintage]
	* BAU Industrial Equipment Utilization Factor[Industry Category,Industrial Process]
	~	$
	~		|

BAU Output from New Industrial Equipment[Industry Category,Industrial Process]=
	MAX(
	  0,
	
	  BAU Last Year Output by ISIC Code with Fuels Based on Energy Content[Industry Category ISIC Code\
		]
	  * 
	  ZIDZ(Total BAU Fuel Use for Energy Purposes by Industrial Process in Electricity Equivalent\
		[Industry Category,Industrial Process],
	    SUM(Total BAU Fuel Use for Energy Purposes by Industrial Process in Electricity Equivalent\
		[Industry Category,Industrial Process!])
	  )
	  - SUM(
	      BAU Last Year Potential Output from Industrial Equipment Installed During Model Run\
		[Industry Category,Industrial Process
	,Model Run Vintage!]
	      - BAU Potential Output from Retiring Industrial Equipment Installed During Model Run\
		[Industry Category,Industrial Process
	,Model Run Vintage!] * One Year)
	  - BAU Potential Output from Preexisting Industrial Equipment[Industry Category,Industrial Process\
		]
	)
	~	$
	~		|

BAU Output from New Industrial Equipment by Fuel Type and Industrial Process[Industry Category\
		,Industrial Fuel,Industrial Process]=
	BAU Share of New Industrial Equipment Allocated by Fuel Type in Electricity Equivalent\
		[Industry Category,Industrial Fuel,Industrial Process]
	* BAU Output from New Industrial Equipment by Industrial Process[Industry Category,Industrial Process\
		]
	~	$
	~		|

BAU Output from New Industrial Equipment by Industrial Process[Industry Category,Industrial Process\
		]=
	BAU Output from New Industrial Equipment[Industry Category,Industrial Process]
	~	$
	~		|

BAU Output from Preexisting Industrial Equipment[Industry Category,Industrial Process\
		]=
	BAU Potential Output from Preexisting Industrial Equipment[Industry Category,Industrial Process\
		]
	* MIN(
	    1,
	
	    ZIDZ(
	      BAU Last Year Output by ISIC Code with Fuels Based on Energy Content[Industry Category ISIC Code\
		],
	      SUM(BAU Potential Output from Industrial Equipment Installed During Model Run[\
		Industry Category,Industrial Process,Model Run Vintage!])
	      + BAU Potential Output from Preexisting Industrial Equipment[Industry Category\
		,Industrial Process]
	    )
	  )
	~	$
	~		|

BAU Peak Electricity Load=
	VMAX(BAU Total Electricity Demand by Hour before Net Imports[Electricity Timeslice
	!,Hour!])/One Hour
	~	MW
	~		|

BAU Peak Electricity Load Growth Relative to Start Year=
	BAU Peak Electricity Load
	/ SYPEL Start Year Peak Electricity Load
	~	Dmnl
	~		|

BAU Pending Cost Driven Retirements[Electricity Source]= INTEG(
	BAU Change in Pending Cost Driven Retirements[Electricity Source], 0)
	~	MW
	~		|

BAU Pending Cost Driven Retirements Excluding Capacity Payment[Electricity Source]= INTEG\
		(
	BAU Change in Pending Cost Driven Retirements Excluding Capacity Payment[Electricity Source\
		], 0)
	~	MW
	~		|

BAU Perc Change in In Scope Emissions due to Electricity Exports=
	IF THEN ELSE(
	  BIEfEE Boolean Include Emissions from Exported Electricity > 0,
	
	  0,
	
	  -BAU Percentage of Generated Electricity that is Exported
	)
	~	Dmnl
	~		|

BAU Perc Points Each Transportation Fuel May be Increased[Vehicle Type,Cargo Type,Vehicle Technology\
		,Transportation Fuel]=
	MAX(
	  MPoEFUbVT Max Perc of Each Fuel Usable by Vehicle Technology[Vehicle Type,Cargo Type\
		,Vehicle Technology,Transportation Fuel]
	  - BPoEFUbVT BAU Perc of Each Fuel Used by Veh Technology[Vehicle Type,Cargo Type,Vehicle Technology\
		,Transportation Fuel
	],
	
	  0
	)
	~	Dmnl
	~		|

BAU Percent Change in Domestically Produced Energy by Producing ISIC Code Relative to Initial Time\
		[ISIC Code]=
	ZIDZ(
	  BAU Domestically Produced Energy by Producing ISIC Code[ISIC Code]
	  - BAU Initial Domestically Produced Energy by Producing ISIC Code[ISIC Code],
	
	  BAU Initial Domestically Produced Energy by Producing ISIC Code[ISIC Code]
	)
	~	Dmnl
	~		|

BAU Percent Change in Employment and EE Compensation by ISIC Code[ISIC Code]=
	Percent Change in BAU Energy Production and Imports vs Initial Year by ISIC Code[ISIC Code\
		]
	* FoPTaFbIC Fractions of Products That are Fuels by ISIC Code[ISIC Code]
	
	+ BPCiObIC BAU Percent Change in Output by ISIC Code[ISIC Code]
	  * (1 - FoPTaFbIC Fractions of Products That are Fuels by ISIC Code[ISIC Code])
	~	Dmnl
	~	Insofar as each ISIC code's revenues are from energy products, we use \
		changes in production (physical quanitty of energy produced) to estimate \
		change in employment and EE compensation.  Insofar as each ISIC code's \
		revenues are from non-energy products, we use changes in economic output, \
		since non-energy products are heterogenous and are presently only tracked \
		in financial terms, not as physical quantities of machines, furniture, \
		etc.  The non-energy term uses the EXOGENOUS percent change in output \
		(BPCiObIC), not the endogenous-revenue-blended measure: energy revenue is \
		price times quantity, and fuel price movements (or a base-year gap between \
		endogenous energy revenue and the BEA output anchor) must not change \
		employment in the non-energy share of these industries when physical \
		activity is unchanged.
	|

BAU Percent Change in Fuel Production from Calculated Fuel Demand[Industry Category] \
		:EXCEPT:       [energy industries within industry category
]=
	0 ~~|
BAU Percent Change in Fuel Production from Calculated Fuel Demand[coal mining 05]=
	ZIDZ(SUM(BAU Fuel Production Imports and Exports[coal mining industry fuel within all fuels\
		!,production]),
	  SUM(BFPIaE BAU Fuel Production Imports and Exports[coal mining industry fuel within all fuels\
		!,production]))
	 -1 ~~|
BAU Percent Change in Fuel Production from Calculated Fuel Demand[oil and gas extraction 06\
		]=
	ZIDZ(BAU Fuel Production Imports and Exports[natural gas,production]+BAU Fuel Production Imports and Exports\
		[crude oil,
production],
	  BFPIaE BAU Fuel Production Imports and Exports[natural gas,production]+BFPIaE BAU Fuel Production Imports and Exports
[crude oil,production])
	 -1 ~~|
BAU Percent Change in Fuel Production from Calculated Fuel Demand[refined petroleum and coke 19\
		]=
	ZIDZ(SUM(BAU Fuel Production Imports and Exports[secondary petroleum product within all fuels\
		!,production]),
	  SUM(BFPIaE BAU Fuel Production Imports and Exports[secondary petroleum product within all fuels\
		!,production]))
	 -1 ~~|
BAU Percent Change in Fuel Production from Calculated Fuel Demand[energy pipelines and gas processing 352T353\
		]=
	ZIDZ(BAU Fuel Production Imports and Exports[natural gas,production]+BAU Fuel Production Imports and Exports\
		[heat,production
	]
	     +BAU Fuel Production Imports and Exports[natural gas,imports]
	     -BAU Fuel Production Imports and Exports[natural gas,exports],
	
	     BFPIaE BAU Fuel Production Imports and Exports[natural gas,production]
	    +BFPIaE BAU Fuel Production Imports and Exports[natural gas,imports]
	    -BFPIaE BAU Fuel Production Imports and Exports[natural gas,exports])
	 -1
	~	Dmnl
	~	We scale the value for energy pipelines and gas processing based on \
		domestic consumption rather than just domestic production since this \
		industry scales with demand for gas transported through pipelines rather \
		than with the domestic natural gas industry.
	|

BAU Percentage Curtailment by Power Plant Type[Electricity Source]=
	ZIDZ(
	  BAU Curtailed Electricity Output[Electricity Source],
	
	  BAU Annual Maximum Potential Electricity Output[Electricity Source]
	)
	~	Dmnl
	~		~	:SUPPLEMENTARY 
	|

BAU Percentage Electricity Generation by Source[Electricity Source]=
	BAU Electricity Generation by Type Including Distributed Generation[Electricity Source\
		]
	/ SUM(BAU Electricity Generation by Type Including Distributed Generation[Electricity Source\
		!])
	~	Dmnl
	~		~	:SUPPLEMENTARY 
	|

BAU Percentage Fuel Use by Industrial Process with Fallback Data[Industry Category,Industrial Fuel\
		,Industrial Process]=
	IF THEN ELSE(
	  SUM(BPFUbIP BAU Percentage Fuel Use by Industrial Process[Industry Category,Industrial Process\
		!,Industrial Fuel])
	  = 0,
	
	  BPFUbIP Fallback Fuel Use Shares by Process for Missing Data[Industrial Fuel,Industrial Process\
		],
	
	  BPFUbIP BAU Percentage Fuel Use by Industrial Process[Industry Category,Industrial Process\
		,Industrial Fuel]
	)
	~	Dmnl
	~	In case no data are provided for how to divide up a given fuel type \
		amongst industrial processes in BPFUbIP and in case there is a non-zero \
		quantity of that fuel use specified in BIFU, we rely on the fallback \
		apportionment of that fuel by industrial process, so we avoid losing \
		(zeroing out) fuel use that is specified in BIFU.
	|

BAU Percentage of Generated Electricity that is Exported=
	ZIDZ(
	  EIaE BAU Exported Electricity,
	
	  SUM(BAU Electricity Generation by Type[Electricity Source!])
	)
	~	Dmnl
	~		|

BAU Plant Types with Positive Dispatch Cost After Subsidies[Electricity Source]=
	IF THEN ELSE( 
	  BAU Plant Types with Zero or Negative Dispatch Cost After Subsidies[Electricity Source\
		]=1,
	  0,
	  1
	 )
	~	Dmnl
	~		|

BAU Plant Types with Zero or Negative Dispatch Cost After Subsidies[Electricity Source\
		]=
	IF THEN ELSE(
	  BAU Dispatch or Opportunity Cost per Unit Electricity Output[Electricity Source] <=\
		 0,
	
	  1,
	
	  0
	)
	~	Dmnl
	~		|

BAU Pollutant Emissions from Imported Electricity[Pollutant,Electricity Source]=
	EIaE BAU Imported Electricity by Electricity Source[Electricity Source]
	* BAU Electricity Fuel Pollutant Emissions Intensity per MWh[Electricity Source,Pollutant\
		]
	~	g pollutant
	~		|

BAU Positive Cost Electricity Dispatched to Meet CES[Electricity Timeslice,Hour,Electricity Source\
		]=
	MIN(
	
	BAU Expected CES Qualifying Output After Guaranteed and RPS Dispatch[Electricity Source\
		,Electricity Timeslice,Hour],
	
	IF THEN ELSE(
	 
	       BAU Remaining CES Required Generation after Guaranteed Dispatch and RPS Dispatch
	= 0,
	 
	       0,
	
	 
	       IF THEN ELSE(
	          SUM(
	            BAU Expected CES Qualifying Output After Guaranteed and RPS Dispatch[Electricity Source\
		!,Electricity Timeslice
	,Hour] 
	          )
	          > BAU Unmet Electricity Demand After RPS and Zero and Negative Cost CES Allocation Steps\
		[Electricity Timeslice,Hour],
	 
	          MIN(
	            BAU Unmet Electricity Demand After RPS and Zero and Negative Cost CES Allocation Steps\
		[Electricity Timeslice,Hour]
	            * ZIDZ(
	                BAU Expected CES Qualifying Output After Guaranteed and RPS Dispatch\
		[Electricity Source,Electricity Timeslice
	,Hour],
	                SUM(BAU Expected CES Qualifying Output After Guaranteed and RPS Dispatch\
		[Electricity Source!,Electricity Timeslice
	,Hour])
	              ),
	
	            ZIDZ(
	              BAU Remaining CES Required Generation after Guaranteed Dispatch and RPS Dispatch\
		,
	   
	              SUM(
	                BAU Expected CES Qualifying Output After Guaranteed and RPS Dispatch\
		[Electricity Source!,Electricity Timeslice
	!,Hour!]
	                *BAU Plant Types with Positive Dispatch Cost After Subsidies[Electricity Source\
		!]
	              )
	            )
	 
	            * BAU Expected CES Qualifying Output After Guaranteed and RPS Dispatch[Electricity Source\
		,Electricity Timeslice
	,Hour]
	            *BAU Plant Types with Positive Dispatch Cost After Subsidies[Electricity Source\
		]
	          ),
	 
	          BAU Expected CES Qualifying Output After Guaranteed and RPS Dispatch[Electricity Source\
		,Electricity Timeslice,Hour
	]
	          * BAU Plant Types with Positive Dispatch Cost After Subsidies[Electricity Source\
		]
	          * ZIDZ(
	              BAU Remaining CES Required Generation after Guaranteed Dispatch and RPS Dispatch\
		,
	              SUM(
	                BAU Expected CES Qualifying Output After Guaranteed and RPS Dispatch\
		[Electricity Source!,Electricity Timeslice
	!,Hour!]
	                *SHELF Days per Electricity Timeslice[Electricity Timeslice!]
	              )
	            )
	     )
	)
	)
	~	MW*hour
	~		|

BAU Positive Cost Electricity Dispatched to Meet RPS[Electricity Timeslice,Hour,Electricity Source\
		]=
	MIN(
	
	BAU Expected RPS Qualifying Capacity After Zero and Negative Cost RPS Dispatch[Electricity Timeslice\
		,Hour,Electricity Source]*One Hour,
	
	IF THEN ELSE(
	 
	       BAU Remaining RPS Required Generation after Guaranteed Dispatch and Zero and Negative Cost Electricity Dispatched to Meet RPS
	= 0,
	 
	       0,
	
	 
	       IF THEN ELSE(
	          SUM(
	            BAU Expected RPS Qualifying Capacity After Zero and Negative Cost RPS Dispatch\
		[Electricity Timeslice,Hour,Electricity Source!] 
	            *One Hour
	          )
	          > BAU Unmet Electricity Demand After Zero and Negative Cost RPS Dispatch[Electricity Timeslice\
		,Hour],
	 
	          MIN(
	            BAU Unmet Electricity Demand After Zero and Negative Cost RPS Dispatch[Electricity Timeslice\
		,Hour]
	            * ZIDZ(
	                BAU Expected RPS Qualifying Capacity After Zero and Negative Cost RPS Dispatch\
		[Electricity Timeslice,Hour,Electricity Source],
	                SUM(BAU Expected RPS Qualifying Capacity After Zero and Negative Cost RPS Dispatch\
		[Electricity Timeslice,Hour,Electricity Source!])
	              ),
	
	            ZIDZ(
	              BAU Remaining RPS Required Generation after Guaranteed Dispatch and Zero and Negative Cost Electricity Dispatched to Meet RPS\
		,
	   
	              SUM(
	                BAU Expected RPS Qualifying Capacity After Zero and Negative Cost RPS Dispatch\
		[Electricity Timeslice!,Hour!,Electricity Source!]
	                *BAU Plant Types with Positive Dispatch Cost After Subsidies[Electricity Source\
		!]
	              )
	              * One Hour 
	            )
	 
	            * BAU Expected RPS Qualifying Capacity After Zero and Negative Cost RPS Dispatch\
		[Electricity Timeslice,Hour,Electricity Source]
	            *BAU Plant Types with Positive Dispatch Cost After Subsidies[Electricity Source\
		]
	            * One Hour
	          ),
	 
	          BAU Expected RPS Qualifying Capacity After Zero and Negative Cost RPS Dispatch\
		[Electricity Timeslice,Hour,Electricity Source]
	          * BAU Plant Types with Positive Dispatch Cost After Subsidies[Electricity Source\
		]
	          * ZIDZ(
	              BAU Remaining RPS Required Generation after Guaranteed Dispatch and Zero and Negative Cost Electricity Dispatched to Meet RPS\
		,
	              SUM(
	                BAU Expected RPS Qualifying Capacity After Zero and Negative Cost RPS Dispatch\
		[Electricity Timeslice!,Hour!,Electricity Source!]
	                *SHELF Days per Electricity Timeslice[Electricity Timeslice!]
	              )
	            )
	     )
	)
	)
	~	MW*hr
	~		|

BAU Potential Capacity by Hour[Electricity Source,Electricity Timeslice,Hour]=
	BAU Electricity Generation Capacity[Electricity Source]
	*BAU Weighted Average Expected Capacity Factors by Hour without RAF[Electricity Source\
		,Electricity Timeslice,Hour]
	~	MW
	~		|

BAU Potential Output from Industrial Equipment Installed During Model Run[Industry Category\
		,Industrial Process,Model Run Vintage]=
	BAU Last Year Potential Output from Industrial Equipment Installed During Model Run[\
		Industry Category,Industrial Process
	,Model Run Vintage]
	+
	IF THEN ELSE(
	  This Year Model Run Vintage Flag[Model Run Vintage] = 1,
	  BAU Output from New Industrial Equipment[Industry Category,Industrial Process],
	  0
	)
	  - BAU Potential Output from Retiring Industrial Equipment Installed During Model Run\
		[Industry Category,Industrial Process
	,Model Run Vintage] * One Year
	~	$
	~		|

BAU Potential Output from Preexisting Industrial Equipment[Industry Category,Industrial Process\
		]=
	BAU Last Year Potential Output from Preexisting Industrial Equipment[Industry Category\
		,Industrial Process]
	- BAU Potential Output from Retiring Preexisting Industrial Equipment[Industry Category\
		,Industrial Process]
	~	$
	~		|

BAU Potential Output from Retiring Industrial Equipment Installed During Model Run[Industry Category\
		,Industrial Process,
Model Run Vintage]=
	BAU Last Year Potential Output from Industrial Equipment Installed During Model Run[\
		Industry Category,Industrial Process
	,Model Run Vintage]
	* 
	Retiring Share of Industrial Equipment Desired Due to Equipment Age[Industrial Process\
		,Model Run Vintage] / One Year
	~	$/Year
	~		|

BAU Potential Output from Retiring Preexisting Industrial Equipment[Industry Category\
		,Industrial Process]=
	BAU Initial Output by Industry Category and Process[Industry Category,Industrial Process\
		]
	* 
	BAU This Year Fraction of Initial Industrial Equipment Retired[Industry Category,Industrial Process\
		]
	~	$
	~		|

BAU Potential Output from Surviving Capacity by Hour[Electricity Timeslice,Hour]=
	SUM(
	  BAU Surviving Electricity Generation Capacity before Economic Retirements[Electricity Source\
		!]
	  * BAU Last Year Hourly Bid Electricity Capacity Factors by Plant Type[Electricity Timeslice\
		,Hour,Electricity Source!]
	)
	* One Hour
	~	MW*hr
	~		|

BAU Power Plant Least Cost Dispatch Parameters as Vector[Electricity Source,ptype]=
	3 ~~|
BAU Power Plant Least Cost Dispatch Parameters as Vector[Electricity Source,ppriority\
		]=
	BAU Dispatch or Opportunity Cost per Unit Electricity Output[Electricity Source
	] ~~|
BAU Power Plant Least Cost Dispatch Parameters as Vector[Electricity Source,pwidth]=
	MAX(
	  ABS(MAX(NSDoDC Normalized Standard Deviation of Dispatch Costs[Electricity Source]\
		,0.01)
	  *(BAU Dispatch or Opportunity Cost per Unit Electricity Output[Electricity Source]
	  + BAU Variable Subsidies per Unit Electricity Output[Electricity Source])
	  ),
	
	  0.01
	) ~~|
BAU Power Plant Least Cost Dispatch Parameters as Vector[Electricity Source,pextra]=
	0
	~	$/(MW*hr)
	~	We require pwidth to be a minimum of 0.01 so that the dispatch allocations \
		do not result in an error due to 0 dispatch costs for some power plant \
		types
	|

BAU Predicted Capacity Payment by Plant Type for Existing Plants[Electricity Source,Optimization Pass\
		]=
	BAU Capacity Market Price for Seasonal Dispatchable Reliability by Optimization Pass\
		[Optimization Pass]
	  * BAU Uncredited Binding Hour Bid Electricity Capacity Factors for Reliability by Plant Type\
		[Electricity Source]
	  * BAU Existing Fleet Reliability Credit Factor with Backstop[Electricity Source]
	  * Days per Year
	  * One Day
	~	$/MW
	~		|

BAU Predicted Change in Energy Market Revenue for CCUS Retrofits[hard coal w CCS es]=
	BAU Average Four Year Prior Total Predicted Net Energy Market Revenue per MW[hard coal w CCS es\
		]
	
	-BAU Average Four Year Prior Total Predicted Net Energy Market Revenue per MW[hard coal es\
		] ~~|
BAU Predicted Change in Energy Market Revenue for CCUS Retrofits[natural gas combined cycle w CCS es\
		]=
	BAU Average Four Year Prior Total Predicted Net Energy Market Revenue per MW[natural gas combined cycle w CCS es
	]
	
	-BAU Average Four Year Prior Total Predicted Net Energy Market Revenue per MW[natural gas combined cycle es
	] ~~|
BAU Predicted Change in Energy Market Revenue for CCUS Retrofits[biomass w CCS es]=
	BAU Average Four Year Prior Total Predicted Net Energy Market Revenue per MW[biomass w CCS es\
		]
	
	-BAU Average Four Year Prior Total Predicted Net Energy Market Revenue per MW[biomass es\
		] ~~|
BAU Predicted Change in Energy Market Revenue for CCUS Retrofits[lignite w CCS es]=
	BAU Average Four Year Prior Total Predicted Net Energy Market Revenue per MW[lignite w CCS es\
		]
	
	-BAU Average Four Year Prior Total Predicted Net Energy Market Revenue per MW[lignite es\
		]
	~	$/MW
	~		|

BAU Preexisting Clinker Capacity Facing Overhaul Decision by Pathway[Cement Production Pathway\
		]=
	MIN(
	  BAU Last Year Preexisting Clinker Production Capacity by Pathway[Cement Production Pathway\
		],
	  CPRS Cement Preexisting Capacity Overhaul Decision Schedule[Cement Production Pathway\
		]
	  + BAU Preexisting Clinker Capacity Reentering Decision Pool by Pathway[Cement Production Pathway\
		]
	)
	~	metric tons/Year
	~	BAU twin of Cement Capacity Facing Overhaul Decision by Pathway.
	|

BAU Preexisting Clinker Capacity Overhauled by Pathway[Cement Production Pathway]=
	BAU Preexisting Clinker Capacity Facing Overhaul Decision by Pathway[Cement Production Pathway\
		]
	* BAU Cement Overhaul Share at Decision[Cement Production Pathway]
	~	metric tons/Year
	~	BAU twin of Cement Capacity Overhauled by Pathway.
	|

BAU Preexisting Clinker Capacity Reentering Decision Pool by Pathway[Cement Production Pathway\
		]= DELAY3I(
	BAU Preexisting Clinker Capacity Overhauled by Pathway[Cement Production Pathway],
	CPPL Cement Pathway Campaign Length[Cement Production Pathway],
	0)
	~	metric tons/Year
	~	BAU twin of Cement Capacity Reentering Decision Pool by Pathway (see the \
		policy twin for the Q4 distributed-recurrence rationale).
	|

BAU Preexisting Clinker Capacity Retirements by Pathway[Cement Production Pathway]=
	BAU Preexisting Clinker Capacity Facing Overhaul Decision by Pathway[Cement Production Pathway\
		]
	- BAU Preexisting Clinker Capacity Overhauled by Pathway[Cement Production Pathway]
	~	metric tons/Year
	~	BAU twin of Preexisting Clinker Capacity Retirements by Pathway.
	|

BAU Preexisting Clinker Production Capacity by Pathway[Cement Production Pathway]=
	BAU Last Year Preexisting Clinker Production Capacity by Pathway[Cement Production Pathway\
		]
	- BAU Preexisting Clinker Capacity Retirements by Pathway[Cement Production Pathway]
	~	metric tons/Year
	~	BAU twin of Preexisting Clinker Production Capacity by Pathway.
	|

BAU Present Value of Clean Industrial Heat Subsidy[Industry Category,Industrial Fuel,\
		industrial heating process]=
	BAU Clean Industrial Heat Subsidy Rate by Fuel Type[Industrial Fuel,industrial heating process\
		]
	* Clean Industrial Heat Subsidy Annuity Factor[Industry Category]
	~	$/BTU
	~		|

BAU Present Value of Industrial Equipment Annual Financing Repayments[Industry Category\
		,Industrial Fuel,Industrial Process]=
	BAU Industrial Equipment Annual Financing Repayment per Unit Energy[Industry Category\
		,Industrial Fuel,Industrial Process]
	* Industrial Equipment Capital Annuity Factor[Industry Category,Industrial Process]
	~	$/BTU
	~		|

BAU Present Value of Industrial Equipment Costs per Unit Energy[Industry Category,Industrial Fuel\
		,Industrial Process]=
	BAU Present Value of Industrial Equipment Annual Financing Repayments[Industry Category\
		,Industrial Fuel,Industrial Process]
	+ BAU Present Value of Industrial Equipment Costs per Unit Energy including Clean Heat Subsidy\
		[Industry Category,Industrial Fuel,Industrial Process]
	~	$/BTU
	~		|

BAU Present Value of Industrial Equipment Costs per Unit Energy including Clean Heat Subsidy\
		[Industry Category,Industrial Fuel
,Industrial Process] :EXCEPT:                   [Industry Category,Industrial Fuel,industrial heating process\
		]=
	(BAU Present Value of Pretax Industrial Fuel Price in Future Years[Industry Category\
		,Industrial Fuel,Industrial Process]
	 + BAU Present Value of Industrial Fuel Tax or Subsidy Rate by Fuel in Future Years[\
		Industry Category,Industrial Fuel,Industrial Process])
	
	* (1 - SoFCTiBoSFbI Share of Fuel Consumption That is Byproduct or Secondary Fuels by Industry\
		[Industry Category,Industrial Fuel
	])
	
	+ BAU Present Value of Industrial Fuel Carbon Tax per Unit Energy in Future Years[Industry Category\
		,Industrial Fuel,Industrial Process] ~~|
BAU Present Value of Industrial Equipment Costs per Unit Energy including Clean Heat Subsidy\
		[Industry Category,Industrial Fuel
,industrial heating process]=
	(BAU Present Value of Pretax Industrial Fuel Price in Future Years[Industry Category\
		,Industrial Fuel,industrial heating process]
	 + BAU Present Value of Industrial Fuel Tax or Subsidy Rate by Fuel in Future Years[\
		Industry Category,Industrial Fuel,industrial heating process])
	
	* (1 - SoFCTiBoSFbI Share of Fuel Consumption That is Byproduct or Secondary Fuels by Industry\
		[Industry Category,Industrial Fuel])
	
	+ BAU Present Value of Industrial Fuel Carbon Tax per Unit Energy in Future Years[Industry Category\
		,Industrial Fuel,industrial heating process]
	
	- BAU Present Value of Clean Industrial Heat Subsidy[Industry Category,Industrial Fuel\
		,industrial heating process]
	~	$/BTU
	~		|

BAU Present Value of Industrial Fuel Carbon Tax per Unit Energy in Future Years[Industry Category\
		,Industrial Fuel,Industrial Process
]=
	BAU Industrial Fuel Taxable CO2e Emissions Intensity[Industry Category,Industrial Fuel\
		]
	* BFoICStCT BAU Fraction of Industry Category Subject to Carbon Tax[Industry Category\
		]
	* BAU Carbon Tax Present Value Factor[Industry Category,Industrial Process]
	~	$/BTU
	~		|

BAU Present Value of Industrial Fuel Tax or Subsidy Rate by Fuel in Future Years[Industry Category\
		,Industrial Fuel,Industrial Process]=
	SUM( 
	  ZIDZ( 
	    BFPaT BAU Fuel Tax by Sector[industrial fuel within all fuels,industry sector,Future Year\
		 !] , 
	    Present Value Discount and Lifetime Window Denominator[Industry Category,Industrial Process\
		,Future Year!]
	  ) 
	)
	~	$/BTU
	~		|

BAU Present Value of Pretax Industrial Fuel Price in Future Years[Industry Category,Industrial Fuel\
		,Industrial Process] :EXCEPT:  [Industry Category,hydrogen if,Industrial Process],[\
		Industry Category,green hydrogen if,Industrial Process],[Industry Category
,low carbon hydrogen if,Industrial Process]=
	SUM( 
	  ZIDZ( 
	    BAU Pretax Fuel Price by Sector in Future Years[industrial fuel within all fuels\
		 ,industry sector,Future Year!], 
	    Present Value Discount and Lifetime Window Denominator[Industry Category,Industrial Process\
		,Future Year!]
	  ) 
	) ~~|
BAU Present Value of Pretax Industrial Fuel Price in Future Years[Industry Category,hydrogen if\
		,Industrial Process]=
	BAU Smoothed Other Hydrogen Cost
	* Industrial Equipment Lifetime Annuity Factor[Industry Category,Industrial Process]\
		 ~~|
BAU Present Value of Pretax Industrial Fuel Price in Future Years[Industry Category,green hydrogen if\
		,Industrial Process]=
	BAU Smoothed Green Hydrogen Cost
	* Industrial Equipment Lifetime Annuity Factor[Industry Category,Industrial Process]\
		 ~~|
BAU Present Value of Pretax Industrial Fuel Price in Future Years[Industry Category,low carbon hydrogen if\
		,Industrial Process]=
	BAU Smoothed Low Carbon Hydrogen Cost
	* Industrial Equipment Lifetime Annuity Factor[Industry Category,Industrial Process]
	~	$/BTU
	~		|

BAU Pretax Fuel Cost per Unit Energy by Sector with Sensitivity Analysis Adjustment[All Fuels\
		,Sectors] :EXCEPT:  [electricity
,Sectors]=
	BAU Pretax Fuel Price by Sector[All Fuels,Sectors]
	* Fuel Price Multiplier for Sensitivity Analysis Runs[All Fuels] ~~|
BAU Pretax Fuel Cost per Unit Energy by Sector with Sensitivity Analysis Adjustment[electricity\
		,Sectors]=
	This Year Pretax Electricity Price by Sector[Sectors]
	* Fuel Price Multiplier for Sensitivity Analysis Runs[electricity]
	~	$/BTU
	~		|

BAU Pretax Fuel Price by Sector[All Fuels, Sectors]=
	SUM(BFPAT BAU Pretax Fuel Price by Sector[All Fuels,Sectors,Future Year!]*Future Year to Year Mapping\
		[Future Year!])
	~	$/BTU
	~		|

BAU Pretax Fuel Price by Sector in Future Years[All Fuels,Sectors,Future Year] :EXCEPT:\
		       
[electricity,Sectors,Future Year]=
	BFPAT BAU Pretax Fuel Price by Sector[All Fuels,Sectors,Future Year] ~~|
BAU Pretax Fuel Price by Sector in Future Years[electricity,Sectors,Future Year]=
	BAU Average Five Year Prior Pretax Electricity Price by Sector[Sectors]
	~	$/BTU
	~		|

BAU Pretax Fuel Price by Sector Including Endogenous Electricity Prices[All Fuels,Sectors\
		] :EXCEPT:  [electricity,Sectors
]=
	BAU Pretax Fuel Price by Sector[All Fuels,Sectors] ~~|
BAU Pretax Fuel Price by Sector Including Endogenous Electricity Prices[electricity,Sectors\
		]=
	BAU This Year Pretax Electricity Price by Sector[Sectors]
	~	$/BTU
	~		|

BAU Process Emissions after CCS[Industry Category,Pollutant]=
	BAU Process Emissions before CCS[Industry Category,Pollutant]
	- BAU This Year Process Pollutants Sequestered by Industry Sector[Industry Category,\
		Pollutant]
	~	g pollutant
	~		|

BAU Process Emissions after GDP and Fuel Production Adjustment[Industry Category,Pollutant\
		] :EXCEPT:      [energy industries within industry category
,Pollutant], [cement and other nonmetallic minerals 239,CO2]=
	BPE BAU Process Emissions[Industry Category,Pollutant]
	* (1 + Perc Change in Sectoral Energy Use due to Exogenous GDP Adjustment[industry sector\
		]) ~~|
BAU Process Emissions after GDP and Fuel Production Adjustment[energy industries within industry category\
		,Pollutant]=
	BPE BAU Process Emissions[energy industries within industry category
	,Pollutant]
	* (1 + Last Year BAU Percent Change in Fuel Production from Calculated Fuel Demand[energy industries within industry category\
		]) ~~|
BAU Process Emissions after GDP and Fuel Production Adjustment[cement and other nonmetallic minerals 239\
		,CO2]=
	BAU Cement Residual Process CO2
	+ BAU Cement Process CO2 Emissions
	~	g pollutant
	~	The cement and other nonmetallic minerals 239 CO2 branch blends the \
		exogenous residual (lime and other carbonate sources, staying on BPE) with \
		the cement module's endogenous calcination-plus-petcoke process CO2. \
		Non-CO2 pollutants for 239 keep the generic BPE branch.
	|

BAU Process Emissions before CCS[Industry Category,Pollutant]=
	BAU Process Emissions after GDP and Fuel Production Adjustment[Industry Category,Pollutant\
		]
	~	g pollutant
	~	This variable does no math operations.  It changes the name of "BAU \
		Process Emissions after GDP Adjustment" to "BAU Process Emissions before \
		CCS" to as to be parallel with the variable named "Process Emissions \
		before CCS".
	|

BAU Process Emissions in CO2e[Industry Category,Pollutant]=
	BAU Process Emissions after GDP and Fuel Production Adjustment[Industry Category,Pollutant\
		]
	* GbPbT GWP by Pollutant by Timeframe[Pollutant,one hundred years]
	~	g CO2e
	~	We use one-hundred year GWP values here (rather than the user-selected \
		20-year or 100-year GWP values) because we must use the same timeframe as \
		our PERAC source document when converting from pollutant to CO2e.
	|

BAU Process Emissions in CO2e after CCS[Industry Category,Pollutant]=
	BAU Process Emissions after CCS[Industry Category,Pollutant]
	* GWP by Pollutant[Pollutant]
	~	g CO2e
	~		|

BAU Process Emissions in CO2e in Metric Tons[Industry Category,Pollutant]=
	BAU Process Emissions in CO2e after CCS[Industry Category,Pollutant]
	/ Grams per Metric Ton CO2e
	~	metric tons CO2e
	~		|

BAU Profitable Capacity for Cost Effective CCUS Retrofits[CCUS Electricity Source, Optimization Pass
,RPS]=
	IF THEN ELSE(
	  BAU Incremental Revenue for Cost Effective CCUS Retrofits[CCUS Electricity Source,\
		Optimization Pass,RPS
	] < 1,
	  0,
	  (1-exp(-((  BAU Incremental Revenue for Cost Effective CCUS Retrofits[CCUS Electricity Source\
		,Optimization Pass,RPS
	]/BAU Capacity Supply Curve Parameters by Power Plant Type[cutoff parameter,CCUS Electricity Source\
		] / One Dollar per MW-(BAU Capacity Supply Curve Parameters by Power Plant Type[location parameter\
		,CCUS Electricity Source]-0.5))/BAU Capacity Supply Curve Parameters by Power Plant Type\
		[scale parameter,CCUS Electricity Source])^BAU Capacity Supply Curve Parameters by Power Plant Type\
		[shape parameter,CCUS Electricity Source]))*BAU Capacity Supply Curve Parameters by Power Plant Type\
		[saturation,CCUS Electricity Source] * One MW
	) ~~|
BAU Profitable Capacity for Cost Effective CCUS Retrofits[CCUS Electricity Source,Optimization Pass
,CES]=
	IF THEN ELSE(
	  BAU Incremental Revenue for Cost Effective CCUS Retrofits[CCUS Electricity Source,\
		Optimization Pass,CES
	] < 1,
	  0,
	  (1-exp(-((  BAU Incremental Revenue for Cost Effective CCUS Retrofits[CCUS Electricity Source\
		,Optimization Pass,CES
	]/BAU Capacity Supply Curve Parameters by Power Plant Type[cutoff parameter,CCUS Electricity Source\
		] / One Dollar per MW-(BAU Capacity Supply Curve Parameters by Power Plant Type[location parameter\
		,CCUS Electricity Source]-0.5))/BAU Capacity Supply Curve Parameters by Power Plant Type\
		[scale parameter,CCUS Electricity Source])^BAU Capacity Supply Curve Parameters by Power Plant Type\
		[shape parameter,CCUS Electricity Source]))*BAU Capacity Supply Curve Parameters by Power Plant Type\
		[saturation,CCUS Electricity Source] * One MW
	)
	~	MW
	~		|

BAU Profitable Capacity for Cost Effective CCUS Retrofits without CES[CCUS Electricity Source\
		]=
	IF THEN ELSE(
	  BAU Incremental Revenue for Cost Effective CCUS Retrofits without CES[CCUS Electricity Source
	] < 1,
	  0,
	  (1-exp(-((  BAU Incremental Revenue for Cost Effective CCUS Retrofits without CES[\
		CCUS Electricity Source
	]/BAU Capacity Supply Curve Parameters by Power Plant Type[cutoff parameter,CCUS Electricity Source\
		] / One Dollar per MW-(BAU Capacity Supply Curve Parameters by Power Plant Type[location parameter\
		,CCUS Electricity Source]-0.5))/BAU Capacity Supply Curve Parameters by Power Plant Type\
		[scale parameter,CCUS Electricity Source])^BAU Capacity Supply Curve Parameters by Power Plant Type\
		[shape parameter,CCUS Electricity Source]))*BAU Capacity Supply Curve Parameters by Power Plant Type\
		[saturation,CCUS Electricity Source] * One MW
	)
	~	MW
	~		|

BAU Profitable Capacity for Cost Effectiveness Additions[Electricity Source, Optimization Pass
,RPS]=
	IF THEN ELSE(
	  BAU Incremental Revenue for Cost Effectiveness Additions[Electricity Source,Optimization Pass\
		,RPS] < 1,
	  0,
	  (1-exp(-((  BAU Incremental Revenue for Cost Effectiveness Additions[Electricity Source\
		,Optimization Pass,RPS]/BAU Capacity Supply Curve Parameters by Power Plant Type[cutoff parameter\
		,Electricity Source] / One Dollar per MW-(BAU Capacity Supply Curve Parameters by Power Plant Type\
		[location parameter,Electricity Source]-0.5))/BAU Capacity Supply Curve Parameters by Power Plant Type\
		[scale parameter,Electricity Source])^BAU Capacity Supply Curve Parameters by Power Plant Type\
		[shape parameter,Electricity Source]))*BAU Capacity Supply Curve Parameters by Power Plant Type\
		[saturation,Electricity Source] * One MW
	) ~~|
BAU Profitable Capacity for Cost Effectiveness Additions[Electricity Source,Optimization Pass
,CES]=
	IF THEN ELSE(
	  BAU Incremental Revenue for Cost Effectiveness Additions[Electricity Source,Optimization Pass\
		,CES] < 1,
	  0,
	  (1-exp(-((  BAU Incremental Revenue for Cost Effectiveness Additions[Electricity Source\
		,Optimization Pass,CES]/BAU Capacity Supply Curve Parameters by Power Plant Type[cutoff parameter\
		,Electricity Source] / One Dollar per MW-(BAU Capacity Supply Curve Parameters by Power Plant Type\
		[location parameter,Electricity Source]-0.5))/BAU Capacity Supply Curve Parameters by Power Plant Type\
		[scale parameter,Electricity Source])^BAU Capacity Supply Curve Parameters by Power Plant Type\
		[shape parameter,Electricity Source]))*BAU Capacity Supply Curve Parameters by Power Plant Type\
		[saturation,Electricity Source] * One MW
	)
	~	MW
	~		|

BAU Profitable Capacity for Cost Effectiveness Additions for Hybrid Power Plants[Hybrid Electricity Source
, Optimization Pass,RPS]=
	IF THEN ELSE(
	  BAU Incremental Revenue for Cost Effectiveness Additions for Hybrid Power Plants[Hybrid Electricity Source
	,Optimization Pass,RPS] < 1,
	  0,
	  (1-exp(-((  BAU Incremental Revenue for Cost Effectiveness Additions for Hybrid Power Plants\
		[Hybrid Electricity Source
	,Optimization Pass,RPS]/BAU Capacity Supply Curve Parameters by Power Plant Type[cutoff parameter\
		,Hybrid Electricity Source] / One Dollar per MW-(BAU Capacity Supply Curve Parameters by Power Plant Type\
		[location parameter,Hybrid Electricity Source]-0.5))/BAU Capacity Supply Curve Parameters by Power Plant Type\
		[scale parameter,Hybrid Electricity Source])^BAU Capacity Supply Curve Parameters by Power Plant Type\
		[shape parameter,Hybrid Electricity Source]))*BAU Capacity Supply Curve Parameters by Power Plant Type\
		[saturation,Hybrid Electricity Source] * One MW
	) ~~|
BAU Profitable Capacity for Cost Effectiveness Additions for Hybrid Power Plants[Hybrid Electricity Source
,Optimization Pass,CES]=
	IF THEN ELSE(
	  BAU Incremental Revenue for Cost Effectiveness Additions for Hybrid Power Plants[Hybrid Electricity Source
	,Optimization Pass,CES] < 1,
	  0,
	  (1-exp(-((  BAU Incremental Revenue for Cost Effectiveness Additions for Hybrid Power Plants\
		[Hybrid Electricity Source
	,Optimization Pass,CES]/BAU Capacity Supply Curve Parameters by Power Plant Type[cutoff parameter\
		,Hybrid Electricity Source] / One Dollar per MW-(BAU Capacity Supply Curve Parameters by Power Plant Type\
		[location parameter,Hybrid Electricity Source]-0.5))/BAU Capacity Supply Curve Parameters by Power Plant Type\
		[scale parameter,Hybrid Electricity Source])^BAU Capacity Supply Curve Parameters by Power Plant Type\
		[shape parameter,Hybrid Electricity Source]))*BAU Capacity Supply Curve Parameters by Power Plant Type\
		[saturation,Hybrid Electricity Source] * One MW
	)
	~	MW
	~		|

BAU Profitable Capacity for Cost Effectiveness Additions for Hybrid Power Plants without CES\
		[Hybrid Electricity Source]=
	IF THEN ELSE(
	  BAU Incremental Revenue for Cost Effectiveness Additions for Hybrid Power Plants without CES
	[Hybrid Electricity Source] < 1,
	  0,
	  (1-exp(-((  BAU Incremental Revenue for Cost Effectiveness Additions for Hybrid Power Plants without CES
	[Hybrid Electricity Source]/BAU Capacity Supply Curve Parameters by Power Plant Type\
		[cutoff parameter,Hybrid Electricity Source] / One Dollar per MW-(BAU Capacity Supply Curve Parameters by Power Plant Type\
		[location parameter,Hybrid Electricity Source]-0.5))/BAU Capacity Supply Curve Parameters by Power Plant Type\
		[scale parameter,Hybrid Electricity Source])^BAU Capacity Supply Curve Parameters by Power Plant Type\
		[shape parameter,Hybrid Electricity Source]))*BAU Capacity Supply Curve Parameters by Power Plant Type\
		[saturation,Hybrid Electricity Source] * One MW
	)
	~	MW
	~		|

BAU Profitable Capacity for Cost Effectiveness Additions without CES[Electricity Source\
		]=
	IF THEN ELSE(
	  BAU Incremental Revenue for Cost Effectiveness Additions without CES[Electricity Source\
		] < 1,
	  0,
	  (1-exp(-((  BAU Incremental Revenue for Cost Effectiveness Additions without CES[Electricity Source\
		]/BAU Capacity Supply Curve Parameters by Power Plant Type[cutoff parameter,Electricity Source\
		] / One Dollar per MW-(BAU Capacity Supply Curve Parameters by Power Plant Type[location parameter\
		,Electricity Source]-0.5))/BAU Capacity Supply Curve Parameters by Power Plant Type\
		[scale parameter,Electricity Source])^BAU Capacity Supply Curve Parameters by Power Plant Type\
		[shape parameter,Electricity Source]))*BAU Capacity Supply Curve Parameters by Power Plant Type\
		[saturation,Electricity Source] * One MW
	)
	~	MW
	~		|

BAU Profitable Capacity for Seasonal Dispatchable Reliability Additions[Electricity Source\
		,Optimization Pass]=
	IF THEN ELSE(
	 IF THEN ELSE(
	  MAX(0,
	  BAU Total Energy Market and Capacity Market Revenue for Seasonal Dispatchable Reliability\
		[Electricity Source,Optimization Pass]
	  -(
	     BAU Annualized Fixed Costs per Unit New Capacity[Electricity Source]
	     * SoCtMbCtbDP Share of Costs that Must be Covered to Be Deemed Profitable[Electricity Source\
		]
	  )
	) <= 0,
	  0,
	  (1-exp(-(((  BAU Total Energy Market and Capacity Market Revenue for Seasonal Dispatchable Reliability\
		[Electricity Source,Optimization Pass]
	  -(
	    BAU Annualized Fixed Costs per Unit New Capacity[Electricity Source]
	     * SoCtMbCtbDP Share of Costs that Must be Covered to Be Deemed Profitable[Electricity Source\
		]
	  ))/BAU Capacity Supply Curve Parameters by Power Plant Type[cutoff parameter,Electricity Source\
		] / One Dollar per MW-(BAU Capacity Supply Curve Parameters by Power Plant Type[location parameter\
		,Electricity Source]-0.5))/BAU Capacity Supply Curve Parameters by Power Plant Type\
		[scale parameter,Electricity Source])^BAU Capacity Supply Curve Parameters by Power Plant Type\
		[shape parameter,Electricity Source]))*BAU Capacity Supply Curve Parameters by Power Plant Type\
		[saturation,Electricity Source] * One MW
	)
	= :NA:,
	  0,
	 IF THEN ELSE(
	  MAX(0,
	  BAU Total Energy Market and Capacity Market Revenue for Seasonal Dispatchable Reliability\
		[Electricity Source,Optimization Pass]
	  -(
	     BAU Annualized Fixed Costs per Unit New Capacity[Electricity Source]
	     * SoCtMbCtbDP Share of Costs that Must be Covered to Be Deemed Profitable[Electricity Source\
		]
	  )
	) <= 0,
	  0,
	  (1-exp(-(((  BAU Total Energy Market and Capacity Market Revenue for Seasonal Dispatchable Reliability\
		[Electricity Source,Optimization Pass]
	  -(
	    BAU Annualized Fixed Costs per Unit New Capacity[Electricity Source]
	     * SoCtMbCtbDP Share of Costs that Must be Covered to Be Deemed Profitable[Electricity Source\
		]
	  ))/BAU Capacity Supply Curve Parameters by Power Plant Type[cutoff parameter,Electricity Source\
		] / One Dollar per MW-(BAU Capacity Supply Curve Parameters by Power Plant Type[location parameter\
		,Electricity Source]-0.5))/BAU Capacity Supply Curve Parameters by Power Plant Type\
		[scale parameter,Electricity Source])^BAU Capacity Supply Curve Parameters by Power Plant Type\
		[shape parameter,Electricity Source]))*BAU Capacity Supply Curve Parameters by Power Plant Type\
		[saturation,Electricity Source] * One MW
	)
	  )
	~	MW
	~	If we do not test for :NA: (no number), then an out-of-bounds lookup in \
		the prior variable can produce a large random number here, which can throw \
		off the model. It may be better to output zero for an out-of-bounds lookup.
	|

BAU Qualifying Hourly Supply for Reliability Credit[Clean Elec Requirement,Electricity Timeslice\
		,Hour]=
	SUM(
	  BAU Elec Portfolio Qualifying Sources[Electricity Source!,Clean Elec Requirement]
	  * BAU Electricity Generation Capacity before Reliability Additions[Electricity Source\
		!]
	  * BAU Last Year Hourly Bid Electricity Capacity Factors by Plant Type[Electricity Timeslice\
		,Hour,Electricity Source!]
	)
	~	MW
	~		|

BAU Quantity Carbon Free Energy May be Increased by Fuel by Regulated Vehicle Type[Vehicle Type\
		,Cargo Type,Transportation Fuel] :EXCEPT:  [Vehicle Type,Cargo Type,electricity tf]\
		,[Vehicle Type,Cargo Type,biofuel gasoline tf],[Vehicle Type,Cargo Type
,biofuel diesel tf]=
	0 ~~|
BAU Quantity Carbon Free Energy May be Increased by Fuel by Regulated Vehicle Type[Vehicle Type\
		,Cargo Type,electricity tf]=
	SUM(BAU Quantity Each Fuel May be Increased in Regulated Vehicle Types with Elec Eff Adj\
		[Vehicle Type,Cargo Type,Vehicle Technology
	!,electricity tf])
	* (1 - Carbon Intensity Ratios by Transportation Fuel[electricity tf]) ~~|
BAU Quantity Carbon Free Energy May be Increased by Fuel by Regulated Vehicle Type[Vehicle Type\
		,Cargo Type,biofuel gasoline tf]=
	(SUM(BAU Quantity Each Fuel May be Increased in Regulated Vehicle Types with Elec Eff Adj\
		[Vehicle Type,Cargo Type,Vehicle Technology
	!,biofuel gasoline tf
	])
	  - BAU Quantity Each Fuel May be Increased in Regulated Vehicle Types with Elec Eff Adj\
		[Vehicle Type,Cargo Type,plugin hybrid vehicle
	,biofuel gasoline tf
	])
	* (1 - Carbon Intensity Ratios by Transportation Fuel[biofuel gasoline tf]) ~~|
BAU Quantity Carbon Free Energy May be Increased by Fuel by Regulated Vehicle Type[Vehicle Type\
		,Cargo Type,biofuel diesel tf]=
	(SUM(BAU Quantity Each Fuel May be Increased in Regulated Vehicle Types with Elec Eff Adj\
		[Vehicle Type,Cargo Type,Vehicle Technology
	!,biofuel diesel tf
	])
	  - BAU Quantity Each Fuel May be Increased in Regulated Vehicle Types with Elec Eff Adj\
		[Vehicle Type,Cargo Type,plugin hybrid vehicle
	,biofuel diesel tf
	])
	* (1 - Carbon Intensity Ratios by Transportation Fuel[biofuel diesel tf])
	~	BTU
	~	Plug-in hybrids can shift to either electricity or biofuels.  To model \
		this explicitly would be very difficult, as we'd need to account for three \
		possible shifts (petroleum gasoline to biofuel gasoline, petroleum \
		gasoline to electricity, and biofuel gasoline to electricity).  In \
		practice, biofuel gasoline is hardly used by plug-in hybrids, and \
		electricity will always be the more economical choice for satisfying an \
		LCFS via generation of carbon-free energy.  Therefore, we only allow for \
		one of these three types of shifts in plug-in hybrids: petroleum gasoline \
		to electricity.  Accordingly, we must subtract out the (small) quantity by \
		which biofuels could be increased in plug-in hybrids when calculating the \
		total amount of potential increase in biofuels, to avoid exceeding the \
		maximum allowable shift in gasoline or diesel vehicles (when the shift is \
		assigned to those vehicles, rather than to plug-in hybrids, later in the \
		calculation steps).
	|

BAU Quantity Each Fuel May be Increased in Regulated Vehicle Types[Vehicle Type,Cargo Type\
		,Vehicle Technology,Transportation Fuel]=
	BAU Perc Points Each Transportation Fuel May be Increased[Vehicle Type,Cargo Type,Vehicle Technology\
		,Transportation Fuel]
	* SUM(BAU Transportation Sector Fuel that would be Used in Absence of LCFS by Regulated Vehicle Types\
		[Vehicle Type,Cargo Type
	,Vehicle Technology,Transportation Fuel!])
	~	BTU
	~		|

BAU Quantity Each Fuel May be Increased in Regulated Vehicle Types with Elec Eff Adj[\
		Vehicle Type,Cargo Type,Vehicle Technology
,Transportation Fuel] :EXCEPT:  [Vehicle Type,Cargo Type,Vehicle Technology,electricity tf\
		]=
	BAU Quantity Each Fuel May be Increased in Regulated Vehicle Types[Vehicle Type,Cargo Type\
		,Vehicle Technology,Transportation Fuel
	] ~~|
BAU Quantity Each Fuel May be Increased in Regulated Vehicle Types with Elec Eff Adj[\
		Vehicle Type,Cargo Type,Vehicle Technology
,electricity tf]=
	BAU Quantity Each Fuel May be Increased in Regulated Vehicle Types[Vehicle Type,Cargo Type\
		,Vehicle Technology,electricity tf
	]
	/ (1 - PTFURfE Percentage Transportation Fuel Use Reduction for Electricity[Vehicle Type\
		,Cargo Type])
	~	BTU
	~		|

BAU Quantization Size for Hourly Dispatch=
	SUM(BAU Electricity Generation by Type[Electricity Source!])
	* 2.5e-07
	~	MW*hr
	~		|

BAU Reduction in CO2 Emissions due to LCFS[Vehicle Type,Cargo Type,Vehicle Technology\
		,Transportation Fuel]=
	BAU Change in Fuel Use by Fuel and Technology due to LCFS with Elec Eff Adj[Vehicle Type\
		,Cargo Type,Vehicle Technology,Transportation Fuel]
	* Reduction in Carbon Intensity of This Fuel Relative to Reference Fuel[Vehicle Type\
		,Transportation Fuel]
	~	g pollutant
	~		|

BAU Reliability Backstop Credit Share=
	MIN(1,
	  ZIDZ(
	    BAU Reliability Backstop Shortfall,
	    BAU Binding Hour Reliability Capability Withheld by Credit Derate
	  )
	)
	~	Dmnl
	~		|

BAU Reliability Backstop Shortfall=
	MAX(0,
	  SUM(BAU Net Electricity Demand Relative to Available Supply in Binding Hour by Optimization Pass\
		[last pass!])
	)
	~	MW*hour
	~		|

BAU Reliability Credit Factor[Electricity Source]=
	VMIN(
	    BAU Elec Portfolio Qualifying Sources[Electricity Source,Clean Elec Requirement!\
		]
	    + (1 - BAU Elec Portfolio Qualifying Sources[Electricity Source,Clean Elec Requirement\
		!])
	    * BAU Reliability Credit Ratio for Non Qualifying Sources[Clean Elec Requirement\
		!]
	  )
	~	Dmnl
	~		|

BAU Reliability Credit Factor with New Entry Backstop[Electricity Source]=
	BAU Reliability Credit Factor[Electricity Source]
	+ (1 - BAU Reliability Credit Factor[Electricity Source])
	  * BAU Last Year New Entry Reliability Credit Relaxation Share
	~	Dmnl
	~		|

BAU Reliability Credit Ratio for Non Qualifying Sources[Clean Elec Requirement]=
	exp(
	  - ((BAU Five Year Foresight Elec Portfolio Values for Reliability Check[Clean Elec Requirement\
		]
	     / RCDCb Reliability Credit Derate Curve Scale Parameter)
	  ^ RCDCa Reliability Credit Derate Curve Shape Parameter)
	)
	~	Dmnl
	~		|

BAU Reliability Emergency Nonqualifying Capacity Need=
	BAU Binding Hour Reliability Shortfall after Fossil Backstop
	/ One Hour
	~	MW
	~		|

BAU Remaining CES Required Generation after Guaranteed Dispatch and RPS Dispatch=
	MAX(0,
	  SUM(BAU Total Electricity Demand by Hour After Demand Altering Technologies[Electricity Timeslice
	!,Hour!]*BAU Elec Portfolio Percentage to Seek This Year[CES]
	*SHELF Days per Electricity Timeslice  [Electricity Timeslice!])
	  
	   -SUM(BAU Electricity Dispatched by Guaranteed Dispatch by Hour[Electricity Source\
		 !,Electricity Timeslice!,Hour!]*BAU Elec Portfolio Qualifying Sources
	[Electricity Source!,CES]*SHELF Days per Electricity Timeslice[Electricity Timeslice\
		 !])
	  
	   -SUM(BAU Zero and Negative Cost Electricity Dispatched to Meet RPS[Electricity Timeslice\
		 !,Hour!,Electricity Source!]*BAU Elec Portfolio Qualifying Sources
	[Electricity Source!,CES]*SHELF Days per Electricity Timeslice
	[Electricity Timeslice!])
	
	-SUM(BAU Positive Cost Electricity Dispatched to Meet RPS[Electricity Timeslice!,Hour\
		 !,Electricity Source!]*BAU Elec Portfolio Qualifying Sources
	[Electricity Source!,CES]*SHELF Days per Electricity Timeslice
	[Electricity Timeslice!])
	
	- SUM(BAU Zero and Negative Cost Electricity Dispatched to Meet CES[Electricity Source\
		 !,Electricity Timeslice!,Hour!]*BAU Elec Portfolio Qualifying Sources[Electricity Source\
		 !,CES]*SHELF Days per Electricity Timeslice[Electricity Timeslice!])
	)
	~	MW*hour
	~		|

BAU Remaining Electricity Exports by Electricity Timeslice by Optimization Pass[Electricity Timeslice\
		,Optimization Pass]=
	IF THEN ELSE(BAU Daily Net Imported Electricity>=0,0,
	  -BAU Daily Net Imported Electricity-SUM(BAU Electricity Exports by Hour[Electricity Timeslice\
		,Hour!,Optimization Pass])
	 )
	~	MW*hour
	~		|

BAU Remaining Electricity Imports by Electricity Timeslice and Optimization Pass[Electricity Timeslice\
		, Optimization Pass]=
	IF THEN ELSE(BAU Daily Net Imported Electricity<=0,0,
	  BAU Daily Net Imported Electricity-SUM(BAU Electricity Imports by Hour[Electricity Timeslice\
		,Hour!,Optimization Pass])
	)
	~	MW*hour
	~		|

BAU Remaining RPS Required Generation after Guaranteed Dispatch and Zero and Negative Cost Electricity Dispatched to Meet RPS\
		=
	MAX(0,
	  SUM(BAU Total Electricity Demand by Hour After Demand Altering Technologies[Electricity Timeslice
	!,Hour!]*BAU Elec Portfolio Percentage to Seek This Year[RPS]
	*SHELF Days per Electricity Timeslice  [Electricity Timeslice!])
	  
	   -SUM(BAU Electricity Dispatched by Guaranteed Dispatch by Hour[Electricity Source\
		!,Electricity Timeslice!,Hour!]*BAU Elec Portfolio Qualifying Sources
	[Electricity Source!,RPS]*SHELF Days per Electricity Timeslice[Electricity Timeslice\
		!])
	  
	   -SUM(BAU Zero and Negative Cost Electricity Dispatched to Meet RPS[Electricity Timeslice\
		!,Hour!,Electricity Source!]*BAU Elec Portfolio Qualifying Sources[Electricity Source\
		!,RPS]*SHELF Days per Electricity Timeslice
	[Electricity Timeslice!])
	)
	~	MW*hr
	~		|

BAU Renewable Electricity Generation Converted to Primary Energy[hydro es]=
	BAU Electricity Generation by Type Including Distributed Generation[hydro es]
	/ MWh per BTU ~~|
BAU Renewable Electricity Generation Converted to Primary Energy[onshore wind es]=
	BAU Electricity Generation by Type Including Distributed Generation[onshore wind es]
	/ MWh per BTU ~~|
BAU Renewable Electricity Generation Converted to Primary Energy[solar PV es]=
	BAU Electricity Generation by Type Including Distributed Generation[solar PV es]
	/ MWh per BTU ~~|
BAU Renewable Electricity Generation Converted to Primary Energy[solar thermal es]=
	BAU Electricity Generation by Type Including Distributed Generation[solar thermal es\
		]
	/ MWh per BTU ~~|
BAU Renewable Electricity Generation Converted to Primary Energy[geothermal es]=
	BAU Electricity Generation by Type Including Distributed Generation[geothermal es]
	/ MWh per BTU ~~|
BAU Renewable Electricity Generation Converted to Primary Energy[offshore wind es]=
	BAU Electricity Generation by Type Including Distributed Generation[offshore wind es\
		]
	/ MWh per BTU
	~	BTU
	~		|

BAU Repayment for Buildings Sector Financed Capital Expenses Expiring After Financing Period\
		[Building Type]= DELAY FIXED (
	BAU Annual Repayment for Financed Buildings Sector Capital Expenses[Building Type],RPfFBSCC Repayment Period for Financed Buildings Sector Capital Costs\
		, 0)
	~	$
	~		|

BAU Repayment of Financing for Change in Electricity Sector Capital Expenditures including Construction Subsidies\
		=
	DEPRECIATE STRAIGHTLINE(
	
	 BAU Annual Repayment for This Year Electricty Transmission Distribution and Storage Expenses
	  * RPfFESCC Repayment Period for Financed Electricity Sector Capital Costs / One Year\
		,
	 
	  RPfFESCC Repayment Period for Financed Electricity Sector Capital Costs,
	
	  1,
	
	  0
	)
	~	$
	~		|

BAU Required Increase in Carbon Free Energy=
	MAX(
	  0,
	
	  SUM(BAU Fuel that would be Used by Regulated Vehicle Types in Absence of LCFS with Elec Eff Adj\
		[Vehicle Type!,Cargo Type!,Vehicle Technology!,Transportation Fuel!])
	  * BAU Required LCFS Percentage
	  - SUM(BAU Carbon Free Energy in Absence of LCFS by Vehicle Type[Vehicle Type!,Cargo Type\
		!,Vehicle Technology!,Transportation Fuel!])
	)
	~	BTU
	~		|

BAU Required Increase in Carbon Free Energy Assigned to Vehicle and Fuel Types[Vehicle Type\
		,Cargo Type,Transportation Fuel]=
	BAU Quantity Carbon Free Energy May be Increased by Fuel by Regulated Vehicle Type[Vehicle Type\
		,Cargo Type,Transportation Fuel]
	* MIN(
	    1,
	
	    ZIDZ(
	      BAU Required Increase in Carbon Free Energy,
	      SUM(BAU Quantity Carbon Free Energy May be Increased by Fuel by Regulated Vehicle Type\
		[Vehicle Type!,Cargo Type!,Transportation Fuel!])
	    )
	  )
	~	BTU
	~		|

BAU Required LCFS Percentage=
	BLP BAU LCFS Percentage
	~	Dmnl
	~		|

BAU Required Revenue for Breakeven Target[Electricity Source]=
	BAU Last Year Annual Recurring Costs by Plant Type[Electricity Source]
	* SoFCtMbCtPR Share of Forward Costs that Must Be Covered to Prevent Retirement[Electricity Source\
		]
	~	$/MW
	~		|

BAU Required ZEV Sales Percentage by Subregion[Subregion,Vehicle Type,Cargo Type]=
	MAX(
	
	  BRZSPbMR BAU Required ZEV Sales Percentage by Model Region[Vehicle Type,Cargo Type\
		],
	
	  BRZSPbS BAU Required ZEV Sales Percentage by Subregion[Subregion,Vehicle Type,Cargo Type\
		]
	)
	~	Dmnl
	~		|

BAU Retirable Vintages by Year[Modeled Vintage]=
	IF THEN ELSE(
	  Dimensionless Time - Modeled Vintage to Year Mapping[Modeled Vintage] <= MLfPPR Minimum Lifetime for Power Plant Retirements\
		/One Year,
	
	  0,
	
	  1
	)
	~	Dmnl
	~		|

BAU Retired Off Grid Electricity Capacity Serving Thermal Batteries[Electricity Source\
		]=
	BAU Last Year Off Grid Electricity Capacity Serving Thermal Batteries[Electricity Source\
		]
	* ZIDZ(
	    BAU Retired Thermal Battery Off Grid Electricity Demand by Power Plant Type[Electricity Source\
		],
	    BAU Last Year Cumulative Thermal Battery Off Grid Electricity Demand by Power Plant Type\
		[Electricity Source]
	  )
	~	MW
	~	BAU twin.
	|

BAU Retired Thermal Battery Off Grid Electricity Demand by Power Plant Type[Electricity Source\
		]=
	MAX(
	  0,
	  SUM(BAU Last Year Cumulative Thermal Battery Off Grid Electricity Demand by Power Plant Type\
		[Electricity Source!])
	  - BAU Thermal Battery Off Grid Capability Requirement
	)
	* ZIDZ(
	    BAU Last Year Cumulative Thermal Battery Off Grid Electricity Demand by Power Plant Type\
		[Electricity Source],
	    SUM(BAU Last Year Cumulative Thermal Battery Off Grid Electricity Demand by Power Plant Type\
		[Electricity Source!])
	  )
	~	MW*hour
	~	BAU twin.
	|

BAU Retiring Components Energy Use[Building Type,Building Fuel,Building Component]=
	MAX(
	  0,
	
	  MIN(
	    BAU Last Year Components Energy Use[Building Type,Building Fuel,Building Component\
		]
	    / One Year,
	
	    IF THEN ELSE(
	      Time < INITIAL TIME + CL Component Lifetime[Building Type,Building Component],
	
	      ZIDZ(
	        SYCEU Start Year Components Energy Use[Building Type,Building Fuel,Building Component\
		],
	        CL Component Lifetime[Building Type,Building Component]
	      ),
	
	      BAU New Components Energy Use after Envelope Effects after Lifetime[Building Type\
		,Building Fuel,Building Component]
	    )
	  )
	)
	~	BTU/Year
	~		|

BAU Retiring Generation Capacity[Electricity Source]=
	MAX(
	    0,
	    MIN(
	      SUM(BAU Retiring Generation Capacity Including Economic and Mandated Retirements\
		[Electricity Source,last pass!]),
	      BAU Last Year Electricity Generation Capacity[Electricity Source]
	     )
	  )
	~	MW
	~		|

BAU Retiring Generation Capacity Including Economic and Mandated Retirements[Electricity Source\
		 ,Optimization Pass]=
	BAU Economic Capacity Retirements by Optimization Pass[Electricity Source,Optimization Pass\
		 ]
	+ BAU Capacity Retirements from Schedule[Electricity Source]
	+SUM(BAU Capacity Retirements Based on Economic Lifetime[Electricity Source,Modeled Vintage\
		! ])
	~	MW
	~		|

BAU Retiring Hydrogen Production Capacity Installed During Model Run by Vintage[Hydrogen Production Pathway\
		,Model Run Vintage]=
	BAU Last Year Hydrogen Production Capacity Installed During Model Run by Vintage[Hydrogen Production Pathway\
		,Model Run Vintage]
	* Fraction of Hydrogen Production Equipment Retired by Age[Model Run Vintage]
	/ One Year
	~	BTU/Year
	~		|

BAU Retiring Preexisting Hydrogen Production Capacity[Hydrogen Production Pathway]=
	BAU Last Year Preexisting Hydrogen Production Capacity[Hydrogen Production Pathway]
	* PHERP Preexisting Hydrogen Equipment Retirement Profile
	/ One Year
	~	BTU/Year
	~		|

BAU Retiring Vehicles[Vehicle Type,Cargo Type,Vehicle Technology]=
	SUM(BAU Last Year Vehicles by Vintage[Vehicle Type,Cargo Type,Vehicle Technology,Vehicle Vintage\
		!] * Vehicle Survival Rate by Vehicle Type Cargo Type Engine and Vintage[Cargo Type\
		,Vehicle Type,Vehicle Vintage!])
	/ One Year
	~	vehicles/Year
	~	Let X be the lifetime of a given type of vehicle (in years).  In the first \
		X years of the model run, we want to retire 1/X of the starting number of \
		vehicles.  Since we only work with whole numbers of vehicles (integers), \
		this may leave us with a remainder.  We deal with this by retiring the \
		remainder (if any) in the first year of the model run, in addition to the \
		1/X vehicles that are retired in each of the first X years.  After X years \
		have elapsed, we simply retire the vehicles we added to the fleet X years \
		ago.
	|

BAU Retiring Vehicles over Fuel Economy[Vehicle Type,Cargo Type,Vehicle Technology]=
	SUM(BAU Last Year Vehicles over Fuel Economy by Vintage[Vehicle Type,Cargo Type,Vehicle Technology\
		,Vehicle Vintage!] * Vehicle Survival Rate by Vehicle Type Cargo Type Engine and Vintage\
		[Cargo Type,Vehicle Type,Vehicle Vintage!])
	/ One Year
	~	vehicles/(miles/BTU)/Year
	~		|

BAU Retrofit Capacity after Quantization[Electricity Source]=
	BAU New Policy Mandated Retrofits[Electricity Source] 
	+ BAU Retrofit Capacity Desired due to Cost Effectiveness[Electricity Source,CES]
	~	MW
	~		|

BAU Retrofit Capacity Desired due to Cost Effectiveness[Electricity Source,Clean Elec Requirement\
		] :EXCEPT:     [CCUS Electricity Source,Clean Elec Requirement]=
	0 ~~|
BAU Retrofit Capacity Desired due to Cost Effectiveness[CCUS Electricity Source,RPS]=
	QUANTUM(
	  MAX(0,
	    SUM(BAU Retrofitted Capacity Desired due to Cost Effectiveness by Optimization Pass\
		[CCUS Electricity Source,last pass!,RPS])),
	  MPPC Minimum Power Plant Capacity[CCUS Electricity Source]
	) ~~|
BAU Retrofit Capacity Desired due to Cost Effectiveness[CCUS Electricity Source,CES]=
	QUANTUM(
	  MAX(0,
	    SUM(BAU Retrofitted Capacity Desired due to Cost Effectiveness by Optimization Pass\
		[CCUS Electricity Source,last pass!,CES])),
	  MPPC Minimum Power Plant Capacity[CCUS Electricity Source]
	)
	~	MW
	~		|

BAU Retrofitted Capacity Desired due to Cost Effectiveness by Optimization Pass[Electricity Source\
		, Optimization Pass,Clean Elec Requirement] :EXCEPT:      [CCUS Electricity Source,\
		Optimization Pass,Clean Elec Requirement]=
	0 ~~|
BAU Retrofitted Capacity Desired due to Cost Effectiveness by Optimization Pass[CCUS Electricity Source\
		,Optimization Pass
,RPS]=
	QUANTUM(
	  MIN(
	    BAU Max Capacity Available for CCUS Retrofits after Mandated Retrofits[CCUS Electricity Source\
		],
	
	  BAU Profitable Capacity for Cost Effective CCUS Retrofits[CCUS Electricity Source,\
		Optimization Pass,RPS]
	    * CSCSoCECBiaSY Share of Cost Effective Capacity Built in a Single Year[CCUS Electricity Source\
		]
	  ),
	  MPPC Minimum Power Plant Capacity[CCUS Electricity Source]
	) ~~|
BAU Retrofitted Capacity Desired due to Cost Effectiveness by Optimization Pass[CCUS Electricity Source\
		,Optimization Pass
,CES]=
	QUANTUM(
	  MIN(
	    BAU Max Capacity Available for CCUS Retrofits after Mandated Retrofits[CCUS Electricity Source\
		],
	
	    BAU Profitable Capacity for Cost Effective CCUS Retrofits[CCUS Electricity Source\
		,Optimization Pass,CES]
	    * CSCSoCECBiaSY Share of Cost Effective Capacity Built in a Single Year[CCUS Electricity Source\
		]
	  ),
	  MPPC Minimum Power Plant Capacity[CCUS Electricity Source]
	)
	~	MW
	~		|

BAU Retrofitted Capacity Desired due to Cost Effectiveness without CES[Electricity Source\
		] :EXCEPT:    [CCUS Electricity Source
]=
	0 ~~|
BAU Retrofitted Capacity Desired due to Cost Effectiveness without CES[CCUS Electricity Source\
		]=
	QUANTUM(
	  MIN(
	    BAU Max Capacity Available for CCUS Retrofits after Mandated Retrofits[CCUS Electricity Source\
		],
	
	    BAU Profitable Capacity for Cost Effective CCUS Retrofits without CES[CCUS Electricity Source\
		]
	    * CSCSoCECBiaSY Share of Cost Effective Capacity Built in a Single Year[CCUS Electricity Source\
		]
	  ),
	 MPPC Minimum Power Plant Capacity[CCUS Electricity Source]
	)
	~	MW
	~		|

BAU Revenue from CES Credits per Unit Electricity Output by Plant Type[Electricity Source\
		]=
	BAU Optimized RPS Credit Price
	* BAU Elec Portfolio Qualifying Sources[Electricity Source,RPS]
	
	+ 
	
	(
	  BAU Optimized CES Credit Price
	  + BZECfNP BAU Zero Emissions Credit for Nuclear Plants[Electricity Source]
	)
	  * BAU Elec Portfolio Qualifying Sources[Electricity Source,CES]
	~	$/(MW*hr)
	~		|

BAU RPS and CES Revenue at Marginal Capacity Factor[Electricity Source]=
	SUM(BAU RPS Revenue at Marginal Capacity Factor by Optimization Pass[last pass!,Electricity Source\
		])
	+ SUM(BAU CES Revenue at Marginal Capacity Factor by Optimization Pass[last pass!,Electricity Source\
		])
	~	$/MW
	~		|

BAU RPS Credit Price by Optimization Pass[pass1]=
	BAU Initial Guess at RPS Price ~~|
BAU RPS Credit Price by Optimization Pass[current pass] :EXCEPT:  [last pass]=
	MIN(IF THEN ELSE(
	  BAU RPS Credit Price by Optimization Pass[preceeding pass] = 0,
	
	  0,
	
	  MAX(
	    0,
	
	    IF THEN ELSE(
	      BAU Expected Achievable Annual RPS by Optimization Pass[preceeding pass]
	      < BAU Elec Portfolio Percentage to Seek This Year[RPS],
	  
	      BAU RPS Credit Price by Optimization Pass[preceeding pass]
	      + BAU RPS Optimization Step Size[current pass],
	
	      BAU RPS Credit Price by Optimization Pass[preceeding pass]
	      - BAU RPS Optimization Step Size[current pass]
	    )
	  )
	), BRACP BAU RPS Alternative Compliance Payment) ~~|
BAU RPS Credit Price by Optimization Pass[last pass]=
	MIN(IF THEN ELSE(
	  BAU RPS Credit Price by Optimization Pass[penultimate pass] = 0,
	
	  0,
	
	  MAX(
	    0,
	    
	    IF THEN ELSE(
	      BAU Final RPS Pass Gate = 1,
	      BAU Final RPS Pass Value,
	      IF THEN ELSE(
	        BAU Expected Achievable Annual RPS by Optimization Pass[penultimate pass]
	        < BAU Elec Portfolio Percentage to Seek This Year[RPS],
	  
	        BAU RPS Credit Price by Optimization Pass[penultimate pass]
	        + BAU RPS Optimization Step Size[last pass],
	
	        BAU RPS Credit Price by Optimization Pass[penultimate pass]
	        - BAU RPS Optimization Step Size[last pass]
	      )
	    )
	  )
	), BRACP BAU RPS Alternative Compliance Payment)
	~	$/(MW*hour)
	~		|

BAU RPS Optimization Step Size[pass1]=
	ABS(BAU RPS Credit Price by Optimization Pass[pass1])
	/ 2 ~~|
BAU RPS Optimization Step Size[current pass]=
	IF THEN ELSE(
	  BAU RPS Steps in Same Direction[preceeding pass]
	  > Steps Allowed in Same Direction Without Increasing Step Size,
	
	  BAU RPS Optimization Step Size[preceeding pass] * 1.5,
	
	  IF THEN ELSE(
	    BAU RPS Steps in Same Direction[preceeding pass]
	    > Steps Allowed in Same Direction With Declining Step Size,
	
	    BAU RPS Optimization Step Size[preceeding pass],
	
	    BAU RPS Optimization Step Size[preceeding pass]
	    / 2
	  )
	)
	~	$/(MW*hour)
	~		|

BAU RPS Qualifying Guaranteed Dispatch Amount[Electricity Source,Electricity Timeslice\
		,Hour,Clean Elec Requirement]=
	BAU Expected Capacity by Hour[Electricity Source,Electricity Timeslice,Hour]
	 * BGDPbES BAU Guaranteed Dispatch Percentage by Electricity Source[Electricity Source\
		]
	 * BAU Elec Portfolio Qualifying Sources[Electricity Source,Clean Elec Requirement]
	 * One Hour
	~	MW*hr
	~		|

BAU RPS Revenue at Expected Capacity Factor by Optimization Pass[Hybrid Electricity Source\
		, Optimization Pass]=
	BAU RPS Credit Price by Optimization Pass[Optimization Pass]
	    * BAU Marginal Capacity Factor x Hours per Year for Hybrid Power Plants[Hybrid Electricity Source\
		,RPS]
	    * BAU Elec Portfolio Qualifying Sources[Hybrid Electricity Source,RPS]
	~	$/MW
	~		|

BAU RPS Revenue at Marginal Capacity Factor by Optimization Pass[Optimization Pass, Electricity Source\
		]=
	BAU RPS Credit Price by Optimization Pass[Optimization Pass]
	* BAU Marginal Capacity Factor x Hours per Year[Electricity Source,RPS]
	* BAU Elec Portfolio Qualifying Sources[Electricity Source,RPS]
	~	$/MW
	~		|

BAU RPS Steps in Negative Direction[pass1]=
	0 ~~|
BAU RPS Steps in Negative Direction[current pass]=
	IF THEN ELSE(
	  BAU Expected Achievable Annual RPS by Optimization Pass[preceeding pass]
	  > BAU Elec Portfolio Percentage to Seek This Year[RPS],
	
	  BAU RPS Steps in Negative Direction[preceeding pass] + 1,
	
	  0
	)
	~	Dmnl
	~		|

BAU RPS Steps in Positive Direction[pass1]=
	0 ~~|
BAU RPS Steps in Positive Direction[current pass]=
	IF THEN ELSE(
	  BAU Expected Achievable Annual RPS by Optimization Pass[preceeding pass]
	  < BAU Elec Portfolio Percentage to Seek This Year[RPS],
	
	  BAU RPS Steps in Positive Direction[preceeding pass] + 1,
	
	  0
	)
	~	Dmnl
	~		|

BAU RPS Steps in Same Direction[Optimization Pass]=
	MAX(
	  BAU RPS Steps in Positive Direction[Optimization Pass],
	  BAU RPS Steps in Negative Direction[Optimization Pass]
	)
	~	Dmnl
	~		|

BAU Salvageable Curtailed Capacity by Hour for Hybrid Power Plants[Electricity Source\
		,Electricity Timeslice,Hour]=
	MIN(
	  BAU Expected Curtailed Capacity by Hour for Plants Built This Year[Electricity Source\
		,Electricity Timeslice,Hour],
	  HESBCpUEC Hybrid Electricity Source Battery Capacity per Unit Electricity Capacity
	)
	~	Dmnl
	~		|

BAU Schedule Netting Credit from Economic Retirements[Electricity Source]= INTEG (
	Change in BAU Schedule Netting Credit from Economic Retirements[Electricity Source],
		0)
	~	MW
	~		|

BAU Second Tier Guaranteed Dispatch Amount[Electricity Source,Electricity Timeslice,Hour\
		]=
	BAU Guaranteed Dispatch Amount[Electricity Source,Electricity Timeslice,Hour]
	- BAU First Tier Guaranteed Dispatch Amount[Electricity Source,Electricity Timeslice\
		,Hour]
	~	MW*hour
	~		|

BAU Share of Annual Expected Output that Can be Shifted[Electricity Source]=
	SUM(BAU Share of Daily Expected Output that Can be Shifted by Electricity Timeslice[\
		Electricity Source,Electricity Timeslice
	!]*SHELF Days per Electricity Timeslice[Electricity Timeslice!])
	/SUM(SHELF Days per Electricity Timeslice[Electricity Timeslice!])
	~	Dmnl
	~		|

BAU Share of Available Capacity Actually Dispatched by Hour[Electricity Timeslice, Hour\
		]=
	ZIDZ(
	  BAU Total Electricity Dispatched by Hour[Electricity Timeslice,Hour],
	
	  SUM(BAU Available Capacity by Hour[Electricity Source!,Electricity Timeslice,Hour]\
		)*One Hour
	)
	~	Dmnl
	~		~	:SUPPLEMENTARY 
	|

BAU Share of Clinker Production Capacity Built During Model Run[Cement Production Pathway\
		]=
	ZIDZ(
	  BAU Clinker Production Capacity Added During Model Run by Pathway[Cement Production Pathway\
		],
	  BAU Clinker Production Capacity by Pathway[Cement Production Pathway]
	)
	~	Dmnl
	~	BAU twin of Share of Clinker Production Capacity Built During Model Run.
	|

BAU Share of Daily Expected Output that Can be Shifted by Electricity Timeslice[Electricity Source\
		, Electricity Timeslice]=
	MIN(1,
	      ZIDZ((HESBCpUEC Hybrid Electricity Source Battery Capacity per Unit Electricity Capacity
	*GBSC Diurnal Grid Battery Daily Storage Duration),
	      BAU Expected Daily Electricity Output by Electricity Timeslice[Electricity Source
	,Electricity Timeslice]
	     ))
	~	Dmnl
	~		|

BAU Share of Electricity Generation Capacity Built This Year[Electricity Source]=
	ZIDZ(
	
	  SUM((BAU Electricity Generation Capacity by Vintage[Electricity Source,Modeled Vintage\
		!]*This Year Modeled Vintage Flag[Modeled Vintage!])),
	
	  BAU Electricity Generation Capacity[Electricity Source]
	
	)
	~	Dmnl
	~		|

BAU Share of Exports by Hour by Optimization Pass[Electricity Timeslice,Hour,Optimization Pass\
		]=
	ZIDZ(BAU Hourly Export Allocation Weight by Optimization Pass[Electricity Timeslice,\
		Hour,Optimization Pass],
	SUM(BAU Hourly Export Allocation Weight by Optimization Pass[Electricity Timeslice,Hour\
		!,Optimization Pass]))
	~	Dmnl
	~		|

BAU Share of Imports by Hour by Optimization Pass[Electricity Timeslice,Hour,Optimization Pass\
		]=
	ZIDZ(BAU Hourly Import Allocation Weight by Optimization Pass[Electricity Timeslice,\
		Hour,Optimization Pass],SUM(BAU Hourly Import Allocation Weight by Optimization Pass\
		[Electricity Timeslice,Hour!,Optimization Pass]))
	~	Dmnl
	~		|

BAU Share of Max Hourly Exports Met[Electricity Timeslice,Hour,Optimization Pass]=
	ZIDZ(BAU Electricity Exports by Hour[Electricity Timeslice,Hour,Optimization Pass],
	  MaMHEIaE Maximum Hourly Exports)
	~	Dmnl
	~		|

BAU Share of Max Hourly Imports Met[Electricity Timeslice,Hour,Optimization Pass]=
	ZIDZ(BAU Electricity Imports by Hour[Electricity Timeslice,Hour,Optimization Pass],
	  BAU Effective Maximum Hourly Electricity Imports[Electricity Timeslice,Hour])
	~	Dmnl
	~		|

BAU Share of Maximum Annual Decrease in Demand from Diurnal Grid Batteries=
	ZIDZ(
	  BAU Maximum Annual Decrease in Demand from Diurnal Grid Batteries,
	
	  (BAU Maximum Annual Decrease in Demand from Diurnal Grid Batteries
	  + BAU Maximum Annual Decrease in Demand from EVs
	  + BAU Maximum Annual Decrease in Demand from Pumped Hydro
	  + BAU Maximum Annual Decrease in Demand from Seasonal Electricity Storage
	  )
	)
	~	Dmnl
	~		|

BAU Share of New Clinker Production Capacity by Pathway[Cement Production Pathway]=
	ZIDZ(
	  BAU Cement Pathway Choice Weight[Cement Production Pathway],
	  SUM(BAU Cement Pathway Choice Weight[Cement Production Pathway!])
	)
	~	Dmnl
	~	BAU twin of Share of New Clinker Production Capacity by Pathway.
	|

BAU Share of New Industrial Equipment Allocated by Fuel Type in Electricity Equivalent\
		[Industry Category,Industrial Fuel
,Industrial Process] :EXCEPT: [Industry Category,Industrial Fuel,industrial heating process\
		]=
	ZIDZ(
	  BAU Industrial Equipment Fuel Choice Weight[Industry Category,Industrial Fuel,Industrial Process\
		],
	  SUM(BAU Industrial Equipment Fuel Choice Weight[Industry Category,Industrial Fuel!\
		,Industrial Process])
	) ~~|
BAU Share of New Industrial Equipment Allocated by Fuel Type in Electricity Equivalent\
		[Industry Category,Industrial Fuel
,industrial heating process]=
	TBEM Thermal Battery Eligibility Mask[industrial heating process]
	* ZIDZ(
	  BAU Industrial Equipment Fuel Choice Weight[Industry Category,Industrial Fuel,industrial heating process\
		],
	  SUM(BAU Industrial Equipment Fuel Choice Weight[Industry Category,Industrial Fuel!\
		,industrial heating process])
	  + BAU Thermal Battery Choice Weight[Industry Category,industrial heating process]
	)
	+ (1 - TBEM Thermal Battery Eligibility Mask[industrial heating process])
	* ZIDZ(
	  BAU Industrial Equipment Fuel Choice Weight[Industry Category,Industrial Fuel,industrial heating process\
		],
	  SUM(BAU Industrial Equipment Fuel Choice Weight[Industry Category,Industrial Fuel!\
		,industrial heating process])
	)
	~	Dmnl
	~	Using standard "Logit" function as described at \
		https://jgcri.github.io/gcam-doc/choice.html. The heating-process branch \
		includes the BAU thermal battery choice weight; see the policy-case twin \
		for documentation.
	|

BAU Share of New Industrial Equipment by Fuel Type in Electricity Equivalent[Industry Category\
		,Industrial Fuel]=
	ZIDZ(
	  SUM(BAU Output from New Industrial Equipment by Fuel Type and Industrial Process[Industry Category\
		,Industrial Fuel,Industrial Process!]),
	
	  SUM(BAU Output from New Industrial Equipment by Industrial Process[Industry Category\
		,Industrial Process!])
	)
	~	Dmnl
	~		|

BAU Share of New Passenger LDV EV Purchases Requiring Home Charger Installations=
	(1-BAU Last Year Percent Vehicle Stock by Vehicle Technology[LDVs, passenger,battery electric vehicle\
		])
	~	Dmnl
	~		|

BAU Share of Off Grid Electricity Demand That is New This Year Met by Power Plant Type\
		[Electricity Source]=
	ZIDZ(
	
	  (
	    GHESS Green Hydrogen Electricity Supply Shareweights[Electricity Source]
	    * exp(MAX(1, BAU Cost per Unit New Elec Output Using Expected Capacity Factors[Electricity Source\
		]/Cost per Unit New Elec Output Unit Correction Factor)/10^4*GHESLE Green Hydrogen Electricity Supply Logit Exponent
	  )
	  ),
	
	  (
	    SUM(GHESS Green Hydrogen Electricity Supply Shareweights[Electricity Source!]
	    * exp(MAX(1, BAU Cost per Unit New Elec Output Using Expected Capacity Factors[Electricity Source\
		!]/Cost per Unit New Elec Output Unit Correction Factor)/10^4*GHESLE Green Hydrogen Electricity Supply Logit Exponent
	  )
	  )
	)
	)
	~	Dmnl
	~		|

BAU Share of Total Electricity Dispatched by Hour by Plant Type[Electricity Timeslice\
		,Hour,Electricity Source]=
	ZIDZ(BAU Total Electricity Dispatched by Hour by Plant Type[Electricity Timeslice,Hour\
		,Electricity Source]
	, SUM(BAU Total Electricity Dispatched by Hour by Plant Type[Electricity Timeslice,Hour\
		,Electricity Source!]))
	~	Dmnl
	~	BAU twin. ZIDZ guard against zero total dispatch in hours where net \
		imports cover all demand.
	|

BAU Share of Vehicle Charging at Private Chargers[Cargo Type, Vehicle Type] :EXCEPT:  \
		[passenger,LDVs]=
	SoVCaPC Share of Vehicle Charging at Private Chargers[Vehicle Type,Cargo Type] ~~|
BAU Share of Vehicle Charging at Private Chargers[passenger, LDVs]=
	LOOKUP INVERT(
	    SoVCaPC Share of Vehicle Charging at Private Chargers for Passenger LDVs,
	    BAU Last Year Percent Vehicle Stock by Vehicle Technology[LDVs,passenger,battery electric vehicle\
		]
	  )
	~	Dmnl
	~		|

BAU Shortfall in Electricity vs Daily Average by Hour after Seasonal Net Peak Load Reduction\
		[Electricity Timeslice,Hour]=
	MAX(
	  0,
	
	  BAU Daily Average Hourly Spare Potential Output from Surviving Capacity[Electricity Timeslice\
		]
	  - BAU Spare Potential Output from Surviving Capacity by Hour after Seasonal Net Peak Load Reduction\
		[Electricity Timeslice,Hour]
	)
	~	MW*hr
	~		|

BAU Shortfall in Potenial Output from Surviving Capacity vs Annual Average by Hour[Electricity Timeslice\
		,Hour]=
	MAX(
	  0,
	
	  BAU Annual Average Hourly Spare Potential Output from Surviving Capacity
	  - BAU Spare Potential Output from Surviving Capacity by Hour[Electricity Timeslice\
		,Hour]
	)
	~	MW*hr
	~		|

BAU Slope of Line Approaching Future Elec Portfolio Percentages by Year[Future Year,Clean Elec Requirement\
		]=
	IF THEN ELSE(
	  Time > Numerical Future Year Definitions[Future Year]
	  :OR:
	  FINAL TIME < Numerical Future Year Definitions[Future Year]
	  :OR:
	  Time + YoFESHtFRV Years of Foresight Electricity Suppliers Have to Future RPS Values\
		 < Numerical Future Year Definitions[Future Year],
	
	  -9999,
	
	
	    (BAU Weighted Average Elec Portfolio Percentage by Year[Future Year,Clean Elec Requirement\
		]
	      - BAU Elec Portfolio Percentage that Would be Achieved with Only Surviving Plants\
		[Clean Elec Requirement])
	    / (Numerical Future Year Definitions[Future Year] - Time + 1) * One Year
	
	  
	)
	~	Dmnl
	~	We use -9999 for slopes of lines approaching points that are not in the \
		future, because we are going to choose the highest slope to any future \
		point, and we don't want any slopes that are not to future points to be \
		selected.  Note that we haven't built for the current model year yet in \
		the calculation flow, so the current model year counts as being in the \
		future.  Also note that in order to prevent the policy case line from \
		diverging from the BAU line in years prior to the first year policies take \
		effect (which is often a year in the past), we only give electricity \
		producers foresignt to BAU RPS values in years when the additional RPS \
		policy is not in effect (thus mirroring BAU case foresight).
	|

BAU Smoothed Green Hydrogen Cost=
	IF THEN ELSE(
	  Time = INITIAL TIME,
	
	  BAU This Year Green Hydrogen Cost,
	
	  BAU Two Year Average Green Hydrogen Cost
	)
	~	$/BTU
	~		|

BAU Smoothed Low Carbon Hydrogen Cost=
	IF THEN ELSE(
	  Time = INITIAL TIME,
	
	  BAU This Year Low Carbon Hydrogen Cost,
	
	  BAU Two Year Average Low Carbon Hydrogen Cost
	)
	~	$/BTU
	~		|

BAU Smoothed Other Hydrogen Cost=
	IF THEN ELSE(
	  Time = INITIAL TIME,
	
	  BAU This Year Other Hydrogen Cost,
	
	  BAU Two Year Average Other Hydrogen Cost
	)
	~	$/BTU
	~		|

BAU Spare Potential Output from Surviving Capacity by Hour[Electricity Timeslice,Hour\
		]=
	BAU Potential Output from Surviving Capacity by Hour[Electricity Timeslice,Hour]
	- BAU Total Electricity Demand by Hour Before Demand Altering Technologies[Electricity Timeslice\
		,Hour]
	~	MW*hr
	~	This variable must be allowed to become negative to reflect the \
		possibility of a shortfall in a given hour.
	|

BAU Spare Potential Output from Surviving Capacity by Hour after Seasonal Net Peak Load Reduction\
		[Electricity Timeslice,Hour]=
	BAU Potential Output from Surviving Capacity by Hour[Electricity Timeslice,Hour]
	- BAU Total Electricity Demand by Hour after Seasonal Net Peak Load Reduction[Electricity Timeslice\
		,Hour]
	~	MW*hr
	~		|

BAU Spur Line Construction Costs[Electricity Source]=
	BAU New Generation Capacity[Electricity Source]
	* CCaMC Spur Line Construction Cost per Unit Capacity[Electricity Source]
	~	$
	~		|

BAU Start Year Electricity Generation Capacity Summed Across Vintages[Electricity Source\
		]= INITIAL(
	SUM(Start Year Electricity Generation Capacity by Vintage[Electricity Source,Modeled Vintage\
		!]))
	~	MW
	~		|

BAU Start Year Low Carbon Hydrogen Production Shares by Pathway[Hydrogen Production Pathway\
		]=
	IF THEN ELSE(
	  SUM(
	    Hydrogen Production Pathways Qualifying as Low Carbon[Hydrogen Production Pathway\
		!]
	    * SYAHPC Start Year Annual Hydrogen Production Capacity[Hydrogen Production Pathway\
		!]
	  )
	  = 0,
	
	  ZIDZ(
	    Hydrogen Production Pathways Qualifying as Low Carbon[Hydrogen Production Pathway\
		],
	    SUM(
	      Hydrogen Production Pathways Qualifying as Low Carbon[Hydrogen Production Pathway\
		!]
	    )
	  ),
	
	  ZIDZ(
	     SYAHPC Start Year Annual Hydrogen Production Capacity[Hydrogen Production Pathway\
		]
	    * Hydrogen Production Pathways Qualifying as Low Carbon[Hydrogen Production Pathway\
		],
	    SUM(
	      Hydrogen Production Pathways Qualifying as Low Carbon[Hydrogen Production Pathway\
		!]
	      * SYAHPC Start Year Annual Hydrogen Production Capacity[Hydrogen Production Pathway\
		!]
	    )
	  )
	)
	~	Dmnl
	~		|

BAU Start Year Other Hydrogen Production Shares by Pathway[Hydrogen Production Pathway\
		]=
	IF THEN ELSE(
	  SUM(SYAHPC Start Year Annual Hydrogen Production Capacity[Hydrogen Production Pathway\
		!]) = 0,
	
	  ZIDZ(1, ELMCOUNT(Hydrogen Production Pathway)),
	
	  ZIDZ(SYAHPC Start Year Annual Hydrogen Production Capacity[Hydrogen Production Pathway\
		],
	  SUM(SYAHPC Start Year Annual Hydrogen Production Capacity[Hydrogen Production Pathway\
		!]))
	)
	~	Dmnl
	~		|

BAU Subsidies for Elec Production for Existing Plants Paid This Year[Electricity Source\
		]=
	BS BAU Subsidy per Unit Electricity Output for Existing Plants[Electricity Source]
	* BAU Electricity Generation by Type[Electricity Source]
	~	$
	~		|

BAU Subsidies Paid for Grid Battery Production Not Passed Through to Consumers=
	(BAU New Grid Battery Capacity + BPMGBSA BAU Policy Mandated Grid Battery Storage Additions
	  + SUM(BAU New Hybrid Grid Battery Storage Capacity[Electricity Source!]))
	
	* BAU Subsidy for Grid Battery Production Not Passed Through to Consumers
	~	$
	~		|

BAU Subsidies Paid for Grid Battery Production Passed Through to Consumers=
	BAU Subsidy for Grid Battery Production Passed Through to Consumers
	
	*
	
	(BAU New Grid Battery Capacity + BPMGBSA BAU Policy Mandated Grid Battery Storage Additions
	  + SUM(BAU New Hybrid Grid Battery Storage Capacity[Electricity Source!]))
	~	$
	~		|

BAU Subsidies Paid for New Grid Battery Construction=
	(BAU New Grid Battery Capacity+BPMGBSA BAU Policy Mandated Grid Battery Storage Additions\
		)
	* BAU Subsidy per Unit Grid Battery Capacity Deployed
	~	$
	~		|

BAU Subsidies Paid per Unit Electricity Output for Newly Eligible CCS Capacity[Electricity Source\
		]=
	BAU New Generation Capacity[Electricity Source]
	* BAU Expected Capacity Factor x Hours per Year for Plants Built This Year[Electricity Source\
		]
	* BAU CCS Subsidy per MWh[Electricity Source]
	~	$
	~		|

BAU Subsidies Paid per Unit Electricity Output for Newly Eligible Generation Capacity\
		[Electricity Source]=
	BAU New Generation Capacity[Electricity Source]
	* BAU Expected Capacity Factor x Hours per Year for Plants Built This Year[Electricity Source\
		]
	* BS BAU Subsidy per Unit Electricity Output[Electricity Source]
	~	$
	~		|

BAU Subsidy for Grid Battery Production=
	BSfGBP BAU Subsidy for Grid Battery Production
	* FoGBPD Fraction of Grid Batteries Produced Domestically
	~	$/(MW*hr)
	~		|

BAU Subsidy for Grid Battery Production Not Passed Through to Consumers=
	BAU Subsidy for Grid Battery Production
	- BAU Subsidy for Grid Battery Production Passed Through to Consumers
	~	$/(MW*hr)
	~		|

BAU Subsidy for Grid Battery Production Passed Through to Consumers=
	BAU Subsidy for Grid Battery Production
	* FoSfBPPTtC Fraction of Subsidy for Battery Production Passed Through to Consumers
	~	$/(MW*hr)
	~		|

BAU Subsidy for Vehicle Battery Production=
	BSfVBP BAU Subsidy for Vehicle Battery Production
	* FoVBPD Fraction of Vehicle Batteries Produced Domestically
	~	$/(kW*hr)
	~		|

BAU Subsidy for Vehicle Battery Production Passed Through to Consumers=
	BAU Subsidy for Vehicle Battery Production
	* FoSfBPPTtC Fraction of Subsidy for Battery Production Passed Through to Consumers
	~	$/(kW*hr)
	~		|

BAU Subsidy Paid on Distributed Solar Capacity[Building Type]=
	BAU This Year Increase in Distributed Electricity Source Capacity[Building Type,solar PV es\
		]
	* BAU Cost per Unit Distributed Solar Capacity
	* BPSfDSPC BAU Perc Subsidy for Distributed Solar PV Capacity[Building Type]
	~	$
	~		|

BAU Subsidy Payments per Unit Electricity Output Expiring After Subsidy Duration Period\
		[Electricity Source]= DELAY FIXED (
	BAU Subsidies Paid per Unit Electricity Output for Newly Eligible Generation Capacity\
		[Electricity Source], BS Duration of Subsidies per Unit Electricity Output[Electricity Source\
		], 0)
	~	$
	~		|

BAU Subsidy per Unit Electricity Capacity Built[Electricity Source]=
	BS BAU Subsidy per Unit Electricity Capacity Built[Electricity Source]
	*BAU Construction Cost per Unit Capacity before Construction Subsidies[Electricity Source\
		]
	~	$/MW
	~		|

BAU Subsidy per Unit Electricity Output Adjusted for Subsidy Duration[Electricity Source\
		]=
	BS BAU Subsidy per Unit Electricity Output[Electricity Source]
	*BAU Duration Multiplier for Subsidies per Unit Electricity Output[Electricity Source\
		]
	~	$/(MW*hour)
	~		|

BAU Subsidy per Unit Electricity Output for Dispatch[Electricity Source]=
	IF THEN ELSE(
	  BAU Last Year Electricity Generation Capacity[Electricity Source]=0,
	                 
	  BS BAU Subsidy per Unit Electricity Output[Electricity Source],
	
	  ZIDZ(
	
	    SUM(BAU Last Year Electricity Generation Capacity by Vintage[Electricity Source,\
		Modeled Vintage!]
	    * BAU Subsidy per Unit Electricity Output for Dispatch by Vintage[Electricity Source\
		,Modeled Vintage!]),
	
	    BAU Last Year Electricity Generation Capacity[Electricity Source]
	  )
	)
	~	$/(MW*hr)
	~		|

BAU Subsidy per Unit Electricity Output for Dispatch by Vintage[Electricity Source,Modeled Vintage\
		]=
	DEPRECIATE STRAIGHTLINE(
	
	  BS BAU Subsidy per Unit Electricity Output[Electricity Source]
	  * BS Duration of Subsidies per Unit Electricity Output[Electricity Source] / One Year
	  * This Year Modeled Vintage Flag[Modeled Vintage],
	 
	  BS Duration of Subsidies per Unit Electricity Output[Electricity Source],
	
	  1,
	
	  0
	)
	~	$/(MW*hr)
	~		|

BAU Subsidy per Unit Grid Battery Capacity Deployed=
	(BPSpUGBCD BAU Percent Subsidy per Unit Grid Battery Capacity Deployed
	  * BAU Total Battery Cost per Unit Capacity)
	~	$/(MW*hr)
	~		|

BAU Sum of Shareweights by Vehicle and Cargo Type[Vehicle Type,Cargo Type]=
	SUM(
	  TTS Transportation Technology Shareweights[Vehicle Type,Cargo Type,Vehicle Technology\
		!]
	  * BAU Vehicle Technologies Qualifying as ZEVs[Vehicle Type,Vehicle Technology!]
	)
	~	Dmnl
	~		|

BAU Summed CES and RPS Credit Price=
	BAU Optimized CES Credit Price
	+ BAU Optimized RPS Credit Price
	~	$/(MW*hour)
	~		|

BAU Surviving Capacity Available After Green Hydrogen Demand[Hydrogen Production Pathway\
		] :EXCEPT:  [electrolysis with guaranteed clean electricity
]=
	BAU Surviving Hydrogen Production Capacity[Hydrogen Production Pathway] ~~|
BAU Surviving Capacity Available After Green Hydrogen Demand[electrolysis with guaranteed clean electricity\
		]=
	BAU Surviving Hydrogen Production Capacity[electrolysis with guaranteed clean electricity\
		]
	- BAU Surviving Capacity Used for Green Hydrogen Production
	~	BTU
	~		|

BAU Surviving Capacity Available After Low Carbon Hydrogen Demand[Hydrogen Production Pathway\
		]=
	BAU Surviving Capacity Available After Green Hydrogen Demand[Hydrogen Production Pathway\
		]
	- BAU Surviving Capacity Used for Low Carbon Hydrogen Production[Hydrogen Production Pathway\
		]
	~	BTU
	~		|

BAU Surviving Capacity Available for Low Carbon Hydrogen Demand[Hydrogen Production Pathway\
		]=
	BAU Surviving Capacity Available After Green Hydrogen Demand[Hydrogen Production Pathway\
		]
	* Hydrogen Production Pathways Qualifying as Low Carbon[Hydrogen Production Pathway]
	~	BTU
	~		|

BAU Surviving Capacity Used for Green Hydrogen Production=
	MIN(
	  BAU Green Hydrogen Demand,
	  BAU Surviving Green Hydrogen Production Capacity
	)
	~	BTU
	~		|

BAU Surviving Capacity Used for Hydrogen Production[Hydrogen Production Pathway] :EXCEPT:\
		  [electrolysis with guaranteed clean electricity
]=
	BAU Surviving Capacity Used for Low Carbon Hydrogen Production[Hydrogen Production Pathway\
		]
	+ BAU Surviving Capacity Used for Other Hydrogen Production[Hydrogen Production Pathway\
		] ~~|
BAU Surviving Capacity Used for Hydrogen Production[electrolysis with guaranteed clean electricity\
		]=
	BAU Surviving Capacity Used for Green Hydrogen Production
	+ BAU Surviving Capacity Used for Low Carbon Hydrogen Production[electrolysis with guaranteed clean electricity\
		]
	+ BAU Surviving Capacity Used for Other Hydrogen Production[electrolysis with guaranteed clean electricity\
		]
	~	BTU
	~		|

BAU Surviving Capacity Used for Low Carbon Hydrogen Production[Hydrogen Production Pathway\
		]=
	ALLOCATE AVAILABLE(
	  BAU Surviving Capacity Available for Low Carbon Hydrogen Demand[Hydrogen Production Pathway\
		],
	  BAU Hydrogen Production Dispatch Cost Parameters as Vector[Hydrogen Production Pathway\
		,ptype],
	  BAU Total Surviving Capacity Used for Low Carbon Hydrogen Production
	)
	~	BTU
	~		|

BAU Surviving Capacity Used for Other Hydrogen Production[Hydrogen Production Pathway\
		]=
	ALLOCATE AVAILABLE(
	  BAU Surviving Capacity Available After Low Carbon Hydrogen Demand[Hydrogen Production Pathway\
		],
	  BAU Hydrogen Production Dispatch Cost Parameters as Vector[Hydrogen Production Pathway\
		,ptype],
	  BAU Total Surviving Capacity Used for Other Hydrogen Demand
	)
	~	BTU
	~		|

BAU Surviving Electricity Generation Capacity[Electricity Source]=
	BAU Surviving Electricity Generation Capacity before Economic Retirements[Electricity Source\
		]
	- BAU Economic Capacity Retirements by Optimization Pass[Electricity Source,pass20]
	~	MW
	~		|

BAU Surviving Electricity Generation Capacity before Economic Retirements[Electricity Source\
		]=
	MAX(
	  0,
	
	  BAU Last Year Electricity Generation Capacity[Electricity Source]
	  - BAU Capacity Retirements from Schedule[Electricity Source]
	)
	~	MW
	~		|

BAU Surviving Electricity Generation Capacity Except Hydro before Economic Retirements\
		[Electricity Source] :EXCEPT: [hydro es]=
	BAU Surviving Electricity Generation Capacity before Economic Retirements[Electricity Source\
		] ~~|
BAU Surviving Electricity Generation Capacity Except Hydro before Economic Retirements\
		[hydro es]=
	0
	~	MW
	~		|

BAU Surviving Fleet[Vehicle Type,Cargo Type]=
	BAU Last Year Fleet[Vehicle Type,Cargo Type]
	- SUM(BAU Retiring Vehicles[Vehicle Type,Cargo Type,Vehicle Technology!]) * One Year
	~	vehicles
	~		|

BAU Surviving Green Hydrogen Production Capacity=
	BAU Surviving Hydrogen Production Capacity[electrolysis with guaranteed clean electricity\
		]
	~	BTU
	~		|

BAU Surviving Hydro Capacity before Economic Retirements=
	BAU Surviving Electricity Generation Capacity before Economic Retirements[hydro es]
	~	MW
	~		|

BAU Surviving Hydrogen Production Capacity[Hydrogen Production Pathway]=
	BAU Surviving Preexisting Hydrogen Production Capacity[Hydrogen Production Pathway]
	+ BAU Surviving Hydrogen Production Capacity Installed During Model Run[Hydrogen Production Pathway\
		]
	~	BTU
	~		|

BAU Surviving Hydrogen Production Capacity Installed During Model Run[Hydrogen Production Pathway\
		]=
	SUM(
	  BAU Last Year Hydrogen Production Capacity Installed During Model Run by Vintage[Hydrogen Production Pathway\
		,Model Run Vintage!]
	  - BAU Retiring Hydrogen Production Capacity Installed During Model Run by Vintage[\
		Hydrogen Production Pathway,Model Run Vintage!] * One Year
	)
	~	BTU
	~		|

BAU Surviving Potential Elec Portfolio Qualifying Output[Clean Elec Requirement]=
	SUM(
	  BAU Surviving Potential Elec Portfolio Qualifying Output by Hour[Electricity Timeslice\
		!,Hour!,Clean Elec Requirement]
	  * SHELF Days per Electricity Timeslice[Electricity Timeslice!]
	)
	~	MW*hr
	~		|

BAU Surviving Potential Elec Portfolio Qualifying Output by Hour[Electricity Timeslice\
		,Hour,Clean Elec Requirement]=
	MIN(
	  SUM(
	    BAU Surviving Electricity Generation Capacity before Economic Retirements[Electricity Source\
		!]
	    * BAU Last Year Achieved Capacity Factors by Hour[Electricity Timeslice,Hour,Electricity Source\
		!]
	    * BAU Elec Portfolio Qualifying Sources[Electricity Source!,Clean Elec Requirement\
		]
	    * One Hour
	  ),
	
	  BAU Total Electricity Demand by Hour After Demand Altering Technologies[Electricity Timeslice
	,Hour]
	)
	~	MW*hr
	~		|

BAU Surviving Preexisting Hydrogen Production Capacity[Hydrogen Production Pathway]=
	BAU Last Year Preexisting Hydrogen Production Capacity[Hydrogen Production Pathway]
	- BAU Retiring Preexisting Hydrogen Production Capacity[Hydrogen Production Pathway]\
		 * One Year
	~	BTU
	~		|

BAU Taxes Paid by Fuel[All Fuels]=
	BAU Taxes Paid on Buildings Fuels Mapped to All Fuels Subscript[All Fuels]
	+ BAU Taxes Paid on District Heating Fuels Mapped to All Fuels Subscript[All Fuels]
	+ BAU Taxes Paid on Electricity Fuels Mapped to All Fuels Subscript[All Fuels]
	+ BAU Taxes Paid on Hydrogen Sector Fuels Mapped to All Fuels Subscript[All Fuels]
	+ BAU Taxes Paid on Industry Fuels Mapped to All Fuels Subscript[All Fuels]
	+ BAU Taxes Paid on Transportation Fuels Mapped to All Fuels Subscript[All Fuels]
	~	$
	~		|

BAU Taxes Paid on Buildings Fuels Mapped to All Fuels Subscript[All Fuels] :EXCEPT:  \
		[building fuel within all fuels]=
	0 ~~|
BAU Taxes Paid on Buildings Fuels Mapped to All Fuels Subscript[building fuel within all fuels\
		]=
	SUM(BAU Total Tax Paid on Buildings Fuels[Building Type!,Building Fuel])
	~	$
	~		|

BAU Taxes Paid on District Heating Fuels Mapped to All Fuels Subscript[All Fuels] :EXCEPT:\
		  [industrial fuel within all fuels]=
	0 ~~|
BAU Taxes Paid on District Heating Fuels Mapped to All Fuels Subscript[industrial fuel within all fuels\
		] :EXCEPT: [hydrogen]=
	BAU Total Tax Paid on Fuels to Generate Heat[Industrial Fuel] ~~|
BAU Taxes Paid on District Heating Fuels Mapped to All Fuels Subscript[hydrogen]=
	BAU Total Tax Paid on Fuels to Generate Heat[hydrogen if]
	+ BAU Total Tax Paid on Fuels to Generate Heat[green hydrogen if]
	+ BAU Total Tax Paid on Fuels to Generate Heat[low carbon hydrogen if]
	~	$
	~		|

BAU Taxes Paid on Electricity Fuels Mapped to All Fuels Subscript[All Fuels] :EXCEPT:\
		  [electricity source within all fuels]=
	0 ~~|
BAU Taxes Paid on Electricity Fuels Mapped to All Fuels Subscript[electricity source within all fuels\
		] :EXCEPT:    [solar],[wind],[natural gas],[hard coal],[biomass],[lignite],[nuclear\
		],[hydrogen]=
	BAU Total Tax Paid on Electricity Fuels[Electricity Source] ~~|
BAU Taxes Paid on Electricity Fuels Mapped to All Fuels Subscript[solar]=
	BAU Total Tax Paid on Electricity Fuels[solar PV es]
	+ BAU Total Tax Paid on Electricity Fuels[solar thermal es] ~~|
BAU Taxes Paid on Electricity Fuels Mapped to All Fuels Subscript[wind]=
	BAU Total Tax Paid on Electricity Fuels[onshore wind es]
	+ BAU Total Tax Paid on Electricity Fuels[offshore wind es] ~~|
BAU Taxes Paid on Electricity Fuels Mapped to All Fuels Subscript[natural gas]=
	BAU Total Tax Paid on Electricity Fuels[natural gas steam turbine es]
	+ BAU Total Tax Paid on Electricity Fuels[natural gas combined cycle es]
	+ BAU Total Tax Paid on Electricity Fuels[natural gas peaker es]
	+ BAU Total Tax Paid on Electricity Fuels[natural gas combined cycle w CCS es] ~~|
BAU Taxes Paid on Electricity Fuels Mapped to All Fuels Subscript[hard coal]=
	BAU Total Tax Paid on Electricity Fuels[hard coal es]
	+ BAU Total Tax Paid on Electricity Fuels[hard coal w CCS es] ~~|
BAU Taxes Paid on Electricity Fuels Mapped to All Fuels Subscript[biomass]=
	BAU Total Tax Paid on Electricity Fuels[biomass es]
	+ BAU Total Tax Paid on Electricity Fuels[biomass w CCS es] ~~|
BAU Taxes Paid on Electricity Fuels Mapped to All Fuels Subscript[lignite]=
	BAU Total Tax Paid on Electricity Fuels[lignite es]
	+ BAU Total Tax Paid on Electricity Fuels[lignite w CCS es] ~~|
BAU Taxes Paid on Electricity Fuels Mapped to All Fuels Subscript[nuclear]=
	BAU Total Tax Paid on Electricity Fuels[nuclear es]
	+ BAU Total Tax Paid on Electricity Fuels[small modular reactor es] ~~|
BAU Taxes Paid on Electricity Fuels Mapped to All Fuels Subscript[hydrogen]=
	BAU Total Tax Paid on Electricity Fuels[hydrogen combustion turbine es]
	+ BAU Total Tax Paid on Electricity Fuels[hydrogen combined cycle es]
	~	$
	~		|

BAU Taxes Paid on Geoengineering Fuels[Industrial Fuel]=
	QUANTUM(
	  BAU Geoengineering Sector Energy Use[Industrial Fuel]
	  * BAU Geoengineering Fuel Total Tax or Subsidy Amount per Unit Energy[Industrial Fuel\
		],
	
	  QSfCF Quantization Size for Cash Flows
	)
	~	$
	~		|

BAU Taxes Paid on Hydrogen Sector Fuels Mapped to All Fuels Subscript[All Fuels] :EXCEPT:\
		 [industrial fuel within all fuels]=
	0 ~~|
BAU Taxes Paid on Hydrogen Sector Fuels Mapped to All Fuels Subscript[industrial fuel within all fuels\
		] :EXCEPT: [hydrogen]=
	BAU Total Tax Paid on Hydrogen Sector Fuels[Industrial Fuel] ~~|
BAU Taxes Paid on Hydrogen Sector Fuels Mapped to All Fuels Subscript[hydrogen]=
	BAU Total Tax Paid on Hydrogen Sector Fuels[hydrogen if]
	+ BAU Total Tax Paid on Hydrogen Sector Fuels[green hydrogen if]
	+ BAU Total Tax Paid on Hydrogen Sector Fuels[low carbon hydrogen if]
	~	$
	~		|

BAU Taxes Paid on Industry Fuels[Industry Category,Industrial Fuel]=
	BAU Industrial Fuel Use for Energy Purposes[Industry Category,Industrial Fuel]
	  * BAU Industrial Fuel Total Tax or Subsidy Amount per Unit Energy[Industry Category\
		,Industrial Fuel]
	  * (1 - SoFCTiBoSFbI Share of Fuel Consumption That is Byproduct or Secondary Fuels by Industry\
		[Industry Category,Industrial Fuel])
	
	+ BAU Industrial Feedstock Use after Adjustments[Industry Category,Industrial Fuel]
	  * (
	      BAU Industrial Fuel Total Tax or Subsidy Amount per Unit Energy[Industry Category\
		,Industrial Fuel]
	      - BAU Industrial Fuel Carbon Tax Amount per Unit Energy[Industry Category,Industrial Fuel\
		]
	    )
	~	$
	~		|

BAU Taxes Paid on Industry Fuels Mapped to All Fuels Subscript[All Fuels] :EXCEPT:  [\
		industrial fuel within all fuels]=
	0 ~~|
BAU Taxes Paid on Industry Fuels Mapped to All Fuels Subscript[industrial fuel within all fuels\
		] :EXCEPT: [hydrogen]=
	SUM(BAU Taxes Paid on Industry Fuels[Industry Category!,Industrial Fuel]) ~~|
BAU Taxes Paid on Industry Fuels Mapped to All Fuels Subscript[hydrogen]=
	SUM(BAU Taxes Paid on Industry Fuels[Industry Category!,hydrogen if])
	+ SUM(BAU Taxes Paid on Industry Fuels[Industry Category!,green hydrogen if])
	+ SUM(BAU Taxes Paid on Industry Fuels[Industry Category!,low carbon hydrogen if])
	~	$
	~		|

BAU Taxes Paid on Transportation Fuels Mapped to All Fuels Subscript[All Fuels] :EXCEPT:\
		  [transportation fuel within all fuels]=
	0 ~~|
BAU Taxes Paid on Transportation Fuels Mapped to All Fuels Subscript[transportation fuel within all fuels\
		]=
	SUM(BAU Total Tax Paid on Transportation Fuels[Transportation Fuel,Vehicle Type!,Cargo Type\
		!,Vehicle Technology!])
	~	$
	~		|

BAU Thermal Battery Annual Costs and Annual Financing Repayment per Unit Energy in Electricity Equivalent\
		[Industry Category,industrial heating process]=
	(
	  TBCC Thermal Battery Capital Cost per Unit Annual Energy Served[industrial heating process\
		]
	  * BAU Capital Recovery Factor by Industry Fuel and Process[Industry Category,electricity if\
		,industrial heating process]
	  * Industrial Equipment Capital Annuity Factor[Industry Category,industrial heating process\
		]

	  + BAU Thermal Battery Blended Charging Electricity Cost per Unit Energy
	    * Start Year Electric Heating Equipment Effective COP[industrial heating process\
		]
	    / TBRTE Thermal Battery Round Trip Efficiency[industrial heating process]
	    * Industrial Equipment Lifetime Annuity Factor[Industry Category,industrial heating process\
		]
	)
	~	$/BTU
	~	BAU twin of Thermal Battery Annual Costs and Annual Financing Repayment \
		per Unit Energy in Electricity Equivalent. See that variable for \
		documentation (no efficiency-improvement intensity ratio, matching the \
		policy case).
	|

BAU Thermal Battery Blended Charging Electricity Cost per Unit Energy=
	SUM(
	  BAU Thermal Battery Charging Mode Share[Thermal Battery Charging Mode!]
	  * BAU Thermal Battery Electricity Cost by Mode[Thermal Battery Charging Mode!]
	)
	~	$/BTU
	~	BAU twin of Thermal Battery Blended Charging Electricity Cost per Unit \
		Energy.
	|

BAU Thermal Battery Charging Electricity Demand[Industry Category]=
	SUM(
	  BAU Thermal Battery Energy Service[Industry Category,industrial heating process!]
	  * Start Year Electric Heating Equipment Effective COP[industrial heating process!]
	  / TBRTE Thermal Battery Round Trip Efficiency[industrial heating process!]
	)
	~	BTU
	~	BAU twin of Thermal Battery Charging Electricity Demand.
	|

BAU Thermal Battery Charging Electricity Demand by Vintage[Industry Category,Model Run Vintage\
		]=
	SUM(
	  BAU Output from Industrial Equipment Installed During Model Run[Industry Category,\
		industrial heating process!,Model Run Vintage]
	  * BAU Last Year Thermal Battery Shares by Vintage[Industry Category,industrial heating process\
		!,Model Run Vintage]
	  * Start Year Electric Heating Equipment Effective COP[industrial heating process!]
	  / TBRTE Thermal Battery Round Trip Efficiency[industrial heating process!]
	)
	* Start Year Energy Intensity of Industrial Production in Electricity Equivalent[Industry Category\
		]
	~	BTU
	~	BAU twin of Thermal Battery Charging Electricity Demand by Vintage.
	|

BAU Thermal Battery Charging Mode Choice Weight[Thermal Battery Charging Mode]=
	TBMS Thermal Battery Charging Mode Shareweights[Thermal Battery Charging Mode]
	* (
	  MAX(BAU Thermal Battery Electricity Cost by Mode[Thermal Battery Charging Mode], 1e-07\
		)
	  / MAX(
	      VMIN(BAU Thermal Battery Electricity Cost by Mode[Thermal Battery Charging Mode\
		!]),
	      1e-07
	    )
	) ^ TBMLE Thermal Battery Charging Mode Logit Exponent
	~	Dmnl
	~	BAU twin of Thermal Battery Charging Mode Choice Weight.
	|

BAU Thermal Battery Charging Mode Share[Thermal Battery Charging Mode]=
	ZIDZ(
	  BAU Thermal Battery Charging Mode Choice Weight[Thermal Battery Charging Mode],
	  SUM(BAU Thermal Battery Charging Mode Choice Weight[Thermal Battery Charging Mode!\
		])
	)
	~	Dmnl
	~	BAU twin of Thermal Battery Charging Mode Share.
	|

BAU Thermal Battery Charging Mode Share by Vintage[Thermal Battery Charging Mode,Model Run Vintage\
		]=
	IF THEN ELSE(
	  This Year Model Run Vintage Flag[Model Run Vintage] = 1,
	  BAU Thermal Battery Charging Mode Share[Thermal Battery Charging Mode],
	  IF THEN ELSE(
	    Dimensionless Time < Model Run Vintage to Year Mapping[Model Run Vintage],
	    0,
	    BAU Last Year Thermal Battery Charging Mode Share by Vintage[Thermal Battery Charging Mode\
		,Model Run Vintage]
	  )
	)
	~	Dmnl
	~	BAU twin of Thermal Battery Charging Mode Share by Vintage.
	|

BAU Thermal Battery Charging Window[Electricity Timeslice,Hour]=
	IF THEN ELSE(
	  SUM(
	    IF THEN ELSE(
	      BAU Last Year Five Year Average Marginal Dispatch Cost by Hour[Electricity Timeslice\
		,Hour for Comparison!]
	      < BAU Last Year Five Year Average Marginal Dispatch Cost by Hour[Electricity Timeslice\
		,Hour]
	      :OR: (
	        BAU Last Year Five Year Average Marginal Dispatch Cost by Hour[Electricity Timeslice\
		,Hour for Comparison!]
	        = BAU Last Year Five Year Average Marginal Dispatch Cost by Hour[Electricity Timeslice\
		,Hour]
	        :AND: Hour Index[Hour for Comparison!] < Hour Index[Hour]
	      ),
	      1,
	      0
	    )
	  ) < TBCH Thermal Battery Daily Charging Hours,
	  1,
	  0
	)
	~	Dmnl
	~	BAU twin of Thermal Battery Charging Window, ranked on the BAU hourly \
		marginal costs - the BAU and policy charging windows can legitimately \
		select different hours.
	|

BAU Thermal Battery Choice Weight[Industry Category,industrial heating process]=
	10000
	* TBS Thermal Battery Shareweight
	* (
	  MAX(BAU Thermal Battery Annual Costs and Annual Financing Repayment per Unit Energy in Electricity Equivalent\
		[Industry Category,industrial heating process], 1e-07)
	  / MAX(BAU Minimum Eligible Fuel Cost per Unit Energy in Electricity Equivalent[Industry Category\
		,industrial heating process], 1e-07)
	) ^ IELC Industrial Equipment Logit Coefficient
	~	Dmnl
	~	BAU twin of Thermal Battery Choice Weight. See that variable for \
		documentation.
	|

BAU Thermal Battery Demand Cap in Electricity Equivalent[Industry Category,industrial heating process\
		]=
	(
	  SUM(BAU Output from Industrial Equipment Installed During Model Run[Industry Category\
		,industrial heating process,Model Run Vintage!])
	  + BAU Output from New Industrial Equipment[Industry Category,industrial heating process\
		]
	  + BAU Output from Preexisting Industrial Equipment[Industry Category,industrial heating process\
		]
	)
	* Start Year Energy Intensity of Industrial Production in Electricity Equivalent[Industry Category\
		]
	~	BTU
	~	BAU twin of Thermal Battery Demand Cap in Electricity Equivalent.
	|

BAU Thermal Battery Electricity Capacity Construction Cost[Electricity Source]=
	BAU New Off Grid Electricity Capacity Serving Thermal Batteries[Electricity Source]
	* BAU Construction Cost per Unit Capacity before Construction Subsidies[Electricity Source\
		]
	~	$
	~	BAU twin of Thermal Battery Electricity Capacity Construction Cost.
	|

BAU Thermal Battery Electricity Capacity Construction Subsidies Paid[Electricity Source\
		]=
	BAU New Off Grid Electricity Capacity Serving Thermal Batteries[Electricity Source]
	* BAU Subsidy per Unit Electricity Capacity Built[Electricity Source]
	~	$
	~	BAU twin of Thermal Battery Electricity Capacity Construction Subsidies \
		Paid (paid on capacity built this year; see the policy twin's comment).
	|

BAU Thermal Battery Electricity Cost by Mode[tb grid charging]=
	BAU Grid Connected Thermal Battery Electricity Cost per Unit Energy ~~|
BAU Thermal Battery Electricity Cost by Mode[tb off grid charging]=
	BAU Off Grid Thermal Battery Electricity Cost per Unit Energy
	~	$/BTU
	~	BAU twin of Thermal Battery Electricity Cost by Mode.
	|

BAU Thermal Battery Electricity Fixed OM Costs[Electricity Source]=
	BAU Off Grid Electricity Capacity Serving Thermal Batteries[Electricity Source]
	* BAU Weighted Average Annual Fixed OM Cost per Unit Capacity[Electricity Source]
	~	$
	~	BAU twin of Thermal Battery Electricity Fixed OM Costs.
	|

BAU Thermal Battery Electricity Generation Subsidies Paid[Electricity Source]=
	BAU Thermal Battery Off Grid Electricity Demand by Power Plant Type[Electricity Source\
		]
	* BAU Subsidy per Unit Electricity Output Adjusted for Subsidy Duration[Electricity Source\
		]
	~	$
	~	BAU twin of Thermal Battery Electricity Generation Subsidies Paid.
	|

BAU Thermal Battery Electricity Ongoing Capital Costs[Electricity Source]=
	BAU Off Grid Electricity Capacity Serving Thermal Batteries[Electricity Source]
	* BAU Weighted Average Annual Capital Costs per Unit Capacity[Electricity Source]
	~	$
	~	BAU twin of Thermal Battery Electricity Ongoing Capital Costs.
	|

BAU Thermal Battery Electricity Variable OM Costs[Electricity Source]=
	BAU Thermal Battery Off Grid Electricity Demand by Power Plant Type[Electricity Source\
		]
	* BAU Weighted Average Variable OM Cost per Unit Electricity Output[Electricity Source\
		]
	~	$
	~	BAU twin of Thermal Battery Electricity Variable OM Costs.
	|

BAU Thermal Battery Energy Service[Industry Category,industrial heating process]=
	MIN(
	  BAU Thermal Battery Energy Service before Demand Cap[Industry Category,industrial heating process\
		],
	  BAU Thermal Battery Demand Cap in Electricity Equivalent[Industry Category,industrial heating process\
		]
	)
	~	BTU
	~	BAU twin of Thermal Battery Energy Service.
	|

BAU Thermal Battery Energy Service before Demand Cap[Industry Category,industrial heating process\
		]=
	(
	SUM(
	  BAU Output from Industrial Equipment Installed During Model Run[Industry Category,\
		industrial heating process,Model Run Vintage!]
	  * BAU Last Year Thermal Battery Shares by Vintage[Industry Category,industrial heating process\
		,Model Run Vintage!]
	)

	+ BAU Output from New Industrial Equipment[Industry Category,industrial heating process\
		]
	* BAU Thermal Battery Share of New Industrial Equipment[Industry Category,industrial heating process\
		]
	)
	* Start Year Energy Intensity of Industrial Production in Electricity Equivalent[Industry Category\
		]
	~	BTU
	~	BAU twin of Thermal Battery Energy Service before Demand Cap.
	|

BAU Thermal Battery Grid Charging Electricity Demand=
	SUM(
	  BAU Thermal Battery Charging Electricity Demand[Industry Category!]
	  * BAU Thermal Battery Grid Charging Share by Industry[Industry Category!]
	)
	* MWh per BTU
	~	MW*hour
	~	BAU twin of Thermal Battery Grid Charging Electricity Demand.
	|

BAU Thermal Battery Grid Charging Electricity Demand by Hour[Electricity Timeslice,Hour\
		]=
	BAU Thermal Battery Grid Charging Electricity Demand
	* ZIDZ(
	    BAU Thermal Battery Charging Window[Electricity Timeslice,Hour],
	    SUM(
	      BAU Thermal Battery Charging Window[Electricity Timeslice!,Hour!]
	      * SHELF Days per Electricity Timeslice[Electricity Timeslice!]
	    )
	  )
	~	MW*hour
	~	BAU twin of Thermal Battery Grid Charging Electricity Demand by Hour.
	|

BAU Thermal Battery Grid Charging Share by Industry[Industry Category]=
	ZIDZ(
	  SUM(
	    BAU Thermal Battery Charging Electricity Demand by Vintage[Industry Category,Model Run Vintage\
		!]
	    * BAU Thermal Battery Charging Mode Share by Vintage[tb grid charging,Model Run Vintage\
		!]
	  )
	  + BAU Thermal Battery New Charging Electricity Demand[Industry Category]
	    * BAU Thermal Battery Charging Mode Share[tb grid charging],
	  SUM(BAU Thermal Battery Charging Electricity Demand by Vintage[Industry Category,Model Run Vintage\
		!])
	  + BAU Thermal Battery New Charging Electricity Demand[Industry Category]
	)
	~	Dmnl
	~	BAU twin of Thermal Battery Grid Charging Share by Industry.
	|

BAU Thermal Battery Grid Delivery Cost per Unit Electricity=
	ZIDZ(
	  BAU Transmission OM Costs
	  + SYTaDC Start Year Transmission Capital Costs
	  + BAU This Year Ongoing CES Costs,
	  BAU Total Electricity Demand Plus Exports in BTU
	)
	~	$/BTU
	~	BAU twin of Thermal Battery Grid Delivery Cost per Unit Electricity. See \
		that variable for documentation.
	|

BAU Thermal Battery New Charging Electricity Demand[Industry Category]=
	SUM(
	  BAU Thermal Battery New Energy Service[Industry Category,industrial heating process\
		!]
	  * Start Year Electric Heating Equipment Effective COP[industrial heating process!]
	  / TBRTE Thermal Battery Round Trip Efficiency[industrial heating process!]
	)
	~	BTU
	~	BAU twin of Thermal Battery New Charging Electricity Demand.
	|

BAU Thermal Battery New Energy Service[Industry Category,industrial heating process]=
	BAU Output from New Industrial Equipment[Industry Category,industrial heating process\
		]
	* BAU Thermal Battery Share of New Industrial Equipment[Industry Category,industrial heating process\
		]
	* Start Year Energy Intensity of Industrial Production in Electricity Equivalent[Industry Category\
		]
	~	BTU
	~	BAU twin of Thermal Battery New Energy Service.
	|

BAU Thermal Battery Off Grid Capability Requirement=
	SUM(
	  BAU Potential Output from Industrial Equipment Installed During Model Run[Industry Category\
		!,industrial heating process!,Model Run Vintage!]
	  * BAU Last Year Thermal Battery Shares by Vintage[Industry Category!,industrial heating process\
		!,Model Run Vintage!]
	  * Start Year Electric Heating Equipment Effective COP[industrial heating process!]
	  / TBRTE Thermal Battery Round Trip Efficiency[industrial heating process!]
	  * Start Year Energy Intensity of Industrial Production in Electricity Equivalent[Industry Category\
		!]
	  * BAU Thermal Battery Charging Mode Share by Vintage[tb off grid charging,Model Run Vintage\
		!]
	)
	* MWh per BTU
	~	MW*hour
	~	BAU twin of Thermal Battery Off Grid Capability Requirement.
	|

BAU Thermal Battery Off Grid Electricity Demand=
	SUM(
	  BAU Thermal Battery Charging Electricity Demand[Industry Category!]
	  * (1 - BAU Thermal Battery Grid Charging Share by Industry[Industry Category!])
	)
	* MWh per BTU
	~	MW*hour
	~	BAU twin of Thermal Battery Off Grid Electricity Demand.
	|

BAU Thermal Battery Off Grid Electricity Demand by Power Plant Type[Electricity Source\
		]=
	BAU Thermal Battery Off Grid Electricity Demand
	* ZIDZ(
	    BAU Thermal Battery Off Grid Electricity Demand That is New This Year[Electricity Source\
		]
	    + BAU Last Year Cumulative Thermal Battery Off Grid Electricity Demand by Power Plant Type\
		[Electricity Source]
	    - BAU Retired Thermal Battery Off Grid Electricity Demand by Power Plant Type[Electricity Source\
		],
	    SUM(
	      BAU Thermal Battery Off Grid Electricity Demand That is New This Year[Electricity Source\
		!]
	      + BAU Last Year Cumulative Thermal Battery Off Grid Electricity Demand by Power Plant Type\
		[Electricity Source!]
	      - BAU Retired Thermal Battery Off Grid Electricity Demand by Power Plant Type[\
		Electricity Source!]
	    )
	  )
	~	MW*hour
	~	BAU twin of Thermal Battery Off Grid Electricity Demand by Power Plant \
		Type.
	|

BAU Thermal Battery Off Grid Electricity Demand That is New This Year[Electricity Source\
		]=
	MAX(
	  BAU Thermal Battery Off Grid Electricity Demand
	  - SUM(BAU Last Year Cumulative Thermal Battery Off Grid Electricity Demand by Power Plant Type\
		[Electricity Source!]),
	
	  0
	)
	* BAU Share of Off Grid Electricity Demand That is New This Year Met by Power Plant Type\
		[Electricity Source]
	~	MW*hour
	~	BAU twin; see the policy-case equation for the high-water-mark baseline \
		rationale.
	|

BAU Thermal Battery Share of New Industrial Equipment[Industry Category,industrial heating process\
		]=
	TBEM Thermal Battery Eligibility Mask[industrial heating process]
	* ZIDZ(
	  BAU Thermal Battery Choice Weight[Industry Category,industrial heating process],
	  SUM(BAU Industrial Equipment Fuel Choice Weight[Industry Category,Industrial Fuel!\
		,industrial heating process])
	  + BAU Thermal Battery Choice Weight[Industry Category,industrial heating process]
	)
	~	Dmnl
	~	BAU twin of Thermal Battery Share of New Industrial Equipment. See that \
		variable for documentation. (Restored 2026-08-18 after an editing error \
		deleted it along with an adjacent stale variable.)
	|

BAU Thermal Fuel Subsidies Paid[All Fuels,Sectors]=
	(BAU Fuel Production Imports and Exports[All Fuels,production]
	 * ZIDZ(
	     BAU Total Energy Use by Sector[Sectors,All Fuels],
	
	     SUM(BAU Total Energy Use by Sector[Sectors!,All Fuels])
	   )
	)
	* BS BAU Subsidy for Thermal Fuels per Energy Unit Produced[All Fuels,Sectors]
	~	$
	~		|

BAU This Year Battery Capacity Affecting Learning=
	Battery Storage Capacity Outside Modeled Region Affecting Learning
	+ BAU Cumulative Battery Capacity Deployed
	~	MW*hr
	~		|

BAU This Year Battery Cost as Fraction of Last Year Battery Cost=
	(1 - PDiBCpDoC Perc Decline in Battery Cost per Doubling of Capacity)
	^ MAX(0, LN(
	        BAU This Year Battery Capacity Affecting Learning
	        / BAU Last Year Battery Storage Affecting Learning
	      )
	    / LN(2)
	  )
	~	Dmnl
	~		|

BAU This Year Battery Manufacturing Price After Subsidies[Vehicle Type,Cargo Type]=
	BAU This Year Battery Manufacturing Price Before Subsidies by Vehicle Type[Vehicle Type\
		,Cargo Type]
	- BAU Subsidy for Vehicle Battery Production Passed Through to Consumers
	~	$/(kW*hr)
	~		|

BAU This Year Battery Manufacturing Price Before Subsidies=
	IF THEN ELSE(BPP Battery Pack Price > 0,
	
	  BPP Battery Pack Price,
	
	  IF THEN ELSE(BPP Battery Pack Price With One Year Delay > 0,
	
	    BPP Battery Pack Price With One Year Delay
	     * BAU This Year Battery Cost as Fraction of Last Year Battery Cost,
	
	    BAU Last Year Battery Manufacturing Price
	     * BAU This Year Battery Cost as Fraction of Last Year Battery Cost
	  )
	)
	~	$/(kW*hr)
	~		|

BAU This Year Battery Manufacturing Price Before Subsidies by Vehicle Type[Vehicle Type\
		,Cargo Type]=
	BAU This Year Battery Manufacturing Price Before Subsidies
	* BPPM Battery Pack Price Multiplier[Vehicle Type,Cargo Type]
	~	$/(hr*kW)
	~		|

BAU This Year Battery Portion of Vehicle Price[Cargo Type,Vehicle Type,Vehicle Technology\
		]=
	BAU This Year Battery Manufacturing Price After Subsidies[Vehicle Type,Cargo Type]
	* This Year Battery Capacity by Vehicle Type[Cargo Type,Vehicle Type,Vehicle Technology\
		]
	* BPM Battery Pack Markup[Vehicle Type,Cargo Type]
	~	$/vehicle
	~		|

BAU This Year Battery Subsidy Passed Through to Consumers by Vehicle Type[Cargo Type,\
		Vehicle Type,Vehicle Technology]=
	BAU Subsidy for Vehicle Battery Production Passed Through to Consumers
	* This Year Battery Capacity by Vehicle Type[Cargo Type,Vehicle Type,Vehicle Technology\
		]
	~	$/vehicle
	~		|

BAU This Year Capacity Market Repayment=
	DEPRECIATE STRAIGHTLINE(
	
	  BAU Total Capacity Market Costs
	  / One Year,
	 
	  Repayment Period for Capacity Market Charges,
	
	  1,
	
	  0
	)
	~	$/Year
	~		|

BAU This Year CCS Cost as Fraction of Last Year CCS Cost=
	(1 - PDiCECpDoC Perc Decline in CCS Eqpt Cost per Doubling of Capacity)
	^ MAX(0, LN(
	        BAU This Year CO2 Sequestered Affecting Learning
	        / BAU Last Year CO2 Sequestered Affecting Learning
	      )
	    / LN(2)
	  )
	~	Dmnl
	~	In the event we have no CCS in the base year, we do not decline CCS costs \
		based on installed capacity, because we cannot calculate the doublings of \
		capacity from the base year.  Also, we disallow increases in CCS cost, \
		which could otherwise happen if CCS capacity declines in any year relative \
		to the prior year.
	|

BAU This Year CCS Subsidies Paid[Electricity Source]=
	BAU CCS Subsidies Paid per Unit Electricity Output for Newly Eligible CCS Capacity[Electricity Source\
		]
	
	+BAU Last Year CCS Subsidies Paid per Unit Electricity Output for Newly Eligible CCS Capacity\
		[Electricity Source]
	
	- BAU CCS Subsidy Payments per Unit Electricity Output Expiring After CCS Subsidy Duration Period\
		[Electricity Source]
	~	$
	~		|

BAU This Year Change in Hydrogen Produced by Pathway[Hydrogen Production Pathway]=
	BAU Hydrogen Production by Pathway[Hydrogen Production Pathway]
	- BAU Last Year Hydrogen Produced by Pathway[Hydrogen Production Pathway]
	~	BTU
	~		|

BAU This Year CO2 Sequestered[electricity sector]=
	SUM(BAU This Year Pollutants Sequestered by Electricity Sector[CO2,Electricity Source\
		!])
	/ Grams per Metric Ton CO2e
	/ Grams Pollutant per Gram CO2e Unit Converter ~~|
BAU This Year CO2 Sequestered[industry sector]=
	SUM(BAU This Year Pollutants Sequestered by Industry Sector[Industry Category!,CO2,Emissions Type\
		!])
	/ Grams per Metric Ton CO2e
	/ Grams Pollutant per Gram CO2e Unit Converter ~~|
BAU This Year CO2 Sequestered[district heat and hydrogen sector]=
	BAU This Year Pollutants Sequestered by Hydrogen Sector[CO2]
	/ Grams per Metric Ton CO2e
	/ Grams Pollutant per Gram CO2e Unit Converter
	~	metric tons CO2e
	~		|

BAU This Year CO2 Sequestered Affecting Learning=
	This Year CO2 Sequestered Outside Modeled Region Affecting Learning
	+ SUM(BAU Last Year CO2 Sequestered[CCS Sectors!])
	~	metric tons CO2e
	~		|

BAU This Year Cumulative Electricity Generation Capacity Affecting Learning[Electricity Source\
		]=
	BAU Cumulative Electricity Capacity Built as of Last Year[Electricity Source]
	+This Year Global Solar and Wind Capacities Affecting Learning[Electricity Source]
	~	MW
	~		|

BAU This Year Cumulative Policy Mandated Grid Battery Storage=
	BAU Last Year Cumulative Policy Mandated Grid Battery Storage
	+ BPMGBSA BAU Policy Mandated Grid Battery Storage Additions
	~	MW*hour
	~		|

BAU This Year Demand Response Capacity=
	DRC BAU Demand Response Capacity
	+ BAU Demand Responsive Electricity Capacity for Electrolyzers
	~	MW
	~		|

BAU This Year DR Capacity by Provider[Cash Flow Entity] :EXCEPT:  [nonenergy industries\
		]=
	DRC BAU Demand Response Capacity
	* DRCo Share of DR by Provider[Cash Flow Entity] ~~|
BAU This Year DR Capacity by Provider[nonenergy industries]=
	DRC BAU Demand Response Capacity
	* DRCo Share of DR by Provider[nonenergy industries]
	+ BAU Demand Responsive Electricity Capacity for Electrolyzers
	~	MW
	~		|

BAU This Year Energy Related Pollutants Sequestered by Industry Sector[Industry Category\
		,Pollutant] :EXCEPT: [Industry Category,CO2]=
	0 ~~|
BAU This Year Energy Related Pollutants Sequestered by Industry Sector[Industry Category\
		,CO2] :EXCEPT: [cement and other nonmetallic minerals 239,CO2]=
	SUM(BAU Industrial Sector Energy Related Emissions before CCS[Industrial Fuel!,Industry Category\
		,CO2])
	* BAU Fraction of CO2 Captured by Industry[Industry Category,energy related emissions\
		] ~~|
BAU This Year Energy Related Pollutants Sequestered by Industry Sector[cement and other nonmetallic minerals 239\
		,CO2]=
	MAX(
	  0,
	  SUM(BAU Industrial Sector Energy Related Emissions before CCS[Industrial Fuel!,cement and other nonmetallic minerals 239\
		,CO2])
	  - BAU Cement Kiln Combustion CO2 Emissions
	)
	* BAU Fraction of CO2 Captured by Industry[cement and other nonmetallic minerals 239\
		,energy related emissions]
	+ BAU Cement Combustion CO2 Captured by Pathway Capture
	~	g pollutant
	~	BAU twin of This Year Energy Related Pollutants Sequestered by Industry \
		Sector (same cement split).
	|

BAU This Year Financing Repayments for Cement Pathway Equipment=
	BAU Last Year Financing Repayments for Cement Pathway Equipment
	+ BAU Annual Financing Repayment for Newly Purchased Cement Pathway Equipment
	- BAU Annual Cement Pathway Equipment Financing Repayments Expiring After Repayment Period
	~	$
	~	BAU twin of This Year Financing Repayments for Cement Pathway Equipment.
	|

BAU This Year Financing Repayments for Hydrogen Production Eqpt[Hydrogen Production Pathway\
		]=
	BAU Annual Financing Repayments for Newly Purchased Hydrogen Production Eqpt[Hydrogen Production Pathway\
		] * One Year
	+ BAU Last Year Financing Repayments for Hydrogen Production Eqpt[Hydrogen Production Pathway\
		]
	- BAU Annual Financing Repayments for Hydrogen Production Eqpt Expiring This Year[Hydrogen Production Pathway\
		] * One Year
	~	$
	~		|

BAU This Year Financing Repayments for Industrial CCS Equipment[Industry Category]=
	BAU Last Year Financing Repayments for Industrial CCS Equipment[Industry Category]
	+ BAU Annual Financing Repayment for Newly Purchased Industrial CCS Equipment[Industry Category\
		]
	- BAU Annual Industrial CCS Equipment Financing Repayments Expiring After Repayment Period\
		[Industry Category]
	~	$
	~		|

BAU This Year Financing Repayments for Industrial Equipment[Industry Category] :EXCEPT:\
		 [cement and other nonmetallic minerals 239]=
	SUM(
	  BAU Annual Financing Repayment for Newly Purchased Industrial Equipment[Industry Category\
		,Industrial Process!]
	  + BAU Last Year Financing Repayments for Industrial Equipment[Industry Category,Industrial Process\
		!]
	  - BAU Annual Industrial Equipment Financing Repayments Expiring After Repayment Period\
		[Industry Category,Industrial Process!]
	) ~~|
BAU This Year Financing Repayments for Industrial Equipment[cement and other nonmetallic minerals 239\
		]=
	SUM(
	  BAU Annual Financing Repayment for Newly Purchased Industrial Equipment[cement and other nonmetallic minerals 239\
		,Industrial Process!]
	  + BAU Last Year Financing Repayments for Industrial Equipment[cement and other nonmetallic minerals 239\
		,Industrial Process!]
	  - BAU Annual Industrial Equipment Financing Repayments Expiring After Repayment Period\
		[cement and other nonmetallic minerals 239,Industrial Process!]
	)
	+ BAU This Year Financing Repayments for Cement Pathway Equipment
	~	$
	~	The cement and other nonmetallic minerals 239 branch adds the BAU cement \
		pathway equipment ladder.
	|

BAU This Year Fraction of Initial Industrial Equipment Retired[Industry Category,Industrial Process\
		]=
	BAU Fraction of All Preexisting Equipment Retired[Industry Category,Industrial Process\
		]
	- BAU Last Year Fraction of All Preexisting Equipment Retired[Industry Category,Industrial Process\
		]
	~	Dmnl
	~		|

BAU This Year Green Hydrogen Cost=
	BAU Cost per Unit New Hydrogen Production[electrolysis with guaranteed clean electricity\
		]
	~	$/BTU
	~		|

BAU This Year Grid Battery Storage Capacity excluding Hybrid Batteries=
	BAU Last Year Grid Battery Storage Capacity excluding Hybrid Batteries
	+ BAU New Grid Battery Capacity
	~	MW*hour
	~		|

BAU This Year Grid Battery Storage Capacity excluding Hybrid Batteries in MW=
	BAU This Year Total Grid Battery Storage Capacity excluding Hybrid Batteries
	/ GBSC Diurnal Grid Battery Daily Storage Duration
	~	MW
	~		|

BAU This Year Grid Battery Storage Capacity in MW=
	(BAU This Year Total Grid Battery Storage Capacity excluding Hybrid Batteries + SUM(\
		BAU This Year Hybrid Grid Battery Storage Capacity
	[Electricity Source!]))
	/ GBSC Diurnal Grid Battery Daily Storage Duration
	~	MW
	~		|

BAU This Year Hybrid Grid Battery Storage Capacity[Electricity Source]=
	BAU Last Year Hybrid Grid Battery Storage Capacity[Electricity Source]
	+ BAU New Hybrid Grid Battery Storage Capacity[Electricity Source]
	~	MW*hour
	~		|

BAU This Year Hybrid Grid Battery Storage Capacity in MW=
	SUM(BAU This Year Hybrid Grid Battery Storage Capacity[Electricity Source!])
	/ GBSC Diurnal Grid Battery Daily Storage Duration
	~	MW
	~		|

BAU This Year Increase in Distributed Electricity Source Capacity[Building Type,Electricity Source\
		]=
	MAX(
	  0,
	
	  BAU Distributed Electricity Source Capacity[Building Type,Electricity Source]
	  - Last Year BAU Distributed Electricity Source Capacity[Building Type,Electricity Source\
		]
	)
	~	MW
	~		|

BAU This Year Increase in Pollutants Sequestered by Hydrogen Sector[Pollutant]=
	MAX(
	  0,

	  BAU This Year Pollutants Sequestered by Hydrogen Sector[Pollutant]
	  - BAU Last Year Potential Pollutants Sequestered by Hydrogen Sector[Pollutant]
	)
	~	g pollutant
	~	BAU twin of the capacity-based new sequestration purchase logic, needed so \
		the policy-minus-BAU capital cost delta compares like with like.
	|

BAU This Year Increase in Pollutants Sequestered by Industry Sector[Industry Category\
		 ,Pollutant,Emissions Type] :EXCEPT: [cement and other nonmetallic minerals 239,CO2\
		,Emissions Type]=
	
	  MAX(
	    0,
	
	    BAU This Year Pollutants Sequestered by Industry Sector[Industry Category,Pollutant\
		 ,Emissions Type]
	    - BAU Last Year Potential Pollutants Sequestered by Industry Sector[Industry Category\
		,Pollutant ,Emissions Type]
	  ) ~~|
BAU This Year Increase in Pollutants Sequestered by Industry Sector[cement and other nonmetallic minerals 239\
		 ,CO2,Emissions Type]=
	MAX(
	  0,
	  BAU This Year Pollutants Sequestered by Industry Sector[cement and other nonmetallic minerals 239\
		 ,CO2,Emissions Type]
	  - BAU Last Year Potential Pollutants Sequestered by Industry Sector[cement and other nonmetallic minerals 239\
		 ,CO2,Emissions Type]
	  - BAU Cement Module Change in CO2 Captured by Emissions Type[Emissions Type]
	)
	~	g pollutant
	~	BAU twin of This Year Increase in Pollutants Sequestered by Industry \
		Sector (same cement exclusion).
	|

BAU This Year Low Carbon Hydrogen Cost=
	ZIDZ(
	  SUM(
	    BAU Cost per Unit New Hydrogen Production[Hydrogen Production Pathway!]
	    * BAU Last Year Low Carbon Hydrogen Production Shares by Pathway[Hydrogen Production Pathway\
		!]
	  ),
	
	  SUM(BAU Last Year Low Carbon Hydrogen Production Shares by Pathway[Hydrogen Production Pathway\
		!])
	)
	~	$/BTU
	~		|

BAU This Year Ongoing CCS Subsidies Paid per Unit Electricity Output[Electricity Source\
		]=
	BAU Subsidies Paid per Unit Electricity Output for Newly Eligible CCS Capacity[Electricity Source\
		]
	
	+BAU Last Year Subsidies Paid per Unit Electricity Output for Newly Eligible CCS Capacity\
		[Electricity Source]
	~	$
	~		|

BAU This Year Ongoing CES Costs=
	BAU CES Costs for Incremental Capacity Additions
	+BAU Last Year Ongoing CES Costs
	+SUM(BAU CES Costs for ACP Compliance[Clean Elec Requirement!])
	-BAU CES Costs for Incremental Capacity Additions after Financial Lifetime
	~	$
	~		|

BAU This Year Ongoing Repayment for Buildings Sector Financed Capital Expenses[Building Type\
		]=
	BAU Annual Repayment for Financed Buildings Sector Capital Expenses[Building Type]
	
	+BAU Last Year Repayment for Financed Buildings Sector Capital Expenses[Building Type\
		]
	~	$
	~		|

BAU This Year Ongoing Subsidies Paid per Unit Electricity Output[Electricity Source]=
	BAU Subsidies Paid per Unit Electricity Output for Newly Eligible Generation Capacity\
		[Electricity Source]
	
	+BAU Last Year Subsidies Paid per Unit Electricity Output for Newly Eligible Generation Capacity\
		[Electricity Source]
	
	- BAU Subsidy Payments per Unit Electricity Output Expiring After Subsidy Duration Period\
		[Electricity Source]
	~	$
	~		|

BAU This Year Other Hydrogen Cost=
	ZIDZ(
	  SUM(
	    BAU Last Year Other Hydrogen Production Shares by Pathway[Hydrogen Production Pathway\
		!]
	    * BAU Cost per Unit New Hydrogen Production[Hydrogen Production Pathway!]
	  ),
	
	  SUM(BAU Last Year Other Hydrogen Production Shares by Pathway[Hydrogen Production Pathway\
		!])
	)
	~	$/BTU
	~		|

BAU This Year Pollutants Sequestered by Electricity Sector[Pollutant,Electricity Source\
		] :EXCEPT:   [CO2,Electricity Source
]=
	0 ~~|
BAU This Year Pollutants Sequestered by Electricity Sector[CO2,Electricity Source]=
	BAU Electricity Generation by Type[Electricity Source]
	* BAU Metric Tons CO2 Stored per MWh[Electricity Source]
	* Grams per Metric Ton CO2e
	* Grams Pollutant per Gram CO2e Unit Converter
	~	g pollutant
	~		|

BAU This Year Pollutants Sequestered by Hydrogen Sector[Pollutant] :EXCEPT: [CO2]=
	0 ~~|
BAU This Year Pollutants Sequestered by Hydrogen Sector[CO2]=
	SUM(BAU Hydrogen Sector Fuel Use by Pathway[natural gas reforming with CCS,Industrial Fuel\
		!]
	* Industrial Fuel Pollutant Emissions Intensities This Year[cement and other nonmetallic minerals 239\
		,CO2,Industrial Fuel!])
	* CCP CO2 Capture Potential by Hydrogen Sector
	~	g pollutant
	~	We use the cement sector as a representative sector from which to source \
		pollutant emissions intensities for this variable.
	|

BAU This Year Pollutants Sequestered by Industry Sector[Industry Category,Pollutant,energy related emissions\
		]=
	BAU This Year Energy Related Pollutants Sequestered by Industry Sector[Industry Category\
		,Pollutant] ~~|
BAU This Year Pollutants Sequestered by Industry Sector[Industry Category,Pollutant,process emissions\
		]=
	BAU This Year Process Pollutants Sequestered by Industry Sector[Industry Category,Pollutant\
		]
	~	g pollutant
	~		|

BAU This Year Pretax Electricity Price by Sector[Sectors]=
	MAX(0,
	  
	 IF THEN ELSE(
	  
	  Time=INITIAL TIME,
	  
	  Start Year Electricity Prices by Sector[Sectors],
	
	  BAU Last Year Electricity Supplier Expenditures after Subsidies per Unit Electricity Produced
	  + Last Year Additional Retail Electricity Costs per Unit Electricity Produced[Sectors\
		]
	  
	 )
	)
	~	$/BTU
	~		|

BAU This Year Process Pollutants Sequestered by Industry Sector[Industry Category,Pollutant\
		] :EXCEPT: [Industry Category,CO2]=
	0 ~~|
BAU This Year Process Pollutants Sequestered by Industry Sector[Industry Category,CO2\
		] :EXCEPT: [cement and other nonmetallic minerals 239,CO2]=
	BAU Process Emissions before CCS[Industry Category,CO2]
	* BAU Fraction of CO2 Captured by Industry[Industry Category,process emissions] ~~|
BAU This Year Process Pollutants Sequestered by Industry Sector[cement and other nonmetallic minerals 239\
		,CO2]=
	(BAU Process Emissions before CCS[cement and other nonmetallic minerals 239,CO2]
	 - BAU Cement Process CO2 Emissions)
	* BAU Fraction of CO2 Captured by Industry[cement and other nonmetallic minerals 239\
		,process emissions]
	+ BAU Cement Process CO2 Captured by Pathway Capture
	~	g pollutant
	~		|

BAU This Year Solar and Wind Hard Costs as Fraction of Last Year Hard Costs[Electricity Source\
		] :EXCEPT:     [onshore wind es
],[solar PV es],[offshore wind es]=
	0 ~~|
BAU This Year Solar and Wind Hard Costs as Fraction of Last Year Hard Costs[onshore wind es\
		]=
	(1 - PDiCCpDoC Perc Decline in Capacity Cost per Doubling of Capacity[onshore wind es\
		])
	^ MAX(0, LN(
	        BAU This Year Cumulative Electricity Generation Capacity Affecting Learning[\
		onshore wind es]
	        / BAU Last Year Cumulative Electricity Generation Capacity Affecting Learning\
		[onshore wind es]
	      )
	    / LN(2)
	  ) ~~|
BAU This Year Solar and Wind Hard Costs as Fraction of Last Year Hard Costs[solar PV es\
		]=
	(1 - PDiCCpDoC Perc Decline in Capacity Cost per Doubling of Capacity[solar PV es])
	^ MAX(0, LN(
	        BAU This Year Cumulative Electricity Generation Capacity Affecting Learning[\
		solar PV es]
	        / BAU Last Year Cumulative Electricity Generation Capacity Affecting Learning\
		[solar PV es]
	      )
	    / LN(2)
	  ) ~~|
BAU This Year Solar and Wind Hard Costs as Fraction of Last Year Hard Costs[offshore wind es\
		]=
	(1 - PDiCCpDoC Perc Decline in Capacity Cost per Doubling of Capacity[offshore wind es\
		])
	^ MAX(0, LN(
	        BAU This Year Cumulative Electricity Generation Capacity Affecting Learning[\
		offshore wind es]
	        / BAU Last Year Cumulative Electricity Generation Capacity Affecting Learning\
		[offshore wind es]
	      )
	    / LN(2)
	  )
	~	Dmnl
	~		|

BAU This Year Total Grid Battery Storage Capacity excluding Hybrid Batteries=
	BAU This Year Grid Battery Storage Capacity excluding Hybrid Batteries
	+ BAU This Year Cumulative Policy Mandated Grid Battery Storage
	~	MW*hour
	~		|

BAU This Year Total Grid Battery Storage Capacity excluding Hybrid Batteries in MW=
	BAU This Year Total Grid Battery Storage Capacity excluding Hybrid Batteries
	/ GBSC Diurnal Grid Battery Daily Storage Duration
	~	MW
	~		|

BAU Three Year Average CF Scaling Revenue for Cost Driven Retirement[Electricity Source\
		]=
	IF THEN ELSE(Time = INITIAL TIME,
	  BAU CF Scaling Revenue per Unit Capacity for Cost Driven Retirement[Electricity Source\
		],
	  IF THEN ELSE(Time = INITIAL TIME + 1,
	    (BAU CF Scaling Revenue per Unit Capacity for Cost Driven Retirement[Electricity Source\
		]
	     + BAU Last Year CF Scaling Revenue per Unit Capacity for Cost Driven Retirement\
		[Electricity Source]) / 2,
	    (BAU CF Scaling Revenue per Unit Capacity for Cost Driven Retirement[Electricity Source\
		]
	     + BAU Last Year CF Scaling Revenue per Unit Capacity for Cost Driven Retirement\
		[Electricity Source]
	     + BAU Two Years Prior CF Scaling Revenue per Unit Capacity for Cost Driven Retirement\
		[Electricity Source]) / 3))
	~	$/MW
	~		|

BAU Three Year Average Fleet Generation Hours for Cost Driven Retirement[Electricity Source\
		]=
	IF THEN ELSE(Time = INITIAL TIME,
	  BAU Fleet Average Generation Hours for Cost Driven Retirement[Electricity Source],
	  IF THEN ELSE(Time = INITIAL TIME + 1,
	    (BAU Fleet Average Generation Hours for Cost Driven Retirement[Electricity Source\
		]
	     + BAU Last Year Fleet Average Generation Hours for Cost Driven Retirement[Electricity Source\
		]) / 2,
	    (BAU Fleet Average Generation Hours for Cost Driven Retirement[Electricity Source\
		]
	     + BAU Last Year Fleet Average Generation Hours for Cost Driven Retirement[Electricity Source\
		]
	     + BAU Two Years Prior Fleet Average Generation Hours for Cost Driven Retirement\
		[Electricity Source]) / 3))
	~	hours
	~		|

BAU Three Year Average Net Energy Market Revenue by Plant Type Excluding Subsidies for Hybrid Power Plants\
		[Hybrid Electricity Source]=
	DEPRECIATE STRAIGHTLINE(
	 BAU One Year Average Net Energy Market Revenue by Plant Type Excluding Subsidies for Hybrid Power Plants\
		[Hybrid Electricity Source],
	 3,
	 1,
	 0
	)
	~	$/MW
	~		|

BAU Three Year Average Total Predicted Net Energy Market Revenue per MW[Electricity Source\
		]=
	DEPRECIATE STRAIGHTLINE(
	 BAU Last Year Five Year Average Annual Net Revenue per MW by Power Plant Type[Electricity Source\
		], 
	 3, 
	 1, 
	 0
	)
	~	$/MW
	~		|

BAU Three Year Average Wholesale Energy Market Costs=
	DEPRECIATE STRAIGHTLINE(
	 BAU One Year Average Wholesale Energy Market Costs,
	 3,
	 1,
	 0
	)
	~	$
	~		|

BAU Three Year Weighted Average Hypothetical Electricity Capacity Factor[Electricity Timeslice\
		,Hour,Electricity Source]=
	(BAU Last Year Hypothetical Hourly Electricity Capacity Factor[Electricity Timeslice\
		,Hour,Electricity Source]
	+ BAU Two Years Prior Hypothetical Hourly Electricity Capacity Factor[Electricity Timeslice\
		,Hour,Electricity Source]
	+ BAU Three Years Prior Hypothetical Hourly Electricity Capacity Factor[Electricity Timeslice\
		,Hour,Electricity Source]
	)
	/3
	~	Dmnl
	~		|

BAU Three Years Prior Hypothetical Hourly Electricity Capacity Factor[Electricity Timeslice\
		,Hour,Electricity Source]= DELAY FIXED (
	BAU Two Years Prior Hypothetical Hourly Electricity Capacity Factor[Electricity Timeslice\
		,Hour,Electricity Source],
	1,
	SYSHECF Start Year Seasonal Expected Hourly Electricity Capacity Factors[Electricity Source\
		,Electricity Timeslice,Hour]
	* RAF Regional Availability Factor for Generation[Electricity Source])
	~	Dmnl
	~		|

BAU Total Annual Recoverable Costs for Cost of Service Rates=
	QUANTUM(
	  BAU Total Cost of Power Generation
	  +BAU Annual Cost Recovery for Capacity Construction and Retrofits
	  +BAU Annual Cost to Keep Generation Capacity Online Past Repayment Period
	  +BAU Total Cost of Transmission Distribution Storage and Other,
	
	  Quantization Size for Dollars
	)
	~	$
	~		|

BAU Total Annual Vehicle Costs[Vehicle Type,Cargo Type,Vehicle Technology]=
	BAU Annual Fuel Expenditures for a Vehicle Sold This Year[Vehicle Type,Cargo Type,Vehicle Technology\
		]
	+ AVMC Annual Vehicle Maintenance Cost[Vehicle Type,Cargo Type,Vehicle Technology]
	+ AVIC Annual Vehicle Insurance Cost[Vehicle Type,Vehicle Technology,Cargo Type]
	+ AVPC Annual Vehicle Parking Cost[Vehicle Type,Cargo Type]
	+ AVLRaPTC Annual Vehicle Licensing Registration and Property Tax Costs[Cargo Type,Vehicle Technology\
		,Vehicle Type]
	~	$/vehicle
	~		|

BAU Total Battery Cost per Unit Capacity=
	BAU Battery Energy Cost per Unit Capacity
	+ BAU Battery Power Cost per Unit Capacity
	  / GBSC Diurnal Grid Battery Daily Storage Duration
	~	$/(MW*hour)
	~		|

BAU Total Capacity Market Costs=
	(SUM(BAU Annual Capacity Market Costs for Seasonal Dispatchable Reliability[Electricity Source\
		!])
	   + BAU Capacity Market Costs for Diurnal Storage
	)
	~	$
	~		|

BAU Total Carbon Tax Revenue=
	SUM(BAU Transportation Sector Carbon Tax Revenue[Vehicle Type!,Cargo Type!])
	+ BAU Electricity Sector Carbon Tax Revenue
	+ BAU Buildings Sector Carbon Tax Revenue
	+ SUM(BAU Industry Sector Carbon Tax Revenue[Industry Category!])
	+ BAU District Heat Sector Carbon Tax Revenue
	+ BAU Hydrogen Sector Carbon Tax Revenue
	+ BAU Geoengineering Sector Carbon Tax Revenue
	~	$
	~		|

BAU Total Cement Demand=
	BCD BAU Cement Demand
	* (1 + Perc Change in Sectoral Energy Use due to Exogenous GDP Adjustment[industry sector\
		])
	~	metric tons/Year
	~	Total BAU cement demand on the apparent-CONSUMPTION basis (production + \
		imports - exports, USGS definition for the US; changed 2026-09-28 from \
		domestic production), scaled by the exogenous GDP adjustment so the EGGRA \
		control setting reaches cement like every other industry (steel review \
		finding, P23). The BAU series itself follows the AEO cement-and-lime \
		value-of-shipments index, the same AEO table the IO model's BAU 239 output \
		growth is built from, so tons and dollars move together. The policy-case \
		demand builds on this, so both cases carry the adjustment symmetrically. \
		Net imports come out downstream at Domestic Clinker Demand, so only \
		in-region production drives capacity, energy, and emissions. Pathway \
		attribution is endogenous (the cost logit, calibrated to start-year data \
		via SYCPbP and the CPSW shareweights), so only total demand is exogenous.
	|

BAU Total Change in Energy Market and CES Revenue for CCUS Retrofits[CCUS Electricity Source\
		, Optimization Pass,RPS]=
	BAU Predicted Change in Energy Market Revenue for CCUS Retrofits[CCUS Electricity Source\
		]
	+ BAU RPS Revenue at Marginal Capacity Factor by Optimization Pass[Optimization Pass\
		,CCUS Electricity Source]
	- BAU RPS Revenue at Marginal Capacity Factor by Optimization Pass[Optimization Pass\
		,CCUS Source Electricity Source] ~~|
BAU Total Change in Energy Market and CES Revenue for CCUS Retrofits[CCUS Electricity Source\
		,Optimization Pass,CES]=
	BAU Predicted Change in Energy Market Revenue for CCUS Retrofits[CCUS Electricity Source\
		]
	+ SUM(BAU RPS Revenue at Marginal Capacity Factor by Optimization Pass[last pass!,CCUS Electricity Source\
		])
	+ BAU CES Revenue at Marginal Capacity Factor by Optimization Pass[Optimization Pass\
		,CCUS Electricity Source]
	- SUM(BAU RPS Revenue at Marginal Capacity Factor by Optimization Pass[last pass!,CCUS Source Electricity Source\
		])
	- BAU CES Revenue at Marginal Capacity Factor by Optimization Pass[Optimization Pass\
		,CCUS Source Electricity Source]
	~	$/MW
	~		|

BAU Total Clinker Capacity Overhauled by Pathway[Cement Production Pathway]=
	BAU Preexisting Clinker Capacity Overhauled by Pathway[Cement Production Pathway]
	+ BAU Model Run Clinker Capacity Overhauled by Pathway[Cement Production Pathway]
	~	metric tons/Year
	~	BAU twin of Total Clinker Capacity Overhauled by Pathway.
	|

BAU Total Clinker Capacity Retired by Pathway[Cement Production Pathway]=
	BAU Model Run Clinker Capacity Retirements by Pathway[Cement Production Pathway]
	+ BAU Preexisting Clinker Capacity Retirements by Pathway[Cement Production Pathway]
	~	metric tons/Year
	~	BAU twin of Total Clinker Capacity Retired by Pathway.
	|

BAU Total Clinker Demand=
	BAU Total Cement Demand * BAU Clinker to Cement Ratio
	~	metric tons/Year
	~	All clinker embodied in BAU cement consumption, including the share that \
		arrives as imported cement or clinker. The module's physical chain runs on \
		clinker (not cement) tons because clinker production, not final grinding \
		and blending, is where the pathway choice and kiln energy occur - but it \
		runs on BAU Domestic Clinker Demand, the in-region slice of this total.
	|

BAU Total CO2e Emissions=
	SUM(
	  BAU Total Pollutant Emissions[Pollutant!]
	  * GWP by Pollutant[Pollutant!])
	~	g CO2e
	~		|

BAU Total CO2e Emissions by Sector[Sectors]=
	SUM(
	  BAU Total Pollutant Emissions by Sector[Sectors,Pollutant!]
	  * GWP by Pollutant[Pollutant!]
	)
	~	g CO2e
	~		~	:SUPPLEMENTARY 
	|

BAU Total CO2e Emissions by Sector and Pollutant[Sectors,Pollutant]=
	BAU Total Pollutant Emissions by Sector[Sectors,Pollutant]
	  * GWP by Pollutant[Pollutant]
	~	g CO2e
	~		~	:SUPPLEMENTARY 
	|

BAU Total Cost of Power Generation=
	BAU Generation Costs
	+BAU Amount Spent on Importing Electricity
	+SUM(BAU Electricity Sector CCS Transportation and Storage Costs[Electricity Source!\
		])
	+BAU This Year Ongoing CES Costs
	-SUM(BAU Electricity Sector Carbon Tax Rebate due to CCS[Electricity Source!])
	-SUM(BAU This Year CCS Subsidies Paid[Electricity Source!])
	-SUM(BAU This Year Ongoing Subsidies Paid per Unit Electricity Output[Electricity Source\
		!])
	~	$
	~		|

BAU Total Cost of Transmission Distribution Storage and Other=
	QUANTUM(
	  BAU Repayment of Financing for Change in Electricity Sector Capital Expenditures including Construction Subsidies
	  +BAU Electricity Supplier Other Expenditures
	  +BAU Electricity Transmission and Distribution OM Expenditures
	  +SYTaDC Start Year Transmission Capital Costs
	  +SYTaDC Start Year Distribution Capital Costs,
	
	  Quantization Size for Dollars
	)
	~	$
	~		|

BAU Total Deployed and Under Construction CCS[Industry Category,Emissions Type]=
	BAU Last Year Total Deployed and Under Construction CCS[Industry Category,Emissions Type\
		]
	+ BAU CCS Retrofit Capacity Construction Started This Year[Industry Category,Emissions Type\
		]
	~	Dmnl
	~		|

BAU Total District Heat Use=
	(
	  SUM(BAU Building Components Energy Use[Building Type!,heat bf,Building Component!]\
		)
	  + SUM(BAU Industrial Fuel Use[heat if,Industry Category!])
	)
	/ (1 - HDL Heat Distribution Losses)
	~	BTU
	~		|

BAU Total District Heat Use by Fuel before CHP[Industrial Fuel]=
	BAU Total District Heat Use
	* BFoHPbF BAU Fraction of Heat Provided by Fuel[Industrial Fuel]
	~	BTU
	~		|

BAU Total Electricity Demand=
	SUM(BAU Transportation Sector Electricity Demand[Vehicle Type!,Cargo Type!])
	+ SUM(BAU Buildings Sector Electricity Demand[Building Type!,Building Component!])
	+ BAU Industrial Sector Electricity Demand
	+ BAU District Heat Electricity Demand
	+ BAU Hydrogen Sector Grid Electricity Demand
	+ BAU Geoengineering Sector Electricity Demand
	+ BAU Thermal Battery Grid Charging Electricity Demand
	~	MW*hour
	~		|

BAU Total Electricity Demand after TnD Losses and Own Use=
	BAU Total Electricity Demand
	+(BAU Total Electricity Demand*BTaDLP BAU Transmission and Distribution Loss Percentage\
		)
	+(BAU Total Electricity Demand*BPPEOUP BAU Power Plant Electricity Own Use Percentage\
		)
	~	MW*hr
	~		|

BAU Total Electricity Demand by Hour After Demand Altering Technologies[Electricity Timeslice
,Hour]=
	BAU Total Electricity Demand by Hour Before Demand Altering Technologies[Electricity Timeslice\
		,Hour]
	+ BAU Change in Electricity Demand from Demand Altering Technologies for Net Peak Load Reduction\
		[Electricity Timeslice,Hour]
	~	MW*hr
	~		|

BAU Total Electricity Demand by Hour after Seasonal Net Peak Load Reduction[Electricity Timeslice\
		,Hour]=
	MAX(
	  0,
	
	  BAU Total Electricity Demand by Hour Before Demand Altering Technologies[Electricity Timeslice\
		,Hour]
	  + BAU Increase in Demand by Hour for Seasonal Net Peak Load Reduction[Electricity Timeslice\
		,Hour]
	  - BAU Decrease in Demand by Hour for Seasonal Net Peak Load Reduction[Electricity Timeslice\
		,Hour]
	)
	~	MW*hr
	~		|

BAU Total Electricity Demand by Hour Before Demand Altering Technologies[Electricity Timeslice\
		,Hour]=
	MAX(
	  0,
	
	  BAU Total Electricity Demand by Hour before Net Imports[Electricity Timeslice,Hour\
		]
	  + SUM(BAU Electricity Exports by Hour[Electricity Timeslice,Hour,last pass!])
	  - SUM(BAU Electricity Imports by Hour[Electricity Timeslice,Hour,last pass!])
	)
	~	MW*hr
	~		|

BAU Total Electricity Demand by Hour before Distributed Generation[Electricity Timeslice\
		,Hour]=
	(SUM(
	  (BAU Buildings Sector Electricity Demand[urban residential,Building Component!]
	    + BAU Buildings Sector Electricity Demand[rural residential,Building Component!]\
		)
	  * Adjusted Load Factors for Residential Buildings Sector[Building Component!,Electricity Timeslice\
		,Hour]
	)
	
	+ SUM(
	    BAU Buildings Sector Electricity Demand[commercial,Building Component!]
	    * Adjusted Load Factors for Commercial Buildings Sector[Building Component!,Electricity Timeslice\
		,Hour]
	  )
	
	+ SUM(
	    BAU Transportation Sector Electricity Demand[Vehicle Type!,Cargo Type!]
	    * Adjusted Load Factors for Transporation Sector[Vehicle Type!,Electricity Timeslice\
		,Hour]
	  )
	
	+ SUM(BAU Total Industrial Electricity Demand by Hour Before CCS[Electricity Timeslice\
		,Hour,Industry Category!])
	
	+ SUM(BAU Fuel Used for CCS by Industry Sector[electricity if,Industry Category!]
	    * Adjusted Load Factors for Industrial CCS[Electricity Timeslice,Hour]
	  ) * MWh per BTU
	
	+ (BAU District Heat Electricity Demand
	    + BAU Hydrogen Sector Grid Electricity Demand)
	  * Adjusted Load Factors for District Heat and Hydrogen Sectors[Electricity Timeslice\
		,Hour]
	
	+ SUM(
	    BAU Buildings Sector Electricity Demand[data centers,Building Component!]
	    * Adjusted Load Factors for Data Centers[Building Component!,Electricity Timeslice\
		,Hour]
	  )
	
	+ BAU Geoengineering Sector Electricity Demand
	  * Adjusted Load Factors for Geoengineering Sector[Electricity Timeslice,Hour]
	
	)
	
	*(BAU Total Electricity Demand after TnD Losses and Own Use
	  /BAU Total Electricity Demand)
	~	MW*hr
	~		|

BAU Total Electricity Demand by Hour before Net Imports[Electricity Timeslice,Hour]=
	BAU Total Electricity Demand by Hour before Distributed Generation[Electricity Timeslice\
		,Hour]
	-SUM(BAU Hourly Output from Distributed Electricity Capacity[Electricity Source!,Electricity Timeslice\
		,Hour])
	+ BAU Thermal Battery Grid Charging Electricity Demand by Hour[Electricity Timeslice\
		,Hour]
	~	MW*hr
	~	BAU twin; see the policy-case equation for documentation of the thermal \
		battery term.
	|

BAU Total Electricity Demand by Hour Plus Reserve Margin After Demand Altering Technologies\
		[Electricity Timeslice,Hour]=
	MAX(0,
	BAU Total Electricity Demand by Hour Before Demand Altering Technologies[Electricity Timeslice\
		,Hour]
	  -SUM(BAU Electricity Exports by Hour[Electricity Timeslice,Hour,last pass!]))
	*(1+RM Reserve Margin)
	
	+(BAU Change in Electricity Demand from Demand Altering Technologies for Net Peak Load Reduction\
		[Electricity Timeslice,Hour]
	  *ELCCAfR ELCC Adjustment for Reliability for Demand Altering Technologies[Electricity Timeslice\
		,Hour])
	~	MW*hr
	~		|

BAU Total Electricity Demand Including TnD Losses=
	SUM(BAU Total Electricity Demand by Hour After Demand Altering Technologies[Electricity Timeslice\
		!,Hour!]
	* SHELF Days per Electricity Timeslice[Electricity Timeslice!])
	~	MW*hr
	~		|

BAU Total Electricity Demand Plus Exports in BTU=
	(BAU Total Electricity Demand + EIaE BAU Exported Electricity)
	/ MWh per BTU
	~	BTU
	~		|

BAU Total Electricity Dispatched by Hour[Electricity Timeslice,Hour]=
	SUM(BAU Total Electricity Dispatched by Hour by Plant Type[Electricity Timeslice,Hour\
		,Electricity Source!])
	~	MW*hr
	~		|

BAU Total Electricity Dispatched by Hour by Plant Type[Electricity Timeslice,Hour,Electricity Source\
		]=
	MAX(0,
	  BAU Electricity Dispatched by Guaranteed Dispatch by Hour[Electricity Source,Electricity Timeslice\
		,Hour]
	  + BAU Electricity Dispatched to Meet Elec Portfolio Stds[Electricity Timeslice,Hour\
		,Electricity Source]
	  + BAU Electricity Dispatched by Least Cost by Hour[Electricity Timeslice,Hour,Electricity Source\
		]
	 )
	~	MW*hr
	~		|

BAU Total Electricity Dispatched by Hour by Plant Type Using Five Year Averages[Electricity Timeslice\
		,Hour,Electricity Source]=
	MAX(0,
	  BAU Electricity Dispatched by Guaranteed Dispatch by Hour[Electricity Source,Electricity Timeslice\
		,Hour]
	  + BAU Electricity Dispatched to Meet Elec Portfolio Stds[Electricity Timeslice,Hour\
		,Electricity Source]
	  + BAU Five Year Average Electricity Dispatched by Least Cost by Hour[Electricity Timeslice\
		,Hour,Electricity Source]
	 )
	~	MW*hr
	~		|

BAU Total Electricity Generation Capacity by Optimization Pass for Seasonal Dispatchable Reliability\
		[Electricity Source,
Optimization Pass]=
	BAU Electricity Generation Capacity before Reliability Additions[Electricity Source]
	-BAU Economic Capacity Retirements by Optimization Pass[Electricity Source,Optimization Pass\
		]
	+BAU New Capacity Desired for Seasonal Dispatchable Reliability by Optimization Pass\
		[Electricity Source,Optimization Pass
	]
	~	MW
	~		|

BAU Total Energy Market and Capacity Market Revenue for Seasonal Dispatchable Reliability\
		 [Electricity Source
,Optimization Pass]=
	BAU Total Energy Market and CES Revenue and Variable Subsidies[Electricity Source
	]
	-BAU RPS and CES Revenue at Marginal Capacity Factor[Electricity Source]
	+ (
	BAU Capacity Market Price for Seasonal Dispatchable Reliability by Optimization Pass\
		 [Optimization Pass
	]
	  * BAU Reliability Credit Factor with New Entry Backstop[Electricity Source]
	  * BAU Uncredited Binding Hour Bid Electricity Capacity Factors for Reliability by Plant Type\
		 [Electricity Source
	]
	  * Days per Year
	  * One Day)
	~	$/MW
	~		|

BAU Total Energy Market and CES Revenue and Variable Subsidies[Electricity Source]=
	SUM(BAU Total Energy Market and CES Revenue and Variable Subsidies by Optimization Pass\
		[Electricity Source,last pass!,CES])
	~	$/MW
	~		|

BAU Total Energy Market and CES Revenue and Variable Subsidies by Optimization Pass[Electricity Source\
		, Optimization Pass,RPS]=
	BAU Average Four Year Prior Total Predicted Net Energy Market Revenue per MW for New Entrants\
		[Electricity Source]
	+BAU RPS Revenue at Marginal Capacity Factor by Optimization Pass[Optimization Pass,\
		Electricity Source] ~~|
BAU Total Energy Market and CES Revenue and Variable Subsidies by Optimization Pass[Electricity Source\
		,Optimization Pass,CES]=
	BAU Average Four Year Prior Total Predicted Net Energy Market Revenue per MW for New Entrants\
		[Electricity Source]
	+ SUM(BAU RPS Revenue at Marginal Capacity Factor by Optimization Pass[last pass!,Electricity Source\
		])
	+BAU CES Revenue at Marginal Capacity Factor by Optimization Pass[Optimization Pass,\
		Electricity Source]
	~	$/MW
	~		|

BAU Total Energy Market and CES Revenue and Variable Subsidies by Optimization Pass for Hybrid Power Plants\
		[Hybrid Electricity Source
,Optimization Pass,RPS]=
	BAU Average Four Year Prior Net Energy Market Revenue by Plant Type Excluding Subsidies for Hybrid Power Plants\
		[Hybrid Electricity Source
	]
	+ BAU RPS Revenue at Marginal Capacity Factor by Optimization Pass[Optimization Pass\
		,Hybrid Electricity Source]*(1-BAU Share of Annual Expected Output that Can be Shifted
	[Hybrid Electricity Source])
	+BAU RPS Revenue at Expected Capacity Factor by Optimization Pass[Hybrid Electricity Source\
		,Optimization Pass]*(BAU Share of Annual Expected Output that Can be Shifted
	[Hybrid Electricity Source]) ~~|
BAU Total Energy Market and CES Revenue and Variable Subsidies by Optimization Pass for Hybrid Power Plants\
		[Hybrid Electricity Source
,Optimization Pass,CES]=
	BAU Average Four Year Prior Net Energy Market Revenue by Plant Type Excluding Subsidies for Hybrid Power Plants\
		[Hybrid Electricity Source
	]
	+ (BAU CES Revenue at Marginal Capacity Factor by Optimization Pass[Optimization Pass\
		,Hybrid Electricity Source]+ SUM(BAU RPS Revenue at Marginal Capacity Factor by Optimization Pass
	[last pass!,Hybrid Electricity Source]))*(1-BAU Share of Annual Expected Output that Can be Shifted\
		[Hybrid Electricity Source
	])
	+(BAU CES Revenue at Expected Capacity Factor by Optimization Pass[Hybrid Electricity Source\
		,Optimization Pass]+ SUM(BAU RPS Revenue at Expected Capacity Factor by Optimization Pass
	[Hybrid Electricity Source,last pass!]))*(BAU Share of Annual Expected Output that Can be Shifted\
		[Hybrid Electricity Source
])
	~	$/MW
	~		|

BAU Total Energy Related Emissions[Sectors,Pollutant] :EXCEPT:      [industry sector,\
		Pollutant],[LULUCF sector,Pollutant],[geoengineering sector,Pollutant]=
	BAU Total Pollutant Emissions by Sector[Sectors,Pollutant] ~~|
BAU Total Energy Related Emissions[industry sector,Pollutant]=
	BAU Total Pollutant Emissions by Sector[industry sector,Pollutant]
	- SUM(BAU Process Emissions after CCS[Industry Category!,Pollutant]) ~~|
BAU Total Energy Related Emissions[LULUCF sector,Pollutant]=
	BAU Total Pollutant Emissions by Sector[LULUCF sector,Pollutant]
	- BLAPE BAU LULUCF Anthropogenic Pollutant Emissions[Pollutant] ~~|
BAU Total Energy Related Emissions[geoengineering sector,Pollutant]=
	SUM(BAU Geoengineering Sector Pollutant Emissions Excluding Captured CO2[Pollutant,Industrial Fuel\
		!])
	~	g pollutant
	~		|

BAU Total Energy Related Emissions in CO2e[Sectors]=
	SUM(
	  BAU Total Energy Related Emissions[Sectors,Pollutant!]
	  * GWP by Pollutant[Pollutant!]
	)
	~	g CO2e
	~		~	:SUPPLEMENTARY 
	|

