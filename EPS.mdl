Clean Electricity Std Percentage=
	0
	~	Dmnl
	~		|

Clean Industrial Heat Investment Subsidy Amount Paid[Industry Category]=
	SUM(Clean Industrial Heat Investment Subsidy Rate[Industry Category,industrial heating process\
		!,Industrial Fuel!]
	  * New Industrial Equipment Potential Energy Use by Fuel Type and Process[Industry Category\
		,Industrial Fuel!,industrial heating process!]
	)
	~	$
	~		|

Clean Industrial Heat Investment Subsidy Rate[Industry Category,industrial heating process\
		,Industrial Fuel]=
	Industrial Equipment Capital Cost per Unit Energy Before Clean Heat Subsidy[Industry Category\
		,Industrial Fuel,industrial heating process]
	* (BCHSR BAU Clean Heat Investment Subsidy Rate[industrial heating process]
	  + Perc Subsidy for Clean Industrial Heat Equipment This Year[industrial heating process\
		])
	* IFTQfS Industrial Fuel Types Qualifying for Clean Heat Investment Subsidy[Industrial Fuel\
		]
	~	$/BTU
	~		|

Clean Industrial Heat Production Subsidy Rate by Equipment Vintage[Industrial Fuel,industrial heating process\
		,Model Run Vintage]=
	IF THEN ELSE(
	  This Year Model Run Vintage Flag[Model Run Vintage] = 1,
	  Clean Industrial Heat Subsidy Rate by Fuel Type[Industrial Fuel,industrial heating process\
		],
	  IF THEN ELSE(
	    Dimensionless Time < Model Run Vintage to Year Mapping[Model Run Vintage],
	    0,
	    IF THEN ELSE(
	      Dimensionless Time >= Model Run Vintage to Year Mapping[Model Run Vintage] + BCHPD BAU Clean Heat PTC Duration\
		/One Year,
	      0,
	      Last Year Clean Industrial Heat Production Subsidy Rate by Equipment Vintage[Industrial Fuel\
		,industrial heating process
	,Model Run Vintage]
	    )
	
	  )
	)
	~	$/BTU
	~		|

Clean Industrial Heat Subsidy Annuity Factor[Industry Category]= INITIAL(
	SUM(
	  ZIDZ(
	    IF THEN ELSE(
	      Numerical Future Year Definitions[Future Year!] - Time < 0,
	      0, 
	      IF THEN ELSE(
	        Numerical Future Year Definitions[Future Year!] - Time >= BCHPD BAU Clean Heat PTC Duration\
		, 
	        0,
	        1
	      )
	    ),
	    Present Value Unmasked Decision Discount Factor[Industry Category,Future Year!]
	  )
	))
	~	Dmnl
	~		Sum of decision-rate discount factors across the clean heat PTC duration \
		window (a future-flow valuation in the fuel choice, so it carries the \
		purchase hurdle premium).  Time invariant for the same reason as the \
		capital annuity factor.
	|

Clean Industrial Heat Subsidy Rate by Fuel Type[Industrial Fuel,industrial heating process\
		]=
	(
	 Subsidy for Clean Industrial Heat Production This Year[industrial heating process]
	 / BpTPEU BTU per Medium Primary Energy Unit
	
	 + BCHSR BAU Clean Heat Production Subsidy Rate[industrial heating process]
	)
	
	* IFTQfS Industrial Fuel Types Qualifying for Clean Heat Production Subsidy[Industrial Fuel\
		]
	~	$/BTU
	~		|

Cleared Viability Ratio for Cost Driven Retirement[Electricity Source]=
	IF THEN ELSE(Time = INITIAL TIME,
	  1,
	  SUM(Viability Ratio for Cost Driven Retirement[Electricity Source,last pass!]))
	~	Dmnl
	~		|

Clinker Capacity Entering Production Support by Program and Pathway[Cement Production Support Program\
		,Cement Production Pathway]=
	New Clinker Production Capacity by Pathway[Cement Production Pathway]
	* IF THEN ELSE(Cement Production Support Offered per Ton of Clinker by Program and Pathway\
		[Cement Production Support Program,Cement Production Pathway] <> 0, 1, 0)
	~	metric tons/Year
	~	New clinker capacity built this year on a pathway a production support \
		program pays for; it is paid for the program term.
	|

Clinker Capacity Leaving Production Support by Program and Pathway[Cement Production Support Program\
		,Cement Production Pathway]=
	DELAY FIXED(Clinker Capacity Entering Production Support by Program and Pathway[Cement Production Support Program\
		,Cement Production Pathway],
	  Cement Production Support Term by Program[Cement Production Support Program], 0)
	~	metric tons/Year
	~	Capacity whose program term ends this year (the entering flow, delayed by \
		the program term).
	|

Clinker Capacity Retired under Replacement Rule by Pathway[Cement Production Pathway]\
		=
	MIN(
	  Additional Clinker Capacity Retired per Unit of New Capacity This Year
	  * Last Year Total New Clinker Production Capacity
	  * ZIDZ(Last Year Preexisting Clinker Production Capacity by Pathway[Cement Production Pathway\
		],
	         SUM(Last Year Preexisting Clinker Production Capacity by Pathway[Cement Production Pathway\
		!])),
	  MAX(0, Last Year Preexisting Clinker Production Capacity by Pathway[Cement Production Pathway\
		]
	         - Preexisting Clinker Capacity Facing Overhaul Decision by Pathway[Cement Production Pathway\
		]
	         + Preexisting Clinker Capacity Overhauled by Pathway[Cement Production Pathway\
		])
	)
	~	metric tons/Year
	~	Start-year kiln capacity retired this year under the capacity replacement \
		rule: the lever times last year's new builds, allocated across pathways by \
		their share of the surviving start-year fleet, capped by what remains \
		after this year's ordinary campaign-end retirements.
	|

Clinker Production by Pathway[Cement Production Pathway]=
	Clinker Production Capacity by Pathway[Cement Production Pathway]
	* CUUB Cement Utilization Upper Bound
	* MIN(
	    1,
	    ZIDZ(
	      Domestic Clinker Demand,
	      SUM(Clinker Production Capacity by Pathway[Cement Production Pathway!]) * CUUB Cement Utilization Upper Bound
	    )
	  )
	~	metric tons/Year
	~	Production by pathway: nameplate capacity net of this year's decision \
		retirements (both the preexisting and the model-run pools - Q4) plus this \
		year's new builds (same-year commissioning), flexing up to the top of the \
		utilization envelope (CUUB - tightness activation 2026-08-28 replaced the \
		frozen SYCCU ceiling so the fleet absorbs demand swings with utilization \
		before capacity; uniform rate across pathways per the 2026-08-28 design \
		decision, merit-order deferred), rationed uniformly when demand falls \
		short. Realized utilization is emergent. No resource-cap analog exists in \
		the logit (the SCM cap acts on the clinker ratio upstream).
	|

Clinker Production Capacity Added During Model Run by Pathway[Cement Production Pathway\
		]=
	Last Year Clinker Production Capacity Added During Model Run by Pathway[Cement Production Pathway\
		]
	+ New Clinker Production Capacity by Pathway[Cement Production Pathway]
	- Model Run Clinker Capacity Retirements by Pathway[Cement Production Pathway]
	~	metric tons/Year
	~	Model-run nameplate available THIS year: the beginning-of-year level plus \
		this year's new builds (same-year commissioning) less the model-run \
		capacity retiring at this year's decisions. Feeds this year's production, \
		the total available capacity, and the new-vs-old energy-intensity split.
	|

Clinker Production Capacity by Pathway[Cement Production Pathway]=
	Preexisting Clinker Production Capacity by Pathway[Cement Production Pathway]
	+ Clinker Production Capacity Added During Model Run by Pathway[Cement Production Pathway\
		]
	~	metric tons/Year
	~	Total clinker nameplate available THIS year (preexisting plus model-run, \
		after this year's retirements and builds): the basis for production. \
		Utilization, headroom, the marginal operating cost, and the unmet-need \
		trigger read Last Year Clinker Production Capacity by Pathway instead, the \
		beginning-of-year value, so the overhaul decision never sees its own \
		same-year retirements.
	|

Clinker Ratio Needed for Procured Cement to Qualify=
	LCPT Low Carbon Procurement Threshold as Share of Fleet CO2 Intensity
	* (1 - Fraction of Cement Demand Purchased under Low Carbon Procurement This Year)
	* BCtCR BAU Clinker to Cement Ratio
	/ MAX(0.01, 1 - LCPT Low Carbon Procurement Threshold as Share of Fleet CO2 Intensity\
		 * Fraction of Cement Demand Purchased under Low Carbon Procurement This Year)
	~	Dmnl
	~	Clinker share a blended cement made with conventional clinker needs to \
		count as low-carbon: the LCPT share of a fleet average that itself \
		includes the procured cement (the rest of the market at the BAU clinker \
		ratio). About 0.57 at the US threshold with half of demand procured.
	|

Clinker Ratio Reduction Required by Intensity Standard=
	ZIDZ(Cement Intensity Standard Gap, Last Year Cement Fleet Net CO2 Intensity per Ton of Clinker\
		)
	~	Dmnl
	~	Reduction in the clinker-to-cement ratio that would close the intensity \
		gap on its own (the gap per tonne of cement over the fleet's CO2 per tonne \
		of clinker).
	|

Clinker to Cement Ratio=
	MAX(0,
	  BCtCR BAU Clinker to Cement Ratio
	  - Fraction of Additional Clinker Substitution This Year)
	~	Dmnl
	~	Policy-case clinker-to-cement ratio (clinker content of the cement \
		consumed, blend basis): the BAU trajectory (limestone-driven, uncapped) \
		minus policy-driven SCM substitution from the cement-measures lever, which \
		can take the ratio down to MACtCR - see Fraction of Additional Clinker \
		Substitution This Year. The substitution's SCM production energy (calcined \
		clay) is added to the module's natural gas stream via SCMEI.
	|

CNBEIR Cement New Build Energy Intensity Ratio[Cement Production Pathway]:INTERPOLATE:\
		:=
	GET DIRECT DATA(
	   'InputData/indst/_cement/CNBEIR/CNBEIR.csv',
	   ',',
	   '1',
	   'B2'
	)
	~	Dmnl
	~	Ratio of new-build energy intensity to the fleet-typical CEIbPaF values, \
		by pathway, applied to capacity built during the model run. Dry kiln with \
		precalciner and dry kiln with CCS 0.8023: DOE Bandwidth Study \
		best-available thermal intensity (2.9 GJ/t, about 2.75 MMBtu/t) over the \
		fleet-typical 3.43 MMBtu/t. Electric kiln and alternative chemistry cement \
		1.0, because their CEIbPaF values already describe new technology. Held \
		flat over time.
	|

