	  + Additional Passenger Vehicle Subsidy This Year[Vehicle Type,Vehicle Technology])\
		 ~~|
Vehicle Subsidy[freight,Vehicle Type,Vehicle Technology]=
	BVS BAU Vehicle Subsidy[freight,Vehicle Type,Vehicle Technology]
	+ Additional Freight Vehicle Subsidy This Year[Vehicle Type,Vehicle Technology]
	~	$/vehicle
	~		|

Vehicle Survival Rate by Vehicle Type Cargo Type Engine and Vintage[Cargo Type,Vehicle Type\
		,Vehicle Vintage]=
	1 - XIDZ(
	  exp(-1 * (MAX(0, Vintage Age[Vehicle Vintage] - VWLbV Vehicle Weibull Location by Vintage\
		[Cargo Type,Vehicle Type,Vehicle Vintage]) / VWSbV Vehicle Weibull Scale by Vintage\
		[Cargo Type,Vehicle Type,Vehicle Vintage]) ^ VWSPbV Vehicle Weibull Shape Parameter by Vintage\
		[Cargo Type,Vehicle Type,Vehicle Vintage]),
	  exp(-1 * (MAX(0, Vintage Age[Vehicle Vintage] - 1 - VWLbV Vehicle Weibull Location by Vintage\
		[Cargo Type,Vehicle Type,Vehicle Vintage]) / VWSbV Vehicle Weibull Scale by Vintage\
		[Cargo Type,Vehicle Type,Vehicle Vintage]) ^ VWSPbV Vehicle Weibull Shape Parameter by Vintage\
		[Cargo Type,Vehicle Type,Vehicle Vintage]),
	  0
	)
	~	Dmnl
	~		|

Vehicle Technologies Qualifying as ZEVs[Vehicle Type,Vehicle Technology]=
