BAU Last Year Total Electricity Demand by Hour After Demand Altering Technologies[Electricity Timeslice\
		,Hour]= DELAY FIXED (
	BAU Total Electricity Demand by Hour After Demand Altering Technologies[Electricity Timeslice\
		,Hour], 1 , 0)
	~	MW*hour
	~		|

BAU Last Year Transportation Sector Fuel Used[Vehicle Type,Cargo Type,Vehicle Technology\
		,Transportation Fuel]= DELAY FIXED (
	BAU Transportation Sector Fuel Used[Vehicle Type,Cargo Type,Vehicle Technology,Transportation Fuel\
		],
	1,
	Est Start Year Transportation Sector Fuel Used[Vehicle Type,Cargo Type,Vehicle Technology\
		,Transportation Fuel])
	~	BTU
	~		|

BAU Last Year Vehicles by Vintage[Vehicle Type,Cargo Type,Vehicle Technology,Vehicle Vintage\
		]= INTEG (
	BAU New Vehicles[Vehicle Type,Cargo Type,Vehicle Technology] * This Year Vintage Flag\
		[Vehicle Vintage]
	- BAU Retiring Vehicles[Vehicle Type,Cargo Type,Vehicle Technology]
	  * ZIDZ(BAU Last Year Vehicles by Vintage[Vehicle Type,Cargo Type,Vehicle Technology\
		,Vehicle Vintage] * Vehicle Survival Rate by Vehicle Type Cargo Type Engine and Vintage\
		[Cargo Type,Vehicle Type,Vehicle Vintage],
	    SUM(BAU Last Year Vehicles by Vintage[Vehicle Type,Cargo Type,Vehicle Technology\
		,Vehicle Vintage!] * Vehicle Survival Rate by Vehicle Type Cargo Type Engine and Vintage\
		[Cargo Type,Vehicle Type,Vehicle Vintage!])),
		SYVbT Start Year Vehicles by Technology[Vehicle Type,Cargo Type,Vehicle Technology]\
		 * SYVSbV Start Year Vehicle Share by Vintage[Vehicle Type,Cargo Type,Vehicle Technology\
		,Vehicle Vintage])
	~	vehicles
	~		|

BAU Last Year Vehicles over Fuel Economy by Vintage[Vehicle Type,Cargo Type,Vehicle Technology\
		,Vehicle Vintage]= INTEG (
	BAU New Vehicles over Fuel Economy[Vehicle Type,Cargo Type,Vehicle Technology] * This Year Vintage Flag\
		[Vehicle Vintage]
	- BAU Retiring Vehicles over Fuel Economy[Vehicle Type,Cargo Type,Vehicle Technology\
		]
	  * ZIDZ(BAU Last Year Vehicles over Fuel Economy by Vintage[Vehicle Type,Cargo Type\
		,Vehicle Technology,Vehicle Vintage] * Vehicle Survival Rate by Vehicle Type Cargo Type Engine and Vintage\
		[Cargo Type,Vehicle Type,Vehicle Vintage],
	    SUM(BAU Last Year Vehicles over Fuel Economy by Vintage[Vehicle Type,Cargo Type,\
		Vehicle Technology,Vehicle Vintage!] * Vehicle Survival Rate by Vehicle Type Cargo Type Engine and Vintage\
		[Cargo Type,Vehicle Type,Vehicle Vintage!])),
		IF THEN ELSE(NVFEbV New Vehicle Fuel Economy by Vintage[Vehicle Type,Cargo Type,Vehicle Technology\
		,Vehicle Vintage] > 0, (SYVbT Start Year Vehicles by Technology[Vehicle Type,Cargo Type\
		,Vehicle Technology] * SYVSbV Start Year Vehicle Share by Vintage[Vehicle Type,Cargo Type\
		,Vehicle Technology,Vehicle Vintage]) / (NVFEbV New Vehicle Fuel Economy by Vintage\
		[Vehicle Type,Cargo Type,Vehicle Technology,Vehicle Vintage]), 0))
	~	vehicles/(miles/BTU)
	~		|

BAU Last Year Weighted Average Annual Capital Cost per Unit Capacity[Electricity Source\
		]=
	DELAY FIXED(BAU Weighted Average Annual Capital Costs per Unit Capacity[Electricity Source\
		],
	  1,
	  0
	)
	~	$/MW
	~		|

