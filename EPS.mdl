Adjusted Load Factors for Commercial Buildings Sector[Building Component,Electricity Timeslice\
		,Hour]=
	Mean Load Factors for Commercial Buildings Sector[Building Component,Electricity Timeslice\
		]
	+ LFHVM Load Factor Hourly Variance Multiplier[Electricity Timeslice,commercial buildings sector\
		]
	  * (
	      SHELF Seasonal Hourly Equipment Load Factors for Commercial Buildings Sector[Building Component\
		,Electricity Timeslice,Hour]
	      - Mean Load Factors for Commercial Buildings Sector[Building Component,Electricity Timeslice\
		]
	    )
	~	Dmnl
	~		|

Adjusted Load Factors for Data Centers[Building Component,Electricity Timeslice,Hour]\
		=
	Mean Load Factors for Data Centers[Building Component,Electricity Timeslice]
	+ LFHVM Load Factor Hourly Variance Multiplier[Electricity Timeslice,commercial buildings sector\
		]
	  * (
	      SHELF Seasonal Hourly Equipment Load Factors for Data Centers[Building Component\
		,Electricity Timeslice,Hour]
	      - Mean Load Factors for Data Centers[Building Component,Electricity Timeslice]
	    )
	~	Dmnl
	~		|

Adjusted Load Factors for District Heat and Hydrogen Sectors[Electricity Timeslice,Hour\
		]=
	Mean Load Factors for District Heat and Hydrogen Sectors[Electricity Timeslice]
	+ LFHVM Load Factor Hourly Variance Multiplier[Electricity Timeslice,district heat and hydrogen sector\
		]
	  * (
	      SHELF Seasonal Hourly Equipment Load Factors for District Heat and Hydrogen Sectors\
		[Electricity Timeslice,Hour]
	      - Mean Load Factors for District Heat and Hydrogen Sectors[Electricity Timeslice\
		]
	    )
	~	Dmnl
	~		|

Adjusted Load Factors for Geoengineering Sector[Electricity Timeslice,Hour]=
	Mean Load Factors for Geoengineering Sector[Electricity Timeslice]
	+ LFHVM Load Factor Hourly Variance Multiplier[Electricity Timeslice,geoengineering sector\
		]
	  * (
	      SHELF Seasonal Hourly Equipment Load Factors for Geoengineering Sector[Electricity Timeslice\
		,Hour]
	      - Mean Load Factors for Geoengineering Sector[Electricity Timeslice]
	    )
	~	Dmnl
	~		|

Adjusted Load Factors for Industrial CCS[Electricity Timeslice,Hour]=
	Mean Load Factors for Industrial CCS[Electricity Timeslice]
	+ LFHVM Load Factor Hourly Variance Multiplier[Electricity Timeslice,industry sector\
		]
	  * (
	      SHELF Seasonal Hourly Equipment Load Factors for Industrial CCS[Electricity Timeslice\
		,Hour]
	      - Mean Load Factors for Industrial CCS[Electricity Timeslice]
	    )
	~	Dmnl
	~		|

Adjusted Load Factors for Industrial Processes[Electricity Timeslice,Hour,Industrial Process\
		]=
	Mean Load Factors for Industrial Processes[Electricity Timeslice,Industrial Process]
	+ LFHVM Load Factor Hourly Variance Multiplier[Electricity Timeslice,industry sector\
		]
	
	* 
	
	(
	  SHELF Seasonal Hourly Equipment Load Factors for Industrial Sector by Process[Electricity Timeslice\
		,Industrial Process,Hour]
	  - Mean Load Factors for Industrial Processes[Electricity Timeslice,Industrial Process\
		]
	)
	~	Dmnl
	~		|

Adjusted Load Factors for Industry Categories[Electricity Timeslice,Hour,Industry Cat w Industry wide Load Factor\
		]=
	Mean Load Factors for Industry Categories[Electricity Timeslice,Industry Cat w Industry wide Load Factor\
		]
	+ LFHVM Load Factor Hourly Variance Multiplier[Electricity Timeslice,industry sector\
		]
	
	* 
	
	(
	  SHELF Seasonal Hourly Equipment Load Factors for Industrial Sector by Category[Electricity Timeslice\
		,Industry Cat w Industry wide Load Factor,Hour]
	  - Mean Load Factors for Industry Categories[Electricity Timeslice,Industry Cat w Industry wide Load Factor\
		]
	)
	~	Dmnl
	~		|

Adjusted Load Factors for Residential Buildings Sector[Building Component,Electricity Timeslice\
		,Hour]=
	Mean Load Factors for Residential Buildings Sector[Building Component,Electricity Timeslice\
		]
	+ LFHVM Load Factor Hourly Variance Multiplier[Electricity Timeslice,residential buildings sector\
		]
	  * (
	      SHELF Seasonal Hourly Equipment Load Factors for Residential Buildings Sector[\
		Building Component,Electricity Timeslice,Hour]
	      - Mean Load Factors for Residential Buildings Sector[Building Component,Electricity Timeslice\
		]
	    )
	~	Dmnl
	~		|

Adjusted Load Factors for Transporation Sector[Vehicle Type,Electricity Timeslice,Hour\
		]=
	Mean Load Factors for Transportation Sector[Vehicle Type,Electricity Timeslice]
	+ LFHVM Load Factor Hourly Variance Multiplier[Electricity Timeslice,transportation sector\
		]
	  * (
	      SHELF Seasonal Hourly Equipment Load Factors for Transportation Sector[Vehicle Type\
		,Electricity Timeslice,Hour]
	      - Mean Load Factors for Transportation Sector[Vehicle Type,Electricity Timeslice\
		]
	    )
	~	Dmnl
	~		|

age bracket:
	age 16to19,
	age 20to24,
	age 25to34,
	age 35to44,
	age 45to54,
	age 55to64,
	age 65plus
	~	
	~		|

Aggregate Decrease in Demand by Timeslice for Seasonal Net Peak Load Reduction[Electricity Timeslice\
		]=
	SUM(Aggregate Increase in Demand by Timeslice for Seasonal Net Peak Load Reduction[Electricity Timeslice\
		!])
	* Weighted Average Round Trip Efficiency for Seasonal Shifting
	* ZIDZ(
	    Aggregate Shortfall in Potential Output from Surviving Capacity vs Average[Electricity Timeslice\
		],
	    SUM(Aggregate Shortfall in Potential Output from Surviving Capacity vs Average[Electricity Timeslice\
		!])
	  )
	~	MW*hr
	~		|

Aggregate Excess Potential Output from Surviving Capacity vs Average[Electricity Timeslice\
		]=
	SUM(Excess Potential Output from Surviving Capacity vs Annual Average by Hour[Electricity Timeslice\
		,Hour!])
	* SHELF Days per Electricity Timeslice[Electricity Timeslice]
	~	MW*hr
	~		|

Aggregate Increase in Demand by Timeslice for Seasonal Net Peak Load Reduction[Electricity Timeslice\
		]=
	MIN(
	  Maximum Annual Quantity of Electricity Absorbed for Seasonal Net Peak Load Reduction
	  * ZIDZ(
	      Aggregate Excess Potential Output from Surviving Capacity vs Average[Electricity Timeslice\
		],
	      SUM(Aggregate Excess Potential Output from Surviving Capacity vs Average[Electricity Timeslice\
		!])
	    ),
	
	  Aggregate Excess Potential Output from Surviving Capacity vs Average[Electricity Timeslice\
		]
	)
	~	MW*hr
	~		|

Aggregate Shortfall in Potential Output from Surviving Capacity vs Average[Electricity Timeslice\
		]=
	SUM(Shortfall in Potential Output from Surviving Capacity vs Annual Average by Hour[\
		Electricity Timeslice,Hour!])
	* SHELF Days per Electricity Timeslice[Electricity Timeslice]
	~	MW*hr
	~		|

Agriculture CO2e Emissions[Pollutant]=
	Industrial Sector Pollutant Emissions[agriculture and forestry 01T03,Pollutant]
	* GWP by Pollutant[Pollutant]
	~	g CO2e
	~		|

Agriculture Pollutant Emissions[Pollutant]=
	Industrial Sector Pollutant Emissions[agriculture and forestry 01T03,Pollutant]
	~	g pollutant
	~		|

