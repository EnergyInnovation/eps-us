Child and Adult Deaths by Demographic Trait[demographic trait excluding age bracket]=
	MAX(
	  0,
	
	  BDbDT BAU Child and Adult Deaths by Demographic Trait[demographic trait excluding age bracket\
		]
	  - Reduction in Child and Adult Premature Mortality by Demographic Trait[demographic trait excluding age bracket\
		]
	)
	~	incidents
	~		|

CIBP Cement Import CO2 Intensity=
	GET DIRECT CONSTANTS(
	   'InputData/indst/_cement/CIBP/CIBP.csv',
	   ',',
	   'B2'
	)
	~	metric tons CO2e/metric ton
	~	Direct CO2 embodied in a tonne of imported cement (production in the \
		exporting country). US default 0.83, the JRC estimate for Portland cement \
		from the main US suppliers (Turkey, Vietnam, Egypt, Algeria); CBAM default \
		values for cement are about 1.44 with a mark-up. See the About tab of the \
		workbook in its folder.
	|

CIBP Cement Import Delivered Price=
	GET DIRECT CONSTANTS(
	   'InputData/indst/_cement/CIBP/CIBP.csv',
	   ',',
	   'B3'
	)
	~	$/metric ton
	~	Delivered (c.i.f.) price of imported cement before any border fee, in the \
		model dollar year. US default about 66 2012-dollars per tonne (92 dollars \
		per tonne in 2025, USGS). See the About tab of the workbook in its folder.
	|

CIBP Cement Import Price Elasticity=
