	  MDSC Maximum Distributed Solar Capacity[Building Type,solar PV es],
	  SYDEC Start Year Distributed Electricity Capacity[Building Type,solar PV es]
	)
	~	MW
	~		|

Start Year Electric Heating Equipment Effective COP[industrial heating process]=
	1 / SYIEUEFbIPaF Start Year Industrial Equipment Unit Energy Factor by Industrial Process and Fuel\
		[electricity if,industrial heating process]
	~	Dmnl
	~	Heat service delivered per BTU of electricity by the model's start year \
		electric heating equipment convention, derived as the reciprocal of the \
		electric unit energy factor (SYIEUEFbIPaF): the exchange rate between the \
		electricity-equivalent service unit and actual heat, by band. In the US \
		calibration this is about 3.7 below 100 C and 2.2 at 100 to 200 C (the \
		convention treats low temperature electric equipment as heat pumps) and \
		0.57 to 0.80 above 200 C (resistance and arc equipment with system \
		losses). Thermal batteries deliver heat resistively, so their charging \
		electricity per unit of electricity-equivalent service is this factor \
		divided by round trip efficiency - keeping thermal battery physics \
		internally consistent with the unit definition (per Dan O'Brien \
		2026-08-20): no heat pump free ride at low temperatures, no phantom \
		furnace losses at high temperatures. Derived, not an input: it moves \
		automatically with any recalibration of SYIEUEFbIPaF.
	|

Start Year Electricity Generation Capacity by Vintage[Electricity Source,Modeled Vintage\
		] :EXCEPT:
	[Electricity Source,historical modeled vintages]=
	0 ~~|
Start Year Electricity Generation Capacity by Vintage[Electricity Source,historical modeled vintages\
		]=
	BHRaSYC Start Year Electricity Generation Capacity by Vintage[Electricity Source,historical modeled vintages\
		]
	~	MW
	~		|

Start Year Electricity Generation Capacity Summed Across Vintages[Electricity Source]\
		= INITIAL(
	SUM(Start Year Electricity Generation Capacity by Vintage[Electricity Source,Modeled Vintage\
		!]))
	~	MW
	~		|

Start Year Electricity Prices by Sector[Sectors]= INITIAL(
	BAU Pretax Fuel Price by Sector[electricity,Sectors])
	~	$/BTU
	~		|

Start Year Electricity Supplier Expenditures after Subsidies per Unit Electricity Produced\
		= INITIAL(
	BAU Electricity Supplier Costs Recovered through Electricity Rates per Unit Electricity Delivered\
		*(1-SoEDtICoS Share of Electricity Demand that Is Cost of Service)
	+ BAU Electricity Supplier Costs Recovered through Electricity Rates per Unit Electricity Delivered for Cost of Service Rates\
		*SoEDtICoS Share of Electricity Demand that Is Cost of Service)
	~	$/BTU
	~		|

Start Year Energy Intensity of Industrial Production in Electricity Equivalent[Industry Category\
		]= INITIAL(
	Raw BAU Industrial Energy Intensity in Electricity Equivalent[Industry Category])
	~	BTU/$
	~		|

Start Year EV Battery Capacity Deployed=
	SUM(SYBCbVT Start Year Battery Capacity by Vehicle Type[Cargo Type!,Vehicle Type!,Vehicle Technology\
		!]
	   * SYVbT Start Year Vehicles by Technology[Vehicle Type!,Cargo Type!,Vehicle Technology\
		!]
	)
	~	MW*hr
	~		|

Start Year Expected Capacity Factors[Electricity Source]=
	SUM(
	  Start Year Seasonal Expected Hourly Electricity Capacity Factors after RAF[Electricity Source\
		,Electricity Timeslice!,Hour!]
	  * SHELF Days per Electricity Timeslice[Electricity Timeslice!]
	)
	/ Hours per Year
	~	Dmnl
	~	The SUM across timeslices and hours weighted by days per timeslice yields \
		expected FULL LOAD HOURS per year (roughly capacity factor times 8760), \
		not a dimensionless fraction; dividing by Hours per Year converts it to a \
		true capacity factor.  Before this correction (2026-07-27) every consumer \
		multiplied this variable by Hours per Year, so start year estimated \
		generation (and the initial values of Last Year Electricity Generation by \
		Type and its BAU twin) were overstated by a factor of about 8760.
	|

Start Year Fleet Avg Fuel Economy[Vehicle Type,Cargo Type,Vehicle Technology]= INITIAL\
		(
	XIDZ(
	  SUM(SYVSbV Start Year Vehicle Share by Vintage[Vehicle Type,Cargo Type,Vehicle Technology\
		,Vehicle Vintage!] * Vehicle Relative Annual Mileage by Vintage[Cargo Type,Vehicle Type\
		,Vehicle Vintage!]),
	  SUM(IF THEN ELSE(NVFEbV New Vehicle Fuel Economy by Vintage[Vehicle Type,Cargo Type\
		,Vehicle Technology,Vehicle Vintage!] > 0, (SYVSbV Start Year Vehicle Share by Vintage\
		[Vehicle Type,Cargo Type,Vehicle Technology,Vehicle Vintage!] * Vehicle Relative Annual Mileage by Vintage\
		[Cargo Type,Vehicle Type,Vehicle Vintage!]) / (NVFEbV New Vehicle Fuel Economy by Vintage\
		[Vehicle Type,Cargo Type,Vehicle Technology,Vehicle Vintage!]), 0)),
	  SUM(NVFEbV New Vehicle Fuel Economy by Vintage[Vehicle Type,Cargo Type,Vehicle Technology\
		,Vehicle Vintage!] * IF THEN ELSE(Vintage to Year Mapping[Vehicle Vintage!] = Dimensionless Time\
		 - 1, 1, 0))
	))
	~	miles/BTU
	~		|

Start Year Grid Battery Storage Capacity in MWh=
	GBSC Start Year Grid Battery Storage Capacity
	* GBSC Diurnal Grid Battery Daily Storage Duration
	~	MW*hr
	~		|

Start Year Industrial Heat Fuel Intensity for Measures[Industry Category]= INITIAL(
	Industrial Heat Fuel Intensity for Measures[Industry Category])
	~	BTU/$
	~	Anchor for the waste heat availability index.
	|

Start Year Low Carbon Hydrogen Production Shares by Pathway[Hydrogen Production Pathway\
		]=
	IF THEN ELSE(
	  SUM(
	    Hydrogen Production Pathways Qualifying as Low Carbon[Hydrogen Production Pathway\
		!]
	    * SYAHPC Start Year Annual Hydrogen Production Capacity[Hydrogen Production Pathway\
		!]
	  )
	  = 0,
	
	  ZIDZ(
	    Hydrogen Production Pathways Qualifying as Low Carbon[Hydrogen Production Pathway\
		],
	    SUM(
	      Hydrogen Production Pathways Qualifying as Low Carbon[Hydrogen Production Pathway\
		!]
	    )
	  ),
	
	  ZIDZ(
	     SYAHPC Start Year Annual Hydrogen Production Capacity[Hydrogen Production Pathway\
		]
	    * Hydrogen Production Pathways Qualifying as Low Carbon[Hydrogen Production Pathway\
		],
	    SUM(
	      Hydrogen Production Pathways Qualifying as Low Carbon[Hydrogen Production Pathway\
		!]
	      * SYAHPC Start Year Annual Hydrogen Production Capacity[Hydrogen Production Pathway\
		!]
	    )
	  )
	)
	~	Dmnl
	~		|

Start Year Other Hydrogen Production Shares by Pathway[Hydrogen Production Pathway]=
	IF THEN ELSE(
	  SUM(SYAHPC Start Year Annual Hydrogen Production Capacity[Hydrogen Production Pathway\
		!]) = 0,
	
	  ZIDZ(1, ELMCOUNT(Hydrogen Production Pathway)),
	
	  ZIDZ(SYAHPC Start Year Annual Hydrogen Production Capacity[Hydrogen Production Pathway\
		],
	  SUM(SYAHPC Start Year Annual Hydrogen Production Capacity[Hydrogen Production Pathway\
		!]))
	)
	~	Dmnl
	~		|

Start Year Seasonal Expected Hourly Electricity Capacity Factors after RAF[Electricity Source\
		,Electricity Timeslice,Hour]=
	SYSHECF Start Year Seasonal Expected Hourly Electricity Capacity Factors[Electricity Source\
		,Electricity Timeslice,Hour]
	* RAF Regional Availability Factor for Generation[Electricity Source]
	* HYECFCA Historical Year Electricity Capacity Factor Calibration Adjustment[Electricity Source\
		]
	~	Dmnl
	~		|

Start Year Vehicles per Household[Vehicle Type,Cargo Type]= INITIAL(
	ZIDZ(SUM(SYVbT Start Year Vehicles by Technology[Vehicle Type,Cargo Type,Vehicle Technology\
		!]), GET DATA AT TIME(NoH Number of Households, INITIAL TIME - One Year))
	)
	~	vehicles/household
	~		|

Steps Allowed in Same Direction With Declining Step Size=
	1
	~	Dmnl
	~		|

Steps Allowed in Same Direction Without Increasing Step Size=
	2
	~	Dmnl
	~		|

STfCCE Smoothing Time for CCS Capital Expenditures=
	GET DIRECT CONSTANTS(
	   'InputData/ccs/STfCCE/STfCCE.csv',
	   ',',
	   'B2*'
	)
	~	Year
	~		|

STfESCE Smoothing Time for Electricity Sector Capital Expenditures=
	GET DIRECT CONSTANTS(
	   'InputData/elec/STfESCE/STfESCE.csv',
	   ',',
	   'B2*'
	)
	~	Year
	~		|

strict industries within industry category:
	coal mining 05,
	oil and gas extraction 06,
	other mining and quarrying 07T08,
	food beverage and tobacco 10T12,
	textiles apparel and leather 13T15,
	wood products 16,
	pulp paper and printing 17T18,
	refined petroleum and coke 19,
	chemicals 20,
	rubber and plastic products 22,
	glass and glass products 231,
	cement and other nonmetallic minerals 239,
	iron and steel 241,
	other metals 242,
	metal products except machinery and vehicles 25,
	computers and electronics 26,
	appliances and electrical equipment 27,
	other machinery 28,
	road vehicles 29,
	nonroad vehicles 30,
	other manufacturing 31T33,
	energy pipelines and gas processing 352T353,
	construction 41T43
	~	
