Non Fossil Primary Energy=
	Total Primary Energy Use[nuclear]
	+ Total Primary Energy Use[hydro]
	+ Total Primary Energy Use[wind]
	+ Total Primary Energy Use[solar]
	+ Total Primary Energy Use[biomass]
	~	BTU
	~		|

Non Hybrid Demand Shifting Capacity in MW[Electricity Timeslice,Hour]=
	(This Year Demand Response Capacity
	 + Non Hybrid Diurnal Storage Power in MW[Electricity Timeslice]
	 + BPHC BAU Pumped Hydro Capacity
	   * SYSHECF Start Year Seasonal Expected Capacity Factor for Pumped Hydro[Electricity Timeslice\
		,Hour]
	 + Total EV Battery Capacity Available in MW)
	* RAF Regional Availability Factor for Demand Altering Technologies
	~	MW
	~		|

Non Hybrid Diurnal Storage Power in MW[Electricity Timeslice]=
	(Last Year Grid Battery Storage Capacity excluding Hybrid Batteries
	 + This Year Cumulative Policy Mandated Grid Battery Storage)
	* (1 - UFDfGBS Usage Factor Discount for Grid Battery Storage[Electricity Timeslice]\
		)
	/ GBSC Diurnal Grid Battery Daily Storage Duration
	~	MW
	~		|

Non Qualifying Annual Energy Serving Peak Reliability Timeslices[Clean Elec Requirement\
		]=
	MAX(One MW * One Hour,
	SUM(
	  MAX(0,
	    Total Electricity Demand by Hour Plus Reserve Margin After Demand Altering Technologies\
		[peak day electricity timeslice!,Hour!]
	    - Qualifying Hourly Supply for Reliability Credit[Clean Elec Requirement,peak day electricity timeslice\
		!,Hour!]*One Hour
	  )
	  * SHELF Days per Electricity Timeslice[peak day electricity timeslice!]
	))
	~	MW*hour
	~		|

Non Qualifying Reliability Credit Rampdown Before Full Requirement[Clean Elec Requirement\
		]=
	SUM(
	  IF THEN ELSE(
	    Numerical Future Year Definitions[Future Year!] >= Time :AND:
	    Numerical Future Year Definitions[Future Year!] <= Time + (RLYr Reliability Lookahead Years\
		 - 1),
	
	    MIN(1,
	      ZIDZ(
	        (1 - Weighted Average Elec Portfolio Percentage by Year[Future Year!,Clean Elec Requirement\
		])
	        * Annual Electricity Demand Energy for Reliability Credit[Clean Elec Requirement\
		],
	        Non Qualifying Annual Energy Serving Peak Reliability Timeslices[Clean Elec Requirement\
		]
	      )
	    ),
	
	    0
	  )
	) / RLYr Reliability Lookahead Years
	* One Year
	~	Dmnl
	~		|

Non RPS Qualifying Guaranteed Dispatch Amount[Electricity Source,Electricity Timeslice\
		,Hour,Clean Elec Requirement]=
	Expected Capacity by Hour[Electricity Source,Electricity Timeslice,Hour]
	 * Guaranteed Dispatch Percentages for Policy Case[Electricity Source]
	 * (1 - Elec Portfolio Qualifying Sources[Electricity Source,Clean Elec Requirement]\
		)
	 *One Hour
	~	MW*hr
	~		|

Non RPS Qualifying Guaranteed Dispatch Amount after RPS Policy[Electricity Source,Electricity Timeslice\
		,Hour,Clean Elec Requirement]=
	Non RPS Qualifying Guaranteed Dispatch Amount[Electricity Source,Electricity Timeslice\
		,Hour,Clean Elec Requirement]
	  * MIN(
	    1,
	
	    ZIDZ(
	      Total Electricity Demand by Hour After Demand Altering Technologies[Electricity Timeslice\
		,Hour]
	      * (1 - Legally Required Elec Portfolio Percentage[Clean Elec Requirement]),      
	
	      Non RPS Qualifying Guaranteed Dispatch Amount[Electricity Source,Electricity Timeslice\
		,Hour,Clean Elec Requirement]
	  )
	)
	~	MW*hr
	~		|

