Marginal Abatement Cost:
	(PriceBin1-PriceBin72)
	~	
	~		|

Marginal Capacity Factor by Hour[Electricity Source,Electricity Timeslice,Hour,Clean Elec Requirement\
		]=
	IF THEN ELSE(
	  Time = INITIAL TIME
	
	  :OR:
	
	   ABS(Last Year Electricity Generation Capacity[Electricity Source])*MW Tolerance Unit Correction Factor\
		 < Tolerance,
	
	  Last Year Weighted Average Expected Capacity Factors by Hour Without Hypothetical Adjustments\
		[Electricity Source,Electricity Timeslice,Hour]
	  *  IF THEN ELSE(
	    SUM(
	      Last Year Weighted Average Expected Capacity Factors by Hour Without Hypothetical Adjustments\
		[Electricity Source!,Electricity Timeslice,Hour]
	      * Last Year Electricity Generation Capacity[Electricity Source!]
	      * Elec Portfolio Qualifying Sources[Electricity Source!,Clean Elec Requirement\
		]
	    )
	    < Last Year Total Electricity Demand by Hour After Demand Altering Technologies[\
		Electricity Timeslice,Hour]/One Hour
	,
	
	    1,
	
	    0),
	         
	
	  IF THEN ELSE(
	    SUM(
	      Last Year Weighted Average Expected Capacity Factors by Hour Without Hypothetical Adjustments\
		[Electricity Source!,Electricity Timeslice,Hour]
	      * Last Year Electricity Generation Capacity[Electricity Source!]
	      * Elec Portfolio Qualifying Sources[Electricity Source!,Clean Elec Requirement\
		]
	    )
	    < Last Year Total Electricity Demand by Hour After Demand Altering Technologies[\
		Electricity Timeslice,Hour]/One Hour
	,
	
	Last Year Weighted Average Expected Capacity Factors by Hour Without Hypothetical Adjustments\
		[Electricity Source,Electricity Timeslice,Hour]
	    ,
	
	    0
	  )
	)
	~	Dmnl
	~		|

Marginal Capacity Factor by Hour for Hybrid Plants[Hybrid Electricity Source,Electricity Timeslice\
		,Hour,Clean Elec Requirement]=
	IF THEN ELSE(
	  Time = INITIAL TIME
	
	  :OR:
	
	   ABS(Last Year Electricity Generation Capacity[Hybrid Electricity Source])*MW Tolerance Unit Correction Factor\
		 < Tolerance,
	
	  Expected Capacity Factors by Hour for Hybrid Plants Built This Year[Hybrid Electricity Source\
		,Electricity Timeslice,Hour]
	  *  IF THEN ELSE(
	    SUM(
	      Last Year Weighted Average Expected Capacity Factors by Hour Without Hypothetical Adjustments\
		[Electricity Source!,Electricity Timeslice,Hour]
	      * Last Year Electricity Generation Capacity[Electricity Source!]
	      * Elec Portfolio Qualifying Sources[Electricity Source!,Clean Elec Requirement\
		]
	    )
	    < Last Year Total Electricity Demand by Hour After Demand Altering Technologies[\
		Electricity Timeslice,Hour]/One Hour
	,
	
	    1,
	
	    0),
	         
	
	  IF THEN ELSE(
	    SUM(
	      Last Year Weighted Average Expected Capacity Factors by Hour Without Hypothetical Adjustments\
		[Electricity Source!,Electricity Timeslice,Hour]
	      * Last Year Electricity Generation Capacity[Electricity Source!]
	      * Elec Portfolio Qualifying Sources[Electricity Source!,Clean Elec Requirement\
		]
	    )
	    < Last Year Total Electricity Demand by Hour After Demand Altering Technologies[\
		Electricity Timeslice,Hour]/One Hour
	,
	
	Expected Capacity Factors by Hour for Hybrid Plants Built This Year[Hybrid Electricity Source\
		,Electricity Timeslice,Hour]
	    ,
	
	    0
	  )
	)
	~	Dmnl
	~		|

Marginal Capacity Factor x Hours per Year[Electricity Source,Clean Elec Requirement]=
	SUM(
	  Marginal Capacity Factor by Hour[Electricity Source,Electricity Timeslice!,Hour!,Clean Elec Requirement\
		]
	  * SHELF Days per Electricity Timeslice[Electricity Timeslice!]
	  * One Hour
	)
	~	hours
	~		|

Marginal Capacity Factor x Hours per Year for Hybrid Power Plants[Hybrid Electricity Source\
		, Clean Elec Requirement]=
	SUM(
	  Marginal Capacity Factor by Hour for Hybrid Plants[Hybrid Electricity Source,Electricity Timeslice\
		!,Hour!,Clean Elec Requirement]
	  * SHELF Days per Electricity Timeslice[Electricity Timeslice!]
	  * One Hour
	)
	~	hours
	~		|

Marginal Carbon Price Factor for Cement=
	1
	~	Dmnl [0,1,0.01]
	~	Policy design setting for the cement module (no implementation schedule): \
		the share of the carbon price that acts on the margin in cement producers' \
		pathway and overhaul choices. One for a carbon tax and for benchmark-based \
		allocation systems (EU, California, Canada), where every marginal tonne \
		pays the full price. China's national ETS instead adjusts a plant's \
		allocation by 0.15 times its intensity deviation from the sector balance \
		value (capped at plus or minus 3 percent), so only about 15 percent of the \
		allowance price reaches the intensity margin: enter 0.15 for that rule. \
		Applies to the process-CO2 and kiln-fuel carbon terms of the pathway \
		operating costs only; the carbon tax actually paid is unchanged.
	|

Marginal Dispatch Cost by Hour[Electricity Timeslice,Hour]=
	IF THEN ELSE(ABS(SUM(Total Electricity Dispatched by Hour by Plant Type[Electricity Timeslice\
		,Hour,Electricity Source!]
	))*MWhr Tolerance Unit Correction Factor < Tolerance,EIaE Imported Electricity Price\
		,
	  IF THEN ELSE(
	    ABS(Electricity Market Price Adjusted for Zero Least Cost Dispatch Hours[Electricity Timeslice\
		,Hour])*Dollar per MWhr Tolerance Unit Correction Factor
	 < Tolerance
	    :OR: ABS(SUM(Electricity Dispatched by Least Cost by Hour[Electricity Timeslice,\
		Hour,Electricity Source!]))*MWhr Tolerance Unit Correction Factor
	 < Tolerance
	,
	
	    SUM(Dispatch Cost per Unit Electricity Output[Electricity Source!]*Share of Total Electricity Dispatched by Hour by Plant Type\
		[Electricity Timeslice,Hour,Electricity Source!]),
	
	    Electricity Market Price Adjusted for Zero Least Cost Dispatch Hours[Electricity Timeslice\
		,Hour]
	  )
	)
	~	$/(MW*hour)
	~		|

Material Efficiency Improvement[Source ISIC Code,Target ISIC Code] :EXCEPT: [Source ISIC Code\
		,Industry Category ISIC Code]=
	0 ~~|
Material Efficiency Improvement[Source ISIC Code,Industry Category ISIC Code] :EXCEPT:\
		 [Fossil and Energy Utility Source ISIC Code,Industry Category ISIC Code],[ISIC 239\
		,Industry Category ISIC Code]=
	Percent Reduction in Nonenergy Intermediate Inputs from Material Efficiency This Year\
		[Industry Category] ~~|
Material Efficiency Improvement[ISIC 239,Industry Category ISIC Code]=
	Percent Reduction in Nonenergy Intermediate Inputs from Material Efficiency This Year\
		[Industry Category]
	+ Cement Content Reduction in 239 Product Requirements ~~|
Material Efficiency Improvement[Fossil and Energy Utility Source ISIC Code,Industry Category ISIC Code\
		]=
	0
	~	Dmnl
	~	Fractional reduction in intermediate input requirements: the Source ISIC's \
		product per unit of the Target (buying) ISIC's output.  Driven by the \
		indst material efficiency policy lever, set per buying Industry Category \
		and applied uniformly to all of that industry's NON-ENERGY intermediate \
		inputs.  Energy-supplying Source ISICs (coal 05, oil and gas 06, refined \
		petroleum 19, electricity 351, pipelines and gas processing 352T353) are \
		structurally zero: industry energy purchases are modeled physically via \
		Industrial Fuel Use and already enter the industry expense passthrough \
		price signal, so a nonzero energy row here would double count.  Targets \
		outside the Industry Categories are zero (the policy applies to industries \
		only).  The ISIC 239 source row additionally carries the cement-content- \
		of-concrete lever (buyers need less cement per unit of their output - a \
		SUPPLIER-specified improvement, scaled by CSoIO to 239-product terms), so \
		that lever's buyer savings and supplier revenue loss book through this \
		standard machinery; its PHYSICAL cut is carried by the cement module and \
		divided back out of the production-percent fold-in - see Cement Content \
		Lever Component of 239 Output Change (2026-08-27).
	|

Material Efficiency Intermediate Cost Savings Share by ISIC Code[ISIC Code]=
	SUM(
	  Material Efficiency Improvement[Source ISIC Code!,ISIC Code]
	  * TIOT Total Input Output Table[Source ISIC Code!,ISIC Code]
	)
	~	Dmnl
	~	The reduction in intermediate input cost per dollar of the industry's \
		output caused by material efficiency, as a share of output value.  Because \
		TIOT coefficients are already dollars of input per dollar of output, no \
		denominator is needed.
	|

Material Efficiency Price Index by ISIC Code[ISIC Code] :EXCEPT: [Industry Category ISIC Code\
		]=
	1 ~~|
Material Efficiency Price Index by ISIC Code[Industry Category ISIC Code]=
	1
	- Material Efficiency Intermediate Cost Savings Share by ISIC Code[Industry Category ISIC Code\
		]
	  * SoCiIEPTtB Share of Change in Industry Expenses Passed Through to Buyers[Industry Category\
		]
	~	Dmnl
	~	The industry's output price relative to BAU under material efficiency: the \
		passed-through share of the intermediate cost savings lowers the unit \
		price of output.  Used to deflate output-denominated coefficients (jobs \
		and value added per unit output) so that nominal output changes caused by \
		the price decline do not register as changes in real activity.  Exact for \
		jobs at any passthrough share; exact for value added at 100% passthrough \
		(with partial passthrough the retained margin raises value added per unit, \
		a second-order effect not captured here).
	|

Max Achievable Annual CES this Year=
	SUM(
	  MIN(
	    Max Expected Hourly Output from CES Qualifying Resources Irrespective of Electricity Demand\
		[Electricity Timeslice!,Hour!],
	  Total Qualifying CES Electricity Demand by Hour After Demand Altering Technologies\
		[Electricity Timeslice!,Hour!])
	  * SHELF Days per Electricity Timeslice[Electricity Timeslice!]
	)
	/ SUM(
	    Total Qualifying CES Electricity Demand by Hour After Demand Altering Technologies\
		[Electricity Timeslice!,Hour!]
	    * SHELF Days per Electricity Timeslice[Electricity Timeslice!]
	  )
	~	Dmnl
	~		|

Max Achievable Annual RPS this Year=
	SUM(
	  MIN(
	    Max Expected Hourly Output from RPS Qualifying Resources Irrespective of Electricity Demand\
		[Electricity Timeslice!,
	Hour!],
	  Total Qualifying RPS Electricity Demand by Hour After Demand Altering Technologies\
		[Electricity Timeslice!,Hour!])
	  * SHELF Days per Electricity Timeslice[Electricity Timeslice!]
	)
	/ SUM(
	    Total Qualifying RPS Electricity Demand by Hour After Demand Altering Technologies\
		[Electricity Timeslice!,Hour!]
	    * SHELF Days per Electricity Timeslice[Electricity Timeslice!]
	  )
	~	Dmnl
	~		|

Max Achievable CES Hit by Optimization Pass[Optimization Pass] :EXCEPT:  [last pass]=
	IF THEN ELSE(
	  ABS(
	    Expected Achievable Annual CES by Optimization Pass[Optimization Pass]
	    - Max Achievable Annual CES this Year
	  ) < Tolerance
	  :AND:
	  Expected Achievable Annual CES by Optimization Pass[Optimization Pass]
	  <= Elec Portfolio Percentage to Seek This Year[CES],
	  1,
	  9999
	) ~~|
Max Achievable CES Hit by Optimization Pass[last pass]=
	9999
	~	Dmnl
	~		|

Max Achievable RPS Hit by Optimization Pass[Optimization Pass] :EXCEPT:  [last pass]=
	IF THEN ELSE(
	  ABS(
	    Expected Achievable Annual RPS by Optimization Pass[Optimization Pass]
	    - Max Achievable Annual RPS this Year
	  ) < Tolerance
	  :AND:
	  Expected Achievable Annual RPS by Optimization Pass[Optimization Pass]
	  <= Elec Portfolio Percentage to Seek This Year[RPS],
	  1,
	  9999
	) ~~|
Max Achievable RPS Hit by Optimization Pass[last pass]=
	9999
	~	Dmnl
	~		|

Max Additional Potential Capacity by Source[Electricity Source]=
	MAX(
	  0,
	
	  MPCbS Max Potential Capacity by Source[Electricity Source]
	  - Surviving Electricity Generation Capacity before Economic Retirements[Electricity Source\
		]
	)
	~	MW
	~		|

Max Capacity Available for CCUS Retrofit[Electricity Source] :EXCEPT:      [CCUS Electricity Source\
		]=
	0 ~~|
Max Capacity Available for CCUS Retrofit[hard coal w CCS es]=
	Surviving Electricity Generation Capacity before Economic Retirements[hard coal es] ~~|
Max Capacity Available for CCUS Retrofit[natural gas combined cycle w CCS es]=
	Surviving Electricity Generation Capacity before Economic Retirements[natural gas combined cycle es\
		] ~~|
Max Capacity Available for CCUS Retrofit[biomass w CCS es]=
	Surviving Electricity Generation Capacity before Economic Retirements[biomass es] ~~|
Max Capacity Available for CCUS Retrofit[lignite w CCS es]=
	Surviving Electricity Generation Capacity before Economic Retirements[lignite es]
	~	MW
	~		|

Max Capacity Available for CCUS Retrofits after Mandated Retrofits[Electricity Source\
		] :EXCEPT:      [CCUS Electricity Source]=
	MAX(0,
	  Max Capacity Available for CCUS Retrofit[Electricity Source]
	  -New Policy Mandated Retrofits[Electricity Source]
	 ) ~~|
Max Capacity Available for CCUS Retrofits after Mandated Retrofits[CCUS Electricity Source\
		]=
	MAX(0,(Max Capacity Available for CCUS Retrofit[CCUS Electricity Source]
	 - New Policy Mandated Retrofits[CCUS Electricity Source]))
	* IF THEN ELSE(
	    BBPPRTY BAU Ban Power Plant Retrofits This Year[CCUS Electricity Source]>0
	    :OR:
	    Boolean Ban New Power Plant Retrofits This Year[CCUS Electricity Source]>0,
	    0,
	    1
	  )
	~	MW
	~		|

Max Capacity Buildable after Cost Effective and RPS Additions[Electricity Source,Clean Elec Requirement\
		]=
	MAX(
	  0,
	
	  Max Capacity Buildable after Mandated and Required Clean Dispatchable Additions[Electricity Source\
		]
	  - New Capacity Desired due to Cost Effectiveness[Electricity Source,Clean Elec Requirement\
		]
	  - New Capacity Desired due to Cost Effectiveness for Hybrid Power Plants[Electricity Source\
		,Clean Elec Requirement]
	)
	~	MW
	~		|

Max Capacity Buildable after Mandated Additions[Electricity Source]=
	MAX(
	  0,
	
	  Max Capacity Buildable This Year[Electricity Source]
	  - New Policy Mandated Capacity[Electricity Source]
	)
	~	MW
	~		|

Max Capacity Buildable after Mandated and Required Clean Dispatchable Additions[Electricity Source\
		]=
	MAX(0,
	  Max Capacity Buildable after Mandated Additions[Electricity Source]
	 )
	~	MW
	~		|

Max Capacity Buildable This Year[Electricity Source]=
	IF THEN ELSE(
	
	  Boolean Ban New Power Plants This Year[Electricity Source] > 0
	  :OR:
	  BBNPPTY BAU Ban New Power Plants This Year[Electricity Source] > 0
	  :OR:
	  Boolean Plant Types that May Not be Built due to Having Been Retired to Zero[Electricity Source\
		] > 0,
	
	  0,
	
	  MIN(
	    Max Additional Potential Capacity by Source[Electricity Source],
	    Annual Electricity Capacity Build Limit[Electricity Source]
	  )
	)
	~	MW
	~		|

Max Capacity that Can be Retired Economically by Plant Type[Electricity Source]=
	MAX(0,
	SUM(
	  Last Year Electricity Generation Capacity by Vintage[Electricity Source,Modeled Vintage\
		!]
	  * Retirable Vintages by Year[Modeled Vintage!]
	)
	  - Planned and Policy Mandated Capacity Retirements[Electricity Source])
	~	MW
	~		|

Max Expected Hourly Output from CES Qualifying Resources Irrespective of Electricity Demand\
		[Electricity Timeslice,Hour]=
	Expected CES Qualifying Hourly Output from Surviving Capacity[Electricity Timeslice,\
		Hour]
	+ Expected CES Qualifying Hourly Output from Mandated and Required Clean Dispatchable Capacity\
		[Electricity Timeslice
	,Hour]
	+ Max Potential CES Qualifying Hourly Output from New Cost Effective Capacity[Electricity Timeslice\
		,Hour]
	~	MW*hour
	~		|

Max Expected Hourly Output from RPS Qualifying Resources Irrespective of Electricity Demand\
		[Electricity Timeslice,Hour]=
	Expected RPS Qualifying Hourly Output from Surviving Capacity[Electricity Timeslice,\
		Hour]
	+ Expected RPS Qualifying Hourly Output from Mandated and Required Clean Dispatchable Capacity\
		[Electricity Timeslice
	,Hour]
	+ Max Potential RPS Qualifying Hourly Output from New Cost Effective Capacity[Electricity Timeslice\
		,Hour]
	~	MW*hour
	~		|

Max Incremental Revenue for Cost Effective CCUS Retrofits for RPS and CES[CCUS Electricity Source\
		,Clean Elec Requirement]=
	MAX(0,
	  Predicted Change in Energy Market Revenue for CCUS Retrofits[CCUS Electricity Source\
		]
	  +Max RPS and CES Revenue at Marginal Capacity Factors[CCUS Electricity Source,Clean Elec Requirement\
		]
	  -(Cost per MW for CCUS Retrofits Excluding Subsidies[CCUS Electricity Source]
	    * SoCtMbCtbDP Share of Costs that Must be Covered to Be Deemed Profitable[CCUS Electricity Source\
		]
	  )
	)
	~	$/MW
	~		|

Max Incremental Revenue for Cost Effectiveness Additions for Hybrid Power Plants for RPS and CES\
		[Hybrid Electricity Source,Clean Elec Requirement]=
	MAX(0,
	  Average Four Year Prior Net Energy Market Revenue by Plant Type Excluding Subsidies for Hybrid Power Plants\
		[Hybrid Electricity Source
	]
	  +Max RPS and CES Revenue at Marginal Capacity Factors for Hybrid Power Plants[Hybrid Electricity Source\
		,Clean Elec Requirement]
	  -(Annualized Fixed Costs per Unit New Capacity[Hybrid Electricity Source]+Annual Financing Repayment per Unit Storage Capacity for Hybrid Power Plants
	[Hybrid Electricity Source])
	    * SoCtMbCtbDP Share of Costs that Must be Covered to Be Deemed Profitable[Hybrid Electricity Source\
		]
	  )
	~	$/MW
	~		|

Max Incremental Revenue for Cost Effectiveness Additions for RPS and CES[Electricity Source\
		,Clean Elec Requirement]=
	MAX(0,
	      Average Four Year Prior Total Predicted Net Energy Market Revenue per MW for New Entrants\
		[Electricity Source]
	      +Max RPS and CES Revenue at Marginal Capacity Factors[Electricity Source,Clean Elec Requirement\
		]
	      -(Annualized Fixed Costs per Unit New Capacity[Electricity Source]
	         * SoCtMbCtbDP Share of Costs that Must be Covered to Be Deemed Profitable
	[Electricity Source]
	      )
	    )
	~	$/MW
	~		|

Max Net Electricity Supply Relative to Demand[Electricity Timeslice]=
	VMAX(Net Electricity Supply Relative to Demand by Hour[Electricity Timeslice,Hour!])
	~	MW*hr
	~	Per-timeslice max over hours of net supply relative to demand \
		(highest-surplus hour). Computed once; rebases the allocation weights so \
		they are non-negative and span all hours.
	|

Max New Capacity Desired due to Cost Effectiveness for Hybrid Power Plants for RPS and CES Before Hybrid Prioritization\
		[Hybrid Electricity Source,Clean Elec Requirement]=
	Max Profitable Capacity for Cost Effectiveness Additions for Hybrid Power Plants for RPS and CES\
		[Hybrid Electricity Source
	,Clean Elec Requirement]
	* CSCSoCECBiaSY Share of Cost Effective Capacity Built in a Single Year[Hybrid Electricity Source\
		]
	~	MW
	~		|

Max New Capacity Desired due to Cost Effectivness for Hybrid Power Plants for RPS and CES\
		[Electricity Source,Clean Elec Requirement] :EXCEPT:           [Hybrid Electricity Source\
		,Clean Elec Requirement]=
	0 ~~|
Max New Capacity Desired due to Cost Effectivness for Hybrid Power Plants for RPS and CES\
		[Hybrid Electricity Source,Clean Elec Requirement]=
	QUANTUM(
	
	  IF THEN ELSE(
	
	    Max Profitable Capacity for Cost Effectiveness Additions for RPS and CES Before Hybrid Prioritization\
		[Hybrid Electricity Source,Clean Elec Requirement]
	    + Max New Capacity Desired due to Cost Effectiveness for Hybrid Power Plants for RPS and CES Before Hybrid Prioritization\
		[Hybrid Electricity Source,Clean Elec Requirement]
	    > Max Capacity Buildable after Mandated and Required Clean Dispatchable Additions\
		[Hybrid Electricity Source],
	
	 
	  Max Capacity Buildable after Mandated and Required Clean Dispatchable Additions[Hybrid Electricity Source\
		]
	  * 
	  ZIDZ(
	    Max New Capacity Desired due to Cost Effectiveness for Hybrid Power Plants for RPS and CES Before Hybrid Prioritization\
		[Hybrid Electricity Source,Clean Elec Requirement],
	    Max New Capacity Desired due to Cost Effectiveness for Hybrid Power Plants for RPS and CES Before Hybrid Prioritization\
		[Hybrid Electricity Source,Clean Elec Requirement]
	    + Max Profitable Capacity for Cost Effectiveness Additions for RPS and CES Before Hybrid Prioritization\
		[Hybrid Electricity Source,Clean Elec Requirement]
	  ),
	  Max New Capacity Desired due to Cost Effectiveness for Hybrid Power Plants for RPS and CES Before Hybrid Prioritization\
		[Hybrid Electricity Source,Clean Elec Requirement]
	),
	  
	MPPC Minimum Power Plant Capacity[Hybrid Electricity Source]
	)
	~	MW
	~		|

Max New Capacity Desired due to Cost Effectivness for RPS and CES[Electricity Source,\
		Clean Elec Requirement] :EXCEPT:  [Hybrid Electricity Source,Clean Elec Requirement\
		]=
	QUANTUM(
	  MIN(
	    Max Capacity Buildable after Mandated and Required Clean Dispatchable Additions[\
		Electricity Source],
	
	    Max Profitable Capacity for Cost Effectiveness Additions for RPS and CES Before Hybrid Prioritization\
		[Electricity Source,Clean Elec Requirement]
	  ),
	 MPPC Minimum Power Plant Capacity[Electricity Source]
	) ~~|
Max New Capacity Desired due to Cost Effectivness for RPS and CES[Hybrid Electricity Source\
		,Clean Elec Requirement]=
	QUANTUM(
	
	  IF THEN ELSE(
	
	    Max Profitable Capacity for Cost Effectiveness Additions for RPS and CES Before Hybrid Prioritization\
		[Hybrid Electricity Source,Clean Elec Requirement]
	    + Max New Capacity Desired due to Cost Effectiveness for Hybrid Power Plants for RPS and CES Before Hybrid Prioritization\
		[Hybrid Electricity Source,Clean Elec Requirement]
	    > Max Capacity Buildable after Mandated and Required Clean Dispatchable Additions\
		[Hybrid Electricity Source],
	
	 
	  Max Capacity Buildable after Mandated and Required Clean Dispatchable Additions[Hybrid Electricity Source\
		]
	  * 
	  ZIDZ(
	    Max Profitable Capacity for Cost Effectiveness Additions for RPS and CES Before Hybrid Prioritization\
		[Hybrid Electricity Source,Clean Elec Requirement],
	    Max New Capacity Desired due to Cost Effectiveness for Hybrid Power Plants for RPS and CES Before Hybrid Prioritization\
		[Hybrid Electricity Source,Clean Elec Requirement]
	    + Max Profitable Capacity for Cost Effectiveness Additions for RPS and CES Before Hybrid Prioritization\
		[Hybrid Electricity Source,Clean Elec Requirement]
	  ),
	  Max Profitable Capacity for Cost Effectiveness Additions for RPS and CES Before Hybrid Prioritization\
		[Hybrid Electricity Source,Clean Elec Requirement]
	),
	  
	MPPC Minimum Power Plant Capacity[Hybrid Electricity Source]
	)
	~	MW
	~		|

Max Potential CES Qualifying Hourly Output from New Cost Effective Capacity[Electricity Timeslice\
		,Hour]=
	SUM(
	  Max New Capacity Desired due to Cost Effectivness for RPS and CES[Electricity Source\
		!,CES]
	   * Last Year Hourly Bid Electricity Capacity Factors by Plant Type[Electricity Timeslice\
		,Hour,Electricity Source!]
	   * Elec Portfolio Qualifying Sources[Electricity Source!,CES]
	  * (1-TACFMfPBTY Time Adjusted Capacity Factor Multiplier for Plants Built This Year\
		[Electricity Source!])
	) * One Hour
	        
	+ SUM(
	  Max Retrofitted Capacity Desired due to Cost Effectiveness for RPS and CES[Electricity Source\
		!,CES]
	  * Last Year Hourly Bid Electricity Capacity Factors by Plant Type[Electricity Timeslice\
		,Hour,Electricity Source!]
	  * Elec Portfolio Qualifying Sources[Electricity Source!,CES]
	  * (1-TACFMfPBTY Time Adjusted Capacity Factor Multiplier for Plants Built This Year\
		[Electricity Source!])
	) * One Hour
	        
	       + SUM(Max New Capacity Desired due to Cost Effectivness for Hybrid Power Plants for RPS and CES\
		[Hybrid Electricity Source
	!,CES]
	        * Expected Capacity Factors by Hour for Hybrid Plants Built This Year[Hybrid Electricity Source\
		!,Electricity Timeslice
	,Hour]
	        * Elec Portfolio Qualifying Sources[Hybrid Electricity Source!,CES]
	       *(1-TACFMfPBTY Time Adjusted Capacity Factor Multiplier for Plants Built This Year\
		[Hybrid Electricity Source!])
	) * One Hour
	~	MW*hour
	~		|

Max Potential RPS Qualifying Hourly Output from New Cost Effective Capacity[Electricity Timeslice\
		,Hour]=
	SUM(
	  Max New Capacity Desired due to Cost Effectivness for RPS and CES[Electricity Source\
		!,RPS]
	   * Last Year Hourly Bid Electricity Capacity Factors by Plant Type[Electricity Timeslice\
		,Hour,Electricity Source!]
	   * Elec Portfolio Qualifying Sources[Electricity Source!,RPS]
	  * (1-TACFMfPBTY Time Adjusted Capacity Factor Multiplier for Plants Built This Year\
		[Electricity Source!])
	) * One Hour
	        
	+ SUM(
	  Max Retrofitted Capacity Desired due to Cost Effectiveness for RPS and CES[Electricity Source\
		!,RPS]
	  * Last Year Hourly Bid Electricity Capacity Factors by Plant Type[Electricity Timeslice\
		,Hour,Electricity Source!]
	  * Elec Portfolio Qualifying Sources[Electricity Source!,RPS]
	  * (1-TACFMfPBTY Time Adjusted Capacity Factor Multiplier for Plants Built This Year\
		[Electricity Source!])
	) * One Hour
	        
	       + SUM(Max New Capacity Desired due to Cost Effectivness for Hybrid Power Plants for RPS and CES\
		[Hybrid Electricity Source
	!,RPS]
	        * Expected Capacity Factors by Hour for Hybrid Plants Built This Year[Hybrid Electricity Source\
		!,Electricity Timeslice
	,Hour]
	        * Elec Portfolio Qualifying Sources[Hybrid Electricity Source!,RPS]
	       *(1-TACFMfPBTY Time Adjusted Capacity Factor Multiplier for Plants Built This Year\
		[Hybrid Electricity Source!])
	) * One Hour
	~	MW*hour
	~		|

Max Profitable Capacity for Cost Effective CCUS Retrofits for RPS and CES[CCUS Electricity Source
,Clean Elec Requirement]=
	IF THEN ELSE(
	  Max Incremental Revenue for Cost Effective CCUS Retrofits for RPS and CES[CCUS Electricity Source\
		,Clean Elec Requirement
	] < 1,
	  0,
	  (1-exp(-((  Max Incremental Revenue for Cost Effective CCUS Retrofits for RPS and CES\
		[CCUS Electricity Source,Clean Elec Requirement
	]/Capacity Supply Curve Parameters by Power Plant Type[cutoff parameter,CCUS Electricity Source\
		] / One Dollar per MW-(Capacity Supply Curve Parameters by Power Plant Type[location parameter\
		,CCUS Electricity Source]-0.5))/Capacity Supply Curve Parameters by Power Plant Type\
		[scale parameter,CCUS Electricity Source])^Capacity Supply Curve Parameters by Power Plant Type\
		[shape parameter,CCUS Electricity Source]))*Capacity Supply Curve Parameters by Power Plant Type\
		[saturation,CCUS Electricity Source] * One MW
	)
	~	MW
	~		|

Max Profitable Capacity for Cost Effectiveness Additions for Hybrid Power Plants for RPS and CES\
		[Hybrid Electricity Source,Clean Elec Requirement]=
	IF THEN ELSE(
	  Max Incremental Revenue for Cost Effectiveness Additions for Hybrid Power Plants for RPS and CES\
		[Hybrid Electricity Source,Clean Elec Requirement
	] < 1,
	  0,
	  (1-exp(-((  Max Incremental Revenue for Cost Effectiveness Additions for Hybrid Power Plants for RPS and CES\
		[Hybrid Electricity Source,Clean Elec Requirement
	]/Capacity Supply Curve Parameters by Power Plant Type[cutoff parameter,Hybrid Electricity Source\
		] / One Dollar per MW-(Capacity Supply Curve Parameters by Power Plant Type[location parameter\
		,Hybrid Electricity Source]-0.5))/Capacity Supply Curve Parameters by Power Plant Type\
		[scale parameter,Hybrid Electricity Source])^Capacity Supply Curve Parameters by Power Plant Type\
		[shape parameter,Hybrid Electricity Source]))*Capacity Supply Curve Parameters by Power Plant Type\
		[saturation,Hybrid Electricity Source] * One MW
	)
	~	MW
	~		|

Max Profitable Capacity for Cost Effectiveness Additions for RPS and CES[Electricity Source
,Clean Elec Requirement]=
	IF THEN ELSE(
	  Max Incremental Revenue for Cost Effectiveness Additions for RPS and CES[Electricity Source\
		,Clean Elec Requirement] < 1,
	  0,
	  (1-exp(-((  Max Incremental Revenue for Cost Effectiveness Additions for RPS and CES\
		[Electricity Source,Clean Elec Requirement]/Capacity Supply Curve Parameters by Power Plant Type\
		[cutoff parameter,Electricity Source] / One Dollar per MW-(Capacity Supply Curve Parameters by Power Plant Type\
		[location parameter,Electricity Source]-0.5))/Capacity Supply Curve Parameters by Power Plant Type\
		[scale parameter,Electricity Source])^Capacity Supply Curve Parameters by Power Plant Type\
		[shape parameter,Electricity Source]))*Capacity Supply Curve Parameters by Power Plant Type\
		[saturation,Electricity Source] * One MW
	)
	~	MW
	~		|

Max Profitable Capacity for Cost Effectiveness Additions for RPS and CES Before Hybrid Prioritization\
		[Electricity Source,Clean Elec Requirement]=
	Max Profitable Capacity for Cost Effectiveness Additions for RPS and CES[Electricity Source\
		,Clean Elec Requirement]
	    * CSCSoCECBiaSY Share of Cost Effective Capacity Built in a Single Year[Electricity Source\
		]
	~	MW
	~		|

Max Retrofitted Capacity Desired due to Cost Effectiveness for RPS and CES[Electricity Source\
		,Clean Elec Requirement] :EXCEPT:        [CCUS Electricity Source,Clean Elec Requirement\
		]=
	0 ~~|
Max Retrofitted Capacity Desired due to Cost Effectiveness for RPS and CES[CCUS Electricity Source\
		,Clean Elec Requirement]=
	QUANTUM(
	  MIN(
	    Max Capacity Available for CCUS Retrofits after Mandated Retrofits[CCUS Electricity Source\
		],
	
	    Max Profitable Capacity for Cost Effective CCUS Retrofits for RPS and CES[CCUS Electricity Source\
		,Clean Elec Requirement]
	    * CSCSoCECBiaSY Share of Cost Effective Capacity Built in a Single Year[CCUS Electricity Source\
		]
	  ),
	 MPPC Minimum Power Plant Capacity[CCUS Electricity Source]
	 )
	~	MW
	~		|

Max RPS and CES Revenue at Marginal Capacity Factors[Electricity Source,Clean Elec Requirement\
		]=
	Elec Portfolio Qualifying Sources[Electricity Source,Clean Elec Requirement]
	*Marginal Capacity Factor x Hours per Year[Electricity Source,Clean Elec Requirement\
		]
	*Elec Portfolio Alternative Compliance Payment
	~	$/MW
	~		|

Max RPS and CES Revenue at Marginal Capacity Factors for Hybrid Power Plants[Hybrid Electricity Source\
		,Clean Elec Requirement]=
	Marginal Capacity Factor x Hours per Year for Hybrid Power Plants[Hybrid Electricity Source\
		,Clean Elec Requirement]
	*Elec Portfolio Alternative Compliance Payment
	*Elec Portfolio Qualifying Sources[Hybrid Electricity Source,Clean Elec Requirement]
	~	$/MW
	~		|

Max Slope of Line Approaching Future Elec Portfolio Standard[Clean Elec Requirement]=
	VMAX(
	  Slope of Line Approaching Future Elec Portfolio Percentages by Year[Future Year!,Clean Elec Requirement\
		]
	)
	~	Dmnl
	~		|

Maximum Absolute Increase in Fuel Exports[All Fuels]=
	Initial BAU Fuel Production Imports and Exports[All Fuels,exports]
	* MPIiFE Maximum Percentage Increase in Fuel Exports[All Fuels]
	~	BTU
	~		|

Maximum Absolute Increase in Fuel Imports[All Fuels]=
	Initial BAU Fuel Production Imports and Exports[All Fuels,imports]
	* MPIiFI Maximum Percentage Increase in Fuel Imports[All Fuels]
	~	BTU
	~		|

Maximum Absolute Increase in Fuel Production[All Fuels]=
	Initial BAU Fuel Production Imports and Exports[All Fuels,production]
	* MPIiFP Maximum Percentage Increase in Fuel Production[All Fuels]
	~	BTU
	~		|

Maximum Achievable Binding Hour Supply for Dispatchable Reliability[Optimization Pass\
		]=
	SUM(
	  (Electricity Generation Capacity before Reliability Additions[Electricity Source!]
	   + MAX(0,
	       MIN(
	         Max Capacity Buildable after Cost Effective and RPS Additions[Electricity Source\
		!,CES],
	         Capacity Supply Curve Parameters by Power Plant Type[saturation,Electricity Source\
		!] * One MW
	           * CSCSoCECBiaSY Share of Cost Effective Capacity Built in a Single Year[Electricity Source\
		!]
	         - Total New Capacity Desired due to Cost Effectiveness[Electricity Source!,\
		CES]
	       )
	     )
	     * MAX(
	         Last Year New Entry Reliability Credit Relaxation Share,
	         IF THEN ELSE(
	           Five Year Foresight Elec Portfolio Values for Reliability Check[RPS]=1,
	           Elec Portfolio Qualifying Sources[Electricity Source!,RPS],
	           IF THEN ELSE(
	             Five Year Foresight Elec Portfolio Values for Reliability Check[CES]=1,
	             Elec Portfolio Qualifying Sources[Electricity Source!,CES],
	             1
	           )
	         )
	       )
	  )
	  * Last Year Hourly Bid Electricity Capacity Factors for Reliability in Binding Hour by Plant Type\
		[Electricity Source!
	]
	)
	* One Hour
	+ New Grid Battery Capacity Deployed for Seasonal Dispatchable Reliability by Optimization Pass\
		[Optimization Pass]
	  * ESTRTE Grid Battery Round Trip Efficiency
	  / GBSC Diurnal Grid Battery Daily Storage Duration
	  * One Hour
	~	MW*hour
	~		|

Maximum Annual Decrease in Demand from Diurnal Grid Batteries=
	SUM(
	  Last Year Grid and Hybrid Battery Storage Available for Load Shifting[Electricity Timeslice\
		!]
	  * SHELF Days per Electricity Timeslice[Electricity Timeslice!]
	  * ESTRTE Grid Battery Round Trip Efficiency
	)
	~	MW*hour
	~		|

Maximum Annual Decrease in Demand from EVs=
	Maximum Daily Quantity of Electricity Charged by EVs for Diurnal Balancing
	* ESTRTE Grid Battery Round Trip Efficiency
	* Days per Year
	~	MW*hour
	~		|

Maximum Annual Decrease in Demand from Pumped Hydro=
	SUM(Maximum Daily Quantity of Electricity Charged by Pumped Hydro[Electricity Timeslice\
		!]
	  * SHELF Days per Electricity Timeslice[Electricity Timeslice!]
	  )
	* ESTRTE Pumped Hydro Round Trip Efficiency
	~	MW*hour
	~		|

Maximum Annual Decrease in Demand from Seasonal Electricity Storage=
	Maximum Annual Quantity of Electricity Charged by Seasonal Electricity Storage
	* SES Seasonal Electricity Storage Round Trip Efficiency
	~	MW*hour
	~		|

Maximum Annual Quantity of Electricity Absorbed for Seasonal Balancing=
	Maximum Annual Quantity of Electricity Charged by Seasonal Electricity Storage
	* RAF Regional Availability Factor for Demand Altering Technologies
	~	MW*hr
	~		|

Maximum Annual Quantity of Electricity Absorbed for Seasonal Net Peak Load Reduction=
	Maximum Annual Quantity of Electricity Absorbed for Seasonal Balancing
	~	MW*hr
	~		|

Maximum Annual Quantity of Electricity Charged by Seasonal Electricity Storage=
	SES Seasonal Electricity Storage Capacity
	* SES Seasonal Electricity Storage Annual Charge and Discharge Cycles
	~	MW*hr
	~		|

Maximum Capacity Factor after RAF[Electricity Source]=
	MCF Maximum Capacity Factor[Electricity Source]
	* RAF Regional Availability Factor for Generation[Electricity Source]
	~	Dmnl
	~		|

Maximum Daily Quantity of Electricity Absorbed for Diurnal Balancing[Electricity Timeslice\
		]=
	(
	  Last Year Grid and Hybrid Battery Storage Available for Load Shifting[Electricity Timeslice\
		]
	  + Maximum Daily Quantity of Electricity Charged by EVs for Diurnal Balancing
	  + Maximum Daily Quantity of Electricity Charged by Pumped Hydro[Electricity Timeslice\
		]
	)
	* RAF Regional Availability Factor for Demand Altering Technologies
	~	MW*hr
	~		|

Maximum Daily Quantity of Electricity Absorbed for Diurnal Net Peak Load Reduction[Electricity Timeslice\
		]=
	Maximum Daily Quantity of Electricity Absorbed for Diurnal Balancing[Electricity Timeslice\
		]
	~	MW*hr
	~		|

Maximum Daily Quantity of Electricity Charged by EVs for Diurnal Balancing=
	Total EV Battery Capacity
	* Fraction of EVs Used for Grid Balancing on Average Day
	* BEVGB Fraction of EV Battery Capacity Used for Grid Balancing when EV is Used for Grid Balancing
	~	MW*hr
	~		|

Maximum Daily Quantity of Electricity Charged by Pumped Hydro[Electricity Timeslice]=
	BPHC BAU Pumped Hydro Capacity
	* SUM(SYSHECF Start Year Seasonal Expected Capacity Factor for Pumped Hydro[Electricity Timeslice\
		,Hour!])
	* One Hour
	~	MW*hr
	~		|

Maximum Daily Quantity of Electricity Reduced by Demand Response Programs[peak day electricity timeslice\
		]=
	This Year Demand Response Capacity
	* DRC Average DR Hours per Day on Which DR is Called Upon ~~|
Maximum Daily Quantity of Electricity Reduced by Demand Response Programs[average day electricity timeslice\
		]=
	0
	~	MW*hr
	~	We assume that DR can be called upon for every peak day (i.e. at least the \
		five peak summer and five peak winter days).  In the U.S., an average \
		number of DR days per year is 24, more than enough to be used on all peak \
		days.
	|

Maximum Daily Quantity of Electricity Reduced by Demand Response Programs for Net Peak Load Reduction\
		[Electricity Timeslice]=
	Maximum Daily Quantity of Electricity Reduced by Demand Response Programs[Electricity Timeslice\
		]
	~	MW*hr
	~		|

Maximum Loading Multiplier[Vehicle Type,Cargo Type]=
	MAX(1, XIDZ(1, BAU Vehicle Utilization Rate[Vehicle Type,Cargo Type], 1))
	~	Dmnl
	~		|

Maximum Possible LCFS Percentage=
	ZIDZ(
	  SUM(Carbon Free Energy in Absence of LCFS by Vehicle Type[Vehicle Type!,Cargo Type\
		!,Vehicle Technology!,Transportation Fuel!])
	    + SUM(Quantity Carbon Free Energy May be Increased by Fuel by Regulated Vehicle Type\
		[Vehicle Type!,Cargo Type!,Transportation Fuel!]),
	
	  SUM(Fuel that would be Used by Regulated Vehicle Types in Absence of LCFS with Elec Eff Adj\
		[Vehicle Type!,Cargo Type!,Vehicle Technology!,Transportation Fuel!])
	)
	~	Dmnl
	~		~	:SUPPLEMENTARY 
	|

Maximum Potential Binding Hour Electricity Output by Hour for Dispatchable Reliability\
		[Optimization Pass]=
	(SUM(
	 Total Electricity Generation Capacity by Optimization Pass for Seasonal Dispatchable Reliability\
		[Electricity Source!,Optimization Pass
	]
	  * Last Year Hourly Bid Electricity Capacity Factors for Reliability in Binding Hour by Plant Type\
		[Electricity Source!
	]
	 )
	
	
	+(New Grid Battery Capacity Deployed for Seasonal Dispatchable Reliability by Optimization Pass\
		[Optimization Pass]
	  *ESTRTE Grid Battery Round Trip Efficiency
	  /GBSC Diurnal Grid Battery Daily Storage Duration)
	)
	* One Hour
	~	MW*hr
	~		|

Maximum Vehicle Loading[Vehicle Type,Cargo Type]=
	ZIDZ(
	  SYAVLo Start Year Average Vehicle Loading[Cargo Type,Vehicle Type],
	  SYVUR Start Year Vehicle Utilization Rate[Vehicle Type,Cargo Type]
	)
	~	things
	~		|

