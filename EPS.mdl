MPPC Minimum Power Plant Capacity[Electricity Source]=
	GET DIRECT CONSTANTS(
	   'InputData/elec/MPPC/MPPC.csv',
	   ',',
	   'B2*'
	)
	~	MW
	~		|

MSCdtRPbQL Market Share Changes due to Rebate Program by Quality Level[Building Component Quality\
		]=
	GET DIRECT CONSTANTS(
	   'InputData/bldgs/MSCdtRPbQL/MSCdtRPbQL.csv',
	   ',',
	   'B2'
	)
	~	Dmnl
	~		|

MSfFIEF Minimum Shareweight for Feasible Industrial Equipment Fuels=
	GET DIRECT CONSTANTS(
	   'InputData/indst/FIEF/MSfFIEF.csv',
	   ',',
	   'B2'
	)
	~	Dmnl
	~	The epsilon floor applied to floor-eligible fuel and process pairs in \
		Effective Industrial Equipment Shareweights. Central value 0.001: at the \
		logit exponent of -6, a floored fuel needs roughly a 3.2x cost per unit \
		service advantage to reach share parity with an incumbent (0.0001 needs \
		4.6x, 0.01 needs 2.2x), and its BAU share is approximately the floor value \
		itself. Zero disables the floor and reproduces the unfloored model exactly.
	|

MSoCRiaSY Maximum Share of Capacity Retired in a Single Year[Electricity Source]=
	GET DIRECT CONSTANTS(
	   'InputData/elec/MSoCRiaSY/MSoCRiaSY.csv',
	   ',',
	   'B2*'
	)
	~	Dmnl
	~		|

MW per GW=
	1000
	
	{
	Wikipedia
	List of SI Prefixes
	https://en.wikipedia.org/wiki/Metric_prefix#List_of_SI_prefixes
	}
	~	MW/GW
	~		|

MW Tolerance Unit Correction Factor=
	1
	~	1/MW
	~		|

MWh per BTU=
	2.931e-07
	
	{
	Google Unit Converter
	https://www.google.com/search?q=mwh+per+btu
	}
	~	MW*hour/BTU
	~	This variable is used in several places in the model where a direct unit \
		conversion (not a change of energy carrier) is needed.  It converts \
		between 1 BTU of electricity and 1 MWh of electricity.  Since this is a \
		strict unit conversion, there is no efficiency loss, and this value \
		applies globally (to all countries that may be modeled).
	|

MWh per TWh=
	1e+06
	~	MW*hour/(TW*hr)
	~		|

MWhr Tolerance Unit Correction Factor=
	1
	~	1/(MW*hr)
	~		|

