Waste Heat Availability Index[Industry Category]=
	IF THEN ELSE(
	  Start Year Industrial Heat Fuel Intensity for Measures[Industry Category] <= 0,

	  1,

	  MIN(1,
	    Industrial Heat Fuel Intensity for Measures[Industry Category]
	    / Start Year Industrial Heat Fuel Intensity for Measures[Industry Category]
	  )
	)
	~	Dmnl
	~	Scales waste heat measure savings potentials down as heating-process fuel \
		intensity falls below its start-year level, so unit-level efficiency gains \
		(including burner-integral heat recovery driven by equipment standards) \
		shrink the remaining system-level waste heat recovery potential.  \
		First-order proxy for the decline in recoverable waste heat per unit of \
		remaining fuel use.  Industries with no heating-process fuel use in the \
		start year default to 1 rather than 0, so the index never fabricates a \
		zero multiplier if such an industry later gains heating fuel use or \
		potential.
	|

Waste Heat Measure:
	GET DIRECT SUBSCRIPT(
	   'InputData/indst/PEaWHRP/PEaWHRP-WM.csv',
	   ',',
	   'A2',
	   'A',
	   ''
	)
	~	
	~	Generic slots for industry waste heat recovery measures.  Unused slots \
		carry zero savings potential and are inert.
	|

Waste Heat Measure Capital Cost per Unit Annual Energy Saved after Capital Subsidy[Industry Category\
		,Waste Heat Measure]=
	WHMCC Waste Heat Measure Capital Cost per Unit Annual Energy Saved[Industry Category\
		,Waste Heat Measure]
	* (1 - Perc Subsidy for Waste Heat Measure Capital Cost This Year[Industry Category]\
		)
	~	$/BTU
	~	Capital cost of each waste heat measure per BTU of annual energy savings \
		capacity, net of the capital cost subsidy.  Used only in the payback-based \
		adoption decision; financing and cash flows are computed on the gross \
		capital cost.
	|

Waste Heat Measure Capital Subsidy Amount Paid[Industry Category]=
	New Waste Heat Measure Capital Expenditures[Industry Category]
	* Perc Subsidy for Waste Heat Measure Capital Cost This Year[Industry Category]
	~	$
	~	Government payments covering the subsidized share of the capital cost of \
		waste heat measure equipment installed this year.  Firms still pay and \
		finance the gross capital cost; the subsidy arrives as a government \
		transfer, mirroring the clean industrial heat investment subsidy \
		convention.
	|

Waste Heat Measure Deployment Retired This Year[Industry Category,Waste Heat Measure,\
		Measure Cost Level]= DELAY FIXED(
	New Waste Heat Measure Deployment This Year[Industry Category,Waste Heat Measure,Measure Cost Level\
		],
	WHMEL Waste Heat Measure Equipment Lifetime[Industry Category,Waste Heat Measure],
	0)
	~	Dmnl
	~	Deployed savings retire at the end of each measure's lifetime, re-opening \
		potential for redeployment.
	|

Waste Heat Measure Energy Savings This Year[Industry Category]=
	Waste Heat Availability Index[Industry Category]
	* SUM(
	    Deployed Fraction of Waste Heat Measure Potential[Industry Category,Waste Heat Measure\
		!,Measure Cost Level!]
	    * MCLS Measure Cost Level Share[Measure Cost Level!]
	    * (WHMFSP Waste Heat Measure Fuel Savings Potential[Industry Category,Waste Heat Measure\
		!]
	       * Industrial Heat Combustion Fuel Base for Measures[Industry Category]
	       + WHMESP Waste Heat Measure Elec Savings Potential[Industry Category,Waste Heat Measure\
		!]
	       * Industrial Heat Electricity Base for Measures[Industry Category])
	  )
	~	BTU
	~	Energy saved this year by deployed waste heat measures.  Basis for OM \
		costs and performance subsidy payments.
	|

Waste Heat Measure OM Expenditures[Industry Category]=
	Waste Heat Availability Index[Industry Category]
	* SUM(
	    Deployed Fraction of Waste Heat Measure Potential[Industry Category,Waste Heat Measure\
		!,Measure Cost Level!]
	    * MCLS Measure Cost Level Share[Measure Cost Level!]
	    * (WHMFSP Waste Heat Measure Fuel Savings Potential[Industry Category,Waste Heat Measure\
		!]
	       * Industrial Heat Combustion Fuel Base for Measures[Industry Category]
	       + WHMESP Waste Heat Measure Elec Savings Potential[Industry Category,Waste Heat Measure\
		!]
	       * Industrial Heat Electricity Base for Measures[Industry Category])
	    * WHMOC Waste Heat Measure OM Cost per Unit Energy Saved[Industry Category,Waste Heat Measure\
		!]
	  )
	~	$
	~	Annual OM cost of deployed waste heat measures, at unadjusted input costs \
		(cost level multipliers affect the deployment decision only).
	|

Waste Heat Measure Performance Subsidy[Industry Category]=
	0,	{agriculture and forestry 01T03}
	0,	{coal mining 05}
	0,	{oil and gas extraction 06}
	0,	{other mining and quarrying 07T08}
	0,	{food beverage and tobacco 10T12}
	0,	{textiles apparel and leather 13T15}
	0,	{wood products 16}
	0,	{pulp paper and printing 17T18}
	0,	{refined petroleum and coke 19}
	0,	{chemicals 20}
	0,	{rubber and plastic products 22}
	0,	{glass and glass products 231}
	0,	{cement and other nonmetallic minerals 239}
	0,	{iron and steel 241}
	0,	{other metals 242}
	0,	{metal products except machinery and vehicles 25}
	0,	{computers and electronics 26}
	0,	{appliances and electrical equipment 27}
	0,	{other machinery 28}
	0,	{road vehicles 29}
	0,	{nonroad vehicles 30}
	0,	{other manufacturing 31T33}
	0,	{energy pipelines and gas processing 352T353}
	0,	{water and waste 36T39}
	0	{construction 41T43}
	~	output currency unit/output TPE unit [0,20,0.25]
	~	Subsidy paid per MMBtu of annual energy savings delivered by deployed \
		waste heat measures.  Adds to the value of measures in the \
		cost-effectiveness screen and is paid out as a government cash flow.
	|

Waste Heat Measure Performance Subsidy Amount Paid[Industry Category]=
	Waste Heat Measure Energy Savings This Year[Industry Category]
	* Waste Heat Measure Performance Subsidy This Year[Industry Category]
	~	$
	~		|

Waste Heat Measure Performance Subsidy in Dollars[Industry Category]=
	Waste Heat Measure Performance Subsidy[Industry Category]
	* OCCF Dollars per Small Output Currency Unit
	~	$/output TPE unit
	~		|

Waste Heat Measure Performance Subsidy This Year[Industry Category]=
	Waste Heat Measure Performance Subsidy in Dollars[Industry Category]
	* VECTOR ELM MAP(
	    Selected Policy Implementation Schedule[indst waste heat measure performance subsidy X agriculture and forestry 01T03\
		],
	
	    (Industry Category-1)
	  )
	~	$/output TPE unit
	~		|

Waste Heat Measure Potential Remaining After BAU Deployment[Industry Category,Waste Heat Measure\
		]=
	1 - WHMBDS Waste Heat Measure BAU Deployed Share by End Year[Industry Category,Waste Heat Measure\
		]
	* (Time - INITIAL TIME) / (FINAL TIME - INITIAL TIME)
	~	Dmnl
	~	Fraction of each measure's loaded potential still available to policy this \
		year, after netting out deployment the BAU case achieves on its own.  BAU \
		deployment ramps linearly from zero at the start year to WHMBDS at the \
		final year, so the ramp adapts to each geography's run period.  Caps both \
		the economic and standards deployment channels.  In the US WHMBDS is zero \
		and this equals 1 in all years.
	|

Waste Heat Measure Simple Payback Period[Industry Category,Waste Heat Measure,Measure Cost Level\
		]=
	IF THEN ELSE(
	  Value of Waste Heat Measure Energy Savings[Industry Category,Waste Heat Measure]
	  - MCLM Measure Cost Level Multiplier[Measure Cost Level]
	    * WHMOC Waste Heat Measure OM Cost per Unit Energy Saved[Industry Category,Waste Heat Measure\
		] <= 0,

	  10,

	  MIN(10,
	    ZIDZ(
	      MCLM Measure Cost Level Multiplier[Measure Cost Level]
	      * Waste Heat Measure Capital Cost per Unit Annual Energy Saved after Capital Subsidy\
		[Industry Category,Waste Heat Measure],

	      Value of Waste Heat Measure Energy Savings[Industry Category,Waste Heat Measure\
		]
	      - MCLM Measure Cost Level Multiplier[Measure Cost Level]
	        * WHMOC Waste Heat Measure OM Cost per Unit Energy Saved[Industry Category,Waste Heat Measure\
		]
	    )
	  )
	)
	~	Dmnl
	~	Simple payback in years at the policy-inclusive value of saved energy (a \
		performance subsidy shortens the payback by raising the value, and a \
		capital subsidy shortens it by cutting the upfront cost).  Capped at the \
		acceptance curve's ten-year endpoint, where acceptance is approximately \
		zero; measures whose operating cost exceeds their value are assigned the \
		cap.
	|

Waste Heat Measure Simple Payback Period at BAU Prices[Industry Category,Waste Heat Measure\
		,Measure Cost Level]=
	IF THEN ELSE(
	  Waste Heat Measure Value at BAU Prices[Industry Category,Waste Heat Measure]
	  - MCLM Measure Cost Level Multiplier[Measure Cost Level]
	    * WHMOC Waste Heat Measure OM Cost per Unit Energy Saved[Industry Category,Waste Heat Measure\
		] <= 0,

	  10,

	  MIN(10,
	    ZIDZ(
	      MCLM Measure Cost Level Multiplier[Measure Cost Level]
	      * WHMCC Waste Heat Measure Capital Cost per Unit Annual Energy Saved[Industry Category\
		,Waste Heat Measure],

	      Waste Heat Measure Value at BAU Prices[Industry Category,Waste Heat Measure]
	      - MCLM Measure Cost Level Multiplier[Measure Cost Level]
	        * WHMOC Waste Heat Measure OM Cost per Unit Energy Saved[Industry Category,Waste Heat Measure\
		]
	    )
	  )
	)
	~	Dmnl
	~	Simple payback in years at BAU prices with no subsidy.  Firms whose \
		acceptance threshold exceeds this payback are treated as having already \
		adopted (embedded in the calibrated base year and the diffusion netting of \
		the potentials).
	|

Waste Heat Measure Tranche Economically Deployable[Industry Category,Waste Heat Measure\
		,Measure Cost Level]=
	IF THEN ELSE(
	  WHMFSP Waste Heat Measure Fuel Savings Potential[Industry Category,Waste Heat Measure\
		]
	  + WHMESP Waste Heat Measure Elec Savings Potential[Industry Category,Waste Heat Measure\
		] <= 0,

	  0,

	  MAX(0,
	    ( PAC Payback Acceptance Curve[waste heat measures](
	        Waste Heat Measure Simple Payback Period[Industry Category,Waste Heat Measure\
		,Measure Cost Level] )
	      - PAC Payback Acceptance Curve[waste heat measures](
	          Waste Heat Measure Simple Payback Period at BAU Prices[Industry Category,Waste Heat Measure\
		,Measure Cost Level] )
	      - 1e-06 )
	    / MAX( 1e-06,
	        PAC Payback Acceptance Curve[waste heat measures](0)
	        - PAC Payback Acceptance Curve[waste heat measures](
	              Waste Heat Measure Simple Payback Period at BAU Prices[Industry Category\
		,Waste Heat Measure,Measure Cost Level] ) )
	  )
	)
	~	Dmnl
	~	Deployment ceiling, as a fraction of tranche potential.  Firms are \
		heterogeneous in the simple payback they will accept (the PAC curve, \
		anchored on audited-plant adoption data).  Policy that shortens the \
		payback wins over the firms whose thresholds lie between the BAU and \
		policy paybacks; the denominator scales that gain against the most any \
		policy could win, so driving the payback to zero unlocks the full loaded \
		potential.  At zero policy the two paybacks are equal and the ceiling is \
		exactly zero.  Baseline-policy deployment, where a geography has it, is \
		handled separately by the BAU deployed share input rather than assumed \
		here.  Same mechanism as the NEMS Industrial Demand Module payback \
		acceptance curve and the FORECAST payback-time-expectation distribution.  \
		Empty measure slots are never deployable.
	|

Waste Heat Measure Value at BAU Prices[Industry Category,Waste Heat Measure]=
	ZIDZ(
	  WHMFSP Waste Heat Measure Fuel Savings Potential[Industry Category,Waste Heat Measure\
		]
	  * BAU Industrial Heat Combustion Fuel Base for Measures[Industry Category]
	  * BAU Blended Industrial Heat Fuel Cost per Unit Energy[Industry Category]
	  + WHMESP Waste Heat Measure Elec Savings Potential[Industry Category,Waste Heat Measure\
		]
	  * BAU Industrial Heat Electricity Base for Measures[Industry Category]
	  * BAU Industrial Fuel Cost per Unit Energy[Industry Category,electricity if],

	  WHMFSP Waste Heat Measure Fuel Savings Potential[Industry Category,Waste Heat Measure\
		]
	  * BAU Industrial Heat Combustion Fuel Base for Measures[Industry Category]
	  + WHMESP Waste Heat Measure Elec Savings Potential[Industry Category,Waste Heat Measure\
		]
	  * BAU Industrial Heat Electricity Base for Measures[Industry Category]
	)
	~	$/BTU
	~	Value of each measure's savings at BAU energy prices with BAU quantity \
		weights and no subsidy.  A pure BAU benchmark for the counterfactual \
		screen.
	|

Waste Management CO2e Emissions[Pollutant]=
	Industrial Sector Pollutant Emissions[water and waste 36T39,Pollutant]
	* GWP by Pollutant[Pollutant]
	~	g CO2e
	~		|

Waste Management Pollutant Emissions[Pollutant]=
	Industrial Sector Pollutant Emissions[water and waste 36T39,Pollutant]
	~	g pollutant
	~		|

Water Consumed by Hydrogen Plants[Hydrogen Production Pathway]=
	Hydrogen Production by Pathway[Hydrogen Production Pathway]
	* WCoHPbP Water Consumption of Hydrogen Production by Pathway[Hydrogen Production Pathway\
		]
	~	l
	~		|

Water Consumed by Power Plants[Electricity Source]=
	Electricity Generation by Type[Electricity Source]
	* WUbPPT Water Consumption by Power Plant Type[Electricity Source]
	~	l
	~		|

Water Withdrawn by Power Plants[Electricity Source]=
	Electricity Generation by Type[Electricity Source]
	* WUbPPT Water Withdrawals by Power Plant Type[Electricity Source]
	~	l
	~		|

WCoHPbP Water Consumption of Hydrogen Production by Pathway[Hydrogen Production Pathway\
		]=
	GET DIRECT CONSTANTS(
	   'InputData/hydgn/WCoHPbP/WCoHPbP.csv',
	   ',',
	   'B2*'
	)
	~	l/BTU
	~		|

Weighted Average Annual Capital Costs per Unit Capacity[Electricity Source]=
	ZIDZ(
	  SUM( Annual CAPEX per Unit Capacity This Year[Electricity Source,Modeled Vintage!]
	    * Electricity Generation Capacity by Vintage[Electricity Source,Modeled Vintage!\
		]
	  ),
	
	   Electricity Generation Capacity[Electricity Source]
	)
	~	$/MW
	~		|

Weighted Average Annual Fixed OM Cost per Unit Capacity[Electricity Source]=
	ZIDZ(
	  SUM(
	    CCaMC Annual Fixed OM Cost per Unit Capacity[Electricity Source,Modeled Vintage!\
		]
	    * Electricity Generation Capacity by Vintage[Electricity Source,Modeled Vintage!\
		]
	  ),
	
	  Electricity Generation Capacity[Electricity Source]
	)
	~	$/MW
	~		|

Weighted Average Charging Cost for Diurnal Technologies=
	ZIDZ(
	SUM(
	    Increase in Demand by Hour for Diurnal Net Peak Load Reduction and RPS Compliance\
		[Electricity Timeslice!,Hour!]
	    * SHELF Days per Electricity Timeslice[Electricity Timeslice!]
	    * Last Year Five Year Average Marginal Dispatch Cost by Hour[Electricity Timeslice\
		!,Hour!]
	  ),
	
	  SUM(
	    Increase in Demand by Hour for Diurnal Net Peak Load Reduction and RPS Compliance\
		[Electricity Timeslice!,Hour!]
	    * SHELF Days per Electricity Timeslice[Electricity Timeslice!]
	  )
	)
	* Days per Year
	~	$/(MW*hr)
	~		|

Weighted Average Compensation per Employee=
	ZIDZ(
	  SUM(
	    Compensation per Employee by ISIC Code[ISIC Code!]
	    * Domestic Employment by ISIC Code[ISIC Code!]
	  ),
	
	  SUM(Domestic Employment by ISIC Code[ISIC Code!])
	)
	~	$/job
	~		|

Weighted Average Discharging Revenue for Diurnal Technologies=
	ZIDZ(
	SUM(
	    Decrease in Demand by Hour for Diurnal Net Peak Load Reduction and RPS Compliance\
		[Electricity Timeslice!,Hour!]
	    * SHELF Days per Electricity Timeslice[Electricity Timeslice!]
	    * Last Year Five Year Average Marginal Dispatch Cost by Hour[Electricity Timeslice\
		!,Hour!]
	  ),
	
	  SUM(
	    Decrease in Demand by Hour for Diurnal Net Peak Load Reduction and RPS Compliance\
		[Electricity Timeslice!,Hour!]
	    * SHELF Days per Electricity Timeslice[Electricity Timeslice!]
	  )
	)
	* Days per Year
	~	$/(MW*hr)
	~		|

Weighted Average Discharging Revenue for Grid Batteries after Subsidies=
	Weighted Average Discharging Revenue for Diurnal Technologies
	+ Levelized Subsidy per Unit Grid Battery Capacity Deployed
	~	$/(MW*hr)
	~		|

Weighted Average Elec Portfolio Percentage by Year[Future Year,Clean Elec Requirement\
		]=
	MIN(
	  1,

	  MAX(Elec Portfolio Percentage by Year from Policy Setting[Future Year,Clean Elec Requirement\
		],
	      IF THEN ELSE(
	        Boolean Use Non BAU Elec Portfolio Settings This Year[Clean Elec Requirement\
		] > 0,

	        Non BAU Weighted Average Elec Portfolio Percentage by Year[Future Year,Clean Elec Requirement\
		],

	        BAU Weighted Average Elec Portfolio Percentage by Year[Future Year,Clean Elec Requirement\
		]
	      ))
	)
	~	Dmnl
	~	When Boolean Use Non BAU Elec Portfolio Settings is enabled, the non-BAU \
		schedule (RPSDbS input file) replaces the BAU schedule (BRPSDbS input \
		file) as the floor for the RPS or CES trajectory.  This also allows a \
		non-BAU schedule BELOW the BAU schedule to take effect, which the \
		percentage policy levers alone cannot do.  The BAU twin variable is \
		deliberately untouched so the BAU scenario never sees this lever.
	|

Weighted Average Electricity Fuel Cost per Unit Electricity Output[Electricity Source\
		]=
	Electricity Fuel Cost per Unit Energy[Electricity Source]
	* Weighted Average Heat Rate by Electricity Fuel[Electricity Source]
	~	$/(MW*hour)
	~	The fuel surcharge for power plants that have higher fuel prices than \
		other plants that buy the same fuel (i.e., natural gas peakers and natural \
		gas steam turbines) is handled on the Fuels sheet, which automatically \
		integrates these surcharges into cash flows.
	|

Weighted Average Expected Capacity Factors by Hour Without Hypothetical Adjustments[Electricity Source\
		,Electricity Timeslice,Hour]=
	Start Year Seasonal Expected Hourly Electricity Capacity Factors after RAF[Electricity Source\
		,Electricity Timeslice,Hour
	]
	* (1 + Weighted Average Increase in Capacity Factors for All Plants due to Technological Improvements\
		[Electricity Source
	])
	~	Dmnl
	~		|

Weighted Average Expected Capacity Factors by Hour without RAF[Electricity Source,Electricity Timeslice\
		,Hour]=
	SYSHECF Start Year Seasonal Expected Hourly Electricity Capacity Factors[Electricity Source\
		,Electricity Timeslice,Hour]
	* (1 + Weighted Average Increase in Capacity Factors for All Plants due to Technological Improvements\
		[Electricity Source])
	~	Dmnl
	~		|

Weighted Average Heat Rate by Electricity Fuel[Electricity Source]=
	Weighted Average Heat Rate by Electricity Fuel before Fuel Use Reduction[Electricity Source\
		]
	* (1 - RnD Electricity Fuel Use Perc Reduction This Year[Electricity Source])
	~	BTU/(MW*hour)
	~		|

Weighted Average Heat Rate by Electricity Fuel before Fuel Use Reduction[Electricity Source\
		]=
	IF THEN ELSE(
	  ABS(Electricity Generation Capacity[Electricity Source])*MW Tolerance Unit Correction Factor\
		 < Tolerance,
	
	  SUM(BHRaSYC BAU Heat Rates[Electricity Source,Modeled Vintage!]*This Year Modeled Vintage Flag\
		[Modeled Vintage!]),
	  
	    ZIDZ(
	    SUM(
	      BHRaSYC BAU Heat Rates[Electricity Source,Modeled Vintage!]
	      * Electricity Generation Capacity by Vintage[Electricity Source,Modeled Vintage\
		!]
	    ),
	
	    Electricity Generation Capacity[Electricity Source]
	  )
	)
	~	BTU/(MW*hour)
	~		|

Weighted Average Increase in Capacity Factors for All Plants due to Technological Improvements\
		[Electricity Source]=
	ZIDZ(
	  SUM(
	    (Last Year Increase in Capacity Factors for New Plants due to Technological Improvements by Vintage\
		[Electricity Source,Modeled Vintage!] 
	      + IiCFfNPdtTI Increase in Capacity Factors for New Plants due to Technological Improvements\
		[Electricity Source] * This Year Modeled Vintage Flag[Modeled Vintage!])
	    * Electricity Generation Capacity by Vintage[Electricity Source,Modeled Vintage!\
		]
	  ),
	
	  Electricity Generation Capacity[Electricity Source]
	)
	~	Dmnl
	~		|

Weighted Average Last Year Percent Change in Industry Contribution to Gross Domestic Product Excluding Most Direct Impacts\
		=
	ZIDZ(
	  SUM(
	    Last Year Percent Change in Contribution to Gross Domestic Product Excluding Most Direct Impacts by ISIC Code\
		[Industry Category ISIC Code!]
	    * Last Year Domestic Output by ISIC Code[Industry Category ISIC Code!]
	  ),
	
	  SUM(Last Year Domestic Output by ISIC Code[Industry Category ISIC Code!])
	)
	~	Dmnl
	~	The denominator is zero in the first simulated year because the "Last \
		Year" variable starts with a zero as its initial value, so we need a \
		ZIDZ() function here.
	|

Weighted Average Percent Change in Cost of Goods by Industry Category[Industry Category\
		]=
	Change in Passthrough Expenses as Share of Nonenergy Industry Output by Industry Category\
		[Industry Category]
	* Domestic Content Share of Consumption Before Import Substitution by ISIC Code[Industry Category ISIC Code\
		]
	
	+ Last Year Carbon Tax Effects on Expenditures by Nonenergy Industries As Share of Nonenergy Industry Output\
		[Industry Category]
	* (1 - Domestic Content Share of Consumption Before Import Substitution by ISIC Code\
		[Industry Category ISIC Code])
	~	Dmnl
	~		|

Weighted Average Round Trip Efficiency for Diurnal Shifting[Electricity Timeslice]=
	ZIDZ(
	  (
	    ESTRTE Grid Battery Round Trip Efficiency
	    * (Last Year Grid and Hybrid Battery Storage Available for Load Shifting[Electricity Timeslice\
		]
	       + Maximum Daily Quantity of Electricity Charged by EVs for Diurnal Balancing
	      )
	
	    + ESTRTE Pumped Hydro Round Trip Efficiency
	      * Maximum Daily Quantity of Electricity Charged by Pumped Hydro[Electricity Timeslice\
		]
	  ),
	
	  (
	    Last Year Grid and Hybrid Battery Storage Available for Load Shifting[Electricity Timeslice\
		]
	    + Maximum Daily Quantity of Electricity Charged by EVs for Diurnal Balancing
	    + Maximum Daily Quantity of Electricity Charged by Pumped Hydro[Electricity Timeslice\
		]
	  )
	)
	~	Dmnl
	~		|

Weighted Average Round Trip Efficiency for Seasonal Shifting=
	ZIDZ(
	  (
	    SES Seasonal Electricity Storage Round Trip Efficiency
	    * Maximum Annual Quantity of Electricity Charged by Seasonal Electricity Storage
	  ),
	
	  (
	    Maximum Annual Quantity of Electricity Charged by Seasonal Electricity Storage
	  )
	)
	~	Dmnl
	~		|

Weighted Average Variable OM Cost per Unit Electricity Output[Electricity Source]=
	IF THEN ELSE(
	  ABS(Electricity Generation Capacity[Electricity Source])*MW Tolerance Unit Correction Factor\
		 < Tolerance,
	  SUM(CCaMC Variable OM Cost per Unit Output[Electricity Source,Modeled Vintage!]*This Year Modeled Vintage Flag\
		[Modeled Vintage!]),
	
	  ZIDZ(
	    SUM(
	      CCaMC Variable OM Cost per Unit Output[Electricity Source,Modeled Vintage!]
	      * Electricity Generation Capacity by Vintage[Electricity Source,Modeled Vintage\
		!]
	    ),
	
	    Electricity Generation Capacity[Electricity Source]
	  )
	)
	~	$/(MW*hour)
	~		|

Weighted Avg Fuel Cost per Unit Energy by Vehicle Technology[Vehicle Type,Cargo Type,\
		Vehicle Technology]=
	XIDZ(
	  SUM(Transportation Fuel Cost per Unit Energy by Vehicle and Cargo Type[Vehicle Type\
		,Cargo Type,Transportation Fuel!]
	      * Last Year Transportation Sector Fuel Used[Vehicle Type,Cargo Type,Vehicle Technology\
		,Transportation Fuel!]),
	
	  SUM(Last Year Transportation Sector Fuel Used[Vehicle Type,Cargo Type,Vehicle Technology\
		,Transportation Fuel!]),
	
	  SUM(Transportation Fuel Cost per Unit Energy by Vehicle and Cargo Type[Vehicle Type\
		,Cargo Type,Transportation Fuel!]
	    * BPoEFUbVT BAU Perc of Each Fuel Used by Veh Technology[Vehicle Type,Cargo Type\
		,Vehicle Technology,Transportation Fuel
	!])
	)
	~	$/BTU
	~	In the event there are no vehicles of a given technology (such as no \
		battery electric vehicles), we don't want a weighted average fuel cost of \
		zero, because this makes that vehicle technology have an artifically low \
		lifetime NPV cost, and the model will choose to build more of that type \
		than it should.  Accordingly, we estimate the cost based on the BAU fuel \
		shares by vehicle technology.
	|

WHM BAU Deployed Share by End Year by Row[PEaWHRP WM Row]=
	GET DIRECT CONSTANTS(
	   'InputData/indst/PEaWHRP/PEaWHRP-WMD.csv',
	   ',',
	   'L2*'
	)
	~	Dmnl
	~	Share of each measure row's loaded potential that the BAU case is assumed \
		to reach by the model's final year without new policy (e.g. from baseline \
		policies such as the EU ETS and EED in European geographies).  The model \
		interpolates linearly from zero at the start year, using INITIAL TIME and \
		FINAL TIME so the ramp adapts to each geography's run period.  Set to zero \
		in the US, where current policy is not expected to drive material \
		deployment of these measures.  Long-form read; use the WHMBDS remap in \
		equations.
	|

WHM Capital Cost by Row[PEaWHRP WM Row]=
	GET DIRECT CONSTANTS(
	   'InputData/indst/PEaWHRP/PEaWHRP-WMD.csv',
	   ',',
	   'G2*'
	)
	~	$/BTU
	~	Capital cost per BTU of annual energy savings capacity for each waste heat \
		measure row.  Long-form read; use the WHMCC remap in equations.
	|

WHM Elec Savings Potential by Row[PEaWHRP WM Row]=
	GET DIRECT CONSTANTS(
	   'InputData/indst/PEaWHRP/PEaWHRP-WMD.csv',
	   ',',
	   'F2*'
	)
	~	Dmnl
	~	Electricity savings potential as a fraction of industry heating-process \
		electricity use.  Long-form read; use the WHMESP remap in equations.
	|

WHM Equipment Lifetime by Row[PEaWHRP WM Row]=
	GET DIRECT CONSTANTS(
	   'InputData/indst/PEaWHRP/PEaWHRP-WMD.csv',
	   ',',
	   'I2*'
	)
	~	years
	~	Equipment lifetime for each waste heat measure row.  Long-form read; use \
		the WHMEL remap in equations.
	|

WHM Fuel Savings Potential by Row[PEaWHRP WM Row]=
	GET DIRECT CONSTANTS(
	   'InputData/indst/PEaWHRP/PEaWHRP-WMD.csv',
	   ',',
	   'E2*'
	)
	~	Dmnl
	~	Fuel savings potential as a fraction of industry heating-process \
		combustion fuel use.  Long-form read; use the WHMFSP remap in equations.
	|

WHM OM Cost by Row[PEaWHRP WM Row]=
	GET DIRECT CONSTANTS(
	   'InputData/indst/PEaWHRP/PEaWHRP-WMD.csv',
	   ',',
	   'H2*'
	)
	~	$/BTU
	~	Annual operations and maintenance cost per BTU of annual energy savings \
		capacity for each waste heat measure row.  Long-form read; use the WHMOC \
		remap in equations.
	|

WHMBDS Waste Heat Measure BAU Deployed Share by End Year[Industry Category,Waste Heat Measure\
		]= INITIAL(
	VECTOR ELM MAP(
	  WHM BAU Deployed Share by End Year by Row[whm 01T03 X waste heat measure 1],
	  (Industry Category - 1) * ELMCOUNT(Waste Heat Measure)
	  + (Waste Heat Measure - 1)
	))
	~	Dmnl
	~	Share of each measure's loaded potential reached in the BAU case by the \
		model's final year without new policy.  Zero in the US; used in European \
		geographies to represent baseline-policy-driven deployment (ETS, EED).
	|

WHMCC Waste Heat Measure Capital Cost per Unit Annual Energy Saved[Industry Category,\
		Waste Heat Measure]= INITIAL(
	VECTOR ELM MAP(
	  WHM Capital Cost by Row[whm 01T03 X waste heat measure 1],
	  (Industry Category - 1) * ELMCOUNT(Waste Heat Measure)
	  + (Waste Heat Measure - 1)
	))
	~	$/BTU
	~	Capital cost of each waste heat measure per BTU of annual energy savings \
		capacity, in the units of IECCpUAEU.
	|

WHMEL Waste Heat Measure Equipment Lifetime[Industry Category,Waste Heat Measure]= INITIAL\
		(
	VECTOR ELM MAP(
	  WHM Equipment Lifetime by Row[whm 01T03 X waste heat measure 1],
	  (Industry Category - 1) * ELMCOUNT(Waste Heat Measure)
	  + (Waste Heat Measure - 1)
	))
	~	years
	~	Lifetime of each waste heat measure, used for capital cost annualization \
		and retirement of deployed savings.
	|

WHMESP Waste Heat Measure Elec Savings Potential[Industry Category,Waste Heat Measure\
		]= INITIAL(
	VECTOR ELM MAP(
	  WHM Elec Savings Potential by Row[whm 01T03 X waste heat measure 1],
	  (Industry Category - 1) * ELMCOUNT(Waste Heat Measure)
	  + (Waste Heat Measure - 1)
	))
	~	Dmnl
	~	Electricity savings potential of each waste heat measure as a fraction of \
		the industry's heating-process electricity use.
	|

WHMFSP Waste Heat Measure Fuel Savings Potential[Industry Category,Waste Heat Measure\
		]= INITIAL(
	VECTOR ELM MAP(
	  WHM Fuel Savings Potential by Row[whm 01T03 X waste heat measure 1],
	  (Industry Category - 1) * ELMCOUNT(Waste Heat Measure)
	  + (Waste Heat Measure - 1)
	))
	~	Dmnl
	~	Fuel savings potential of each waste heat measure as a fraction of the \
		industry's heating-process combustion fuel use.
	|

WHMOC Waste Heat Measure OM Cost per Unit Energy Saved[Industry Category,Waste Heat Measure\
		]= INITIAL(
	VECTOR ELM MAP(
	  WHM OM Cost by Row[whm 01T03 X waste heat measure 1],
	  (Industry Category - 1) * ELMCOUNT(Waste Heat Measure)
	  + (Waste Heat Measure - 1)
	))
	~	$/BTU
	~	Annual OM cost of each waste heat measure per BTU of annual energy savings \
		capacity.
	|

Wholesale Energy Market Costs=
	IF THEN ELSE(
	 Time - INITIAL TIME <= 1,
	 One Year Average Wholesale Energy Market Costs,
	 
	 IF THEN ELSE(
	  Time - INITIAL TIME = 2,
	  Two Year Average Wholesale Energy Market Costs,
	  Three Year Average Wholesale Energy Market Costs
	 )
	)
	~	$
	~		|

WHR Measure Energy Use Multiplier[Industry Category,Industrial Fuel] :EXCEPT:     [Industry Category\
		,electricity if]=
	1 - Fraction of Industrial Heat Fuel Use Avoided by Waste Heat Measures[Industry Category\
		] ~~|
WHR Measure Energy Use Multiplier[Industry Category,electricity if]=
	1 - Fraction of Industrial Heat Electricity Use Avoided by Waste Heat Measures[Industry Category\
		]
	~	Dmnl
	~	Multiplier on heating-process equipment energy use from deployed waste \
		heat measures.  Applies to the industrial heating process subrange only; \
		fuel savings reduce combustion fuels and electricity savings reduce \
		electricity use.
	|

Within Industry Compensation per Employed Person[ISIC Code]=
	ZIDZ(
	
	  BAU Employee Compensation by ISIC Code by Year[ISIC Code],
	
	  BAU Employment by ISIC Code by Year[ISIC Code]
	)
	~	$/job
	~		|

Within Industry Jobs per Unit Energy Production[ISIC Code]=
	ZIDZ(
	
	  BAU Employment by ISIC Code by Year[ISIC Code],
	
	  BAU Fuel Production Mapped to ISIC Codes[ISIC Code]
	)
	~	jobs/BTU
	~		|

Within Industry Jobs per Unit Output[ISIC Code]=
	ZIDZ(
	  ZIDZ(
	    BAU Employment by ISIC Code by Year[ISIC Code],

	    BAU Output by ISIC Code by Year[ISIC Code]
	  ),
	  Material Efficiency Price Index by ISIC Code[ISIC Code]
	)
	~	jobs/$
	~	Jobs per dollar of output, deflated by the material efficiency price \
		index: when material efficiency lowers an industry's output price, a \
		dollar of its output represents more physical production and therefore \
		more jobs.  Deflation keeps this coefficient anchored to real (BAU price) \
		output.  The compensation per employed person coefficient must NOT be \
		deflated (it is per job, not per output dollar).
	|

Within Industry Value Added per Unit Energy Production[ISIC Code]=
	ZIDZ(
	
	  BAU Value Added by ISIC Code by Year[ISIC Code],
	
	  BAU Fuel Production Mapped to ISIC Codes[ISIC Code]
	)
	~	$/BTU
	~		|

Within Industry Value Added per Unit Output[ISIC Code]=
	ZIDZ(
	  ZIDZ(
	    BAU Value Added by ISIC Code by Year[ISIC Code],

	    BAU Output by ISIC Code by Year[ISIC Code]
	  ),
	  Material Efficiency Price Index by ISIC Code[ISIC Code]
	)
	~	Dmnl
	~	Value added per dollar of output, deflated by the material efficiency \
		price index: when the passed-through savings lower the output price, value \
		added becomes a larger share of each (smaller) output dollar.  Exact at \
		100% passthrough; with partial passthrough the retained margin adds to \
		value added per unit, a second-order effect not captured here.
	|

WMITR Worker Marginal Income Tax Rate=
	GET DIRECT CONSTANTS(
	   'InputData/io-model/WMITR/WMITR.csv',
	   ',',
	   'B2'
	)
	~	Dmnl
	~		|

WUbPPT Water Consumption by Power Plant Type[Electricity Source]=
	GET DIRECT CONSTANTS(
	   'InputData/elec/WUbPPT/WUbPPT-consumption.csv',
	   ',',
	   'B2*'
	)
	~	l/(MW*hour)
	~		|

WUbPPT Water Withdrawals by Power Plant Type[Electricity Source]=
	GET DIRECT CONSTANTS(
	   'InputData/elec/WUbPPT/WUbPPT-withdrawals.csv',
	   ',',
	   'B2*'
	)
	~	l/(MW*hour)
	~		|

Years Elapsed Since Model Run Vintage[Model Run Vintage]=
	MAX(
	  0,
	
	  Time - Model Run Vintage to Year Mapping[Model Run Vintage]*One Year
	)
	~	years
	~		|

YoFESHtFRV Years of Foresight Electricity Suppliers Have to Future RPS Values=
	GET DIRECT CONSTANTS(
	   'InputData/ctrl-settings/YoFESHtFRV/YoFESHtFRV.csv',
	   ',',
	   'B2*'
	)
	~	years
	~		|

ZEC Subsidies Paid[Electricity Source]=
	Electricity Generation by Type[Electricity Source]
	* BZECfNP BAU Zero Emissions Credit for Nuclear Plants[Electricity Source]
	~	$
	~		|

Zero and Negative Cost Electricity Dispatched to Meet CES[Electricity Source,Electricity Timeslice\
		,Hour]=
	Expected CES Qualifying Output After Guaranteed and RPS Dispatch[Electricity Source,\
		Electricity Timeslice,Hour]
	* Plant Types with Zero or Negative Dispatch Cost After Subsidies[Electricity Source\
		]
	* MIN(
	    1,
	
	    ZIDZ(
	      Unmet Electricity Demand after RPS Allocation Steps[Electricity Timeslice,Hour\
		],
	
	      SUM(
	        Expected CES Qualifying Output After Guaranteed and RPS Dispatch[Electricity Source\
		!,Electricity Timeslice,Hour]
	        * Plant Types with Zero or Negative Dispatch Cost After Subsidies[Electricity Source\
		!]
	      )
	    )
	  )
	~	MW*hour
	~		|

Zero and Negative Cost Electricity Dispatched to Meet RPS[Electricity Timeslice,Hour,\
		Electricity Source]=
	Expected RPS Qualifying Capacity After Guaranteed Dispatch[Electricity Timeslice,Hour\
		,Electricity Source]
	* Plant Types with Zero or Negative Dispatch Cost After Subsidies[Electricity Source\
		]
	* MIN(
	    1,
	
	    ZIDZ(
	      Unmet Electricity Demand After Guaranteed Dispatch[Electricity Timeslice,Hour]\
		,
	
	      SUM(
	        Expected RPS Qualifying Capacity After Guaranteed Dispatch[Electricity Timeslice\
		,Hour,Electricity Source!]
	        * Plant Types with Zero or Negative Dispatch Cost After Subsidies[Electricity Source\
		!]
	      )
	    )
	  )
	~	MW*hr
	~		|

Zero Fuel Cost Electricity Source:
	onshore wind es, solar PV es, solar thermal es, offshore wind es, hydro es, geothermal es
	~	
	~		|

ZEV Sales Share Without ZEV Standard[Subregion,Vehicle Type,Cargo Type]=
	ZIDZ(
	  SUM(
	    New Vehicles before ZEV Standards by Subregion[Subregion,Vehicle Type,Cargo Type\
		,Vehicle Technology!]
	    * Vehicle Technologies Qualifying as ZEVs[Vehicle Type,Vehicle Technology!]
	  ),
	
	  SUM(New Vehicles before ZEV Standards by Subregion[Subregion,Vehicle Type,Cargo Type\
		,Vehicle Technology!])
	)
	~	Dmnl
	~		|

ZEV Standard by Subregion[Subregion,Vehicle Type,Cargo Type]=
	MAX(
	  Required ZEV Sales Percentage by Subregion[Subregion,Cargo Type,Vehicle Type],
	
	  MAX(
	    MIN(
	    BRZSPbMR BAU Required ZEV Sales Percentage by Model Region[Vehicle Type,Cargo Type\
		]
	    + Additional Minimum Required ZEV Sales Percentage for Model Region This Year[Cargo Type\
		,Vehicle Type],
	  
	    1
	    ),
	
	  0
	  )
	)
	~	Dmnl
	~		|

********************************************************
	.Control
********************************************************~
		Simulation Control Parameters
	|

FINAL TIME=
	GET DIRECT CONSTANTS(
	   'InputData/plcy-schd/FT/FT.csv',
	   ',',
	   'B2*'
	)
	~	Year
	~	The final time for the simulation.
	|

INITIAL TIME=
	GET DIRECT CONSTANTS(
	   'InputData/plcy-schd/IT/IT.csv',
	   ',',
	   'B2*'
	)
	~	Year
	~	The initial time for the simulation.
	|

Last Year Change in Energy Supplier Cost per Unit Fuel Produced[All Fuels] :EXCEPT:   \
		[electricity],[heat],[hydrogen],[coal mining industry fuel within all fuels
],[NGPS industry fuel within all fuels],[biomass and biofuel within all fuels]=
	0 ~~|
Last Year Change in Energy Supplier Cost per Unit Fuel Produced[electricity]=
	0 ~~|
Last Year Change in Energy Supplier Cost per Unit Fuel Produced[heat]= DELAY FIXED (
	Change in District Heat Supplier Expenditures per Unit Heat Produced, 1, 0) ~~|
Last Year Change in Energy Supplier Cost per Unit Fuel Produced[hydrogen]= DELAY FIXED\
		 (
	Change in Hydrogen Supplier Expenditures per Unit Hydrogen Produced, 1, 0) ~~|
Last Year Change in Energy Supplier Cost per Unit Fuel Produced[coal mining industry fuel within all fuels\
		]= DELAY FIXED (
	Change in Fuel Supplier Expenditures per Unit Fuel Produced[coal mining industry fuel within all fuels\
		], 1,
	 0) ~~|
Last Year Change in Energy Supplier Cost per Unit Fuel Produced[NGPS industry fuel within all fuels\
		]= DELAY FIXED (
	Change in Fuel Supplier Expenditures per Unit Fuel Produced[NGPS industry fuel within all fuels\
		], 1, 0) ~~|
Last Year Change in Energy Supplier Cost per Unit Fuel Produced[biomass and biofuel within all fuels\
		]= DELAY FIXED (
	Change in Fuel Supplier Expenditures per Unit Fuel Produced[biomass and biofuel within all fuels\
		], 1, 0)
	~	$/BTU
	~		|

SAVEPER  = 
        TIME STEP
	~	Year [0,?]
	~	The frequency with which output is stored.
	|

TIME STEP  = 1
	~	Year [0,?]
	~	The time step for the simulation.
	|

Total Energy Market and Capacity Market Revenue for Seasonal Dispatchable Reliability\
		[Electricity Source,Optimization Pass]=
	Total Energy Market and CES Revenue and Variable Subsidies[Electricity Source]
	-RPS and CES Revenue at Marginal Capacity Factor[Electricity Source]
	+ (
	Capacity Market Price for Seasonal Dispatchable Reliability by Optimization Pass[Optimization Pass
	]
	*Reliability Credit Factor with New Entry Backstop[Electricity Source]
	* Uncredited Binding Hour Bid Electricity Capacity Factors for Reliability by Plant Type\
		[Electricity Source]
	  * Days per Year
	  * One Day)
	~	$/MW
	~		|

