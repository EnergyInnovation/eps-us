Boolean Persistently Deep Unviable for Cost Driven Retirement[Electricity Source]=
	Boolean Deep Unviable for Cost Driven Retirement[Electricity Source]
	* Last Year Boolean Deep Unviable for Cost Driven Retirement[Electricity Source]
	* Two Years Prior Boolean Deep Unviable for Cost Driven Retirement[Electricity Source\
		]
	~	Dmnl
	~		|

Boolean Plant Types that May Not be Built due to Having Been Retired to Zero[Electricity Source\
		]=
	IF THEN ELSE(
	  Start Year Electricity Generation Capacity Summed Across Vintages[Electricity Source\
		] > 0,
	
	  IF THEN ELSE(
	   Planned and Policy Mandated Capacity Retirements[Electricity Source]
	    >= Last Year Electricity Generation Capacity[Electricity Source],
	
	    1,
	
	    0
	  ),
	
	  0
	)
	~	Dmnl
	~		|

Boolean Rebate Program for Efficient Components[Building Component]=
	0,	{heating}
	0,	{cooling and ventilation}
	0,	{envelope}
	0,	{lighting}
	0,	{appliances}
	0	{other component}
	~	Dmnl [0,1,1]
	~		|

Boolean Rebate Program for Efficient Components This Year[Building Component]=
	Boolean Rebate Program for Efficient Components[Building Component]
	* VECTOR ELM MAP(
	    Selected Policy Implementation Schedule[bldgs rebate X heating],
	
	    (Building Component-1)
	  )
	~	Dmnl
	~		|

Boolean Subject to Economic Retirement[Electricity Source]=
