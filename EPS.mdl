Social Benefits from Emissions Reduction=
	QUANTUM(
	  Economic Benefit from Avoided Climate Damages
	  + SUM(Monetized Benefit from Avoided Health Outcomes[Health Outcome!])
	  + Monetized Benefit from Avoided Premature Mortality,
	
	  QSfCF Quantization Size for Cash Flows
	)
	~	$
	~		|

Social Benefits from Emissions Reduction per Unit CO2e Abated=
	ZIDZ(
	  Social Benefits from Emissions Reduction,
	  - Change in Total CO2e Emissions
	)
	~	$/g CO2e
	~		~	:SUPPLEMENTARY 
	|

