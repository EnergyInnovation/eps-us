		],
	
	    (Electricity Source-1)
	  )
	~	Dmnl
	~		|

Boolean Cement Fuel Present in Industry 239 Input Data[Industrial Fuel]= INITIAL(
	IF THEN ELSE(
	  BIFU BAU Industrial Fuel Use for Energy[cement and other nonmetallic minerals 239,\
		Industrial Fuel]
	  * SUM(BAU Percentage Fuel Use by Industrial Process with Fallback Data[cement and other nonmetallic minerals 239\
		,Industrial Fuel,industrial process end use!])
	  + BIFU BAU Industrial Fuel Use as Feedstock[cement and other nonmetallic minerals 239\
		,Industrial Fuel]
	  > 0, 1, 0
	))
	~	Dmnl
	~	One for fuels that industry 239's input data (BIFU) actually contains, \
		zero otherwise. The cement module's fuel use is added to 239's fuel \
		accounts only for these fuels. Today this excludes only biomass, where the \
		module books alternative kiln fuels (tires, waste; 16 percent of kiln fuel \
		per PCA) that the legacy 239 data counts under other fuels. Adding them \
		would create net-new energy and break start-year neutrality, so they stay \
		inside the module pending a team decision on refreshing 239's BAU fuel mix \
		(see Cement_1b_Carveout_Memo.md).
	|

Boolean Cost Driven Retirement Gate at Last Pass[Electricity Source]=
	IF THEN ELSE(SUM(Average Three Year Prior Net Loss per Unit Output[Electricity Source\
		,last pass!]) > 0, 1, 0)
	~	Dmnl
	~		|

Boolean Deep Unviable for Cost Driven Retirement[Electricity Source]=
	Boolean Subject to Economic Retirement[Electricity Source]
	* IF THEN ELSE(Required Revenue for Breakeven Target[Electricity Source] > 0, 1, 0)
	* IF THEN ELSE(Last Year Cleared Viability Ratio for Cost Driven Retirement[Electricity Source\
		]
	  < DUVT Deep Unviability Threshold, 1, 0)
	~	Dmnl
	~		|

Boolean Improved Contractor Edu and Training=
	0
	~	Dmnl [0,1,1]
	~		|

Boolean Improved Contractor Edu and Training This Year=
	Boolean Improved Contractor Edu and Training
	* Selected Policy Implementation Schedule[bldgs contractor training X]
	~	Dmnl
	~		|

Boolean Improved Device Labeling=
	0
	~	Dmnl [0,1,1]
	~		|

Boolean Improved Device Labeling This Year=
