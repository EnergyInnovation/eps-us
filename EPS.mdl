	Amortized Decommissioning Costs - BAU Amortized Decommissioning Costs
	~	$
	~		|

Change in Demand Response Costs by Recipient[Cash Flow Entity]=
	Cost of Providing Demand Response by Recipient[Cash Flow Entity]
	- BAU Cost of Providing Demand Response by Recipient[Cash Flow Entity]
	~	$
	~		|

Change in Distributed Capacity[Building Type, Electricity Source]=
	Distributed Electricity Source Capacity[Building Type,Electricity Source]
	- BAU Distributed Electricity Source Capacity[Building Type,Electricity Source]
	~	MW
	~		|

Change in Distribution Construction Costs=
	DEPRECIATE STRAIGHTLINE(
	
	  (Distribution Construction Costs-BAU Distribution Construction Costs),
	 
	  STfESCE Smoothing Time for Electricity Sector Capital Expenditures,
	
	  1,
	
	  0
	)
	~	$
	~	We use a DEPRECIATE STRAIGHTLINE function to even out price spikes that \
		unrealistically affect the price of electricity, because the costs of \
		construction of new generation assets really would be spread out over a \
		few years.  We use an initial value of zero because prior to the start of \
		the model run, the change in construction costs due to policies is zero \
		(none were in effect).
	|

Change in Distribution Construction Costs by Recipient ISIC Code[ISIC Code]=
	Change in Distribution Construction Costs
	* SoTaCCbIC Share of Transmission and Distribution Capital Costs by ISIC Code[ISIC Code\
		]
	~	$
	~		|

Change in Distribution OM Costs=
	Distribution OM Costs-BAU Distribution OM Costs
	~	$
	~		|

Change in Distribution OM Costs by Recipient ISIC Code[ISIC Code]=
	Change in Transmission OM Costs
	* SoTaDOMCbIC Share of Transmission and Distribution OM Costs by ISIC Code[ISIC Code\
		]
	~	$
	~		|

Change in District Heat Supplier Expenditures per Unit Heat Produced=
	ZIDZ(
	  District Heating Change in Energy Expenditures by Entity[other energy suppliers]
	  + District Heating Change in Nonenergy Expenditures by Entity[other energy suppliers\
		],
	
	  Total District Heat Use
	)
	* MIN(
	    1,
	
	    ZIDZ(
	      Total District Heat Use,
	
	      First Year Total Heat Use
	    )
	  )
	~	$/BTU
	~	The term in the MIN function dampens instability that happens if district \
		heat use approaches zero.
	|

Change in District Heating Pollutant Emissions[Pollutant]=
	SUM(District Heating Pollutant Emissions[Pollutant,Industrial Fuel!])
	- SUM(BAU District Heating Pollutant Emissions[Pollutant,Industrial Fuel!])
	~	g pollutant
	~		~	:SUPPLEMENTARY 
	|

Change in Domestic Consumption of Nonenergy Products[Industry Category]=
	Change in Domestic Output by ISIC Code[Industry Category ISIC Code]
	+ Change in Imports of Nonenergy Products[Industry Category]
	- Change in Exports of Nonenergy Products[Industry Category]
	~	$
	~		|

Change in Domestic Content Share of Consumption by ISIC Code[ISIC Code]=
	Domestic Content Share of Consumption by ISIC Code[ISIC Code]
	- BAU Domestic Content Share of Consumption by ISIC Code from Exogenous Data[ISIC Code\
		]
	~	Dmnl
	~		|

Change in Domestic Employee Compensation by ISIC Code[Target ISIC Code]=
	Direct Change in Domestic Compensation by ISIC Code[Target ISIC Code]
	+ Indirect Change in Domestic Compensation by ISIC Code[Target ISIC Code]
	+ Induced Change in Domestic Compensation by ISIC Code[Target ISIC Code]
	~	$
	~		|

Change in Domestic Individual Income Tax Revenue by ISIC Code[ISIC Code]=
	Change in Domestic Employee Compensation by ISIC Code[ISIC Code]
	* WMITR Worker Marginal Income Tax Rate
	~	$
	~		|

Change in Domestic Jobs after Productivity Effects by ISIC Code[ISIC Code]=
	Direct Change in Domestic Jobs after Productivity Effects by ISIC Code[ISIC Code]
	+ Indirect Change in Domestic Jobs after Productivity Effects by ISIC Code[ISIC Code\
		]
	+ Induced Change in Domestic Jobs after Productivity Effects by ISIC Code[ISIC Code]
	~	jobs
	~		|

Change in Domestic Jobs by Demographic Trait[Demographic Trait]=
	QUANTUM(
	  SUM(
	    Change in Domestic Jobs after Productivity Effects by ISIC Code[ISIC Code!]
	    * DoEbIC Demographics of Employees by ISIC Code[ISIC Code!,Demographic Trait]
	  ),
	
	  Quantization Size for Jobs
	)
	~	jobs
	~		|

Change in Domestic Jobs by Union Status[union]=
	QUANTUM(
	  SUM(
	    Change in Domestic Jobs after Productivity Effects by ISIC Code[ISIC Code!]
	    * URPbIC Union Representation Percentage by ISIC Code[ISIC Code!]
	  ),
	
	  Quantization Size for Jobs
	) ~~|
Change in Domestic Jobs by Union Status[nonunion]=
	QUANTUM(
	  SUM(
	    Change in Domestic Jobs after Productivity Effects by ISIC Code[ISIC Code!]
	    * (1 - URPbIC Union Representation Percentage by ISIC Code[ISIC Code!])
	  ),
	
	  Quantization Size for Jobs
	)
	~	jobs
	~		|

Change in Domestic Output by ISIC Code[ISIC Code] :EXCEPT: [Fossil and Energy Utility ISIC Code\
		]=
	ZIDZ(
	  Change in Domestic Value Added by ISIC Code[ISIC Code],

	  Within Industry Value Added per Unit Output[ISIC Code]
	) ~~|
Change in Domestic Output by ISIC Code[Fossil and Energy Utility ISIC Code]=
	Direct Change in Fuel Industry Revenue by ISIC Code[Fossil and Energy Utility ISIC Code\
		]
	* Domestic Content Share of Consumption by ISIC Code[Fossil and Energy Utility ISIC Code\
		]
	* FoPTaFbIC Fractions of Products That are Fuels by ISIC Code[Fossil and Energy Utility ISIC Code\
		]

	+ SUM(
	  Change in Fuel Industry Cash Flow from Fuel Exports[All Fuels!]
	  * Export Backing Share by Fuel[All Fuels!]
	  * FtPICM Fuel to Producing ISIC Code Map[All Fuels!,Fossil and Energy Utility ISIC Code\
		]
	)
	* (1 - Domestic Content Share of Consumption by ISIC Code[Fossil and Energy Utility ISIC Code\
		])
	* FoPTaFbIC Fractions of Products That are Fuels by ISIC Code[Fossil and Energy Utility ISIC Code\
		]

	+ ZIDZ(
	  Change in Domestic Value Added by ISIC Code[Fossil and Energy Utility ISIC Code]
	  - Change in Fuel Production Mapped to ISIC Codes[Fossil and Energy Utility ISIC Code\
		]
	    * Within Industry Value Added per Unit Energy Production[Fossil and Energy Utility ISIC Code\
		]
	    * FoPTaFbIC Fractions of Products That are Fuels by ISIC Code[Fossil and Energy Utility ISIC Code\
		],

	  Within Industry Value Added per Unit Output[Fossil and Energy Utility ISIC Code]
	)
	~	$
	~	For nonenergy industries, the change in output is reconstructed from the \
		change in value added at the industry's BAU value-added-per-unit-output \
		ratio.  For fossil and energy utility industries, the fuel portion of the \
		change in output is instead the price-inclusive change in domestic fuel \
		industry revenue (weighted by FoPTaFbIC, mirroring the BAU Output by ISIC \
		Code by Year blend), so that these industries' revenue tracks fuel prices \
		the same way their fuel input costs do.  The remaining (non-fuel) portion \
		converts the residual change in value added - total minus the physical \
		fuel-production term already counted in Direct Change in Domestic Value \
		Added - at the value-added-per-unit-output ratio.  Value added and \
		employment for these industries remain on the physical energy production \
		basis.  The change in fuel export cash flow is additionally credited at (1 \
		- domestic content share): the main revenue term is DCS-weighted (correct \
		for domestic sales, where only the domestically-produced share accrues to \
		local producers), but exports are entirely domestically produced, so their \
		DCS-cut portion is restored here.  Mirrors the same domestic-vs-export \
		split in BAU Domestic Energy Revenue by Producing ISIC Code.
	|

Change in Domestic Value Added by ISIC Code[Target ISIC Code]=
	Direct Change in Domestic Value Added by ISIC Code[Target ISIC Code]
	+ Indirect Change in Domestic Value Added by ISIC Code[Target ISIC Code]
	+ Induced Change in Domestic Value Added by ISIC Code[Target ISIC Code]
	~	$
	~		|

Change in Elec CCS Transportation and Storage Costs[Electricity Source]=
	Electricity Sector CCS Transportation and Storage Costs[Electricity Source]
	- BAU Electricity Sector CCS Transportation and Storage Costs[Electricity Source]
	~	$
	~		|

Change in Electricity Demand from Demand Altering Technologies for Net Peak Load Reduction\
		[Electricity Timeslice
,Hour]=
	MAX(
	  Increase in Demand by Hour for Seasonal Net Peak Load Reduction[Electricity Timeslice\
		,Hour]
	  + Increase in Demand by Hour for Diurnal Net Peak Load Reduction[Electricity Timeslice\
		,Hour]
	  - Decrease in Demand by Hour for Seasonal Net Peak Load Reduction[Electricity Timeslice\
		,Hour]
	  - Decrease in Demand by Hour for Diurnal Net Peak Load Reduction[Electricity Timeslice\
		,Hour],
	
	  - Total Electricity Demand by Hour Before Demand Altering Technologies[Electricity Timeslice\
		,Hour] * 0.95
	)
	~	MW*hr
	~		|

Change in Electricity Demand from Demand Altering Technologies on Peak Summer Day[Hour\
		]=
	SUM(Change in Electricity Demand from Demand Altering Technologies for Net Peak Load Reduction\
		[peak summer day electricity timeslice!,Hour])
	/ ELMCOUNT(peak summer day electricity timeslice)
	~	MW*hr
	~		|

Change in Electricity Demand from Demand Altering Technologies on Peak Winter Day[Hour\
		]=
	SUM(Change in Electricity Demand from Demand Altering Technologies for Net Peak Load Reduction\
		[peak winter day electricity timeslice!,Hour])
	/ ELMCOUNT(peak winter day electricity timeslice)
	~	MW*hr
	~		|

Change in Electricity Exports=
	Exported Electricity
	- EIaE BAU Exported Electricity
	~	MW*hour
	~		|

Change in Electricity Fuel Taxes Paid[Electricity Source]=
	Total Tax Paid on Electricity Fuels[Electricity Source]
	- BAU Total Tax Paid on Electricity Fuels[Electricity Source]
	~	$
	~		|

Change in Electricity Generation by Type[Electricity Source]=
	Electricity Generation by Type[Electricity Source]
	- BAU Electricity Generation by Type[Electricity Source]
	~	MW*hour
	~		|

Change in Electricity Generation Capacity[Electricity Source]=
	Electricity Generation Capacity[Electricity Source]
	- BAU Electricity Generation Capacity[Electricity Source]
	~	MW
	~		|

Change in Electricity Generation Subsidies Paid[Electricity Source]=
	(This Year Ongoing Subsidies Paid per Unit Electricity Output[Electricity Source]
	- BAU This Year Ongoing Subsidies Paid per Unit Electricity Output[Electricity Source\
		])
	
	+ (Subsidies for Elec Production for Existing Plants Paid This Year[Electricity Source\
		]
	- BAU Subsidies for Elec Production for Existing Plants Paid This Year[Electricity Source\
		])
	~	$
	~		|

Change in Electricity Imports=
	Imported Electricity
	- BAU Imported Electricity
	~	MW*hour
	~		|

Change in Electricity Sector Battery Costs=
	DEPRECIATE STRAIGHTLINE(
	
	  Amount Spent on Grid Batteries
	  - BAU Amount Spent on Grid Batteries,
	 
	  STfESCE Smoothing Time for Electricity Sector Capital Expenditures,
	
	  1,
	
	  0
	)
	~	$
	~	We use a DEPRECIATE STRAIGHTLINE function to even out price spikes that \
		unrealistically affect the price of electricity, because the costs of \
		construction of new generation assets really would be spread out over a \
		few years.  We use an initial value of zero because prior to the start of \
		the model run, the change in construction costs due to policies is zero \
		(none were in effect).
	|

Change in Electricity Sector Capacity Construction Costs[Electricity Source]=
	DEPRECIATE STRAIGHTLINE(
	
	  Cost of Capacity Construction before Construction Subsidies[Electricity Source]
	  + Cost of Capacity Retrofitting before Construction Subsidies[Electricity Source]
	  - BAU Cost of Capacity Construction before Construction Subsidies[Electricity Source\
		]
	  - BAU Cost of Capacity Retrofitting before Construction Subsidies[Electricity Source\
		],
	 
	  STfESCE Smoothing Time for Electricity Sector Capital Expenditures,
	
	  1,
	
	  0
	)
	~	$
	~	We use a DEPRECIATE STRAIGHTLINE function to even out price spikes that \
		unrealistically affect the price of electricity, because the costs of \
		construction of new generation assets really would be spread out over a \
		few years.  We use an initial value of zero because prior to the start of \
		the model run, the change in construction costs due to policies is zero \
		(none were in effect).
	|

Change in Electricity Sector Carbon Tax Rebate due to CCS[Electricity Source]=
	Electricity Sector Carbon Tax Rebate due to CCS[Electricity Source]-BAU Electricity Sector Carbon Tax Rebate due to CCS\
		[Electricity Source]
	~	$
	~		|

Change in Electricity Sector CCS Transportation and Storage Costs[Electricity Source]\
		=
	Electricity Sector CCS Transportation and Storage Costs[Electricity Source]
	- BAU Electricity Sector CCS Transportation and Storage Costs[Electricity Source]
	~	$
	~		|

Change in Electricity Sector CCS Transportation and Storage Costs by Recipient ISIC Code\
		[ISIC Code] :EXCEPT:  [ISIC 352T353]=
	0 ~~|
Change in Electricity Sector CCS Transportation and Storage Costs by Recipient ISIC Code\
		[ISIC 352T353]=
	SUM(Change in Electricity Sector CCS Transportation and Storage Costs[Electricity Source\
		!])
	~	$
	~		|

Change in Electricity Sector CCS Transportation and Storage Subsidies[Electricity Source\
		]=
	Electricity Sector CCS Transportation and Storage Subsidies[Electricity Source]
	- BAU Electricity Sector CCS Transportation and Storage Subsidies[Electricity Source\
		]
	~	$
	~		|

Change in Electricity Sector Fixed OM Costs[Electricity Source]=
	Elec Supplier Fixed OM Costs[Electricity Source]
	- BAU Elec Supplier Fixed OM Costs[Electricity Source]
	~	$
	~		|

Change in Electricity Sector Fixed OM Costs by Recipient ISIC Code[ISIC Code]=
	SUM(
	  Change in Electricity Sector Fixed OM Costs[Electricity Source!]
	  * SoESCaOMCbIC Share of Electricity Sector Fixed OM Costs by ISIC Code[Electricity Source\
		!,ISIC Code]
	)
	~	$
	~		|

Change in Electricity Sector OM Costs by Recipient ISIC Code[ISIC Code]=
	Change in Electricity Sector Fixed OM Costs by Recipient ISIC Code[ISIC Code]
	+ Change in Electricity Sector Variable OM Costs by Recipient ISIC Code[ISIC Code]
	+ Change in Transmission OM Costs by Recipient ISIC Code[ISIC Code]
	+ Change in Distribution OM Costs by Recipient ISIC Code[ISIC Code]
	+ Change in Electricity Sector CCS Transportation and Storage Costs by Recipient ISIC Code\
		[ISIC Code]
	~	$
	~		|

Change in Electricity Sector Pollutant Emissions[Pollutant]=
	SUM(Electricity Sector Pollutant Emissions[Pollutant,Electricity Source!])
	- SUM(BAU Electricity Sector Pollutant Emissions[Pollutant,Electricity Source!])
	~	g pollutant
	~		~	:SUPPLEMENTARY 
	|

Change in Electricity Sector Variable OM Costs[Electricity Source]=
	Elec Supplier Variable OM Costs[Electricity Source]
	- BAU Elec Supplier Variable OM Costs[Electricity Source]
	~	$
	~		|

Change in Electricity Sector Variable OM Costs by Recipient ISIC Code[ISIC Code]=
	SUM(
	  Change in Electricity Sector Variable OM Costs[Electricity Source!]
	  * SoESCaOMCbIC Share of Electricity Sector Variable OM Costs by ISIC Code[Electricity Source\
		!,ISIC Code]
	)
	~	$
	~		|

Change in Electricity Supplier Costs Recovered through Electricity Rates per Unit Electricity Delivered for Cost of Service Rates\
		=
	Electricity Supplier Costs Recovered through Electricity Rates per Unit Electricity Delivered for Cost of Service Rates
	- BAU Electricity Supplier Costs Recovered through Electricity Rates per Unit Electricity Delivered for Cost of Service Rates
	~	$/BTU
	~		|

Change in Electricity Supplier Other Expenditures=
	Electricity Supplier Other Expenditures
	-BAU Electricity Supplier Other Expenditures
	~	$
	~		|

Change in Electricity Transmission and Distribution OM Expenditures=
	Electricity Transmission and Distribution OM Expenditures
	-BAU Electricity Transmission and Distribution OM Expenditures
	~	$
	~		|

Change in Embedded CO2 in Exported Fuels[All Fuels]=
	Change in Fuel Exports[All Fuels]
	* CO2 Emissions Intensity by Fuel for All Fuels[All Fuels]
	~	g pollutant
	~		|

Change in Energy Export Revenue including Electricity[All Fuels] :EXCEPT: [electricity\
		]=
	QUANTUM(
	  Change in Fuel Export Revenue[All Fuels],
	  QSfCF Quantization Size for Cash Flows
	) ~~|
Change in Energy Export Revenue including Electricity[electricity]=
	Change in Amount Received from Exporting Electricity
	~	$
	~		|

Change in Energy Exports including Electricity[All Fuels] :EXCEPT:  [electricity]=
