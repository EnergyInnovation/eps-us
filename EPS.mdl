Vehicles[Vehicle Type,Cargo Type,Vehicle Technology]=
	SUM(Last Year Vehicles by Vintage[Vehicle Type,Cargo Type,Vehicle Technology,Vehicle Vintage\
		!])
	+ New Vehicles[Vehicle Type,Cargo Type,Vehicle Technology] * One Year
	- Retiring Vehicles[Vehicle Type,Cargo Type,Vehicle Technology] * One Year
	~	vehicles
	~		|

Vehicles per Household Curve Position[Vehicle Type,Cargo Type]= INITIAL(
	IF THEN ELSE(
	  VpHCS Vehicles per Household Curve Saturation[Vehicle Type,Cargo Type] > Start Year Vehicles per Household\
		[Vehicle Type,Cargo Type]
	  :AND: Start Year Vehicles per Household[Vehicle Type,Cargo Type] > 0,
	  LN(Start Year Vehicles per Household[Vehicle Type,Cargo Type] / VpHCS Vehicles per Household Curve Saturation\
		[Vehicle Type,Cargo Type])
	  / exp(VpHCIR Vehicles per Household Curve Income Response[Vehicle Type,Cargo Type]\
		 * ZIDZ(GET DATA AT TIME(BGDP BAU Gross Domestic Product, INITIAL TIME - One Year),\
		 GET DATA AT TIME(NoH Number of Households, INITIAL TIME - One Year))),
	  0)
	)
	~	Dmnl
	~		|

Vehicles per Household Ratio to BAU[Vehicle Type,Cargo Type]=
	IF THEN ELSE(
	  BDMFL Boolean Disable Macroeconomic Feedback Loops > 0,
	  1,
	  exp(Vehicles per Household Curve Position[Vehicle Type,Cargo Type]
	    * (exp(VpHCIR Vehicles per Household Curve Income Response[Vehicle Type,Cargo Type\
		] * BAU GDP per Household * Last Year GDP Ratio to BAU)
	       - exp(VpHCIR Vehicles per Household Curve Income Response[Vehicle Type,Cargo Type\
		] * BAU GDP per Household)))
	)
	~	Dmnl
	~		|

Vehicles per Million Vehicles=
	1e+06
	~	vehicles/million vehicles
	~		|

Vehicles per Thousand Vehicles=
	1000
	~	vehicles/thousand vehicles
	~		|

Viability Headroom Ratio for Cost Driven Retirement[Electricity Source]=
	MAX(1,
	  ZIDZ(Maximum Capacity Factor after RAF[Electricity Source] * Hours per Year,
	    Three Year Average Fleet Generation Hours for Cost Driven Retirement[Electricity Source\
		]))
	~	Dmnl
	~		|

Viability Ratio for Cost Driven Retirement[Electricity Source,Optimization Pass]=
	ZIDZ(
	  Three Year Average CF Scaling Revenue for Cost Driven Retirement[Electricity Source\
		]
	    * Viability Headroom Ratio for Cost Driven Retirement[Electricity Source]
	  + Predicted Capacity Payment by Plant Type for Existing Plants[Electricity Source,\
		Optimization Pass],
	  Required Revenue for Breakeven Target[Electricity Source])
	~	Dmnl
	~		|

Viability Ratio for Cost Driven Retirement Excluding Capacity Payment[Electricity Source\
		]=
	ZIDZ(
	  Three Year Average CF Scaling Revenue for Cost Driven Retirement[Electricity Source\
		]
	    * Viability Headroom Ratio for Cost Driven Retirement[Electricity Source],
	  Required Revenue for Breakeven Target[Electricity Source])
	~	Dmnl
	~		|

