	~	BTU
	~		|

Initial Guess at Capacity Market Price=
	150
	~	$/(MW*day)
	~		|

Initial Guess at CES Price=
	MIN(
	   MAX(5,
	      ZIDZ(
	        SUM(
	          Cost per Unit New Elec Output Using Expected Capacity Factors[Electricity Source\
		!]
	          *Last Year Electricity Generation Capacity[Electricity Source!]
	          *Elec Portfolio Qualifying Sources[Electricity Source!,CES]
	        ),
	
	        SUM(Elec Portfolio Qualifying Sources[Electricity Source!,CES]*Last Year Electricity Generation Capacity\
		[Electricity Source!])
	  )
	 ),
	  Elec Portfolio Alternative Compliance Payment
	)
	~	$/(MW*hr)
	~	We use a maximum of $5/MWh or the calculated value.
	|

Initial Guess at RPS Price=
	MIN(
	    MAX(5,
	      ZIDZ(
	        SUM(
	          Cost per Unit New Elec Output Using Expected Capacity Factors[Electricity Source\
		!]
	          *Last Year Electricity Generation Capacity[Electricity Source!]
	          * Elec Portfolio Qualifying Sources[Electricity Source!,RPS]
	        ),
	
	        SUM(Elec Portfolio Qualifying Sources[Electricity Source!,RPS]*Last Year Electricity Generation Capacity\
		[Electricity Source!])
	      )
	  ),
	  Elec Portfolio Alternative Compliance Payment
	)
	~	$/(MW*hr)
	~	We use a maximum of $5/MWh or the calculated value.
	|

Initial Output by Industry Category and Process[Industry Category,Industrial Process]\
		= INITIAL(
	SYObIC Start Year Output by ISIC Code[Industry Category ISIC Code]
	*
	ZIDZ(Total BAU Fuel Use for Energy Purposes by Industrial Process in Electricity Equivalent\
		[Industry Category,Industrial Process],
	  SUM(Total BAU Fuel Use for Energy Purposes by Industrial Process in Electricity Equivalent\
		[Industry Category,Industrial Process!])
	))
	~	$
	~		|

Initial Time Dimensionless=
	INITIAL TIME / One Year
	~	Dmnl
	~		|

Intensity Standard Clinker Substitution Fraction=
	MIN(CSPAbY Clinker Substitution Potential Available by Year,
	    ZIDZ(MAX(0, BCtCR BAU Clinker to Cement Ratio
	                - (Last Year Clinker to Cement Ratio - Clinker Ratio Reduction Required by Intensity Standard\
		)),
	         MAX(0, BCtCR BAU Clinker to Cement Ratio - MACtCR Minimum Achievable Clinker to Cement Ratio\
		)))
	~	Dmnl
	~	Share of the achievable clinker substitution the intensity standard calls \
		for this year: the ratio reduction needed (on top of last year's) as a \
		fraction of the gap between the BAU and minimum ratios, capped by this \
		year's SCM supply. The first compliance step; the cheapest one in practice.
	|

Intensity Standard Gap after Clinker Substitution=
	MAX(0, Cement Intensity Standard Gap
	  - MIN(Clinker Ratio Reduction Required by Intensity Standard,
	        MAX(0, Last Year Clinker to Cement Ratio
	               - (BCtCR BAU Clinker to Cement Ratio
	                  - CSPAbY Clinker Substitution Potential Available by Year
	                    * MAX(0, BCtCR BAU Clinker to Cement Ratio - MACtCR Minimum Achievable Clinker to Cement Ratio\
		))))
	    * Last Year Cement Fleet Net CO2 Intensity per Ton of Clinker)
	~	kg CO2/metric ton
	~	The part of the intensity gap clinker substitution cannot close this year \
		(SCM supply exhausted), to be met by building low-carbon kilns.
	|

Intensity Standard Required Share of New Clinker Capacity=
	ZIDZ(Intensity Standard Gap after Clinker Substitution / Kilograms per Metric Ton
	       * Last Year Cement Domestic Production in Cement Tons,
	     Last Year Total New Clinker Production Capacity
	       * SUM(Low Carbon Pathway Allocation of Required New Clinker Capacity[Cement Production Pathway\
		!] * Cement CCfD Abatement per Ton of Clinker by Pathway[Cement Production Pathway!\
		]))
	~	Dmnl
	~	Share of new clinker capacity the intensity standard needs as low-carbon \
		kilns: the CO2 gap left after clinker substitution, in tons, over what \
		last year's total new capacity would abate if built as the low-carbon mix.
	|

Interest Rate Subsidy Value for Industrial Equipment[Industry Category]=
	MAX(0,
	  This Year Financing Repayments for Industrial Equipment at Unsubsidized Rate[Industry Category\
		]
	  - This Year Financing Repayments for Industrial Equipment[Industry Category]
	)
	~	$
	~	What industry saves this year because the industrial cost of capital lever \
		reduced the financing interest rate: policy-case loan repayments at the \
		unsubsidized rate minus actual policy-case repayments.  Compares two \
		policy-case ladders (never policy vs BAU), so it isolates the rate effect \
		from policy-driven changes in loan volume.  Zero when the lever is \
		inactive.
	|

Interregional Electricity Trade Costs=
	Amount Spent on Importing Electricity
	-Amount Received from Exporting Electricity
	~	$
	~		|

Inverse Square Root of Two Pi=
	1/sqrt(2*3.14159)
	~	Dmnl
	~		|

IRoND Interest Rate on National Debt=
	GET DIRECT CONSTANTS(
	   'InputData/io-model/IRoND/IRoND.csv',
	   ',',
	   'B2'
	)
	~	Dmnl
	~		|

Is Carbon Tax Border Adjustment Disabled=
