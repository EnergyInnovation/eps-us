PEM BAU Deployed Share by End Year by Row[PEaWHRP PM Row]=
	GET DIRECT CONSTANTS(
	   'InputData/indst/PEaWHRP/PEaWHRP-PMD.csv',
	   ',',
	   'L2*'
	)
	~	Dmnl
	~	Share of each measure row's loaded potential that the BAU case is assumed \
		to reach by the model's final year without new policy (e.g. from baseline \
		policies such as the EU ETS and EED in European geographies).  The model \
		interpolates linearly from zero at the start year, using INITIAL TIME and \
		FINAL TIME so the ramp adapts to each geography's run period.  Set to zero \
		in the US, where current policy is not expected to drive material \
		deployment of these measures.  Long-form read; use the PEMBDS remap in \
		equations.
	|

PEM Capital Cost by Row[PEaWHRP PM Row]=
	GET DIRECT CONSTANTS(
	   'InputData/indst/PEaWHRP/PEaWHRP-PMD.csv',
	   ',',
	   'G2*'
	)
	~	$/BTU
	~	Capital cost per BTU of annual energy savings capacity for each process \
		efficiency measure row.  Long-form read; use the PEMCC remap in equations.
	|

PEM Elec Savings Potential by Row[PEaWHRP PM Row]=
	GET DIRECT CONSTANTS(
	   'InputData/indst/PEaWHRP/PEaWHRP-PMD.csv',
	   ',',
	   'F2*'
	)
	~	Dmnl
	~	Electricity savings potential as a fraction of industry total electricity \
		use.  Long-form read; use the PEMESP remap in equations.
	|

PEM Equipment Lifetime by Row[PEaWHRP PM Row]=
	GET DIRECT CONSTANTS(
	   'InputData/indst/PEaWHRP/PEaWHRP-PMD.csv',
	   ',',
	   'I2*'
	)
	~	years
	~	Equipment lifetime for each process efficiency measure row.  Long-form \
		read; use the PEMEL remap in equations.
	|

PEM Fuel Savings Potential by Row[PEaWHRP PM Row]=
	GET DIRECT CONSTANTS(
	   'InputData/indst/PEaWHRP/PEaWHRP-PMD.csv',
	   ',',
	   'E2*'
	)
	~	Dmnl
	~	Fuel savings potential as a fraction of industry total combustion fuel \
		use.  Long-form read; use the PEMFSP remap in equations.
	|

PEM OM Cost by Row[PEaWHRP PM Row]=
	GET DIRECT CONSTANTS(
	   'InputData/indst/PEaWHRP/PEaWHRP-PMD.csv',
	   ',',
	   'H2*'
	)
	~	$/BTU
	~	Annual operations and maintenance cost per BTU of annual energy savings \
		capacity for each process efficiency measure row.  May be negative for \
		measures that reduce nonenergy operating costs.  Long-form read; use the \
		PEMOC remap in equations.
	|

PEMBDS Process Efficiency Measure BAU Deployed Share by End Year[Industry Category,Process Efficiency Measure\
		]= INITIAL(
	VECTOR ELM MAP(
	  PEM BAU Deployed Share by End Year by Row[pem 01T03 X efficiency measure 1],
	  (Industry Category - 1) * ELMCOUNT(Process Efficiency Measure)
	  + (Process Efficiency Measure - 1)
	))
	~	Dmnl
	~	Share of each measure's loaded potential reached in the BAU case by the \
		model's final year without new policy.  Zero in the US; used in European \
		geographies to represent baseline-policy-driven deployment (ETS, EED).
	|

PEMCC Process Efficiency Measure Capital Cost per Unit Annual Energy Saved[Industry Category\
		,Process Efficiency Measure]= INITIAL(
	VECTOR ELM MAP(
	  PEM Capital Cost by Row[pem 01T03 X efficiency measure 1],
	  (Industry Category - 1) * ELMCOUNT(Process Efficiency Measure)
	  + (Process Efficiency Measure - 1)
	))
	~	$/BTU
	~	Capital cost of each process efficiency measure per BTU of annual energy \
		savings capacity, in the units of IECCpUAEU.
	|

PEMEL Process Efficiency Measure Equipment Lifetime[Industry Category,Process Efficiency Measure\
		]= INITIAL(
	VECTOR ELM MAP(
	  PEM Equipment Lifetime by Row[pem 01T03 X efficiency measure 1],
	  (Industry Category - 1) * ELMCOUNT(Process Efficiency Measure)
	  + (Process Efficiency Measure - 1)
	))
	~	years
	~	Lifetime of each process efficiency measure, used for capital cost \
		annualization and retirement of deployed savings.
	|

PEMESP Process Efficiency Measure Elec Savings Potential[Industry Category,Process Efficiency Measure\
		]= INITIAL(
	VECTOR ELM MAP(
	  PEM Elec Savings Potential by Row[pem 01T03 X efficiency measure 1],
	  (Industry Category - 1) * ELMCOUNT(Process Efficiency Measure)
	  + (Process Efficiency Measure - 1)
	))
	~	Dmnl
	~	Electricity savings potential of each process efficiency measure as a \
		fraction of the industry's total electricity use.
	|

PEMFSP Process Efficiency Measure Fuel Savings Potential[Industry Category,Process Efficiency Measure\
		]= INITIAL(
	VECTOR ELM MAP(
	  PEM Fuel Savings Potential by Row[pem 01T03 X efficiency measure 1],
	  (Industry Category - 1) * ELMCOUNT(Process Efficiency Measure)
	  + (Process Efficiency Measure - 1)
	))
	~	Dmnl
	~	Fuel savings potential of each process efficiency measure as a fraction of \
		the industry's total combustion fuel use.
	|

PEMOC Process Efficiency Measure OM Cost per Unit Energy Saved[Industry Category,Process Efficiency Measure\
		]= INITIAL(
	VECTOR ELM MAP(
	  PEM OM Cost by Row[pem 01T03 X efficiency measure 1],
	  (Industry Category - 1) * ELMCOUNT(Process Efficiency Measure)
	  + (Process Efficiency Measure - 1)
	))
	~	$/BTU
	~	Annual OM cost of each process efficiency measure per BTU of annual energy \
		savings capacity.  May be negative.
	|

Pending Cost Driven Retirements[Electricity Source]= INTEG(
	Change in Pending Cost Driven Retirements[Electricity Source], 0)
	~	MW
	~		|

Pending Cost Driven Retirements Excluding Capacity Payment[Electricity Source]= INTEG\
		(
	Change in Pending Cost Driven Retirements Excluding Capacity Payment[Electricity Source\
		], 0)
	~	MW
	~		|

penultimate pass:
