Nonqualifying New Entry Binding Hour Capability=
	SUM(
	  (1 - Elec Portfolio Qualifying Sources[Electricity Source!,CES])
	  * MAX(0,
	      MIN(
	        Max Capacity Buildable after Cost Effective and RPS Additions[Electricity Source\
		!,CES],
	        Capacity Supply Curve Parameters by Power Plant Type[saturation,Electricity Source\
		!] * One MW
	          * CSCSoCECBiaSY Share of Cost Effective Capacity Built in a Single Year[Electricity Source\
		!]
	        - Total New Capacity Desired due to Cost Effectiveness[Electricity Source!,CES\
		]
	      )
	    )
	  * Uncredited Binding Hour Bid Electricity Capacity Factors for Reliability by Plant Type\
		[Electricity Source!]
	)
	* One Hour
	~	MW*hour
	~		|

