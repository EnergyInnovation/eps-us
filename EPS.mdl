	  )
	~	Dmnl
	~		|

Share of Procured Cement Supplied as Blended Cement=
	IF THEN ELSE(Clinker Ratio Needed for Procured Cement to Qualify >= Minimum Clinker Ratio of Blended Low Carbon Cement\
		 :AND: Fraction of Cement Demand Purchased under Low Carbon Procurement This Year >\
		 0,
	  MIN(1, ZIDZ(Fraction of Additional Clinker Substitution This Year, Fraction of Cement Demand Purchased under Low Carbon Procurement This Year\
		 * MAX(0, BCtCR BAU Clinker to Cement Ratio - Clinker Ratio Needed for Procured Cement to Qualify\
		))),
	  0)
	~	Dmnl
	~	Share of the procured cement supplied as blended cement this year: the \
		clinker substitution achieved (from any policy, capped by supplementary \
		material supply) over what blending the whole procured volume would take. \
		Producers send their blended cement to the committed buyers first.
	|

Share of Start Year Buildings Surviving[Building Type]=
	MAX(
	  0,
	
	  1 -
	  (
	    (Time - INITIAL TIME + 1)
	    / CL Component Lifetime[Building Type,envelope]
	  )
	)
	~	Dmnl
	~		|

Share of Total Electricity Dispatched by Hour by Plant Type[Electricity Timeslice,Hour\
		,Electricity Source]=
	ZIDZ(Total Electricity Dispatched by Hour by Plant Type[Electricity Timeslice,Hour,Electricity Source\
		]
	, SUM(Total Electricity Dispatched by Hour by Plant Type[Electricity Timeslice,Hour,\
		Electricity Source!]))
	~	Dmnl
	~	ZIDZ guard: total dispatch can be exactly zero in hours where net imports \
		cover all demand (residual demand clamps to zero), which would otherwise \
		divide by zero here.
	|

