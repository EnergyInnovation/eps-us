	GET DIRECT CONSTANTS(
	   'InputData/ccs/CC/CC-CCoHSCE.csv',
	   ',',
	   'B2'
	)
	~	$/metric ton CO2e/Year
	~		|

CC Capital Cost of Eqpt to Sequester One Ton of Industry CO2 per Year[Industry Category\
		,energy related emissions]=
	GET DIRECT CONSTANTS(
	   'InputData/ccs/CC/CC-CCoIECE.csv',
	   ',',
