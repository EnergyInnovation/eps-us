Mileage Weighted Vehicles[Vehicle Type,Cargo Type,Vehicle Technology]=
	SUM(Last Year Vehicles by Vintage[Vehicle Type,Cargo Type,Vehicle Technology,Vehicle Vintage\
		!] * (1 - Vehicle Survival Rate by Vehicle Type Cargo Type Engine and Vintage[Cargo Type\
		,Vehicle Type,Vehicle Vintage!]) * Vehicle Relative Annual Mileage by Vintage[Cargo Type\
		,Vehicle Type,Vehicle Vintage!])
	+ New Vehicles[Vehicle Type,Cargo Type,Vehicle Technology] * One Year
	~	vehicles
	~		|

