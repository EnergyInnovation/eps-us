Change in Kept Online Capacity Pool due to Predicted Capacity Payment[Electricity Source\
		]=
	(MIN(
	   Economic Capacity Retirements Excluding Capacity Payment[Electricity Source],
	   MAX(0,
	     MIN(
	       Generation Capacity Reliant on Predicted Capacity Payment This Year[Electricity Source\
		],
	       Electricity Generation Capacity[Electricity Source])
	     - Kept Online Capacity Pool due to Predicted Capacity Payment[Electricity Source\
		]))
	 - MIN(
	   Kept Online Capacity Pool due to Predicted Capacity Payment[Electricity Source],
	   Retiring Generation Capacity[Electricity Source]
	   + MAX(0,
	     Kept Online Capacity Pool due to Predicted Capacity Payment[Electricity Source]
	     - Electricity Generation Capacity[Electricity Source])))
	/ One Year
	~	MW/Year
	~		|

