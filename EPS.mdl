Percent Change in Employment by Demographic Trait[Demographic Trait]=
	ZIDZ(
	
	  Domestic Employment by Demographic Trait[Demographic Trait]
	  - BAU Domestic Employment by Demographic Trait[Demographic Trait],
	
	  BAU Domestic Employment by Demographic Trait[Demographic Trait]
	)
	~	Dmnl
	~		|

Percent Change in Exports of Nonenergy Products[Industry Category]=
	MAX(
	
	  -1, 
	
	  ZIDZ(
	    Domestic Product Attractiveness Ratio due to Passthrough Cost Changes[Industry Category\
		],

	    EMSbIC Export Market Share by Industry Category[Industry Category]
	    * Domestic Product Attractiveness Ratio due to Passthrough Cost Changes[Industry Category\
		]
	    + 1 - EMSbIC Export Market Share by Industry Category[Industry Category]
	  )
	  - 1

	)
	~	Dmnl
	~	CES (Armington) share equation: foreign buyers reallocate between this \
		geography's exports and competing supply as relative costs change.  The \
		denominator renormalizes over the whole foreign market, so the export \
		response shrinks as this geography's world market share (EMSbIC) grows - a \
		dominant exporter cannot lose more sales than buyers can substitute away.  \
		At EMSbIC = 0 this reduces to the small-share power form (cost \
		ratio)^(-elasticity) - 1, which is why 0 is a safe default for geographies \
		without market share data.  Outer MAX(-1, ...) retained as a redundant \
		safety bound.
	|

Percent Change in Fleet Avg Fuel Economy[Vehicle Type,Cargo Type,Vehicle Technology]=
	IF THEN ELSE(BAU Fleet Avg Fuel Economy[Vehicle Type,Cargo Type,Vehicle Technology] \
		> 0, (Fleet Avg Fuel Economy[Vehicle Type,Cargo Type,Vehicle Technology]
	  - BAU Fleet Avg Fuel Economy[Vehicle Type,Cargo Type,Vehicle Technology]) / (BAU Fleet Avg Fuel Economy\
		[Vehicle Type,Cargo Type,Vehicle Technology]), 0)
	~	Dmnl
	~		|

Percent Change in Fuel Costs due to Energy Price Feedbacks[All Fuels,Sectors]=
	ZIDZ(
	  Pretax Fuel Cost per Unit Energy by Sector After Modeled Price Adjustments[All Fuels\
		,Sectors]
	  - BAU Pretax Fuel Cost per Unit Energy by Sector with Sensitivity Analysis Adjustment\
		[All Fuels,Sectors],
	
	  BAU Pretax Fuel Cost per Unit Energy by Sector with Sensitivity Analysis Adjustment\
		[All Fuels,Sectors]
	)
	~	Dmnl
	~	This variable is only used to assess performance of the energy price \
		feedbacks and is not used in downstream calculations.
	~	:SUPPLEMENTARY 
	|

