Binding Hour Demand Shifting Headroom for Reliability=
	SUM(Binding Peak Hour for Reliability Additions[peak day electricity timeslice!,Hour\
		!]
	    * Demand Shifting Headroom for Reliability by Hour[peak day electricity timeslice\
		!,Hour!]
	    * ELCCAfR ELCC Adjustment for Reliability for Demand Altering Technologies[peak day electricity timeslice\
		!,Hour!])
	~	MW
	~		|

Binding Hour Hybrid Storage Capability for Reliability=
	SUM(Last Year Hybrid Grid Battery Storage Capacity[Electricity Source!])
	/ GBSC Diurnal Grid Battery Daily Storage Duration
	* RAF Regional Availability Factor for Demand Altering Technologies
	* SUM(Binding Peak Hour for Reliability Additions[peak day electricity timeslice!,Hour\
		!]
	      * ELCCAfR ELCC Adjustment for Reliability for Demand Altering Technologies[peak day electricity timeslice\
		!,Hour!])
	~	MW
	~		|

Binding Hour Reliability Capability Withheld by Credit Derate=
	SUM(
	  Electricity Generation Capacity before Reliability Additions[Electricity Source!]
	  * (Uncredited Binding Hour Bid Electricity Capacity Factors for Reliability by Plant Type\
		[Electricity Source!]
	     - Last Year Hourly Bid Electricity Capacity Factors for Reliability in Binding Hour by Plant Type\
		[Electricity Source
	!])
	)
	* One Hour
	~	MW*hour
	~		|

Binding Hour Reliability Shortfall after Fossil Backstop=
	MAX(0,
	  Reliability Backstop Shortfall
	  - Binding Hour Reliability Capability Withheld by Credit Derate
	)
	~	MW*hour
	~		|

Binding Peak Hour for Reliability Additions[peak day electricity timeslice,Hour]=
	IF THEN ELSE(Net Electricity Demand Relative to Available Supply by Hour before Reliability Additions\
		[peak day electricity timeslice,Hour]<=0,0,
	
	IF THEN ELSE(Net Electricity Demand Relative to Available Supply by Hour before Reliability Additions\
		[peak day electricity timeslice,Hour]=VMAX(Net Electricity Demand Relative to Available Supply by Hour before Reliability Additions\
		[peak day electricity timeslice!,Hour!]),1,0)
	
	)
	~	Dmnl
	~		|

biomass and biofuel within all fuels:
	biomass,
	biofuel gasoline,
	biofuel diesel
	~	Dmnl
	~		|

