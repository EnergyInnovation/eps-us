	   'InputData/elec/UFDfGBS/UFDfGBS.csv',
	   ',',
	   '1',
	   'B2'
	)
	~	Dmnl
	~		|

Uncredited Binding Hour Bid Electricity Capacity Factors for Reliability by Plant Type\
		[Electricity Source]=
	SUM(
	  Binding Peak Hour for Reliability Additions[peak day electricity timeslice!,Hour!]
	  * Last Year Hourly Bid Electricity Capacity Factors by Plant Type[peak day electricity timeslice\
		!,Hour!,Electricity Source
	]
	  * ELCCAfR ELCC Adjustment for Reliability for Generation Sources[Electricity Source\
		,peak day electricity timeslice!,Hour
	!]
	)
	~	Dmnl
	~		|

Union Status:
	union,
	nonunion
	~	
	~		|

Unmet Clinker Production Capacity Need=
	MAX(
	  0,
	  Domestic Clinker Demand
	  - (
	      SUM(Last Year Clinker Production Capacity by Pathway[Cement Production Pathway\
		!])
	      - SUM(Total Clinker Capacity Retired by Pathway[Cement Production Pathway!])
	    )
	    * SYCCU Start Year Cement Capacity Utilization
	)
	~	metric tons/Year
	~	Demand (production units) not servable this year by surviving nameplate \
		capacity net of this year's decision retirements (both the preexisting and \
		the model-run pools - Q4), at the SYCCU sizing norm - the capacity gap the \
		market builds toward. The tightness activation (2026-08-28) kept this \
		trigger at the norm (production itself flexes up to CUUB, and the blend \
		weight damps how much of this gap is built - see Preliminary New Clinker \
		Production Capacity); drives same-year replacement builds via the pathway \
		logit.
	|

Unmet Electricity Demand After Elec Portfolio Std Dispatch[Electricity Timeslice,Hour\
		]=
	QUANTUM(
	MAX(
	  0,
	
	  Unmet Electricity Demand After Guaranteed Dispatch[Electricity Timeslice,Hour]
	  - SUM(Electricity Dispatched to Meet Elec Portfolio Stds[Electricity Timeslice,Hour\
		,Electricity Source!])
	),
	1
	)
	~	MW*hr
	~		|

Unmet Electricity Demand After Guaranteed Dispatch[Electricity Timeslice,Hour]=
	MAX(
	  0,
	
	  Total Electricity Demand by Hour After Demand Altering Technologies[Electricity Timeslice\
		,
	Hour]
	  - SUM(Electricity Dispatched by Guaranteed Dispatch by Hour[Electricity Source!,Electricity Timeslice\
		,Hour])
	)
	~	MW*hr
	~		|

Unmet Electricity Demand after RPS Allocation Steps[Electricity Timeslice,Hour]=
	Unmet Electricity Demand After Zero and Negative Cost RPS Dispatch[Electricity Timeslice\
		,Hour]
	- SUM(Positive Cost Electricity Dispatched to Meet RPS[Electricity Timeslice,Hour,Electricity Source\
		!])
	~	MW*hour
	~		|

Unmet Electricity Demand After RPS and Zero and Negative Cost CES Allocation Steps[Electricity Timeslice\
		,Hour]=
	Unmet Electricity Demand after RPS Allocation Steps[Electricity Timeslice,Hour]
	- SUM(Zero and Negative Cost Electricity Dispatched to Meet CES[Electricity Source!,\
		Electricity Timeslice,Hour])
	~	MW*hour
	~		|

Unmet Electricity Demand After Zero and Negative Cost RPS Dispatch[Electricity Timeslice\
		,Hour]=
	MAX(0,
	  Unmet Electricity Demand After Guaranteed Dispatch[Electricity Timeslice,Hour]
	  -SUM(Zero and Negative Cost Electricity Dispatched to Meet RPS[Electricity Timeslice\
		,Hour,Electricity Source!])
	 )
	~	MW*hr
	~		|

Unmet Electricity Demand by Hour[Electricity Timeslice,Hour]=
	QUANTUM(
	  MAX(
	    0,
	
	    Total Electricity Demand by Hour After Demand Altering Technologies[Electricity Timeslice
	,Hour]
	    - Total Electricity Dispatched by Hour[Electricity Timeslice,Hour]
	  ),
	
	  Quantization Size for Hourly Dispatch
	)
	~	MW*hr
	~		|

Unmet Electricity Demand Summed Across Hours[Electricity Timeslice]=
	SUM(Unmet Electricity Demand by Hour[Electricity Timeslice,Hour!])
	~	MW*hr
	~		~	:SUPPLEMENTARY 
	|

Unserved Clinker Demand This Year=
	MAX(
	  0,
	  Domestic Clinker Demand
	  - SUM(Clinker Production by Pathway[Cement Production Pathway!])
	)
	~	metric tons/Year
	~	Diagnostic (steel P23 lesson): demand the module could not serve (nonzero \
		only if new-build allocation is blocked, e.g. every pathway shareweight \
		zero). Should be zero in any healthy run; check it in every gate \
		extraction.
	~	:SUPPLEMENTARY 
	|

Unviable Fleet Retirement Schedule Base[Electricity Source]= INTEG (
	Change in Unviable Fleet Retirement Schedule Base[Electricity Source],
	0)
	~	MW
	~		|

Unviable Fleet Scheduled Retirement[Electricity Source]=
	Boolean Persistently Deep Unviable for Cost Driven Retirement[Electricity Source]
	* ZIDZ(
	    (Unviable Fleet Retirement Schedule Base[Electricity Source]
	     + Newly Persistently Deep Unviable for Cost Driven Retirement[Electricity Source\
		]
	       * Max Capacity that Can be Retired Economically by Plant Type[Electricity Source\
		])
	    * One Year,
	    RSLfUF Retirement Schedule Length for Unviable Fleets[Electricity Source])
	~	MW
	~		|

URPbIC Union Representation Percentage by ISIC Code[ISIC Code]=
	GET DIRECT CONSTANTS(
	   'InputData/io-model/URPbIC/URPbIC.csv',
	   ',',
	   'B2'
	)
	~	Dmnl
	~		|

Use per Vehicle Multiplier at BAU Fleet Mix[Vehicle Type,Cargo Type]=
	IF THEN ELSE( VAUL Vehicle Absorbed Use as Loading[Vehicle Type,Cargo Type] > 0, MIN\
		( ZIDZ( ZIDZ(Travel Demand Ratio to BAU[Vehicle Type,Cargo Type], Vehicle Loading Multiplier\
		[Vehicle Type,Cargo Type]), ZIDZ( Fleet Size Ratio from Macroeconomic Feedback[Vehicle Type\
		,Cargo Type] * Travel Demand Ratio from Mode Shifting[Vehicle Type,Cargo Type] ^ EoFSwMS Elasticity of Fleet Size wrt Mode Shifting\
		[Vehicle Type,Cargo Type], Vehicle Loading Multiplier[Vehicle Type,Cargo Type]) ), \
		ZIDZ(Maximum Loading Multiplier[Vehicle Type,Cargo Type], Vehicle Loading Multiplier\
		[Vehicle Type,Cargo Type]) ), ZIDZ( ZIDZ(Travel Demand Ratio to BAU[Vehicle Type,Cargo Type\
		], Vehicle Loading Multiplier[Vehicle Type,Cargo Type]), Fleet Size Ratio from Macroeconomic Feedback\
		[Vehicle Type,Cargo Type] * ZIDZ(Travel Demand Ratio from Mode Shifting[Vehicle Type\
		,Cargo Type], Vehicle Loading Multiplier[Vehicle Type,Cargo Type]) ^ EoFSwMS Elasticity of Fleet Size wrt Mode Shifting\
		[Vehicle Type,Cargo Type] ) )
	~	Dmnl
	~		|

Value of CCS[Industry Category,process emissions]=
	Carbon Tax Rate[industry sector]
	* (1 - Does Carbon Tax Exempt Process Emissions This Year[Industry Category])
	
	+ Industrial CCS Transportation and Storage Subsidy
	+ Industry Sector CCS Subsidy by Industry Category[Industry Category] ~~|
Value of CCS[Industry Category,energy related emissions]=
	Industry Sector CCS Subsidy by Industry Category[Industry Category]
	+ Carbon Tax Rate[industry sector]
	+ Industrial CCS Transportation and Storage Subsidy
	~	$/metric ton CO2e
	~		|

Value of Process Efficiency Measure Energy Savings[Industry Category,Process Efficiency Measure\
		]=
	ZIDZ(
	  PEMFSP Process Efficiency Measure Fuel Savings Potential[Industry Category,Process Efficiency Measure\
		]
	  * Industrial Combustion Fuel Base for Measures[Industry Category]
	  * Blended Industrial Combustion Fuel Cost per Unit Energy[Industry Category]
	  + PEMESP Process Efficiency Measure Elec Savings Potential[Industry Category,Process Efficiency Measure\
		]
	  * Industrial Electricity Base for Measures[Industry Category]
	  * Industrial Fuel Cost per Unit Energy[Industry Category,electricity if],

	  PEMFSP Process Efficiency Measure Fuel Savings Potential[Industry Category,Process Efficiency Measure\
		]
	  * Industrial Combustion Fuel Base for Measures[Industry Category]
	  + PEMESP Process Efficiency Measure Elec Savings Potential[Industry Category,Process Efficiency Measure\
		]
	  * Industrial Electricity Base for Measures[Industry Category]
	)
	+ Process Efficiency Measure Performance Subsidy This Year[Industry Category]
	~	$/BTU
	~	Value per BTU saved annually: the average of avoided fuel and electricity \
		expenditures weighted by the BTU each savings channel delivers (fraction \
		times its base), plus any performance subsidy.  Fuel prices are \
		carbon-tax-inclusive, so no separate carbon tax term is added.
	|

Value of Waste Heat Measure Energy Savings[Industry Category,Waste Heat Measure]=
	ZIDZ(
	  WHMFSP Waste Heat Measure Fuel Savings Potential[Industry Category,Waste Heat Measure\
		]
	  * Industrial Heat Combustion Fuel Base for Measures[Industry Category]
	  * Blended Industrial Heat Fuel Cost per Unit Energy[Industry Category]
	  + WHMESP Waste Heat Measure Elec Savings Potential[Industry Category,Waste Heat Measure\
		]
	  * Industrial Heat Electricity Base for Measures[Industry Category]
	  * Industrial Fuel Cost per Unit Energy[Industry Category,electricity if],

	  WHMFSP Waste Heat Measure Fuel Savings Potential[Industry Category,Waste Heat Measure\
		]
	  * Industrial Heat Combustion Fuel Base for Measures[Industry Category]
	  + WHMESP Waste Heat Measure Elec Savings Potential[Industry Category,Waste Heat Measure\
		]
	  * Industrial Heat Electricity Base for Measures[Industry Category]
	)
	+ Waste Heat Measure Performance Subsidy This Year[Industry Category]
	~	$/BTU
	~	Value per BTU saved annually: the average of avoided fuel and electricity \
		expenditures weighted by the BTU each savings channel delivers (fraction \
		times its base), plus any performance subsidy.  Fuel prices are \
		carbon-tax-inclusive, so no separate carbon tax term is added.
	|

Variable Costs per Unit New Elec Output[Electricity Source]=
	Fuel Cost per Unit Output for Plants Built This Year[Electricity Source]
	+ Variable OM Cost per Unit Output for Plants Built This Year[Electricity Source]
	+ Electricity Sector CCS Transportation and Storage Costs per MWh[Electricity Source\
		]
	-Carbon Price Credit per MWh[Electricity Source]
	- Subsidy per Unit Electricity Output Adjusted for Subsidy Duration[Electricity Source\
		]
	- CCS Subsidy per MWh Adjusted for Subsidy Duration[Electricity Source]
	~	$/(MW*hr)
	~		|

Variable OM Cost per Unit Output for Plants Built This Year[Electricity Source]=
	SUM(
	  CCaMC Variable OM Cost per Unit Output[Electricity Source,Modeled Vintage!]
	  * This Year Modeled Vintage Flag[Modeled Vintage!]
	)
	~	$/(MW*hour)
	~		|

Variable Renewable Electricity Source:
	onshore wind es,
	solar PV es,
	solar thermal es,
	offshore wind es
	~	
	~		|

Variable Subsidies per Unit Capacity[Electricity Source]=
	Variable Subsidies per Unit Elec Output[Electricity Source]
	*
	ZIDZ(
	  Last Year Electricity Generation by Type[Electricity Source],
	  Last Year Electricity Generation Capacity[Electricity Source]
	)
	~	$/MW
	~		|

Variable Subsidies per Unit Elec Output[Electricity Source]=
	Carbon Price Credit per MWh[Electricity Source]
	+CCS Subsidy per Unit Output for Dispatch[Electricity Source]
	+Subsidy per Unit Electricity Output for Dispatch[Electricity Source]
	+ Subsidy per Unit Output for Existing Plants[Electricity Source]
	~	$/(MW*hr)
	~		|

Variable Subsidies per Unit New Elec Output[Electricity Source]=
	Carbon Price Credit per MWh[Electricity Source]
	+CCS Subsidy per MWh Adjusted for Subsidy Duration[Electricity Source]
	+Subsidy per Unit Electricity Output Adjusted for Subsidy Duration[Electricity Source\
		]
	~	$/(MW*hr)
	~		|

