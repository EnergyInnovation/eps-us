	  0,
	
	  Construction Cost per Unit Capacity before Construction Subsidies[Electricity Source\
		]
	    - Subsidy per Unit Electricity Capacity Built[Electricity Source]
	)
	
	+ CCaMC Spur Line Construction Cost per Unit Capacity[Electricity Source]
	~	$/MW
	~		|

Construction Cost per Unit Capacity before Construction Subsidies[Electricity Source]\
		 :EXCEPT:             [onshore wind es
]
,
[
solar PV es
],[offshore wind es],[hard coal w CCS es],[natural gas combined cycle w CCS es],[biomass w CCS es\
		],[lignite w CCS es]=
	CCaMC BAU Construction Cost per Unit Capacity[Electricity Source]
	* (1 - RnD Electricity Capital Cost Perc Reduction This Year[Electricity Source]) ~~|
Construction Cost per Unit Capacity before Construction Subsidies[onshore wind es]=
	IF THEN ELSE(
	  CCaMC BAU Construction Cost per Unit Capacity[onshore wind es] > 0,
	
	  (CCaMC BAU Construction Cost per Unit Capacity[onshore wind es] - CCaMC BAU Soft Costs per Unit Capacity\
		[onshore wind es
	])
	  * (1 - RnD Electricity Capital Cost Perc Reduction This Year[onshore wind es])
	  + Soft Costs per Unit Capacity[onshore wind es],
	
	  IF THEN ELSE(
	    CCaMC BAU Construction Cost per Unit Capacity With One Year Delay[onshore wind es\
		] > 0,
	      (CCaMC BAU Construction Cost per Unit Capacity With One Year Delay[onshore wind es\
		] - BAU Last Year Soft Costs per Unit Capacity
	[onshore wind es])
	      * This Year Solar and Wind Hard Costs as Fraction of Last Year Hard Costs[onshore wind es\
		]
	      * (1 - RnD Electricity Capital Cost Perc Reduction This Year[onshore wind es])
	      + Soft Costs per Unit Capacity[onshore wind es],
	
	      (Last Year Construction Cost per Unit Capacity before Construction Subsidies[onshore wind es\
		] - BAU Last Year Soft Costs per Unit Capacity[onshore wind es])
	      * This Year Solar and Wind Hard Costs as Fraction of Last Year Hard Costs[onshore wind es\
		]
	      * (1 - RnD Electricity Capital Cost Perc Reduction This Year[onshore wind es])
	      + Soft Costs per Unit Capacity[onshore wind es]
	   )
	) ~~|
Construction Cost per Unit Capacity before Construction Subsidies[solar PV es]=
	IF THEN ELSE(
	  CCaMC BAU Construction Cost per Unit Capacity[solar PV es] > 0,
	
	  (CCaMC BAU Construction Cost per Unit Capacity[solar PV es] - CCaMC BAU Soft Costs per Unit Capacity\
		[solar PV es
	])
	  * (1 - RnD Electricity Capital Cost Perc Reduction This Year[solar PV es])
	  + Soft Costs per Unit Capacity[solar PV es],
	
	  IF THEN ELSE(
	    CCaMC BAU Construction Cost per Unit Capacity With One Year Delay[solar PV es] >\
		 0,
	      (CCaMC BAU Construction Cost per Unit Capacity With One Year Delay[solar PV es\
		] - BAU Last Year Soft Costs per Unit Capacity
	[solar PV es])
	      * This Year Solar and Wind Hard Costs as Fraction of Last Year Hard Costs[solar PV es\
		]
	      * (1 - RnD Electricity Capital Cost Perc Reduction This Year[solar PV es])
	      + Soft Costs per Unit Capacity[solar PV es],
	
	      (Last Year Construction Cost per Unit Capacity before Construction Subsidies[solar PV es\
		] - BAU Last Year Soft Costs per Unit Capacity[solar PV es])
	      * This Year Solar and Wind Hard Costs as Fraction of Last Year Hard Costs[solar PV es\
		]
	      * (1 - RnD Electricity Capital Cost Perc Reduction This Year[solar PV es])
	      + Soft Costs per Unit Capacity[solar PV es]
	   )
	) ~~|
Construction Cost per Unit Capacity before Construction Subsidies[offshore wind es]=
	IF THEN ELSE(
	  CCaMC BAU Construction Cost per Unit Capacity[offshore wind es] > 0,
	
	  (CCaMC BAU Construction Cost per Unit Capacity[offshore wind es] - CCaMC BAU Soft Costs per Unit Capacity\
		[offshore wind es
	])
	  * (1 - RnD Electricity Capital Cost Perc Reduction This Year[offshore wind es])
	  + Soft Costs per Unit Capacity[offshore wind es],
	
	  IF THEN ELSE(
	    CCaMC BAU Construction Cost per Unit Capacity With One Year Delay[offshore wind es\
		] > 0,
	      (CCaMC BAU Construction Cost per Unit Capacity With One Year Delay[offshore wind es\
		] - BAU Last Year Soft Costs per Unit Capacity[offshore wind es])
	      * This Year Solar and Wind Hard Costs as Fraction of Last Year Hard Costs[offshore wind es\
		]
	      * (1 - RnD Electricity Capital Cost Perc Reduction This Year[offshore wind es]\
		)
	      + Soft Costs per Unit Capacity[offshore wind es],
	
	      (Last Year Construction Cost per Unit Capacity before Construction Subsidies[offshore wind es\
		] - BAU Last Year Soft Costs per Unit Capacity[offshore wind es])
	      * This Year Solar and Wind Hard Costs as Fraction of Last Year Hard Costs[offshore wind es\
		]
	      * (1 - RnD Electricity Capital Cost Perc Reduction This Year[offshore wind es]\
		)
	      + Soft Costs per Unit Capacity[offshore wind es]
	   )
	) ~~|
Construction Cost per Unit Capacity before Construction Subsidies[hard coal w CCS es]\
		=
	IF THEN ELSE(
	  CCaMC BAU Construction Cost per Unit Capacity[hard coal w CCS es] > 0,
	
	  (CCaMC BAU Construction Cost per Unit Capacity[hard coal w CCS es] - CCaMC BAU Soft Costs per Unit Capacity\
		[hard coal w CCS es])
	  * (1 - RnD Electricity Capital Cost Perc Reduction This Year[hard coal w CCS es])
	  + Soft Costs per Unit Capacity[hard coal w CCS es],
	
	  IF THEN ELSE(
	    CCaMC BAU Construction Cost per Unit Capacity With One Year Delay[hard coal w CCS es\
		] > 0,
	      (CCaMC BAU Construction Cost per Unit Capacity With One Year Delay[hard coal w CCS es\
		] - BAU Last Year Soft Costs per Unit Capacity[hard coal w CCS es])
	      * This Year CCS Cost as Fraction of Last Year CCS Cost
	      * (1 - RnD Electricity Capital Cost Perc Reduction This Year[hard coal w CCS es\
		])
	      + Soft Costs per Unit Capacity[hard coal w CCS es],
	
	      (Last Year Construction Cost per Unit Capacity before Construction Subsidies[hard coal w CCS es\
		] - BAU Last Year Soft Costs per Unit Capacity[hard coal w CCS es])
	      * This Year CCS Cost as Fraction of Last Year CCS Cost
	      * (1 - RnD Electricity Capital Cost Perc Reduction This Year[hard coal w CCS es\
		])
	      + Soft Costs per Unit Capacity[hard coal w CCS es]
	   )
	) ~~|
Construction Cost per Unit Capacity before Construction Subsidies[natural gas combined cycle w CCS es\
		]=
	IF THEN ELSE(
	  CCaMC BAU Construction Cost per Unit Capacity[natural gas combined cycle w CCS es]\
		 > 0,
	
	  (CCaMC BAU Construction Cost per Unit Capacity[natural gas combined cycle w CCS es\
		] - CCaMC BAU Soft Costs per Unit Capacity[natural gas combined cycle w CCS es])
	  * (1 - RnD Electricity Capital Cost Perc Reduction This Year[natural gas combined cycle w CCS es\
		])
	  + Soft Costs per Unit Capacity[natural gas combined cycle w CCS es],
	
	  IF THEN ELSE(
	    CCaMC BAU Construction Cost per Unit Capacity With One Year Delay[natural gas combined cycle w CCS es\
		] > 0,
	      (CCaMC BAU Construction Cost per Unit Capacity With One Year Delay[natural gas combined cycle w CCS es\
		] - BAU Last Year Soft Costs per Unit Capacity
	[natural gas combined cycle w CCS es])
	      * This Year CCS Cost as Fraction of Last Year CCS Cost
	      * (1 - RnD Electricity Capital Cost Perc Reduction This Year[natural gas combined cycle w CCS es\
		])
	      + Soft Costs per Unit Capacity[natural gas combined cycle w CCS es],
	
	      (Last Year Construction Cost per Unit Capacity before Construction Subsidies[natural gas combined cycle w CCS es\
		] - BAU Last Year Soft Costs per Unit Capacity[natural gas combined cycle w CCS es]\
		)
	      * This Year CCS Cost as Fraction of Last Year CCS Cost
	      * (1 - RnD Electricity Capital Cost Perc Reduction This Year[natural gas combined cycle w CCS es\
		])
	      + Soft Costs per Unit Capacity[natural gas combined cycle w CCS es]
	   )
	) ~~|
Construction Cost per Unit Capacity before Construction Subsidies[biomass w CCS es]=
	IF THEN ELSE(
	  CCaMC BAU Construction Cost per Unit Capacity[biomass w CCS es] > 0,
	
	  (CCaMC BAU Construction Cost per Unit Capacity[biomass w CCS es] - CCaMC BAU Soft Costs per Unit Capacity\
		[biomass w CCS es])
	  * (1 - RnD Electricity Capital Cost Perc Reduction This Year[biomass w CCS es])
	  + Soft Costs per Unit Capacity[biomass w CCS es],
	
	  IF THEN ELSE(
	    CCaMC BAU Construction Cost per Unit Capacity With One Year Delay[biomass w CCS es\
		] > 0,
	      (CCaMC BAU Construction Cost per Unit Capacity With One Year Delay[biomass w CCS es\
		] - BAU Last Year Soft Costs per Unit Capacity
	[biomass w CCS es])
	      * This Year CCS Cost as Fraction of Last Year CCS Cost
	      * (1 - RnD Electricity Capital Cost Perc Reduction This Year[biomass w CCS es]\
		)
	      + Soft Costs per Unit Capacity[biomass w CCS es],
	
	      (Last Year Construction Cost per Unit Capacity before Construction Subsidies[biomass w CCS es\
		] - BAU Last Year Soft Costs per Unit Capacity[biomass w CCS es])
	      * This Year CCS Cost as Fraction of Last Year CCS Cost
	      * (1 - RnD Electricity Capital Cost Perc Reduction This Year[biomass w CCS es]\
		)
	      + Soft Costs per Unit Capacity[biomass w CCS es]
	   )
	) ~~|
Construction Cost per Unit Capacity before Construction Subsidies[lignite w CCS es]=
	IF THEN ELSE(
	  CCaMC BAU Construction Cost per Unit Capacity[lignite w CCS es] > 0,
	
	  (CCaMC BAU Construction Cost per Unit Capacity[lignite w CCS es] - CCaMC BAU Soft Costs per Unit Capacity\
		[lignite w CCS es])
	  * (1 - RnD Electricity Capital Cost Perc Reduction This Year[lignite w CCS es])
	  + Soft Costs per Unit Capacity[lignite w CCS es],
	
	  IF THEN ELSE(
	    CCaMC BAU Construction Cost per Unit Capacity With One Year Delay[lignite w CCS es\
		] > 0,
	      (CCaMC BAU Construction Cost per Unit Capacity With One Year Delay[lignite w CCS es\
		] - BAU Last Year Soft Costs per Unit Capacity
	[lignite w CCS es])
	      * This Year CCS Cost as Fraction of Last Year CCS Cost
	      * (1 - RnD Electricity Capital Cost Perc Reduction This Year[lignite w CCS es]\
		)
	      + Soft Costs per Unit Capacity[lignite w CCS es],
	
	      (Last Year Construction Cost per Unit Capacity before Construction Subsidies[lignite w CCS es\
		] - BAU Last Year Soft Costs per Unit Capacity[lignite w CCS es])
	      * This Year CCS Cost as Fraction of Last Year CCS Cost
	      * (1 - RnD Electricity Capital Cost Perc Reduction This Year[lignite w CCS es]\
		)
	      + Soft Costs per Unit Capacity[lignite w CCS es]
	   )
	)
	~	$/MW
	~	To use endogenous learning for onshore wind, offshore wind, solar PV, \
		and/or plant types equipped with CCS, leave zeroes in CCaMC for \
		construction cost in all years after the first modeled year.  If the model \
		sees a non-zero construction cost value in CCaMC for any given year, it \
		will use that value in that year, overriding the endogenous learning \
		calculations.
	|

Consumer Preference Shadow Cost[Vehicle Type, Cargo Type, Vehicle Technology] :EXCEPT:\
		  [LDVs,passenger,battery electric vehicle]=
	0 ~~|
Consumer Preference Shadow Cost[LDVs,passenger,battery electric vehicle]=
	BCPSC BAU Consumer Preference Shadow Cost*
	(1-Last Year Percent Vehicle Stock by Vehicle Technology[LDVs,passenger,battery electric vehicle\
		])
	~	$/vehicle
	~		|

Correction for Difference in Input vs Calculated BAU Components Energy Use[Building Type\
		,Building Fuel,Building Component]=
	BAU Correction for Difference in Input vs Calculated BAU Components Energy Use[Building Type\
		,Building Fuel,Building Component]
	* Policy Driven Percent Change in Components Energy Use[Building Type,Building Fuel,\
		Building Component]
	~	BTU
	~		|

Cost Driven Retirement Gap[Electricity Source,Optimization Pass]=
	MAX(0, Last Year Electricity Generation Capacity[Electricity Source]
	  - Breakeven Capacity for Cost Driven Retirement[Electricity Source,Optimization Pass\
		])
	~	MW
	~		|

Cost Driven Retirement Gap Excluding Capacity Payment[Electricity Source]=
	MAX(0, Last Year Electricity Generation Capacity[Electricity Source]
	  - Breakeven Capacity for Cost Driven Retirement Excluding Capacity Payment[Electricity Source\
		])
	~	MW
	~		|

Cost Driven Share of New Clinker Production Capacity by Pathway[Cement Production Pathway\
		]=
	ZIDZ(
	  Cement Pathway Choice Weight[Cement Production Pathway],
	  SUM(Cement Pathway Choice Weight[Cement Production Pathway!])
	)
	~	Dmnl
	~	Pathway shares of this year's new clinker capacity from the relative-cost \
		logit alone, before any mandate: each pathway's choice weight over the sum \
		of the weights.
	|

Cost of Capacity Construction before Construction Subsidies[Electricity Source]=
	New Generation Capacity Excluding Retrofit Capacity[Electricity Source]
	* Construction Cost per Unit Capacity before Construction Subsidies[Electricity Source\
		]
	
	+ New Hybrid Grid Battery Storage Capacity[Electricity Source]
	* Total Battery Cost per Unit Capacity
	~	$
	~		|

Cost of Capacity Retrofitting before Construction Subsidies[Electricity Source]=
	Retrofit Capacity after Quantization[Electricity Source]
	* CCaMC Power Plant CCS Retrofitting Costs[Electricity Source]
	~	$
	~		|

Cost of Capital by Industry Fuel and Process[Industry Category,Industrial Fuel,Industrial Process\
		]=
	BCoISC Weighted Average Cost of Capital by Industry[Industry Category]
	* 
	(
	  1 - (Perc Decrease in Cost of Capital for Clean Industrial Equipment This Year[Industrial Process\
		,Industry Category]
	    * IFTQfS Industrial Fuel Types Qualifying for Loans[Industrial Fuel]
	  )
	)
	~	Dmnl
	~		|

Cost of CHP Conversion for Heat=
	Heat Shifted to CHP Facilities This Year
	* CECpUES CHP Equipment Cost per Unit Energy Shifted
	~	$
	~		|

Cost of Electricity Sector Capital for Power Plants[Electricity Source]=
	BCoESC BAU Cost of Electricity Sector Capital for Power Plants[Electricity Source]
	* (1 - Percentage Decrease in Cost of Capital for Power Plants This Year[Electricity Source\
		])
	~	Dmnl
	~		|

Cost of Green Hydrogen Electricity Capacity Construction[Electricity Source]=
	New Off Grid Capacity for Green Hydrogen Demand[Electricity Source]
	* Construction Cost per Unit Capacity before Construction Subsidies[Electricity Source\
		]
	~	$
	~		|

Cost of Implementing Land Use Policies[Land Use Policy]=
	Land Area Newly Affected by Policy[Land Use Policy] * One Year
	* ICoLUPpUA Implementation Cost of Land Use Policies per Unit Area[Land Use Policy]
	~	$
	~		|

Cost of Maintaining Area Previously Affected by Land Use Policies[Land Use Policy]=
	Cumulative Total Land Area Affected by Policy[Land Use Policy]
	* AOCoLUPpUA Annual Ongoing Cost of Land Use Policies per Unit Area[Land Use Policy]
	~	$
	~		|

