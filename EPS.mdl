	~	MW
	~		|

Profitable Capacity for Cost Effectiveness Additions for Hybrid Power Plants[Hybrid Electricity Source
, Optimization Pass,RPS]=
	IF THEN ELSE(
	  Incremental Revenue for Cost Effectiveness Additions for Hybrid Power Plants[Hybrid Electricity Source\
		,Optimization Pass,RPS
	] < 1,
	  0,
	  (1-exp(-((  Incremental Revenue for Cost Effectiveness Additions for Hybrid Power Plants\
		[Hybrid Electricity Source,Optimization Pass,RPS
	]/Capacity Supply Curve Parameters by Power Plant Type[cutoff parameter,Hybrid Electricity Source\
		] / One Dollar per MW-(Capacity Supply Curve Parameters by Power Plant Type[location parameter\
		,Hybrid Electricity Source]-0.5))/Capacity Supply Curve Parameters by Power Plant Type\
		[scale parameter,Hybrid Electricity Source])^Capacity Supply Curve Parameters by Power Plant Type\
		[shape parameter,Hybrid Electricity Source]))*Capacity Supply Curve Parameters by Power Plant Type\
		[saturation,Hybrid Electricity Source] * One MW
	) ~~|
Profitable Capacity for Cost Effectiveness Additions for Hybrid Power Plants[Hybrid Electricity Source\
		,Optimization Pass,CES]=
	IF THEN ELSE(
	  Incremental Revenue for Cost Effectiveness Additions for Hybrid Power Plants[Hybrid Electricity Source\
		,Optimization Pass,CES
	] < 1,
	  0,
	  (1-exp(-((  Incremental Revenue for Cost Effectiveness Additions for Hybrid Power Plants\
		[Hybrid Electricity Source,Optimization Pass,CES
	]/Capacity Supply Curve Parameters by Power Plant Type[cutoff parameter,Hybrid Electricity Source\
		] / One Dollar per MW-(Capacity Supply Curve Parameters by Power Plant Type[location parameter\
		,Hybrid Electricity Source]-0.5))/Capacity Supply Curve Parameters by Power Plant Type\
		[scale parameter,Hybrid Electricity Source])^Capacity Supply Curve Parameters by Power Plant Type\
		[shape parameter,Hybrid Electricity Source]))*Capacity Supply Curve Parameters by Power Plant Type\
		[saturation,Hybrid Electricity Source] * One MW
	)
	~	MW
	~		|

Profitable Capacity for Cost Effectiveness Additions for Hybrid Power Plants without CES\
		[Hybrid Electricity Source]=
	IF THEN ELSE(
	  Incremental Revenue for Cost Effectiveness Additions for Hybrid Power Plants without CES\
		[Hybrid Electricity Source
	] < 1,
	  0,
	  (1-exp(-((  Incremental Revenue for Cost Effectiveness Additions for Hybrid Power Plants without CES\
		[Hybrid Electricity Source
	]/Capacity Supply Curve Parameters by Power Plant Type[cutoff parameter,Hybrid Electricity Source\
		] / One Dollar per MW-(Capacity Supply Curve Parameters by Power Plant Type[location parameter\
		,Hybrid Electricity Source]-0.5))/Capacity Supply Curve Parameters by Power Plant Type\
		[scale parameter,Hybrid Electricity Source])^Capacity Supply Curve Parameters by Power Plant Type\
		[shape parameter,Hybrid Electricity Source]))*Capacity Supply Curve Parameters by Power Plant Type\
		[saturation,Hybrid Electricity Source] * One MW
	)
	~	MW
	~		|

Profitable Capacity for Cost Effectiveness Additions without CES[Electricity Source]=
	IF THEN ELSE(
	  Incremental Revenue for Cost Effectiveness Additions without CES[Electricity Source\
		] < 1,
	  0,
	  (1-exp(-((  Incremental Revenue for Cost Effectiveness Additions without CES[Electricity Source\
		]/Capacity Supply Curve Parameters by Power Plant Type[cutoff parameter,Electricity Source\
		] / One Dollar per MW-(Capacity Supply Curve Parameters by Power Plant Type[location parameter\
		,Electricity Source]-0.5))/Capacity Supply Curve Parameters by Power Plant Type[scale parameter\
		,Electricity Source])^Capacity Supply Curve Parameters by Power Plant Type[shape parameter\
		,Electricity Source]))*Capacity Supply Curve Parameters by Power Plant Type[saturation\
		,Electricity Source] * One MW
	)
	~	MW
	~		|

Profitable Capacity for Seasonal Dispatchable Reliability Additions[Electricity Source\
		,Optimization Pass]=
	IF THEN ELSE(
	 IF THEN ELSE(
	  MAX(0,
	  Total Energy Market and Capacity Market Revenue for Seasonal Dispatchable Reliability\
		[Electricity Source
	,Optimization Pass]
	  -(
	     Annualized Fixed Costs per Unit New Capacity[Electricity Source]
	     * SoCtMbCtbDP Share of Costs that Must be Covered to Be Deemed Profitable[Electricity Source\
		]
	  )
	) <= 0,
	  0,
	  (1-exp(-(((  Total Energy Market and Capacity Market Revenue for Seasonal Dispatchable Reliability\
		[Electricity Source
	,Optimization Pass]
	  -(
	    Annualized Fixed Costs per Unit New Capacity[Electricity Source]
	     * SoCtMbCtbDP Share of Costs that Must be Covered to Be Deemed Profitable[Electricity Source\
		]
	  ))/Capacity Supply Curve Parameters by Power Plant Type[cutoff parameter,Electricity Source\
		] / One Dollar per MW-(Capacity Supply Curve Parameters by Power Plant Type[location parameter\
		,Electricity Source]-0.5))/Capacity Supply Curve Parameters by Power Plant Type[scale parameter\
		,Electricity Source])^Capacity Supply Curve Parameters by Power Plant Type[shape parameter\
		,Electricity Source]))*Capacity Supply Curve Parameters by Power Plant Type[saturation\
		,Electricity Source] * One MW
	)
	= :NA:,
	  0,
	 IF THEN ELSE(
	  MAX(0,
	  Total Energy Market and Capacity Market Revenue for Seasonal Dispatchable Reliability\
		[Electricity Source
	,Optimization Pass]
	  -(
	     Annualized Fixed Costs per Unit New Capacity[Electricity Source]
	     * SoCtMbCtbDP Share of Costs that Must be Covered to Be Deemed Profitable[Electricity Source\
		]
	  )
	) <= 0,
	  0,
	  (1-exp(-(((  Total Energy Market and Capacity Market Revenue for Seasonal Dispatchable Reliability\
		[Electricity Source
	,Optimization Pass]
	  -(
	    Annualized Fixed Costs per Unit New Capacity[Electricity Source]
	     * SoCtMbCtbDP Share of Costs that Must be Covered to Be Deemed Profitable[Electricity Source\
		]
	  ))/Capacity Supply Curve Parameters by Power Plant Type[cutoff parameter,Electricity Source\
		] / One Dollar per MW-(Capacity Supply Curve Parameters by Power Plant Type[location parameter\
		,Electricity Source]-0.5))/Capacity Supply Curve Parameters by Power Plant Type[scale parameter\
		,Electricity Source])^Capacity Supply Curve Parameters by Power Plant Type[shape parameter\
		,Electricity Source]))*Capacity Supply Curve Parameters by Power Plant Type[saturation\
		,Electricity Source] * One MW
	)
	  
	)
	~	MW
	~	If we do not test for :NA: (no number), then an out-of-bounds lookup in \
		the prior variable can produce a large random number here, which can throw \
		off the model. It may be better to output zero for an out-of-bounds lookup.
	|

Proportion of Primary Energy from Non Fossil Sources=
	Non Fossil Primary Energy
	/
	(
	  Total Primary Energy Use[hard coal]
	  + Total Primary Energy Use[natural gas]
	  + Total Primary Energy Use[nuclear]
	  + Total Primary Energy Use[hydro]
	  + Total Primary Energy Use[wind]
	  + Total Primary Energy Use[solar]
	  + Total Primary Energy Use[biomass]
	  + Total Primary Energy Use[petroleum gasoline]
	  + Total Primary Energy Use[petroleum diesel]
	  + Total Primary Energy Use[biofuel gasoline]
	  + Total Primary Energy Use[biofuel diesel]
	  + Total Primary Energy Use[jet fuel or kerosene]
	  + Total Primary Energy Use[geothermal]
	)
	~	Dmnl
	~	We can't sum across the All Fuels subscript because that would include \
		electricity and heat, energy carriers for which no value exists in the \
		"Total Primary Energy Use" variable.
	~	:SUPPLEMENTARY 
	|

