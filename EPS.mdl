	/ Grams per Metric Ton CO2e
	~	metric tons CO2e
	~		|

Procurement Clinker Substitution Fraction=
	IF THEN ELSE(Clinker Ratio Needed for Procured Cement to Qualify >= Minimum Clinker Ratio of Blended Low Carbon Cement\
		,
	  MIN(1, ZIDZ(Fraction of Cement Demand Purchased under Low Carbon Procurement This Year\
		 * MAX(0, BCtCR BAU Clinker to Cement Ratio - Clinker Ratio Needed for Procured Cement to Qualify\
		),
	              MAX(0, BCtCR BAU Clinker to Cement Ratio - MACtCR Minimum Achievable Clinker to Cement Ratio\
		))),
	  0)
	~	Dmnl
	~	Share of the achievable clinker substitution needed to supply the procured \
		cement as blended cement (LC3 and similar): the procured share times how \
		far below the BAU ratio its clinker share must go, over the achievable \
		gap. Zero when the threshold is stricter than blending can reach. Blended \
		cement is cheaper than new kilns, so procurement draws on it first.
	|

Production Exceeding Both Caps[All Fuels]=
	Production Exceeding Cap[All Fuels]
	- Production Shifted to Imports due to Production Cap[All Fuels]
	~	BTU
	~		|

Production Exceeding Cap[All Fuels]=
	MAX(
	  0,
	
	  Change in Fuel Production before Cap[All Fuels]
	  - Maximum Absolute Increase in Fuel Production[All Fuels]
	)
	~	BTU
	~		|

Production Shifted to Imports due to Production Cap[All Fuels]=
	MIN(
	  Production Exceeding Cap[All Fuels],
	
	  Spare Capacity under Imports Cap[All Fuels]
	)
	~	BTU
	~		|

Profitable Capacity for Cost Effective CCUS Retrofits[CCUS Electricity Source, Optimization Pass\
		,RPS]=
	IF THEN ELSE(
	  Incremental Revenue for Cost Effective CCUS Retrofits[CCUS Electricity Source,Optimization Pass\
		,RPS] < 1,
	  0,
	  (1-exp(-((  Incremental Revenue for Cost Effective CCUS Retrofits[CCUS Electricity Source\
		,Optimization Pass,RPS]/Capacity Supply Curve Parameters by Power Plant Type[cutoff parameter\
		,CCUS Electricity Source] / One Dollar per MW-(Capacity Supply Curve Parameters by Power Plant Type\
		[location parameter,CCUS Electricity Source]-0.5))/Capacity Supply Curve Parameters by Power Plant Type\
		[scale parameter,CCUS Electricity Source])^Capacity Supply Curve Parameters by Power Plant Type\
		[shape parameter,CCUS Electricity Source]))*Capacity Supply Curve Parameters by Power Plant Type\
		[saturation,CCUS Electricity Source] * One MW
	) ~~|
Profitable Capacity for Cost Effective CCUS Retrofits[CCUS Electricity Source,Optimization Pass\
		,CES]=
	IF THEN ELSE(
	  Incremental Revenue for Cost Effective CCUS Retrofits[CCUS Electricity Source,Optimization Pass\
		,CES] < 1,
	  0,
	  (1-exp(-((  Incremental Revenue for Cost Effective CCUS Retrofits[CCUS Electricity Source\
		,Optimization Pass,CES]/Capacity Supply Curve Parameters by Power Plant Type[cutoff parameter\
		,CCUS Electricity Source] / One Dollar per MW-(Capacity Supply Curve Parameters by Power Plant Type\
		[location parameter,CCUS Electricity Source]-0.5))/Capacity Supply Curve Parameters by Power Plant Type\
		[scale parameter,CCUS Electricity Source])^Capacity Supply Curve Parameters by Power Plant Type\
		[shape parameter,CCUS Electricity Source]))*Capacity Supply Curve Parameters by Power Plant Type\
		[saturation,CCUS Electricity Source] * One MW
	)
	~	MW
	~		|

Profitable Capacity for Cost Effective CCUS Retrofits without CES[CCUS Electricity Source\
		]=
	IF THEN ELSE(
	  Incremental Revenue for Cost Effective CCUS Retrofits without CES[CCUS Electricity Source\
		] < 1,
	  0,
	  (1-exp(-((  Incremental Revenue for Cost Effective CCUS Retrofits without CES[CCUS Electricity Source\
		]/Capacity Supply Curve Parameters by Power Plant Type[cutoff parameter,CCUS Electricity Source\
		] / One Dollar per MW-(Capacity Supply Curve Parameters by Power Plant Type[location parameter\
		,CCUS Electricity Source]-0.5))/Capacity Supply Curve Parameters by Power Plant Type\
		[scale parameter,CCUS Electricity Source])^Capacity Supply Curve Parameters by Power Plant Type\
		[shape parameter,CCUS Electricity Source]))*Capacity Supply Curve Parameters by Power Plant Type\
		[saturation,CCUS Electricity Source] * One MW
	)
	~	MW
