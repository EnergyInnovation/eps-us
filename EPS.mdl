Breakeven Capacity for Cost Driven Retirement[Electricity Source,Optimization Pass]=
	IF THEN ELSE(Viability Ratio for Cost Driven Retirement[Electricity Source,Optimization Pass\
		] >= 1,
	  IF THEN ELSE(Required Revenue for Breakeven Target[Electricity Source]
	      - Predicted Capacity Payment by Plant Type for Existing Plants[Electricity Source\
		,Optimization Pass] > 0,
	    Last Year Electricity Generation Capacity[Electricity Source]
	      * Three Year Average CF Scaling Revenue for Cost Driven Retirement[Electricity Source\
		]
	      / (Required Revenue for Breakeven Target[Electricity Source]
	         - Predicted Capacity Payment by Plant Type for Existing Plants[Electricity Source\
		,Optimization Pass]),
	    Last Year Electricity Generation Capacity[Electricity Source]),
	  Last Year Electricity Generation Capacity[Electricity Source]
	    * ZIDZ(1, Viability Headroom Ratio for Cost Driven Retirement[Electricity Source\
		])
	    * MAX(0, ZIDZ(Viability Ratio for Cost Driven Retirement[Electricity Source,Optimization Pass\
		]
	              - DUVT Deep Unviability Threshold,
	              1 - DUVT Deep Unviability Threshold)))
	~	MW
	~		|

Breakeven Capacity for Cost Driven Retirement Excluding Capacity Payment[Electricity Source\
		]=
	IF THEN ELSE(Viability Ratio for Cost Driven Retirement Excluding Capacity Payment[Electricity Source\
		] >= 1,
	  Last Year Electricity Generation Capacity[Electricity Source]
	    * ZIDZ(Three Year Average CF Scaling Revenue for Cost Driven Retirement[Electricity Source\
		],
	        Required Revenue for Breakeven Target[Electricity Source]),
	  Last Year Electricity Generation Capacity[Electricity Source]
	    * ZIDZ(1, Viability Headroom Ratio for Cost Driven Retirement[Electricity Source\
		])
	    * MAX(0, ZIDZ(Viability Ratio for Cost Driven Retirement Excluding Capacity Payment\
		[Electricity Source]
	              - DUVT Deep Unviability Threshold, 1 - DUVT Deep Unviability Threshold\
		)))
	~	MW
	~		|

