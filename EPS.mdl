ASCAPEX Annual Sustaining CAPEX Age Slope[Electricity Source]=
	GET DIRECT CONSTANTS(
	   'InputData/elec/ASCAPEX/ASCAPEX-slope.csv',
	   ',',
	   'B2*'
	)
	~	$/MW
	~		|

ASCAPEX Annual Sustaining CAPEX Base per Unit Capacity[Electricity Source]=
	GET DIRECT CONSTANTS(
	   'InputData/elec/ASCAPEX/ASCAPEX-base.csv',
	   ',',
	   'B2*'
	)
	~	$/MW
	~		|

ASCAPEX Annual Sustaining CAPEX Incremental Adder Over 40 Years[Electricity Source]=
	GET DIRECT CONSTANTS(
	   'InputData/elec/ASCAPEX/ASCAPEX-adder40.csv',
	   ',',
	   'B2*'
	)
	~	$/MW
	~		|

ATfER Adjustment Time for Economic Retirements[Electricity Source]=
	GET DIRECT CONSTANTS(
	   'InputData/elec/ATfER/ATfER.csv',
	   ',',
	   'B2*'
	)
	~	Year
	~		|

Available Capacity After Elec Portfolio Std Dispatch[Electricity Timeslice,Hour,Electricity Source\
		]=
	MAX(
	  0,
	
	  Available Capacity After Guaranteed Dispatch[Electricity Timeslice,Hour,Electricity Source\
		]
	  - Electricity Dispatched to Meet Elec Portfolio Stds[Electricity Timeslice,Hour,Electricity Source\
		]/ One Hour
	)
	~	MW
	~		|

Available Capacity After Guaranteed Dispatch[Electricity Timeslice,Hour,Electricity Source\
		]=
	MAX(
	  0,
	
	  Available Capacity by Hour[Electricity Source,Electricity Timeslice,Hour]
	  - Electricity Dispatched by Guaranteed Dispatch by Hour[Electricity Source,Electricity Timeslice\
		,Hour]/One Hour
	)
	~	MW
	~		|

Available Capacity by Hour[Electricity Source,Electricity Timeslice,Hour]=
	Electricity Generation Capacity[Electricity Source]
	* Hourly Bid Electricity Capacity Factors by Plant Type[Electricity Timeslice,Hour,Electricity Source\
		]
	* (1 - Share of Electricity Generation Capacity Built This Year[Electricity Source] \
		* TACFMfPBTY Time Adjusted Capacity Factor Multiplier for Plants Built This Year[Electricity Source\
		])
	~	MW
	~		|

Available Capacity for Least Cost Dispatch Mapped[Electricity Timeslice,Hour,Electricity Source\
		]=
	Available Capacity After Elec Portfolio Std Dispatch[Electricity Timeslice,Hour,Electricity Source\
		]
	* One Hour
	~	MW*hour
	~		|

AVCC Average Vehicle Charger Capacity[Vehicle Type,Cargo Type]=
	GET DIRECT CONSTANTS(
	   'InputData/trans/AVCC/AVCC.csv',
	   ',',
	   'B2'
	)
	~	kW
	~		|

Average Annual Dist Traveled by Vehicle Type[Vehicle Type,Cargo Type,Vehicle Technology\
		]=
	BAADTbVT BAU Average Annual Dist Traveled by Vehicle Type[Vehicle Type,Cargo Type]
	* (1 + Perc Change in Avg Annual Dist Traveled by Vehicle Type[Vehicle Type,Cargo Type\
		,Vehicle Technology])
	~	miles/vehicle
	~		|

Average Annual Dist Traveled by Vehicle Type Weighted by Technology[Vehicle Type,Cargo Type\
		]=
	ZIDZ( SUM( BAU Average Annual Dist Traveled per Vehicle[Vehicle Type,Cargo Type] * (\
		1 + Perc Change in Avg Annual Dist Traveled by Vehicle Type[Vehicle Type,Cargo Type\
		,Vehicle Technology!]) * Mileage Weighted Last Year Vehicles[Vehicle Type,Cargo Type\
		,Vehicle Technology!] ), SUM(Mileage Weighted Last Year Vehicles[Vehicle Type,Cargo Type\
		,Vehicle Technology!]) )
	* Vehicle Utilization Multiplier from Travel Change[Vehicle Type,Cargo Type]
	~	miles/vehicle
	~		|

average day electricity timeslice:
	average winter day,
	average spring day,
	average summer day,
	average fall day
	~	
	~		|

Average Five Year Prior Pretax Electricity Price by Sector[Sectors]=
	Five Year Average Pretax Electricity Price by Sector[Sectors]
	* 5
	/ MIN(5, (Time - INITIAL TIME) / One Year + 1)
	~	$/BTU
	~	Trailing five year average of the endogenous retail electricity price, \
		used as the expected future electricity price in forward-looking \
		technology choice decisions (adaptive expectations).  DEPRECIATE \
		STRAIGHTLINE spreads each year's price over five years, so multiplying by \
		five recovers the sum of the five most recent years' prices (including the \
		current year, whose price is known at decision time because it is set from \
		last year's electricity supplier costs).  Until five years have elapsed, \
		dividing by the number of years simulated so far averages over the years \
		available, so this equals the start year electricity price in the first \
		modeled year.
	|

Average Four Year Prior Net Energy Market Revenue by Plant Type Excluding Subsidies for Hybrid Power Plants\
		[Hybrid Electricity Source]=
	IF THEN ELSE(
	 Time - INITIAL TIME <= 1,
	 One Year Average Net Energy Market Revenue by Plant Type Excluding Subsidies for Hybrid Power Plants\
		[Hybrid Electricity Source
	],
	 
	 IF THEN ELSE(
	  Time - INITIAL TIME = 2,
	  Two Year Average Net Energy Market Revenue by Plant Type Excluding Subsidies for Hybrid Power Plants\
		[Hybrid Electricity Source
	],
	
	  IF THEN ELSE(
	   Time - INITIAL TIME = 3,
	   Three Year Average Net Energy Market Revenue by Plant Type Excluding Subsidies for Hybrid Power Plants\
		[Hybrid Electricity Source
	],
	   Four Year Average Net Energy Market Revenue by Plant Type Excluding Subsidies for Hybrid Power Plants\
		[Hybrid Electricity Source
	]
	  )
	 )
	)
	
	+Expected Capacity Factor x Hours per Year for Plants Built This Year[Hybrid Electricity Source\
		]*Variable Subsidies per Unit New Elec Output
	[Hybrid Electricity Source]
	~	$/MW
	~		|

Average Four Year Prior Total Predicted Net Energy Market Revenue per MW[Electricity Source\
		] :EXCEPT: [CCUS Electricity Source]=
	IF THEN ELSE(
	 Time - INITIAL TIME <= 1,
	 Last Year Five Year Average Annual Net Revenue per MW by Power Plant Type[Electricity Source\
		],
	
	 IF THEN ELSE(
	  Time - INITIAL TIME = 2,
	  Two Year Average Total Predicted Net Energy Market Revenue per MW[Electricity Source\
		],
	
	  IF THEN ELSE(
	   Time - INITIAL TIME = 3,
	   Three Year Average Total Predicted Net Energy Market Revenue per MW[Electricity Source\
		],
	
	   Four Year Average Total Predicted Net Energy Market Revenue per MW[Electricity Source\
		]
	
	  )
	 )
	)
	* New Plant Capacity Factor Scaling for Merchant Entry[Electricity Source]

	+ Variable Subsidies per Unit New Elec Output[Electricity Source]
	  *Expected Capacity Factor x Hours per Year for Plants Built This Year
	[Electricity Source] ~~|
Average Four Year Prior Total Predicted Net Energy Market Revenue per MW[CCUS Electricity Source\
		]=
	IF THEN ELSE(
	 Time - INITIAL TIME <= 1,
	 Last Year Five Year Average Annual Net Revenue per MW by Power Plant Type[CCUS Electricity Source\
		],
	
	 IF THEN ELSE(
	  Time - INITIAL TIME = 2,
	  Two Year Average Total Predicted Net Energy Market Revenue per MW[CCUS Electricity Source\
		],
	
	  IF THEN ELSE(
	   Time - INITIAL TIME = 3,
	   Three Year Average Total Predicted Net Energy Market Revenue per MW[CCUS Electricity Source\
		],
	
	   Four Year Average Total Predicted Net Energy Market Revenue per MW[CCUS Electricity Source\
		]
	
	  )
	 )
	)
	* New Plant Capacity Factor Scaling for Merchant Entry[CCUS Electricity Source]

	+ Variable Subsidies per Unit New Elec Output[CCUS Electricity Source]
	  *Expected Capacity Factor x Hours per Year for Plants Built This Year
	[CCUS Electricity Source]
	~	$/(MW*hr)
	~		|

Average Four Year Prior Total Predicted Net Energy Market Revenue per MW for New Entrants\
		[Electricity Source]=
	Average Four Year Prior Total Predicted Net Energy Market Revenue per MW[Electricity Source\
		]
	+ Entrant Dispatch Cost Advantage Revenue per MW[Electricity Source]
	~	$/MW
	~		|

Average New Clinker Capacity Cost per Ton of Clinker=
	SUM(
	  Share of New Clinker Production Capacity by Pathway[Cement Production Pathway!]
	  * Cement Pathway Levelized Cost per Ton of Clinker[Cement Production Pathway!]
	)
	~	$/metric ton
	~	Share-weighted cost of this year's new-build pathway mix: the replacement \
		alternative in the overhaul-vs-replace decision.
	|

Average Three Year Prior Net Loss per Unit Output[Electricity Source,Optimization Pass\
		]=
	IF THEN ELSE(
	  Net Loss per Unit Capacity[Electricity Source,Optimization Pass]>0
	  :AND:
	  Last Year Net Loss per Unit Capacity[Electricity Source,Optimization Pass]>0
	  :AND:
	  Two Years Prior Net Loss per Unit Capacity[Electricity Source,Optimization Pass]>0\
		,
	
	  (Net Loss per Unit Capacity[Electricity Source,Optimization Pass]+Last Year Net Loss per Unit Capacity\
		[Electricity Source,Optimization Pass]+Two Years Prior Net Loss per Unit Capacity[Electricity Source\
		,Optimization Pass])/3,
	
	  0
	
	)
	~	$/MW
	~		|

Average Three Year Prior Net Loss per Unit Output Excluding Capacity Payment[Electricity Source\
		]=
	IF THEN ELSE(
	  Net Loss per Unit Capacity Excluding Predicted Capacity Payment[Electricity Source\
		]>0
	  :AND:
	  Last Year Net Loss per Unit Capacity Excluding Predicted Capacity Payment[Electricity Source\
		]>0
	  :AND:
	  Two Years Prior Net Loss per Unit Capacity Excluding Capacity Payment[Electricity Source\
		]>0,
	
	  (Net Loss per Unit Capacity Excluding Predicted Capacity Payment[Electricity Source\
		]+Last Year Net Loss per Unit Capacity Excluding Predicted Capacity Payment[Electricity Source\
		]+Two Years Prior Net Loss per Unit Capacity Excluding Capacity Payment[Electricity Source\
		])/3,
	
	  0
	
	)
	~	$/MW
	~		|

Average Vehicle Loading after Policies[Vehicle Type,Cargo Type]=
	BAU Average Vehicle Loading[Vehicle Type,Cargo Type]
	* Vehicle Loading Multiplier[Vehicle Type,Cargo Type]
	* Loading Multiplier from Absorbed Travel[Vehicle Type,Cargo Type]
	~	things
	~		|

