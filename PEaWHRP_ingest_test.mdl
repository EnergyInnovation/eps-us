{UTF-8}
Check PEM Capex Cement EM5=
	PEMCC Process Efficiency Measure Capital Cost per Unit Annual Energy Saved[cement and other nonmetallic minerals 239\
		,efficiency measure 5]
	~	$/BTU
	~	Expected 0 (zero-capex cement measure).
	|

Check PEM Opex Min=
	VMIN(PEMOC Process Efficiency Measure OM Cost per Unit Energy Saved[Industry Category\
		!,Process Efficiency Measure!])
	~	$/BTU
	~	Expected -1.909E-05 (negative-opex measure).
	|

Check Sum MCLM=
	SUM(MCLM Measure Cost Level Multiplier[Measure Cost Level!])
	~	Dmnl
	~	Expected 5.0000.
	|

Check Sum MCLS=
	SUM(MCLS Measure Cost Level Share[Measure Cost Level!])
	~	Dmnl
	~	Expected 1.
	|

Check Sum MHRP=
	SUM(MHRP Measure Hurdle Rate Premium[Industry Category!])
	~	Dmnl
	~	Expected 25 x 0.07 = 1.75.
	|

Check Sum PEM Elec Savings=
	SUM(PEMESP Process Efficiency Measure Elec Savings Potential[Industry Category!,Process Efficiency Measure\
		!])
	~	Dmnl
	~	Compare against xlsx column total.
	|

Check Sum PEM Fuel Savings=
	SUM(PEMFSP Process Efficiency Measure Fuel Savings Potential[Industry Category!,Process Efficiency Measure\
		!])
	~	Dmnl
	~	Compare against xlsx column total.
	|

Check Sum WHM Elec Savings=
	SUM(WHMESP Waste Heat Measure Elec Savings Potential[Industry Category!,Waste Heat Measure\
		!])
	~	Dmnl
	~	Compare against xlsx column total.
	|

Check Sum WHM Fuel Savings=
	SUM(WHMFSP Waste Heat Measure Fuel Savings Potential[Industry Category!,Waste Heat Measure\
		!])
	~	Dmnl
	~	Compare against xlsx column total.
	|

Check WHM Capex Steel WM3=
	WHMCC Waste Heat Measure Capital Cost per Unit Annual Energy Saved[iron and steel 241\
		,waste heat measure 3]
	~	$/BTU
	~	Spot check against xlsx.
	|

Check WHM Lifetime Chem WM4=
	WHMEL Waste Heat Measure Equipment Lifetime[chemicals 20,waste heat measure 4]
	~	years
	~	Expected 20.
	|

Check WHM Fuel Savings PPP WM6=
	WHMFSP Waste Heat Measure Fuel Savings Potential[pulp paper and printing 17T18,waste heat measure 6\
		]
	~	Dmnl
	~	Expected 0.02637590346582127.
	|

