PEMCC Process Efficiency Measure Capital Cost per Unit Annual Energy Saved[Industry Category\
		,Process Efficiency Measure]= INITIAL(
	VECTOR ELM MAP(
	  PEM Capital Cost by Row[pem 01T03 X efficiency measure 1],
	  (Industry Category - 1) * ELMCOUNT(Process Efficiency Measure)
	  + (Process Efficiency Measure - 1)
	))
	~	$/BTU
	~		|

PEMEL Process Efficiency Measure Equipment Lifetime[Industry Category,Process Efficiency Measure\
		]= INITIAL(
	VECTOR ELM MAP(
	  PEM Equipment Lifetime by Row[pem 01T03 X efficiency measure 1],
	  (Industry Category - 1) * ELMCOUNT(Process Efficiency Measure)
	  + (Process Efficiency Measure - 1)
	))
	~	years
	~		|

PEMESP Process Efficiency Measure Elec Savings Potential[Industry Category,Process Efficiency Measure\
		]= INITIAL(
	VECTOR ELM MAP(
	  PEM Elec Savings Potential by Row[pem 01T03 X efficiency measure 1],
	  (Industry Category - 1) * ELMCOUNT(Process Efficiency Measure)
	  + (Process Efficiency Measure - 1)
	))
	~	Dmnl
	~		|

PEMFSP Process Efficiency Measure Fuel Savings Potential[Industry Category,Process Efficiency Measure\
		]= INITIAL(
	VECTOR ELM MAP(
	  PEM Fuel Savings Potential by Row[pem 01T03 X efficiency measure 1],
	  (Industry Category - 1) * ELMCOUNT(Process Efficiency Measure)
