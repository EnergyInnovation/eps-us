# Vensim model run results (Vensim Data Format)
*.vdf
*.vdfx
*.4vmfx

# Vensim sensitivity simulation parameters (Vensim Sensitivity Control)
*.vsc

# Vensim auto-generated model backups
*.2mdl

# Vensim temporary run cache files
*.3vm
*.3vmfx

# Vensim settings specific to current user's computer
*.mdls

# Mac-specific files
.DS_Store

# Vensim command scripts (generated by the Python scripts)
*.cmd

# Tab-separated values files (generated by Vensim command scripts or Vensim "Export Dataset" command)
*.tsv
*.tab

# Windows applications' hidden temporary backup files
~*

# Editing-session model snapshots and probe fragments (local working copies only)
*.bak
*.0mdl

# Vensim savelists: scratch/diagnostic lists are local-only.
# The exported-output lists below are real repo artifacts.
*.lst
!OutputVarsToExport.lst
!OutputVarsForWedgeDiagram.lst
!OutputVarsForCarbonCapToTaxScript.lst
!InputData/**/*.lst

# Local model snapshots and session backups (git history is the real record)
EPS_*.mdl
EPS.mdl.*
EPSGUIVIEW.mdl

# Local run drivers and logs
*.log
*.tmp
LOADMODEL

# Local scenario .cin files: the shared scenarios below are real repo artifacts
*.cin
!US_ClimateAmbition.cin
!hydgn.cin
!procemiss.cin

# Working notes and planning docs are local-only by default, so they never show up as
# unstaged files. Docs already committed stay tracked (gitignore does not affect tracked
# files); to add a NEW doc to the repo deliberately, use: git add -f <file>.md
*.md

# Local scratch data
ProcSpecTiming.csv
CESdemo_parse.py
